{% extends 'front/front.html.twig' %}

{% block title %}Verification e-mail{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-verify-local-preview {
      margin-top: 1.5rem;
      padding: 1.4rem 1.5rem;
      border-radius: 24px;
      background:
        radial-gradient(circle at top left, rgba(38, 209, 170, 0.14), transparent 42%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(232, 243, 255, 0.92));
      border: 1px solid rgba(21, 96, 189, 0.14);
      box-shadow: 0 18px 42px rgba(21, 96, 189, 0.08);
    }

    .ft-verify-local-preview__badge,
    .ft-verify-preview-card__status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      border-radius: 999px;
      padding: 0.42rem 0.8rem;
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .ft-verify-local-preview__badge {
      margin-bottom: 0.9rem;
      color: #0f5fd3;
      background: rgba(15, 95, 211, 0.1);
    }

    .ft-verify-local-preview h3 {
      margin-bottom: 0.6rem;
      font-size: 1.15rem;
      font-weight: 800;
      color: #15315d;
    }

    .ft-verify-local-preview p {
      margin-bottom: 0.9rem;
      color: #557097;
      line-height: 1.7;
    }

    .ft-verify-local-preview__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .ft-verify-local-preview__meta span {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.55rem 0.85rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      color: #26466f;
      font-size: 0.84rem;
      font-weight: 600;
    }

    .ft-verify-preview-card {
      margin-bottom: 1.2rem;
      padding: 1.15rem 1.2rem;
      border-radius: 22px;
      border: 1px solid rgba(21, 96, 189, 0.14);
      background:
        radial-gradient(circle at top right, rgba(21, 96, 189, 0.08), transparent 38%),
        linear-gradient(145deg, rgba(246, 250, 255, 0.98), rgba(234, 243, 255, 0.96));
      box-shadow: 0 14px 34px rgba(21, 96, 189, 0.08);
    }

    .ft-verify-preview-card--warning {
      background:
        radial-gradient(circle at top right, rgba(255, 191, 72, 0.14), transparent 38%),
        linear-gradient(145deg, rgba(255, 252, 244, 0.98), rgba(255, 247, 226, 0.96));
      border-color: rgba(232, 170, 54, 0.18);
    }

    .ft-verify-preview-card__header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 0.9rem;
    }

    .ft-verify-preview-card__eyebrow {
      display: block;
      margin-bottom: 0.2rem;
      color: #5f7ca7;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .ft-verify-preview-card__header strong {
      color: #17325f;
      font-size: 1rem;
    }

    .ft-verify-preview-card__status {
      color: #0f5fd3;
      background: rgba(15, 95, 211, 0.1);
    }

    .ft-verify-preview-card__code {
      margin-bottom: 0.85rem;
      border-radius: 18px;
      padding: 0.95rem 1rem;
      background: rgba(255, 255, 255, 0.86);
      color: #0d2c59;
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: 0.42rem;
      text-align: center;
      box-shadow: inset 0 0 0 1px rgba(21, 96, 189, 0.08);
    }

    .ft-verify-preview-card p {
      color: #59739a;
      line-height: 1.65;
    }

    @media (max-width: 767.98px) {
      .ft-verify-preview-card__header {
        flex-direction: column;
      }

      .ft-verify-preview-card__code {
        font-size: 1.7rem;
        letter-spacing: 0.28rem;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div class="ft-auth-page ft-verify-page">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
      <div class="col-12 col-lg-10">
        <div class="ft-verify-shell">
          <div class="ft-verify-side">
            <div class="ft-verify-kicker">
              <i class="bi bi-shield-lock"></i>
              Confirmation d inscription
            </div>
            <h1 class="ft-auth-title mb-3">Verifiez votre adresse e-mail</h1>
            <p class="ft-verify-copy mb-4">
              Saisissez le code a 6 chiffres envoye a votre adresse e-mail pour activer votre acces FinTrust.
              Le code reste valide pendant 10 minutes.
            </p>

            <div class="ft-verify-points">
              <div class="ft-verify-point">
                <i class="bi bi-envelope-check"></i>
                <div>
                  <strong>Code unique</strong>
                  <span>Un nouveau code est genere pour chaque renvoi.</span>
                </div>
              </div>
              <div class="ft-verify-point">
                <i class="bi bi-clock-history"></i>
                <div>
                  <strong>Expiration courte</strong>
                  <span>Le code expire automatiquement apres 10 minutes.</span>
                </div>
              </div>
              <div class="ft-verify-point">
                <i class="bi bi-bank"></i>
                <div>
                  <strong>Acces protege</strong>
                  <span>La connexion reste bloquee tant que l e-mail n est pas verifie.</span>
                </div>
              </div>
            </div>

            {% if mailDeliveryDisabled %}
              <div class="ft-verify-local-preview">
                <div class="ft-verify-local-preview__badge">
                  <i class="bi bi-lightning-charge"></i>
                  Mode local actif
                </div>
                <h3>Envoi e-mail indisponible sur cette machine</h3>
                <p>
                  Le SMTP FinTrust n est pas encore configure. Pour continuer votre validation locale,
                  utilisez le code genere ci-contre.
                </p>
                <div class="ft-verify-local-preview__meta">
                  <span><i class="bi bi-shield-lock"></i> Aucun envoi externe</span>
                  <span><i class="bi bi-laptop"></i> Valable sur ce poste de travail</span>
                </div>
              </div>
            {% endif %}
          </div>

          <div class="ft-auth-card ft-verify-card">
            <div class="ft-auth-header text-center mb-4">
              <div class="ft-auth-logo mb-3">
                <svg viewBox="0 0 40 40" fill="none" width="48" height="48">
                  <rect width="40" height="40" rx="10" fill="#1560BD"/>
                  <path d="M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z" fill="white"/>
                </svg>
              </div>
              <h2 class="ft-auth-title ft-verify-title">Entrer mon code</h2>
              <p class="text-muted mb-0">Utilisez le code recu par e-mail pour finaliser votre inscription.</p>
            </div>

            {% if verificationPreview %}
              <div class="ft-verify-preview-card">
                <div class="ft-verify-preview-card__header">
                  <div>
                    <span class="ft-verify-preview-card__eyebrow">Code local disponible</span>
                    <strong>Validation immediate sur cette machine</strong>
                  </div>
                  <span class="ft-verify-preview-card__status">LOCAL</span>
                </div>
                <div class="ft-verify-preview-card__code">{{ verificationPreview.code }}</div>
                <p class="mb-0">
                  Code genere pour <strong>{{ verificationPreview.email }}</strong>{% if verificationPreview.generatedAt %},
                  a {{ verificationPreview.generatedAt|date('H:i') }}{% endif %}.
                </p>
              </div>
            {% elseif mailDeliveryDisabled %}
              <div class="ft-verify-preview-card ft-verify-preview-card--warning">
                <div class="ft-verify-preview-card__header">
                  <div>
                    <span class="ft-verify-preview-card__eyebrow">Apercu en attente</span>
                    <strong>Le code local apparaitra apres inscription ou renvoi</strong>
                  </div>
                  <span class="ft-verify-preview-card__status">ATTENTE</span>
                </div>
                <p class="mb-0">Utilisez le bouton de renvoi pour generer un nouveau code local si besoin.</p>
              </div>
            {% endif %}

            {{ form_start(verifyForm, {attr: {novalidate: 'novalidate'}}) }}
              {{ form_errors(verifyForm) }}

              <div class="mb-3">
                <label class="form-label fw-semibold" for="{{ verifyForm.email.vars.id }}">
                  <i class="bi bi-envelope me-1 text-primary"></i>{{ form_label(verifyForm.email) }}
                </label>
                {{ form_widget(verifyForm.email, {attr: {class: 'form-control ft-input', placeholder: 'exemple@fintrust.tn'}}) }}
                {% if verifyForm.email.vars.errors|length > 0 %}
                  <div class="text-danger small mt-1">{{ form_errors(verifyForm.email) }}</div>
                {% endif %}
              </div>

              <div class="mb-2">
                <label class="form-label fw-semibold" for="{{ verifyForm.code.vars.id }}">
                  <i class="bi bi-key me-1 text-primary"></i>{{ form_label(verifyForm.code) }}
                </label>
                {{ form_widget(verifyForm.code, {attr: {class: 'form-control ft-input ft-verify-code-input', placeholder: '123456'}}) }}
                <div class="form-text">Le code contient exactement 6 chiffres.</div>
                {% if verifyForm.code.vars.errors|length > 0 %}
                  <div class="text-danger small mt-1">{{ form_errors(verifyForm.code) }}</div>
                {% endif %}
              </div>

              <button type="submit" class="btn ft-btn-primary w-100 py-2 fw-semibold mt-3">
                <i class="bi bi-patch-check me-2"></i>Verifier mon compte
              </button>
            {{ form_end(verifyForm) }}

            <form method="post" action="{{ path('app_verify_account_resend') }}" class="mt-3">
              <input type="hidden" name="_token" value="{{ csrf_token('resend_verification_code') }}">
              <input type="hidden" name="email" value="{{ prefilledEmail ?: verifyForm.email.vars.value }}">
              <button type="submit" class="btn ft-btn-outline-primary w-100">
                <i class="bi bi-arrow-repeat me-2"></i>Renvoyer un nouveau code
              </button>
            </form>

            <div class="text-center mt-4">
              <span class="text-muted small">Deja verifie ?</span>
              <a href="{{ path('app_login') }}" class="ms-1 fw-semibold text-primary text-decoration-none">
                Se connecter
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
