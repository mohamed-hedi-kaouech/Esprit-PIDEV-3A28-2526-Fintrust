{% extends 'front/front.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="ft-auth-page">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
      <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="ft-auth-card">
          <div class="ft-auth-header text-center mb-4">
            <div class="ft-auth-logo mb-3">
              <a href="{{ path('app') }}" class="d-inline-flex text-decoration-none" title="Retour a l accueil">
                <svg viewBox="0 0 40 40" fill="none" width="48" height="48">
                  <rect width="40" height="40" rx="10" fill="#1560BD"/>
                  <path d="M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z" fill="white"/>
                </svg>
              </a>
            </div>
            <h1 class="ft-auth-title">Bon retour</h1>
            <p class="text-muted">Connectez-vous a votre espace client FinTrust</p>
          </div>

          {% if error %}
            <div class="alert alert-danger d-flex align-items-center" role="alert">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>
              <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
          {% endif %}

          {% if app.request.query.get('reset') %}
            <div class="alert alert-info d-flex align-items-center" role="alert">
              <i class="bi bi-shield-lock-fill me-2"></i>
              <span>Votre mot de passe a ete mis a jour. Veuillez vous reconnecter.</span>
            </div>
          {% endif %}

          <form method="post" action="{{ path('app_login') }}" id="loginForm" novalidate="novalidate">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">
                <i class="bi bi-envelope me-1 text-primary"></i>Adresse e-mail
              </label>
              <input
                type="text"
                id="email"
                name="email"
                value="{{ last_username }}"
                class="form-control ft-input"
                placeholder="vous@exemple.com"
                autocomplete="email"
              />
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <label for="password" class="form-label fw-semibold">
                  <i class="bi bi-lock me-1 text-primary"></i>Mot de passe
                </label>
                <a href="{{ path('app_forgot_password') }}" class="small fw-semibold text-decoration-none">
                  Mot de passe oublie ?
                </a>
              </div>
              <div class="input-group">
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-control ft-input"
                  placeholder="••••••••"
                  autocomplete="current-password"
                />
                <button class="btn btn-outline-secondary ft-toggle-pwd" type="button" id="togglePwd" tabindex="-1">
                  <i class="bi bi-eye" id="togglePwdIcon"></i>
                </button>
              </div>
            </div>

            {% if captcha_required %}
              <div class="ft-captcha-card mb-3">
                <label class="form-label fw-semibold mb-2">
                  <i class="bi bi-shield-check me-1 text-primary"></i>Verification anti-bot
                </label>
                <input type="hidden" name="captcha_token" value="{{ captcha.token }}">
                <label class="ft-captcha-checkbox" for="captcha_confirm">
                  <input type="checkbox" id="captcha_confirm" name="captcha_confirm" value="1">
                  <span class="ft-captcha-box"><i class="bi bi-check-lg"></i></span>
                  <span class="ft-captcha-label">{{ captcha.label }}</span>
                </label>
                <div class="form-text">La verification s active apres plusieurs tentatives echouees.</div>
              </div>
            {% endif %}

            <button type="submit" class="btn ft-btn-primary w-100 py-2 fw-semibold mt-2">
              <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
            </button>

            <div class="ft-auth-divider" aria-hidden="true">
              <span>Ou continuer avec</span>
            </div>

            <button
              type="button"
              class="btn ft-btn-biometric w-100 py-2 fw-semibold"
              id="openBiometricModal"
              aria-haspopup="dialog"
              aria-controls="biometricModal"
            >
              <i class="bi bi-person-bounding-box me-2"></i>Connexion par reconnaissance faciale
            </button>

            <div class="text-center mt-3">
              <button
                type="button"
                class="btn btn-link ft-auth-inline-link p-0"
                id="openBiometricEnroll"
                aria-haspopup="dialog"
                aria-controls="biometricModal"
              >
                Activer la connexion faciale sur cet appareil
              </button>
            </div>
          </form>

          <div class="text-center mt-4">
            <span class="text-muted small">Pas encore de compte ?</span>
            <a href="{{ path('app_register') }}" class="ms-1 fw-semibold text-primary text-decoration-none">
              Creer un compte
            </a>
            <div class="mt-2">
              <a href="{{ path('app_verify_account', last_username ? {email: last_username} : {}) }}" class="small fw-semibold text-decoration-none">
                Verifier mon adresse e-mail
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="ft-face-modal" id="biometricModal" aria-hidden="true">
  <div class="ft-face-modal__backdrop" data-close-biometric></div>
  <div
    class="ft-face-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="biometricModalTitle"
    aria-describedby="biometricModalText"
  >
    <button type="button" class="ft-face-modal__close" data-close-biometric aria-label="Fermer">
      <i class="bi bi-x-lg"></i>
    </button>

    <div class="ft-face-modal__eyebrow" id="biometricModeLabel">Connexion biometrique</div>
    <h2 class="ft-face-modal__title" id="biometricModalTitle">Connexion biométrique sécurisée</h2>
    <p class="ft-face-modal__text" id="biometricModalText">Utilisez la biométrie sécurisée de votre appareil pour continuer.</p>

    <div class="ft-face-status" id="biometricStatus">
      <span class="ft-face-status__dot"></span>
      <span id="biometricStatusText">Préparation sécurisée...</span>
    </div>

    <div class="ft-face-camera">
      <video id="biometricVideo" class="ft-face-camera__video" playsinline autoplay muted></video>
      <div class="ft-face-camera__placeholder" id="biometricPlaceholder">
        <div class="ft-face-camera__icon"><i class="bi bi-shield-lock"></i></div>
        <p class="mb-0">Validez avec Face ID, Windows Hello ou la biométrie de votre appareil.</p>
      </div>
      <div class="ft-face-frame">
        <div class="ft-face-frame__corners"></div>
        <div class="ft-face-frame__scan"></div>
      </div>
    </div>

    <div class="ft-face-state-list">
      <div class="ft-face-state-pill"><i class="bi bi-phone me-2"></i>Appareil prêt</div>
      <div class="ft-face-state-pill"><i class="bi bi-person-check me-2"></i>Identité locale vérifiée</div>
      <div class="ft-face-state-pill"><i class="bi bi-shield-check me-2"></i>Validation FinTrust</div>
    </div>

    <div class="ft-face-feedback d-none" id="biometricFeedback"></div>

    <div class="ft-face-modal__footer">
      <button type="button" class="btn btn-outline-secondary" data-close-biometric>Annuler</button>
      <button type="button" class="btn ft-btn-outline-primary d-none" id="retryBiometric">Reessayer</button>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
  document.getElementById('togglePwd')?.addEventListener('click', function() {
    const pwd = document.getElementById('password');
    const icon = document.getElementById('togglePwdIcon');
    if (pwd.type === 'password') {
      pwd.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      pwd.type = 'password';
      icon.className = 'bi bi-eye';
    }
  });

  (() => {
    const modal = document.getElementById('biometricModal');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const openLoginButton = document.getElementById('openBiometricModal');
    const openEnrollButton = document.getElementById('openBiometricEnroll');
    const closeButtons = modal ? modal.querySelectorAll('[data-close-biometric]') : [];
    const placeholder = document.getElementById('biometricPlaceholder');
    const statusText = document.getElementById('biometricStatusText');
    const feedback = document.getElementById('biometricFeedback');
    const retryButton = document.getElementById('retryBiometric');
    const title = document.getElementById('biometricModalTitle');
    const text = document.getElementById('biometricModalText');
    const modeLabel = document.getElementById('biometricModeLabel');
    const biometricToken = {{ csrf_token('biometric_login')|json_encode|raw }};
    let currentMode = 'login';

    const setStatus = (message) => {
      if (statusText) {
        statusText.textContent = message;
      }
    };

    const setFeedback = (message, type = 'info') => {
      if (!feedback) {
        return;
      }

      feedback.className = `ft-face-feedback ft-face-feedback--${type}`;
      feedback.textContent = message;
    };

    const resetFeedback = () => {
      if (!feedback) {
        return;
      }

      feedback.className = 'ft-face-feedback d-none';
      feedback.textContent = '';
    };

    const base64UrlToBuffer = (value) => {
      const padding = '='.repeat((4 - value.length % 4) % 4);
      const base64 = (value + padding).replace(/-/g, '+').replace(/_/g, '/');
      const binary = window.atob(base64);
      const bytes = new Uint8Array(binary.length);

      for (let index = 0; index < binary.length; index += 1) {
        bytes[index] = binary.charCodeAt(index);
      }

      return bytes.buffer;
    };

    const bufferToBase64Url = (buffer) => {
      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });

      return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
    };

    const withPublicKeyBuffers = (options) => ({
      ...options,
      challenge: base64UrlToBuffer(options.challenge),
      user: options.user ? { ...options.user, id: base64UrlToBuffer(options.user.id) } : undefined,
      excludeCredentials: (options.excludeCredentials || []).map((credential) => ({
        ...credential,
        id: base64UrlToBuffer(credential.id),
      })),
      allowCredentials: (options.allowCredentials || []).map((credential) => ({
        ...credential,
        id: base64UrlToBuffer(credential.id),
      })),
    });

    const postJson = async (url, payload) => {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.message || 'Operation biométrique impossible.');
      }

      return data;
    };

    const requireWebAuthn = () => {
      if (!window.PublicKeyCredential || !navigator.credentials) {
        throw new Error('La biométrie sécurisée n est pas disponible sur ce navigateur.');
      }
    };

    const handleBiometricEnroll = async () => {
      requireWebAuthn();

      const email = emailInput?.value.trim() ?? '';
      const password = passwordInput?.value ?? '';

      if (email === '' || password.trim() === '') {
        throw new Error('Renseignez votre e-mail et votre mot de passe pour activer la biométrie.');
      }

      setStatus('Préparation de l activation...');
      const options = await postJson('{{ path('app_biometric_enroll_options') }}', {
        _token: biometricToken,
        email,
        password,
      });

      setStatus('Validation sur votre appareil...');
      const credential = await navigator.credentials.create({
        publicKey: withPublicKeyBuffers(options),
      });

      if (!credential || !credential.response || typeof credential.response.getPublicKey !== 'function') {
        throw new Error('Ce navigateur ne fournit pas la clé biométrique nécessaire. Essayez Chrome, Edge ou Safari récent.');
      }

      const publicKey = credential.response.getPublicKey();
      if (!publicKey) {
        throw new Error('La clé biométrique de l appareil est indisponible.');
      }

      await postJson('{{ path('app_biometric_enroll_verify') }}', {
        _token: biometricToken,
        email,
        id: credential.id,
        clientDataJSON: bufferToBase64Url(credential.response.clientDataJSON),
        publicKeySpki: bufferToBase64Url(publicKey),
        publicKeyAlgorithm: credential.response.getPublicKeyAlgorithm(),
        deviceLabel: navigator.platform || 'Appareil biométrique',
      });

      setStatus('Biométrie activée');
      setFeedback('Connexion biométrique activée avec succès sur cet appareil. Une autre personne ne pourra pas ouvrir ce compte sans la biométrie valide de cet appareil.', 'success');
      retryButton?.classList.add('d-none');
    };

    const handleBiometricLogin = async () => {
      requireWebAuthn();

      const email = emailInput?.value.trim() ?? '';
      if (email === '') {
        throw new Error('Renseignez votre e-mail avant la connexion biométrique.');
      }

      setStatus('Préparation de la vérification...');
      const options = await postJson('{{ path('app_biometric_auth_options') }}', {
        _token: biometricToken,
        email,
      });

      setStatus('Vérification locale en cours...');
      const assertion = await navigator.credentials.get({
        publicKey: withPublicKeyBuffers(options),
      });

      if (!assertion) {
        throw new Error('La vérification biométrique a été annulée.');
      }

      setStatus('Validation FinTrust...');
      const result = await postJson('{{ path('app_biometric_auth_verify') }}', {
        _token: biometricToken,
        email,
        id: assertion.id,
        clientDataJSON: bufferToBase64Url(assertion.response.clientDataJSON),
        authenticatorData: bufferToBase64Url(assertion.response.authenticatorData),
        signature: bufferToBase64Url(assertion.response.signature),
      });

      setStatus('Identité confirmée');
      setFeedback(result.message || 'Identité confirmée. Connexion en cours...', 'success');
      retryButton?.classList.add('d-none');

      window.setTimeout(() => {
        window.location.href = result.redirectUrl || '{{ path('front_dashboard') }}';
      }, 700);
    };

    const openModal = async (mode) => {
      if (!modal) {
        return;
      }

      currentMode = mode;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('ft-face-modal-open');
      resetFeedback();
      retryButton?.classList.add('d-none');

      if (mode === 'enroll') {
        modeLabel.textContent = 'Activation biometrique';
        title.textContent = 'Enregistrer mon visage sur cet appareil';
        text.textContent = 'Cette activation liera ce compte a la biométrie sécurisée de cet appareil. Une autre personne ne pourra pas entrer sur ce compte sans validation biométrique locale.';
        setStatus('Prêt à activer');
        placeholder?.classList.remove('d-none');
        setFeedback('Renseignez vos identifiants, puis validez l activation sur votre appareil.', 'info');
        return;
      }

      modeLabel.textContent = 'Connexion biometrique';
      title.textContent = 'Connexion biométrique sécurisée';
      text.textContent = 'Utilisez la biométrie sécurisée de votre appareil pour ouvrir la session du compte saisi.';
      setStatus('Prêt à vérifier');
      placeholder?.classList.remove('d-none');
      setFeedback('Saisissez votre e-mail puis validez avec la biométrie locale de cet appareil.', 'info');
    };

    const closeModal = () => {
      if (!modal) {
        return;
      }

      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('ft-face-modal-open');
      retryButton?.classList.add('d-none');
      resetFeedback();
    };

    retryButton?.addEventListener('click', async () => {
      resetFeedback();
      retryButton?.classList.add('d-none');

      try {
        if (currentMode === 'enroll') {
          await handleBiometricEnroll();
          return;
        }

        await handleBiometricLogin();
      } catch (error) {
        setStatus('Verification impossible');
        setFeedback(error.message || 'La verification biométrique a échoué.', 'error');
        retryButton?.classList.remove('d-none');
      }
    });
    closeButtons.forEach((button) => button.addEventListener('click', closeModal));

    openLoginButton?.addEventListener('click', async () => {
      openModal('login');
      try {
        await handleBiometricLogin();
      } catch (error) {
        setStatus('Verification impossible');
        setFeedback(error.message || 'La verification biométrique a échoué.', 'error');
        retryButton?.classList.remove('d-none');
      }
    });

    openEnrollButton?.addEventListener('click', async () => {
      openModal('enroll');
      try {
        await handleBiometricEnroll();
      } catch (error) {
        setStatus('Activation impossible');
        setFeedback(error.message || 'L activation biométrique a échoué.', 'error');
        retryButton?.classList.remove('d-none');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal?.classList.contains('is-open')) {
        closeModal();
      }
    });
  })();
</script>
<style>
  .ft-auth-divider {
    display: flex;
    align-items: center;
    gap: .9rem;
    margin: 1.2rem 0 1rem;
    color: #7b8aa4;
    font-size: .88rem;
    font-weight: 600;
  }

  .ft-auth-divider::before,
  .ft-auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(21, 96, 189, 0), rgba(21, 96, 189, .14), rgba(21, 96, 189, 0));
  }

  .ft-btn-biometric {
    background: #fff;
    color: #123c8d;
    border: 1.5px solid rgba(21, 96, 189, .16);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease;
  }

  .ft-btn-biometric:hover {
    background: #f8fbff;
    color: #0f3f94;
    border-color: rgba(21, 96, 189, .28);
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, .08);
  }

  .ft-auth-inline-link {
    color: #1c5fd1;
    font-size: .92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .ft-auth-inline-link:hover {
    color: #0f4cae;
    text-decoration: underline;
  }

  .ft-face-modal {
    position: fixed;
    inset: 0;
    display: none;
    z-index: 1200;
  }

  .ft-face-modal.is-open {
    display: block;
  }

  .ft-face-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, .38);
    backdrop-filter: blur(6px);
  }

  .ft-face-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(92vw, 540px);
    margin: 5vh auto;
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,250,255,.98));
    border: 1px solid rgba(21, 96, 189, .1);
    box-shadow: 0 30px 80px rgba(15, 23, 42, .18);
    border-radius: 28px;
    padding: 1.5rem 1.5rem 1.35rem;
  }

  .ft-face-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, .28);
    background: rgba(255,255,255,.86);
    color: #475569;
  }

  .ft-face-modal__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .45rem .8rem;
    border-radius: 999px;
    background: #edf5ff;
    color: #18448f;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .02em;
    margin-bottom: 1rem;
  }

  .ft-face-modal__title {
    font-family: var(--ft-font-display);
    color: #0f172a;
    font-size: 1.85rem;
    margin-bottom: .45rem;
  }

  .ft-face-modal__text {
    color: #64748b;
    margin-bottom: 1rem;
  }

  .ft-face-status {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: .45rem .8rem;
    border-radius: 999px;
    background: #f8fbff;
    border: 1px solid rgba(21, 96, 189, .08);
    color: #194287;
    font-size: .88rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .ft-face-status__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: linear-gradient(135deg, #60a5fa, #2563eb);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, .08);
  }

  .ft-face-camera {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    border-radius: 24px;
    background:
      radial-gradient(circle at top, rgba(59, 130, 246, .12), transparent 40%),
      linear-gradient(180deg, #eef5ff, #f8fbff);
    border: 1px solid rgba(21, 96, 189, .1);
  }

  .ft-face-camera__video,
  .ft-face-camera__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ft-face-camera__video {
    object-fit: cover;
    background: #dbeafe;
  }

  .ft-face-camera__placeholder {
    display: grid;
    place-items: center;
    text-align: center;
    color: #54708f;
    padding: 1.5rem;
    background: linear-gradient(180deg, rgba(248, 251, 255, .88), rgba(237, 245, 255, .96));
  }

  .ft-face-camera__icon {
    width: 72px;
    height: 72px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(21, 96, 189, .12);
    color: #1d4ed8;
    font-size: 1.7rem;
    margin-bottom: .9rem;
  }

  .ft-face-frame {
    position: absolute;
    inset: 14%;
    border-radius: 30px;
    pointer-events: none;
  }

  .ft-face-frame__corners {
    position: absolute;
    inset: 0;
    border-radius: 30px;
    border: 1.5px solid rgba(148, 163, 184, .38);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.42);
  }

  .ft-face-frame__scan {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 22%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(59,130,246,0), rgba(59,130,246,.92), rgba(59,130,246,0));
    box-shadow: 0 0 18px rgba(59,130,246,.35);
    animation: ft-face-scan 2.8s ease-in-out infinite;
  }

  .ft-face-state-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: 1rem;
  }

  .ft-face-state-pill {
    padding: .55rem .8rem;
    border-radius: 999px;
    background: #f8fbff;
    border: 1px solid rgba(21, 96, 189, .08);
    color: #54708f;
    font-size: .84rem;
    font-weight: 600;
  }

  .ft-face-feedback {
    margin-top: 1rem;
    border-radius: 16px;
    padding: .9rem 1rem;
    font-size: .92rem;
    line-height: 1.5;
  }

  .ft-face-feedback--success {
    background: #edfdf3;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .ft-face-feedback--error {
    background: #fff1f2;
    color: #be123c;
    border: 1px solid #fecdd3;
