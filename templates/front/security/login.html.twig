{% extends 'front/front.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="ft-auth-page">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
      <div class="col-12 col-lg-10">
        <div class="row g-4 align-items-stretch">
          <div class="col-lg-6">
            <div class="ft-login-showcase h-100">
              <div class="ft-login-showcase__eyebrow">
                <i class="bi bi-stars"></i>
                <span>Connexion intelligente FinTrust</span>
              </div>
              <h1 class="ft-login-showcase__title">Entrez avec votre mot de passe ou votre selfie KYC de reference</h1>
              <p class="ft-login-showcase__text">
                Votre selfie KYC est enregistre dans vos fichiers de verification. Lors de la connexion,
                FinTrust compare le selfie capture avec votre dossier, puis valide l acces avec votre mot de passe.
              </p>

              <div class="ft-login-showcase__grid">
                <div class="ft-login-spotlight">
                  <div class="ft-login-spotlight__icon"><i class="bi bi-camera2"></i></div>
                  <div>
                    <strong>Selfie KYC</strong>
                    <p>Capture guidee, comparaison visuelle et refus si le selfie ne correspond pas au compte.</p>
                  </div>
                </div>
                <div class="ft-login-spotlight">
                  <div class="ft-login-spotlight__icon"><i class="bi bi-shield-lock"></i></div>
                  <div>
                    <strong>Double validation</strong>
                    <p>Le mot de passe reste actif pour garder une connexion plus serieuse et plus sure.</p>
                  </div>
                </div>
                <div class="ft-login-spotlight">
                  <div class="ft-login-spotlight__icon"><i class="bi bi-folder-check"></i></div>
                  <div>
                    <strong>Securite 2FA FinTrust</strong>
                    <p>FinTrust renforce chaque acces sensible avec des verifications supplementaires pour mieux proteger votre compte.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="ft-auth-card">
              <div class="ft-auth-header text-center mb-4">
                <div class="ft-auth-logo mb-3">
                  <a href="{{ path('app') }}" class="d-inline-flex text-decoration-none" title="Retour a l accueil">
                    <svg viewBox="0 0 40 40" fill="none" width="52" height="52">
                      <rect width="40" height="40" rx="10" fill="#1560BD"/>
                      <path d="M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z" fill="white"/>
                    </svg>
                  </a>
                </div>
                <h2 class="ft-auth-title">Bon retour</h2>
                <p class="text-muted mb-0">Connectez-vous a votre espace client FinTrust</p>
              </div>

              {% if error %}
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                  <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
              {% endif %}

              {% if app.request.query.get('reset') %}
                <div class="alert alert-info d-flex align-items-center" role="alert">
                  <i class="bi bi-shield-lock-fill me-2"></i>
                  <span>Votre mot de passe a ete mis a jour. Veuillez vous reconnecter.</span>
                </div>
              {% endif %}

              <form method="post" action="{{ path('app_login') }}" id="loginForm" novalidate="novalidate">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>

                <div class="mb-3">
                  <label for="email" class="form-label fw-semibold">
                    <i class="bi bi-envelope me-1 text-primary"></i>Adresse e-mail
                  </label>
                  <input
                    type="text"
                    id="email"
                    name="email"
                    value="{{ last_username }}"
                    class="form-control ft-input"
                    placeholder="vous@exemple.com"
                    autocomplete="email"
                  />
                </div>

                <div class="mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <label for="password" class="form-label fw-semibold">
                      <i class="bi bi-lock me-1 text-primary"></i>Mot de passe
                    </label>
                    <a href="{{ path('app_forgot_password') }}" class="small fw-semibold text-decoration-none">
                      Mot de passe oublie ?
                    </a>
                  </div>
                  <div class="input-group">
                    <input
                      type="password"
                      id="password"
                      name="password"
                      class="form-control ft-input"
                      placeholder="••••••••"
                      autocomplete="current-password"
                    />
                    <button class="btn btn-outline-secondary ft-toggle-pwd" type="button" id="togglePwd" tabindex="-1">
                      <i class="bi bi-eye" id="togglePwdIcon"></i>
                    </button>
                  </div>
                </div>

                {% if captcha_required %}
                  <div class="ft-captcha-card mb-3">
                    <label class="form-label fw-semibold mb-2">
                      <i class="bi bi-shield-check me-1 text-primary"></i>Verification anti-bot
                    </label>
                    {% if captcha.externalEnabled %}
                      <input type="hidden" name="recaptcha_token" data-recaptcha-token data-site-key="{{ captcha.siteKey }}" data-action="{{ captcha.action }}">
                      <div class="ft-captcha-checkbox">
                        <span class="ft-captcha-box"><i class="bi bi-shield-check"></i></span>
                        <span class="ft-captcha-label">Protection Google reCAPTCHA v3 activee</span>
                      </div>
                      <div class="form-text">Validation invisible via le bundle externe KarserRecaptcha3Bundle.</div>
                    {% else %}
                      <input type="hidden" name="captcha_token" value="{{ captcha.token }}">
                      <label class="ft-captcha-checkbox" for="captcha_confirm">
                        <input type="checkbox" id="captcha_confirm" name="captcha_confirm" value="1">
                        <span class="ft-captcha-box"><i class="bi bi-check-lg"></i></span>
                        <span class="ft-captcha-label">{{ captcha.label }}</span>
                      </label>
                      <div class="form-text">Le CAPTCHA local reste actif tant que les cles reCAPTCHA ne sont pas configurees.</div>
                    {% endif %}
                  </div>
                {% endif %}

                <button type="submit" class="btn ft-btn-primary w-100 py-2 fw-semibold mt-2">
                  <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                </button>

                <div class="ft-auth-divider" aria-hidden="true">
                  <span>Ou continuer avec</span>
                </div>

                <button
                  type="button"
                  class="btn ft-btn-selfie w-100 py-2 fw-semibold"
                  id="openSelfieLogin"
                  aria-haspopup="dialog"
                  aria-controls="selfieModal"
                >
                  <i class="bi bi-person-bounding-box me-2"></i>Connexion selfie KYC + mot de passe
                </button>

                <div class="text-center mt-3">
                  <button
                    type="button"
                    class="btn btn-link ft-auth-inline-link p-0"
                    id="openSelfieEnroll"
                    aria-haspopup="dialog"
                    aria-controls="selfieModal"
                  >
                    Enregistrer ou remplacer mon selfie KYC
                  </button>
                </div>
              </form>

              <div class="text-center mt-4">
                <span class="text-muted small">Pas encore de compte ?</span>
                <a href="{{ path('app_register') }}" class="ms-1 fw-semibold text-primary text-decoration-none">
                  Creer un compte
                </a>
                <div class="mt-2">
                  <a href="{{ path('app_verify_account', last_username ? {email: last_username} : {}) }}" class="small fw-semibold text-decoration-none">
                    Verifier mon adresse e-mail
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="ft-face-modal" id="selfieModal" aria-hidden="true">
  <div class="ft-face-modal__backdrop" data-close-selfie></div>
  <div
    class="ft-face-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="selfieModalTitle"
    aria-describedby="selfieModalText"
  >
    <button type="button" class="ft-face-modal__close" data-close-selfie aria-label="Fermer">
      <i class="bi bi-x-lg"></i>
    </button>

    <div class="ft-face-modal__eyebrow" id="selfieModeLabel">Connexion selfie KYC</div>
    <h2 class="ft-face-modal__title" id="selfieModalTitle">Verifier mon identite avec mon selfie KYC</h2>
    <p class="ft-face-modal__text" id="selfieModalText">
      Capturez un selfie depuis votre camera. FinTrust le compare au selfie de reference enregistre dans vos fichiers KYC,
      puis valide la connexion avec votre mot de passe.
    </p>

    <div class="ft-face-status" id="selfieStatus">
      <span class="ft-face-status__dot"></span>
      <span id="selfieStatusText">Camera prete</span>
    </div>

    <div class="ft-selfie-shell">
      <div class="ft-selfie-camera">
        <video id="selfieVideo" class="ft-selfie-camera__video" playsinline autoplay muted></video>
        <canvas id="selfieCanvas" class="d-none"></canvas>
        <div class="ft-selfie-camera__placeholder" id="selfiePlaceholder">
          <div class="ft-selfie-camera__icon"><i class="bi bi-camera2"></i></div>
          <p class="mb-0">Autorisez la camera puis capturez votre selfie de verification.</p>
        </div>
        <div class="ft-selfie-frame">
          <div class="ft-selfie-frame__corners"></div>
          <div class="ft-selfie-frame__scan"></div>
        </div>
      </div>

      <div class="ft-selfie-preview d-none" id="selfiePreviewWrap">
        <div class="ft-selfie-preview__label">Apercu capture</div>
        <img id="selfiePreview" alt="Selfie capture" class="ft-selfie-preview__image">
      </div>
    </div>

    <div class="row g-3 mt-2 mb-3">
      <div class="col-md-6">
        <label for="selfieModalEmail" class="form-label fw-semibold">
          <i class="bi bi-envelope me-1 text-primary"></i>Adresse e-mail
        </label>
        <input
          type="email"
          id="selfieModalEmail"
          class="form-control ft-input"
          placeholder="vous@exemple.com"
          autocomplete="username"
        />
      </div>
      <div class="col-md-6">
        <label for="selfieModalPassword" class="form-label fw-semibold">
          <i class="bi bi-lock me-1 text-primary"></i>Mot de passe
        </label>
        <input
          type="password"
          id="selfieModalPassword"
          class="form-control ft-input"
          placeholder="••••••••"
          autocomplete="current-password"
        />
      </div>
    </div>

    <div class="ft-face-state-list">
      <div class="ft-face-state-pill"><i class="bi bi-camera-video me-2"></i>Camera locale</div>
      <div class="ft-face-state-pill"><i class="bi bi-folder2-open me-2"></i>Reference KYC</div>
      <div class="ft-face-state-pill"><i class="bi bi-key me-2"></i>Mot de passe conserve</div>
    </div>

    <div class="ft-face-feedback d-none" id="selfieFeedback"></div>

    <div class="ft-face-modal__footer">
      <button type="button" class="btn btn-outline-secondary" data-close-selfie>Annuler</button>
      <button type="button" class="btn btn-outline-primary" id="captureSelfieBtn">
        <i class="bi bi-camera-fill me-2"></i>Capturer
      </button>
      <button type="button" class="btn ft-btn-primary" id="selfieActionBtn">
        <i class="bi bi-shield-check me-2"></i>Verifier
      </button>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if captcha_required and captcha.externalEnabled %}
  <script src="https://www.google.com/recaptcha/api.js?render={{ captcha.siteKey }}"></script>
{% endif %}
<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
  (() => {
    const tokenInput = document.querySelector('[data-recaptcha-token]');
    const form = tokenInput?.closest('form');
    if (!tokenInput || !form || typeof grecaptcha === 'undefined') {
      return;
    }
    let submitted = false;
    form.addEventListener('submit', (event) => {
      if (submitted) {
        return;
      }
      event.preventDefault();
      grecaptcha.ready(() => {
        grecaptcha.execute(tokenInput.dataset.siteKey, { action: tokenInput.dataset.action || 'login' }).then((token) => {
          tokenInput.value = token;
          submitted = true;
          form.submit();
        });
      });
    });
  })();

  document.getElementById('togglePwd')?.addEventListener('click', function() {
    const pwd = document.getElementById('password');
    const icon = document.getElementById('togglePwdIcon');
    if (pwd.type === 'password') {
      pwd.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      pwd.type = 'password';
      icon.className = 'bi bi-eye';
    }
  });

  (() => {
    const modal = document.getElementById('selfieModal');
    const video = document.getElementById('selfieVideo');
    const canvas = document.getElementById('selfieCanvas');
    const placeholder = document.getElementById('selfiePlaceholder');
    const previewWrap = document.getElementById('selfiePreviewWrap');
    const preview = document.getElementById('selfiePreview');
    const statusText = document.getElementById('selfieStatusText');
    const feedback = document.getElementById('selfieFeedback');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const modalEmailInput = document.getElementById('selfieModalEmail');
    const modalPasswordInput = document.getElementById('selfieModalPassword');
    const captureButton = document.getElementById('captureSelfieBtn');
    const actionButton = document.getElementById('selfieActionBtn');
    const openLoginButton = document.getElementById('openSelfieLogin');
    const openEnrollButton = document.getElementById('openSelfieEnroll');
    const title = document.getElementById('selfieModalTitle');
    const text = document.getElementById('selfieModalText');
    const modeLabel = document.getElementById('selfieModeLabel');
    const closeButtons = modal ? modal.querySelectorAll('[data-close-selfie]') : [];
    const csrfToken = {{ csrf_token('selfie_auth')|json_encode|raw }};

    let currentMode = 'login';
    let currentStream = null;
    let capturedSelfie = '';
    let capturedFingerprint = '';
    const faceApiModelUrl = 'https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights';
    let faceApiReadyPromise = null;

    const ensureFaceApiReady = async () => {
      if (typeof faceapi === 'undefined') {
        throw new Error('Le moteur de reconnaissance faciale FinTrust n a pas pu se charger. Rechargez la page puis recommencez.');
      }

      if (!faceApiReadyPromise) {
        faceApiReadyPromise = Promise.all([
          faceapi.nets.tinyFaceDetector.loadFromUri(faceApiModelUrl),
          faceapi.nets.faceLandmark68Net.loadFromUri(faceApiModelUrl),
          faceapi.nets.faceRecognitionNet.loadFromUri(faceApiModelUrl)
        ]);
      }

      await faceApiReadyPromise;
    };

    const setStatus = (message) => {
      if (statusText) {
        statusText.textContent = message;
      }
    };

    const setFeedback = (message, type = 'info') => {
      if (!feedback) {
        return;
      }

      feedback.className = `ft-face-feedback ft-face-feedback--${type}`;
      feedback.textContent = message;
    };

    const resetFeedback = () => {
      if (!feedback) {
        return;
      }

      feedback.className = 'ft-face-feedback d-none';
      feedback.textContent = '';
    };

    const buildSelfieFingerprint = async (sourceCanvas) => {
      await ensureFaceApiReady();

      const normalizedCanvas = document.createElement('canvas');
      normalizedCanvas.width = 48;
      normalizedCanvas.height = 48;
      const normalizedContext = normalizedCanvas.getContext('2d', { willReadFrequently: true });
      const cropWidth = sourceCanvas.width * 0.52;
      const cropHeight = sourceCanvas.height * 0.7;
      const cropX = (sourceCanvas.width - cropWidth) / 2;
      const cropY = (sourceCanvas.height - cropHeight) / 2.8;

      normalizedContext.drawImage(
        sourceCanvas,
        cropX,
        cropY,
        cropWidth,
        cropHeight,
        0,
        0,
        48,
        48
      );

      const { data } = normalizedContext.getImageData(0, 0, 48, 48);
      const pixels = [];
      const histogram = new Array(16).fill(0);
      let sum = 0;

      for (let index = 0; index < data.length; index += 4) {
        const gray = Math.round((data[index] * 0.299) + (data[index + 1] * 0.587) + (data[index + 2] * 0.114));
        pixels.push(gray);
        histogram[Math.min(15, Math.floor(gray / 16))] += 1;
        sum += gray;
      }

      const mean = sum / pixels.length;
      const variance = pixels.reduce((carry, value) => carry + ((value - mean) ** 2), 0) / pixels.length;
      const deviation = Math.max(18, Math.sqrt(variance));
      let hash = '';
      let upperHash = '';
      let middleHash = '';
      let lowerHash = '';

      const buildRegionHash = (startRow, endRow) => {
        let regionHash = '';

        for (let gridY = startRow; gridY < endRow; gridY += 1) {
          for (let gridX = 0; gridX < 16; gridX += 1) {
            let cellSum = 0;
            let cellCount = 0;

            for (let y = gridY * 3; y < (gridY + 1) * 3; y += 1) {
              for (let x = gridX * 3; x < (gridX + 1) * 3; x += 1) {
                const sampleX = Math.min(47, x);
                const sampleY = Math.min(47, y);
                const sampleIndex = (sampleY * 48) + sampleX;
                const normalizedValue = Math.max(0, Math.min(255, (((pixels[sampleIndex] - mean) / deviation) * 42) + 128));
                cellSum += normalizedValue;
                cellCount += 1;
              }
            }

            const cellAverage = cellCount > 0 ? (cellSum / cellCount) : 0;
            regionHash += cellAverage >= 128 ? '1' : '0';
          }
        }

        return regionHash;
      };

      for (let gridY = 0; gridY < 16; gridY += 1) {
        for (let gridX = 0; gridX < 16; gridX += 1) {
          let cellSum = 0;
          let cellCount = 0;

          for (let y = gridY * 3; y < (gridY + 1) * 3; y += 1) {
            for (let x = gridX * 3; x < (gridX + 1) * 3; x += 1) {
              const sampleX = Math.min(47, x);
              const sampleY = Math.min(47, y);
              const sampleIndex = (sampleY * 48) + sampleX;
              const normalizedValue = Math.max(0, Math.min(255, (((pixels[sampleIndex] - mean) / deviation) * 42) + 128));
              cellSum += normalizedValue;
              cellCount += 1;
            }
          }

          const cellAverage = cellCount > 0 ? (cellSum / cellCount) : 0;
          hash += cellAverage >= mean ? '1' : '0';
        }
      }

      upperHash = buildRegionHash(0, 5);
      middleHash = buildRegionHash(5, 11);
      lowerHash = buildRegionHash(11, 16);

      const detection = await faceapi
        .detectSingleFace(sourceCanvas, new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.45 }))
        .withFaceLandmarks()
        .withFaceDescriptor();

      if (!detection?.descriptor) {
        throw new Error('Aucun visage exploitable n a ete detecte. Regardez la camera bien de face et reprenez le selfie.');
      }

      return JSON.stringify({
        hash,
        upperHash,
        middleHash,
        lowerHash,
        descriptor: Array.from(detection.descriptor, (value) => Number(value.toFixed(8))),
        histogram: histogram.map((bucket) => Number((bucket / pixels.length).toFixed(6))),
        mean: Number(mean.toFixed(4)),
        deviation: Number(deviation.toFixed(4))
      });
    };

    const setMode = (mode) => {
      currentMode = mode;

      if (mode === 'enroll') {
        modeLabel.textContent = 'Enregistrement selfie KYC';
        title.textContent = 'Enregistrer ou remplacer mon selfie KYC';
        text.textContent = 'Capturez un selfie clair. Il sera range dans vos fichiers KYC et servira ensuite de reference pour votre connexion selfie + mot de passe.';
        actionButton.innerHTML = '<i class="bi bi-cloud-check me-2"></i>Enregistrer';
        setStatus('Pret a enregistrer');
        setFeedback('Saisissez l e-mail et le mot de passe du compte, puis capturez un selfie clair avant d enregistrer.', 'info');
        return;
      }

      modeLabel.textContent = 'Connexion selfie KYC';
      title.textContent = 'Verifier mon identite avec mon selfie KYC';
      text.textContent = 'Capturez un selfie depuis votre camera. FinTrust le compare au selfie de reference enregistre dans vos fichiers KYC, puis valide la connexion avec votre mot de passe.';
      actionButton.innerHTML = '<i class="bi bi-shield-check me-2"></i>Verifier';
      setStatus('Camera prete');
      setFeedback('Renseignez votre e-mail et votre mot de passe, puis capturez votre selfie pour verifier votre identite.', 'info');
    };

    const stopCamera = () => {
      if (currentStream) {
        currentStream.getTracks().forEach((track) => track.stop());
        currentStream = null;
      }
    };

    const syncModalCredentialsFromMain = () => {
      if (modalEmailInput && emailInput && !modalEmailInput.value) {
        modalEmailInput.value = emailInput.value || '';
      }

      if (modalPasswordInput && passwordInput && !modalPasswordInput.value) {
        modalPasswordInput.value = passwordInput.value || '';
      }
    };

    const syncMainCredentialsFromModal = () => {
      if (modalEmailInput && emailInput) {
        emailInput.value = modalEmailInput.value || '';
      }

      if (modalPasswordInput && passwordInput) {
        passwordInput.value = modalPasswordInput.value || '';
      }
    };

    const startCamera = async () => {
      if (!navigator.mediaDevices?.getUserMedia) {
        throw new Error('La camera n est pas disponible sur ce navigateur.');
      }

      stopCamera();
      currentStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: 'user',
          width: { ideal: 960 },
          height: { ideal: 720 }
        },
        audio: false
      });

      video.srcObject = currentStream;
      placeholder?.classList.add('d-none');
      setStatus('Camera active');
    };

    const captureSelfie = async () => {
      if (!video || !canvas || !video.videoWidth || !video.videoHeight) {
        throw new Error('La camera n est pas encore prete. Attendez une seconde puis recommencez.');
      }

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const context = canvas.getContext('2d');
      context.drawImage(video, 0, 0, canvas.width, canvas.height);
      capturedSelfie = canvas.toDataURL('image/png');
      capturedFingerprint = await buildSelfieFingerprint(canvas);

      if (preview && previewWrap) {
        preview.src = capturedSelfie;
        previewWrap.classList.remove('d-none');
      }

      setStatus('Selfie capture');
      setFeedback('Selfie capture avec succes. Vous pouvez maintenant lancer la verification.', 'success');
    };

    const postJson = async (url, payload) => {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(payload),
      });

      const rawText = await response.text();
      let data = null;

      try {
        data = rawText ? JSON.parse(rawText) : {};
      } catch (error) {
        throw new Error('Le serveur a renvoye une erreur technique inattendue. Rechargez la page puis recommencez.');
      }

      if (!response.ok) {
        const error = new Error(data.message || 'Operation selfie impossible.');
        error.code = data.code || 'selfie_error';
        error.score = data.score;
        error.threshold = data.threshold;
        throw error;
      }

      return data;
    };

    const ensureCredentials = () => {
      const email = modalEmailInput?.value.trim() || emailInput?.value.trim() || '';
      const password = modalPasswordInput?.value || passwordInput?.value || '';

      if (email === '' || password.trim() === '') {
        throw new Error('Renseignez votre e-mail et votre mot de passe avant d utiliser le selfie KYC.');
      }

      if (capturedSelfie === '') {
        throw new Error('Capturez d abord votre selfie pour continuer.');
      }

      if (capturedFingerprint === '') {
        throw new Error('L empreinte du selfie est absente. Reprenez votre capture.');
      }

      syncMainCredentialsFromModal();

      return { email, password, selfie: capturedSelfie, fingerprint: capturedFingerprint, _token: csrfToken };
    };

    const runAction = async () => {
      const payload = ensureCredentials();

      if (currentMode === 'enroll') {
        setStatus('Enregistrement du selfie...');
        const result = await postJson('{{ path('app_selfie_enroll') }}', payload);
        setStatus('Selfie KYC enregistre');
        setFeedback(result.message || 'Votre selfie KYC est pret.', 'success');
        return;
      }

      setStatus('Comparaison du selfie KYC...');
      const result = await postJson('{{ path('app_selfie_auth') }}', payload);
      setStatus('Connexion validee');
      setFeedback(`${result.message || 'Connexion validee.'} Score de correspondance : ${result.score}/100.`, 'success');

      window.setTimeout(() => {
        window.location.href = result.redirectUrl || '{{ path('front_dashboard') }}';
      }, 700);
    };

    const handleError = (error) => {
      const suffix = error.score ? ` Score obtenu : ${error.score}/100.` : '';
      setStatus(currentMode === 'enroll' ? 'Enregistrement impossible' : 'Verification impossible');
      setFeedback((error.message || 'Une erreur est survenue.') + suffix, 'error');
    };

    const openModal = async (mode) => {
      if (!modal) {
        return;
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('ft-face-modal-open');
      capturedSelfie = '';
      capturedFingerprint = '';
      previewWrap?.classList.add('d-none');
      resetFeedback();
      syncModalCredentialsFromMain();
      setMode(mode);

      try {
        await startCamera();
      } catch (error) {
        handleError(error);
      }
    };

    const closeModal = () => {
      stopCamera();
      modal?.classList.remove('is-open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('ft-face-modal-open');
      capturedSelfie = '';
      capturedFingerprint = '';
      resetFeedback();
      previewWrap?.classList.add('d-none');
      placeholder?.classList.remove('d-none');
    };

    openLoginButton?.addEventListener('click', () => openModal('login'));
    openEnrollButton?.addEventListener('click', () => openModal('enroll'));
    modalEmailInput?.addEventListener('input', syncMainCredentialsFromModal);
    modalPasswordInput?.addEventListener('input', syncMainCredentialsFromModal);
    captureButton?.addEventListener('click', async () => {
      try {
        await captureSelfie();
      } catch (error) {
        handleError(error);
      }
    });
    actionButton?.addEventListener('click', async () => {
      try {
        await runAction();
      } catch (error) {
        handleError(error);
      }
    });

    closeButtons.forEach((button) => button.addEventListener('click', closeModal));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal?.classList.contains('is-open')) {
        closeModal();
      }
    });
  })();
</script>

