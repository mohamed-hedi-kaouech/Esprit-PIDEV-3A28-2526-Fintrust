{% extends 'front/front.html.twig' %}
{% block title %}Signature electronique confirmee{% endblock %}

{% block body %}
<div class="ft-app-page">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 text-center">
        <div class="ft-app-card ft-premium-card p-5">
          <div class="mb-4">
            <span style="font-size: 4rem; color: #198754;">
              <i class="bi bi-patch-check-fill"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-2" style="color: #198754;">Signature confirmee</h2>
          <p class="text-muted mb-4">
            Votre cheque a ete signe electroniquement avec succes via Yousign.
            L'equipe FinTrust a ete notifiee et traitera votre demande dans les meilleurs delais.
          </p>
          <a href="{{ path('front_wallet_cheques') }}" class="btn ft-btn-primary">
            <i class="bi bi-arrow-left me-2"></i>Retour a mes cheques
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
