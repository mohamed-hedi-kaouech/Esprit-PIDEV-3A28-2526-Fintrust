{% set assets = marketInsights.assets|default({}) %}
{% set walletContext = marketInsights.wallet_context|default(null) %}

<div class="ft-app-card ft-premium-card">
  <div class="ft-app-card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-graph-up-arrow me-2 text-primary"></i>{{ title|default('Radar marche') }}</span>
    <span class="badge ft-badge-blue">{{ marketInsights.market_sentiment|default('balanced')|upper }}</span>
  </div>
  <div class="ft-app-card-body">
    <div class="row g-3 mb-3">
      {% for asset in assets %}
        <div class="col-md-6">
          <div class="border rounded-4 p-3 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div class="fw-semibold">{{ asset.asset }}</div>
              <span class="badge {{ asset.trend == 'UP' ? 'text-bg-success' : (asset.trend == 'DOWN' ? 'text-bg-danger' : 'text-bg-secondary') }}">{{ asset.trend }}</span>
            </div>
            <div class="small text-muted mt-1">Actuel {{ asset.value_current|number_format(asset.value_current >= 1000 ? 2 : 4, '.', ' ') }}</div>
            <div class="small text-muted">1 mois {{ asset.predicted_1m|number_format(asset.predicted_1m >= 1000 ? 2 : 4, '.', ' ') }}</div>
            <div class="small text-muted">3 mois {{ asset.predicted_3m|number_format(asset.predicted_3m >= 1000 ? 2 : 4, '.', ' ') }}</div>
            <div class="small text-muted">6 mois {{ asset.predicted_6m|number_format(asset.predicted_6m >= 1000 ? 2 : 4, '.', ' ') }}</div>
            <div class="small mt-2">Confiance {{ asset.confidence }}% | Precision simulee {{ asset.historical_accuracy }}%</div>
            <div class="small text-muted">Volatilite {{ asset.volatility }}%</div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if walletContext %}
      <div class="alert alert-light border">
        <div class="fw-semibold mb-1">Lecture wallet</div>
        <div class="small">Wallet #{{ walletContext.wallet_id }} | {{ walletContext.currency }} | Solde {{ walletContext.balance|number_format(2, ',', ' ') }}</div>
        <div class="small mt-1">{{ walletContext.international_transfer_hint }}</div>
      </div>
    {% endif %}

    {% if marketInsights.recommended_actions is not empty %}
      <div class="mb-3">
        <div class="fw-semibold mb-2">Actions recommandees</div>
        <div class="list-group list-group-flush">
          {% for action in marketInsights.recommended_actions|slice(0, 3) %}
            <div class="list-group-item px-0">
              <i class="bi bi-arrow-right-circle text-primary me-2"></i>{{ action }}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if marketInsights.alerts is not empty %}
      <div class="alert alert-warning mb-0">
        <div class="fw-semibold mb-1">Alertes</div>
        {% for alert in marketInsights.alerts|slice(0, 2) %}
          <div class="small">{{ alert }}</div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
