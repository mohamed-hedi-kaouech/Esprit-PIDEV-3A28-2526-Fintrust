                  </div>
                  <div>
                    <label class="form-label small fw-semibold" for="voiceCommandInput">Commande vocale ou texte</label>
                    <textarea id="voiceCommandInput" class="form-control" rows="3" placeholder="Ex: Voir mon solde"></textarea>
                    <div class="form-text mt-2">La saisie se remplit automatiquement pendant que vous parlez.</div>
                  </div>
                </div>
                <div class="form-check form-switch mb-3">
                  <input class="form-check-input" type="checkbox" role="switch" id="voiceAutoSend" checked>
                  <label class="form-check-label small fw-semibold" for="voiceAutoSend">Analyser automatiquement apres la dictee</label>
                </div>
                <div class="ft-wallet-inline-actions">
                  <button id="voiceMicButton" type="button" class="btn ft-btn-outline-primary ft-wallet-glow-btn">
                    <i class="bi bi-mic me-1"></i>Dicter
                  </button>
                  <button id="voiceSendButton" type="button" class="btn ft-btn-primary ft-wallet-glow-btn">
                    <i class="bi bi-send me-1"></i>Envoyer
                  </button>
                  <button id="voiceSpeakButton" type="button" class="btn ft-btn-outline-primary" disabled>
                    <i class="bi bi-volume-up me-1"></i>Lire
                  </button>
                </div>
              </div>
              <div id="voiceStatus" class="ft-wallet-status-banner mb-3">Pret pour une commande vocale. Cliquez sur Dicter pour parler.</div>
              <div class="ft-wallet-output-box">
                <div class="small text-muted mb-2">Reponse instantanee</div>
                <div id="voiceResponse" class="fs-6 fw-semibold mb-2">La reponse apparaitra ici.</div>
              </div>
              <div id="voiceDetails" class="list-group list-group-flush"></div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <script>
    const walletFlowCanvas = document.getElementById('walletFlowChart');
    if (walletFlowCanvas) {
      new Chart(walletFlowCanvas, {
        type: 'line',
        data: {
          labels: {{ walletChart.labels|json_encode|raw }},
          datasets: [{
            label: 'Flux',
            data: {{ walletChart.values|json_encode|raw }},
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37,99,235,0.12)',
            fill: true,
            tension: 0.35,
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { ticks: { color: '#64748b' }, grid: { color: 'rgba(148,163,184,.15)' } },
            x: { ticks: { color: '#64748b' }, grid: { display: false } }
          }
        }
      });
    }

    const assistantInput = document.getElementById('walletAssistantInput');
    const assistantSendButton = document.getElementById('walletAssistantSendButton');
    const assistantStatus = document.getElementById('walletAssistantStatus');
    const assistantResponse = document.getElementById('walletAssistantResponse');
    const assistantTranscript = document.getElementById('walletAssistantTranscript');
    const assistantIntent = document.getElementById('walletAssistantIntent');
    const assistantConfidence = document.getElementById('walletAssistantConfidence');
    const assistantDetails = document.getElementById('walletAssistantDetails');

    document.querySelectorAll('.wallet-assistant-prompt').forEach((button) => {
      button.addEventListener('click', () => {
        if (!assistantInput) {
          return;
        }

        assistantInput.value = button.dataset.question || '';
        sendWalletAssistantCommand();
      });
    });

    if (assistantSendButton) {
      assistantSendButton.addEventListener('click', sendWalletAssistantCommand);
    }

    function sendWalletAssistantCommand() {
      if (!assistantInput) {
        return;
      }

      const text = assistantInput.value.trim();
      if (!text) {
        assistantStatus.className = 'alert alert-warning py-2 small mb-3';
        assistantStatus.textContent = 'Saisissez une question pour lancer l assistant.';
        return;
      }

      assistantStatus.className = 'alert alert-info py-2 small mb-3';
      assistantStatus.textContent = 'Analyse de votre question en cours...';

      fetch('{{ path('api_v1_voice_command') }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({text, language: 'fr'})
      })
        .then(parseJsonResponse)
        .then((payload) => renderCommandResult(payload, {
          transcriptEl: assistantTranscript,
          intentEl: assistantIntent,
          confidenceEl: assistantConfidence,
          responseEl: assistantResponse,
          detailsEl: assistantDetails,
          statusEl: assistantStatus,
          speakButtonEl: null
        }))
        .catch(() => {
          assistantStatus.className = 'alert alert-danger py-2 small mb-3';
          assistantStatus.textContent = 'Impossible de traiter la question pour le moment.';
        });
    }

    const qrData = document.getElementById('merchantQrData');
    const qrAmount = document.getElementById('merchantQrAmount');
    const qrCanvas = document.getElementById('merchantQrCanvas');
    const qrDecoded = document.getElementById('merchantQrDecoded');
    const previewButton = document.getElementById('merchantPreviewButton');
    const payButton = document.getElementById('merchantPayButton');
    const statusBox = document.getElementById('merchantQrStatus');
    const merchantName = document.getElementById('merchantName');
    const merchantWallet = document.getElementById('merchantWallet');
    const merchantAmount = document.getElementById('merchantAmount');
    const merchantReference = document.getElementById('merchantReference');
    const merchantSourceWallet = document.getElementById('merchantSourceWallet');
    const resultBox = document.getElementById('merchantQrResult');
    let lastMerchantPayload = null;
    let qrCode = null;

    if (previewButton) {
      previewButton.addEventListener('click', () => sendMerchantQr('{{ path('api_v1_merchant_qr_preview') }}', false));
    }
    if (payButton) {
      payButton.addEventListener('click', () => sendMerchantQr('{{ path('api_v1_merchant_qr_pay') }}', true));
    }
    if (qrData) {
      qrData.addEventListener('input', () => {
        if (payButton) {
          payButton.disabled = true;
        }
        renderVisualQr();
        renderDecodedQrData();
      });
    }
    if (qrAmount) {
      qrAmount.addEventListener('input', () => {
        if (payButton) {
          payButton.disabled = true;
        }
        renderDecodedQrData();
      });
    }
    document.addEventListener('DOMContentLoaded', () => {
      renderVisualQr();
      renderDecodedQrData();
    });

    function buildMerchantPayload() {
      const payload = {qr_data: qrData.value.trim()};
      if (qrAmount.value.trim() !== '') {
        payload.amount = qrAmount.value.trim();
      }

      return payload;
    }

    function sendMerchantQr(url, payment) {
      const payload = payment && lastMerchantPayload ? lastMerchantPayload : buildMerchantPayload();
      statusBox.className = 'alert alert-info py-2 small';
      statusBox.textContent = payment ? 'Confirmation du paiement...' : 'Verification du QR...';

      fetch(url, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload)
      })
        .then(parseJsonResponse)
        .then((body) => ({ok: true, body}))
        .then(({ok, body}) => {
          if (!ok) {
            throw body;
          }

          payment ? renderMerchantPayment(body) : renderMerchantPreview(body, payload);
        })
        .catch((error) => {
          if (payButton) {
            payButton.disabled = true;
          }
          statusBox.className = 'alert alert-danger py-2 small';
          statusBox.textContent = error?.error || error?.message || 'Operation QR impossible pour le moment.';
          renderDecodedQrData();
        });
    }

    function renderMerchantPreview(payload, rawPayload) {
      lastMerchantPayload = rawPayload;
      const valid = Boolean(payload.valid);

      if (payButton) {
        payButton.disabled = !valid;
      }

      statusBox.className = valid ? 'alert alert-success py-2 small' : 'alert alert-warning py-2 small';
      statusBox.textContent = valid ? 'QR valide. Vous pouvez confirmer.' : (payload.errors || []).join(' ');

      merchantName.textContent = payload.merchant?.name || '-';
      merchantWallet.textContent = payload.merchant?.wallet_id ? `Wallet commercant #${payload.merchant.wallet_id}` : '-';
      merchantAmount.textContent = payload.payment?.amount ? `${Number(payload.payment.amount).toFixed(2)} ${payload.payment.currency || '{{ wallet.devise }}'}` : '-';
      merchantReference.textContent = payload.payment?.reference || '-';
      merchantSourceWallet.textContent = payload.source_wallet
        ? `#${payload.source_wallet.wallet_id} | solde ${Number(payload.source_wallet.balance).toFixed(2)} ${payload.source_wallet.currency}`
        : '#{{ wallet.idWallet }} | {{ wallet.devise }}';
      renderDecodedQrData(payload);

      renderMerchantRows([
        `Wallet commercant: #${payload.merchant?.wallet_id || '-'}`,
        `Type QR: ${payload.payment?.qr_type || '-'}`,
        `Montant libre: ${payload.payment?.free_amount ? 'oui' : 'non'}`,
        `Transaction commercant: ${payload.payment?.transaction_id || '-'}`,
        `Controle solde: ${valid ? 'OK' : 'a verifier'}`
      ]);
    }

    function renderMerchantPayment(payload) {
      if (payButton) {
        payButton.disabled = true;
      }

      statusBox.className = 'alert alert-success py-2 small';
      statusBox.textContent = payload.message || 'Paiement confirme.';

      renderMerchantRows([
        `Reference transfert: ${payload.transfer?.reference || '-'}`,
        `Transaction: #${payload.transfer?.id || '-'}`,
        `Statut: ${payload.transfer?.status || 'VALIDE'}`
      ]);
    }

    function renderMerchantRows(items) {
      resultBox.innerHTML = '';
      items.forEach((item) => {
        const row = document.createElement('div');
        row.className = 'list-group-item px-0';
        row.innerHTML = '<i class="bi bi-check2-circle text-primary me-2"></i>' + escapeHtml(item);
        resultBox.appendChild(row);
      });
    }

    function renderVisualQr() {
      if (!qrCanvas) {
        return;
      }

      const value = qrData ? qrData.value.trim() : '';
      qrCanvas.innerHTML = '';

      if (!value) {
        qrCanvas.innerHTML = '<span class="text-muted small text-center">Aucune donnee QR</span>';
        return;
      }

      if (typeof QRCode === 'undefined') {
        qrCanvas.innerHTML = '<span class="text-muted small text-center">Apercu QR indisponible</span>';
        return;
      }

      qrCode = new QRCode(qrCanvas, {
        text: value,
        width: 148,
        height: 148,
        colorDark: '#0f172a',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });
    }

    function renderDecodedQrData(previewPayload = null) {
      if (!qrDecoded) {
        return;
      }

      const decoded = decodeQrData(qrData ? qrData.value.trim() : '');
      const amount = previewPayload?.payment?.amount || decoded.amount || (qrAmount ? qrAmount.value.trim() : '') || '-';
      const reference = previewPayload?.payment?.reference || decoded.reference || decoded.ref || '-';
      const merchant = previewPayload?.merchant?.name || decoded.merchant_name || decoded.merchantName || decoded.merchant || '-';
      const wallet = previewPayload?.merchant?.wallet_id || decoded.merchant_wallet_id || decoded.wallet_id || decoded.merchantWalletId || '-';
      const type = previewPayload?.payment?.qr_type || decoded.type || decoded.qr_type || (decoded.amount ? 'dynamic' : 'static');
      const transaction = previewPayload?.payment?.transaction_id || decoded.transaction_id || decoded.transactionId || '-';

      qrDecoded.innerHTML = [
        `<span class="d-block"><strong>Type :</strong> ${escapeHtml(String(type))}</span>`,
        `<span class="d-block"><strong>Commercant :</strong> ${escapeHtml(String(merchant))}</span>`,
        `<span class="d-block"><strong>Wallet :</strong> ${escapeHtml(String(wallet))}</span>`,
        `<span class="d-block"><strong>Montant :</strong> ${escapeHtml(String(amount))}</span>`,
        `<span class="d-block"><strong>Reference :</strong> ${escapeHtml(String(reference))}</span>`,
        `<span class="d-block"><strong>Transaction :</strong> ${escapeHtml(String(transaction))}</span>`
      ].join('');
    }

    function decodeQrData(value) {
      if (!value) {
        return {};
      }

      try {
        const decoded = JSON.parse(value);
        return decoded && typeof decoded === 'object' ? decoded : {};
      } catch (error) {
        const params = new URLSearchParams(value);
        const entries = Object.fromEntries(params.entries());
        return entries && Object.keys(entries).length > 0 ? entries : {};
      }
    }

    const voiceInput = document.getElementById('voiceCommandInput');
    const voiceLanguage = document.getElementById('voiceLanguage');
    const voiceSendButton = document.getElementById('voiceSendButton');
    const voiceMicButton = document.getElementById('voiceMicButton');
    const voiceSpeakButton = document.getElementById('voiceSpeakButton');
    const voiceAutoSend = document.getElementById('voiceAutoSend');
    const voiceStatus = document.getElementById('voiceStatus');
    const voiceResponse = document.getElementById('voiceResponse');
    const voiceTranscript = document.getElementById('voiceTranscript');
    const voiceIntent = document.getElementById('voiceIntent');
    const voiceConfidence = document.getElementById('voiceConfidence');
    const voiceDetails = document.getElementById('voiceDetails');
    const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let lastVoiceText = '';
    let recognition = null;
    let isListening = false;
    let finalTranscript = '';
    let dictationBaseText = '';
    let hasCapturedSpeech = false;
    let heardSpeechSignal = false;
    let noSpeechRetryCount = 0;
    let shouldRestartRecognition = false;
    const maxNoSpeechRetries = 2;
    let silenceTimer = null;
    const silenceDelayMs = 4200;
    let lastInterimTranscript = '';
    let pendingRedirectTimer = null;

    if (!Recognition && voiceStatus) {
      voiceStatus.className = 'alert alert-warning py-2 small';
      voiceStatus.textContent = 'La dictee vocale n est pas prise en charge par ce navigateur. Utilisez Chrome ou Edge pour activer le micro.';
      if (voiceMicButton) {
        voiceMicButton.disabled = true;
      }
    }

    if (Recognition && voiceStatus && !window.isSecureContext && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
      voiceStatus.className = 'alert alert-warning py-2 small';
      voiceStatus.textContent = 'La dictée vocale du navigateur demande une page securisee HTTPS ou localhost.';
    }

    if (voiceSendButton) {
      voiceSendButton.addEventListener('click', sendVoiceCommand);
    }

    if (voiceInput) {
      voiceInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
          event.preventDefault();
          sendVoiceCommand();
        }
      });
    }

    if (voiceMicButton) {
      voiceMicButton.addEventListener('click', async () => {
        if (!Recognition) {
          if (voiceInput) {
            voiceInput.focus();
          }
          return;
        }

        if (isListening && recognition) {
          recognition.stop();
          return;
        }

        const micReady = await ensureMicrophoneAvailability();
        if (!micReady) {
          return;
        }

        window.setTimeout(() => {
          startVoiceRecognition();
        }, 180);
      });
    }

    if (voiceSpeakButton) {
      voiceSpeakButton.addEventListener('click', () => {
        if (!lastVoiceText || !window.speechSynthesis) {
          return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(lastVoiceText);
        utterance.lang = voiceLanguage.value === 'en' ? 'en-US' : 'fr-FR';
        window.speechSynthesis.speak(utterance);
      });
    }

    function sendVoiceCommand() {
      if (!voiceInput) {
        return;
      }

      const text = voiceInput.value.trim();
      if (!text) {
        voiceStatus.className = 'alert alert-warning py-2 small';
        voiceStatus.textContent = 'Saisissez ou dictez une commande.';
        return;
      }

      voiceStatus.className = 'alert alert-info py-2 small';
      voiceStatus.textContent = 'Analyse de la commande...';

      fetch('{{ path('api_v1_voice_command') }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({text, language: voiceLanguage.value})
      })
        .then(parseJsonResponse)
        .then((payload) => {
          renderCommandResult(payload, {
            transcriptEl: voiceTranscript,
            intentEl: voiceIntent,
            confidenceEl: voiceConfidence,
            responseEl: voiceResponse,
            detailsEl: voiceDetails,
            statusEl: voiceStatus,
            speakButtonEl: voiceSpeakButton
          });
          lastVoiceText = payload.response_text || '';
        })
        .catch(() => {
          voiceStatus.className = 'alert alert-danger py-2 small';
          voiceStatus.textContent = 'Impossible de traiter la commande vocale.';
        });
    }

    function startVoiceRecognition() {
      if (recognition) {
        try {
          recognition.abort();
        } catch (error) {
        }
      }

      recognition = new Recognition();
      recognition.lang = getRecognitionLang();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.maxAlternatives = 3;
      finalTranscript = '';
      lastInterimTranscript = '';
      dictationBaseText = voiceInput ? voiceInput.value.trim() : '';
      hasCapturedSpeech = false;
      heardSpeechSignal = false;
      shouldRestartRecognition = false;
      clearSilenceTimer();

      recognition.onstart = () => {
        isListening = true;
        updateMicButton(true);
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = 'Ecoute en cours... Parlez maintenant, le texte s ecrit automatiquement.';
      };

      recognition.onaudiostart = () => {
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = 'Micro active. Parlez naturellement.';
      };

      recognition.onspeechstart = () => {
        heardSpeechSignal = true;
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = 'Voix detectee. Transcription en direct...';
      };

      recognition.onspeechend = () => {
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = 'Pause detectee. Je finalise la transcription...';
        scheduleRecognitionStop(1200);
      };

      recognition.onsoundstart = () => {
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = 'Son detecte. Continuez a parler normalement.';
      };

      recognition.onresult = (event) => {
        let interimTranscript = '';

        for (let index = event.resultIndex; index < event.results.length; index += 1) {
          const transcript = event.results[index][0]?.transcript || '';
          if (event.results[index].isFinal) {
            finalTranscript += transcript + ' ';
          } else {
            interimTranscript += transcript;
          }
        }

        const currentTranscript = (finalTranscript + interimTranscript).trim();
        lastInterimTranscript = currentTranscript;
        hasCapturedSpeech = currentTranscript.length > 0;
        heardSpeechSignal = heardSpeechSignal || hasCapturedSpeech;
        noSpeechRetryCount = 0;
        const mergedTranscript = mergeDictationText(dictationBaseText, currentTranscript);
        applyVoiceText(mergedTranscript);
        voiceStatus.className = 'alert alert-info py-2 small';
        voiceStatus.textContent = interimTranscript
          ? 'Transcription en cours... Continuez a parler.'
          : 'Texte capture. Vous pouvez continuer ou attendre l envoi automatique.';
        voiceConfidence.textContent = event.results[event.results.length - 1]?.[0]?.confidence
          ? Math.round(Number(event.results[event.results.length - 1][0].confidence) * 100) + '%'
          : '-';
        scheduleRecognitionStop();
      };

      recognition.onerror = (event) => {
        clearSilenceTimer();

        if (event.error === 'no-speech' && noSpeechRetryCount < maxNoSpeechRetries && !hasCapturedSpeech) {
          shouldRestartRecognition = true;
          voiceStatus.className = 'alert alert-info py-2 small';
          voiceStatus.textContent = 'Je n ai pas encore capte votre voix. Nouvelle tentative en cours...';
          try {
            recognition.stop();
          } catch (error) {
          }
          return;
        }

        isListening = false;
        updateMicButton(false);
        voiceStatus.className = 'alert alert-warning py-2 small';
        voiceStatus.textContent = getSpeechErrorMessage(event.error);
      };

      recognition.onend = () => {
        const transcript = voiceInput.value.trim() || mergeDictationText(dictationBaseText, lastInterimTranscript);
        isListening = false;
        updateMicButton(false);
        clearSilenceTimer();

        if (shouldRestartRecognition && noSpeechRetryCount < maxNoSpeechRetries) {
          noSpeechRetryCount += 1;
          voiceStatus.className = 'alert alert-info py-2 small';
          voiceStatus.textContent = 'Aucune voix detectee. Je relance automatiquement l ecoute...';
          window.setTimeout(() => {
            startVoiceRecognition();
          }, 250);
          return;
        }

        if (heardSpeechSignal && transcript && transcript !== dictationBaseText) {
          noSpeechRetryCount = 0;
          applyVoiceText(transcript);
          if (voiceAutoSend && voiceAutoSend.checked) {
            voiceStatus.className = 'alert alert-success py-2 small';
            voiceStatus.textContent = 'Texte dicte ajoute automatiquement. Analyse en cours...';
            sendVoiceCommand();
          } else {
            voiceStatus.className = 'alert alert-success py-2 small';
            voiceStatus.textContent = 'Texte dicte ajoute automatiquement. Vous pouvez maintenant envoyer la commande.';
          }
          return;
        }

        if (!transcript || transcript === dictationBaseText) {
          noSpeechRetryCount = 0;
          voiceStatus.className = 'alert alert-warning py-2 small';
          voiceStatus.textContent = 'Aucune phrase detectee. Reessayez en parlant plus pres du micro.';
          return;
        }

        noSpeechRetryCount = 0;
        applyVoiceText(transcript);
        if (voiceAutoSend && voiceAutoSend.checked) {
          voiceStatus.className = 'alert alert-success py-2 small';
          voiceStatus.textContent = 'Texte dicte ajoute automatiquement. Analyse en cours...';
          sendVoiceCommand();
        } else {
          voiceStatus.className = 'alert alert-success py-2 small';
          voiceStatus.textContent = 'Texte dicte ajoute automatiquement. Vous pouvez maintenant envoyer la commande.';
        }
      };

      try {
        recognition.start();
      } catch (error) {
        isListening = false;
        updateMicButton(false);
        voiceStatus.className = 'alert alert-warning py-2 small';
        voiceStatus.textContent = 'Impossible de lancer la dictee vocale pour le moment. Rechargez la page et reessayez.';
      }
    }

    function applyVoiceText(text) {
      const value = text || '';

      if (voiceInput) {
        voiceInput.value = value;
        voiceInput.dispatchEvent(new Event('input', {bubbles: true}));
        voiceInput.dispatchEvent(new Event('change', {bubbles: true}));
      }

      if (voiceTranscript) {
        voiceTranscript.textContent = value || '-';
      }

      if (voiceInput && value) {
        voiceInput.focus();
        voiceInput.setSelectionRange(value.length, value.length);
      }
    }

    function updateMicButton(listening) {
      if (!voiceMicButton) {
        return;
      }

      voiceMicButton.classList.toggle('btn-danger', listening);
      voiceMicButton.classList.toggle('ft-btn-outline-primary', !listening);
      voiceMicButton.innerHTML = listening
        ? '<i class="bi bi-stop-circle me-1"></i>Arreter'
        : '<i class="bi bi-mic me-1"></i>Dicter';
    }

    function getRecognitionLang() {
      if (voiceLanguage.value === 'en') {
        return 'en-US';
      }

      if (voiceLanguage.value === 'wo') {
        return 'fr-FR';
      }

      return 'fr-FR';
    }

    function getSpeechErrorMessage(errorCode) {
      switch (errorCode) {
        case 'audio-capture':
          return 'Aucun micro n a ete detecte sur cet appareil.';
        case 'not-allowed':
        case 'service-not-allowed':
          return 'L acces au micro a ete refuse. Autorisez le microphone dans le navigateur puis reessayez.';
        case 'no-speech':
          return 'Aucune voix n a ete captee. Parlez plus distinctement et reessayez.';
        case 'network':
          return 'Le service de reconnaissance vocale du navigateur est momentanement indisponible.';
        default:
          return 'La dictee vocale a rencontre un probleme. Vous pouvez toujours saisir votre commande au clavier.';
      }
    }

    async function ensureMicrophoneAccess() {
      if (!window.isSecureContext && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        voiceStatus.className = 'alert alert-warning py-2 small';
        voiceStatus.textContent = 'Le navigateur bloque le micro hors HTTPS. Ouvrez cette page en HTTPS ou sur localhost.';
        return false;
      }

      if (!navigator.permissions || !navigator.permissions.query) {
        return true;
      }

      try {
        const permissionStatus = await navigator.permissions.query({name: 'microphone'});
        if (permissionStatus.state === 'denied') {
          voiceStatus.className = 'alert alert-warning py-2 small';
          voiceStatus.textContent = 'Le microphone est refuse dans le navigateur. Autorisez le micro puis reessayez.';
          return false;
        }

        return true;
      } catch (error) {
        return true;
      }
    }

    async function ensureMicrophoneAvailability() {
      if (!await ensureMicrophoneAccess()) {
        return false;
      }

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        return true;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({audio: true});
        stream.getTracks().forEach((track) => track.stop());
        return true;
      } catch (error) {
        voiceStatus.className = 'alert alert-warning py-2 small';
        voiceStatus.textContent = 'Le microphone est bloque ou indisponible. Autorisez l acces micro dans le navigateur puis reessayez.';
        return false;
      }
    }

    function mergeDictationText(baseText, transcript) {
      const cleanBase = baseText.trim();
      const cleanTranscript = transcript.trim();

      if (!cleanBase) {
        return cleanTranscript;
      }

      if (!cleanTranscript) {
        return cleanBase;
      }

      return `${cleanBase} ${cleanTranscript}`.replace(/\s+/g, ' ').trim();
    }

    function parseJsonResponse(response) {
      return response.text().then((text) => {
        let body = {};

        if (text) {
          try {
            body = JSON.parse(text);
          } catch (error) {
            body = {message: text};
          }
        }

        if (!response.ok) {
          return Promise.reject(body);
        }

        return body;
      });
    }

    function scheduleRecognitionStop(delay = silenceDelayMs) {
      clearSilenceTimer();
      silenceTimer = window.setTimeout(() => {
        if (recognition && isListening) {
          recognition.stop();
        }
      }, delay);
    }

    function clearSilenceTimer() {
      if (silenceTimer !== null) {
        window.clearTimeout(silenceTimer);
        silenceTimer = null;
      }
    }

    function renderCommandResult(payload, elements) {
      clearPendingRedirect();
      elements.transcriptEl.textContent = payload.transcript || '-';
      elements.intentEl.textContent = payload.intent || '-';
      elements.confidenceEl.textContent = payload.confidence ? Math.round(Number(payload.confidence) * 100) + '%' : '-';
      elements.responseEl.textContent = payload.response_text || 'Aucune reponse.';
      elements.statusEl.className = 'alert alert-success py-2 small' + (elements.statusEl.id === 'walletAssistantStatus' ? ' mb-3' : '');
      elements.statusEl.textContent = (payload.action || 'voice.command.done') + ' | langue: ' + (payload.language || 'fr');

      if (elements.speakButtonEl) {
        elements.speakButtonEl.disabled = !payload.response_text || !window.speechSynthesis;
      }

      elements.detailsEl.innerHTML = '';
      const items = payload.details?.items || payload.details?.cheques || payload.suggestions || payload.details || [];
      (Array.isArray(items) ? items : []).slice(0, 6).forEach((item) => {
        const row = document.createElement('div');
        row.className = 'list-group-item px-0';
        row.innerHTML = '<i class="bi bi-check2-circle text-primary me-2"></i>' + escapeHtml(typeof item === 'string' ? item : JSON.stringify(item));
        elements.detailsEl.appendChild(row);
      });

      if (payload.redirect_url) {
        elements.statusEl.className = 'alert alert-success py-2 small' + (elements.statusEl.id === 'walletAssistantStatus' ? ' mb-3' : '');
        elements.statusEl.textContent = 'Commande comprise. Redirection automatique vers l action demandee...';
        pendingRedirectTimer = window.setTimeout(() => {
          window.location.href = payload.redirect_url;
        }, 900);
      }
    }

    function clearPendingRedirect() {
      if (pendingRedirectTimer !== null) {
        window.clearTimeout(pendingRedirectTimer);
        pendingRedirectTimer = null;
      }
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>\"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      })[char]);
    }
  </script>
{% endblock %}
