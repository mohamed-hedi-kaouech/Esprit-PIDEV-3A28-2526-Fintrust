{% extends 'front/front.html.twig' %}
{% block title %}Mon wallet{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-wallet-studio-hero {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(96, 165, 250, .28);
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, .22), transparent 30%),
        radial-gradient(circle at bottom left, rgba(37, 99, 235, .18), transparent 35%),
        linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .94));
    }
    .ft-wallet-studio-hero::after {
      content: '';
      position: absolute;
      inset: auto -12% -40% auto;
      width: 280px;
      height: 280px;
      border-radius: 999px;
      background: rgba(59, 130, 246, .08);
      filter: blur(12px);
      pointer-events: none;
    }
    .ft-wallet-studio-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    .ft-wallet-module-card {
      position: relative;
      overflow: hidden;
      border-radius: 1.2rem;
      border: 1px solid rgba(96, 165, 250, .2);
      padding: 1.15rem;
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.95));
      box-shadow: 0 16px 36px rgba(15, 23, 42, .08);
      height: 100%;
    }
    .ft-wallet-module-card::before {
      content: '';
      position: absolute;
      inset: 0 auto auto 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #2563eb, #22c55e, #06b6d4);
      opacity: .95;
    }
    .ft-wallet-module-icon {
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: #fff;
      margin-bottom: .85rem;
      box-shadow: 0 14px 28px rgba(37, 99, 235, .18);
    }
    .ft-wallet-module-icon.blue { background: linear-gradient(135deg, #2563eb, #0ea5e9); }
    .ft-wallet-module-icon.green { background: linear-gradient(135deg, #16a34a, #10b981); }
    .ft-wallet-module-icon.cyan { background: linear-gradient(135deg, #0891b2, #22d3ee); }
    .ft-wallet-module-icon.indigo { background: linear-gradient(135deg, #4f46e5, #2563eb); }
    .ft-wallet-module-card h3 {
      font-size: 1.05rem;
      margin-bottom: .4rem;
      color: #0f172a;
    }
    .ft-wallet-module-card p {
      color: #475569;
      font-size: .92rem;
      margin-bottom: .9rem;
    }
    .ft-wallet-chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
    }
    .ft-wallet-chip {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .45rem .8rem;
      border-radius: 999px;
      background: rgba(239, 246, 255, .9);
      border: 1px solid rgba(147, 197, 253, .45);
      color: #1d4ed8;
      font-size: .78rem;
      font-weight: 600;
    }
    .ft-wallet-studio-panel {
      border-radius: 1.4rem;
      border: 1px solid rgba(148, 163, 184, .18);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.96));
      box-shadow: 0 18px 44px rgba(15, 23, 42, .08);
    }
    .ft-wallet-studio-panel .ft-app-card-header {
      background: linear-gradient(90deg, rgba(37, 99, 235, .08), rgba(34, 211, 238, .08));
    }
    .ft-wallet-quick-prompt {
      border: 1px solid rgba(96, 165, 250, .32);
      background: #fff;
      border-radius: 999px;
      padding: .6rem .95rem;
      font-weight: 600;
      color: #1d4ed8;
      transition: all .2s ease;
    }
    .ft-wallet-quick-prompt:hover {
      background: #eff6ff;
      transform: translateY(-1px);
    }
    .ft-wallet-voice-box,
    .ft-wallet-ai-box {
      border-radius: 1.1rem;
      border: 1px solid rgba(226, 232, 240, .95);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.96));
      padding: 1rem;
      height: 100%;
    }
    .ft-wallet-ai-layout {
      display: grid;
      gap: 1rem;
    }
    .ft-wallet-ai-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .ft-wallet-ai-stats .ft-dash-card {
      min-height: 6rem;
      padding: 1.1rem 1.15rem;
    }
    .ft-wallet-ai-stats .ft-dash-card-label {
      margin-bottom: .55rem;
    }
    .ft-wallet-ai-composer {
      display: grid;
      gap: 1rem;
    }
    .ft-wallet-ai-composer textarea {
      min-height: 8.25rem;
      resize: vertical;
    }
    .ft-wallet-ai-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
    }
    .ft-wallet-ai-actions .btn {
      min-width: 11.5rem;
    }
    .ft-wallet-ai-prompts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .75rem;
    }
    .ft-wallet-mini-stat {
      border-radius: 1rem;
      border: 1px solid rgba(226, 232, 240, .9);
      background: rgba(255, 255, 255, .92);
      padding: .95rem 1rem;
    }
    .ft-wallet-mini-stat-label {
      display: block;
      font-size: .78rem;
      color: #64748b;
      margin-bottom: .35rem;
    }
    .ft-wallet-mini-stat-value {
      font-weight: 700;
      color: #0f172a;
    }
    .ft-wallet-anchor-btn {
      min-width: 10rem;
    }
    .ft-wallet-feature-panel {
      position: relative;
      overflow: hidden;
      border-radius: 1.6rem;
      border: 1px solid rgba(125, 211, 252, .34);
      background:
        radial-gradient(circle at top right, rgba(34, 211, 238, .18), transparent 28%),
        radial-gradient(circle at bottom left, rgba(59, 130, 246, .14), transparent 32%),
        linear-gradient(180deg, rgba(255,255,255,.99), rgba(240,249,255,.95));
      box-shadow: 0 24px 54px rgba(15, 23, 42, .10);
    }
    .ft-wallet-feature-panel::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 5px;
      background: linear-gradient(90deg, #2563eb, #22d3ee, #38bdf8);
    }
    .ft-wallet-feature-panel .ft-app-card-header {
      position: relative;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
      background: linear-gradient(90deg, rgba(219, 234, 254, .7), rgba(224, 242, 254, .7));
      border-bottom: 1px solid rgba(191, 219, 254, .5);
    }
    .ft-wallet-feature-title {
      display: flex;
      align-items: center;
      gap: .75rem;
      font-weight: 700;
      color: #0f172a;
    }
    .ft-wallet-feature-icon {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.1rem;
      box-shadow: 0 16px 32px rgba(37, 99, 235, .20);
    }
    .ft-wallet-feature-icon.qr {
      background: linear-gradient(135deg, #0284c7, #22d3ee);
    }
    .ft-wallet-feature-icon.voice {
      background: linear-gradient(135deg, #2563eb, #4f46e5);
    }
    .ft-wallet-feature-badge {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .45rem .8rem;
      border-radius: 999px;
      background: rgba(239, 246, 255, .95);
      border: 1px solid rgba(96, 165, 250, .35);
      color: #1d4ed8;
      font-size: .76rem;
      font-weight: 700;
    }
    .ft-wallet-feature-badge.security {
      color: #0f766e;
      border-color: rgba(45, 212, 191, .35);
      background: rgba(240, 253, 250, .92);
    }
    .ft-wallet-feature-panel .ft-app-card-body {
      padding: 1.25rem 1.25rem 1.4rem;
    }
    .ft-wallet-status-banner {
      border-radius: 1rem;
      border: 1px solid rgba(125, 211, 252, .45);
      background: linear-gradient(90deg, rgba(207, 250, 254, .95), rgba(224, 242, 254, .95));
      color: #155e75;
      padding: .85rem 1rem;
      font-weight: 600;
    }
    .ft-wallet-editor-shell {
      border-radius: 1.2rem;
      border: 1px solid rgba(191, 219, 254, .52);
      background: rgba(255,255,255,.9);
      padding: 1rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }
    .ft-wallet-editor-shell textarea,
    .ft-wallet-editor-shell input,
    .ft-wallet-editor-shell select {
      border-radius: .95rem;
      border-color: rgba(191, 219, 254, .9);
      box-shadow: none;
    }
    .ft-wallet-editor-shell textarea {
      min-height: 10rem;
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.98));
    }
    .ft-wallet-side-glass {
      border-radius: 1.2rem;
      border: 1px solid rgba(191, 219, 254, .52);
      background: linear-gradient(180deg, rgba(248,250,252,.95), rgba(239,246,255,.92));
      padding: 1rem;
      min-height: 100%;
    }
    .ft-wallet-side-kicker {
      font-size: .74rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #64748b;
      margin-bottom: .45rem;
      display: block;
    }
    .ft-wallet-side-value {
      font-size: 1.55rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1rem;
    }
    .ft-wallet-inline-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
      margin-top: 1rem;
      margin-bottom: 1rem;
    }
    .ft-wallet-glow-btn {
      box-shadow: 0 12px 26px rgba(37, 99, 235, .18);
    }
    .ft-wallet-response-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .ft-wallet-response-grid .ft-wallet-mini-stat {
      min-height: 5.8rem;
    }
    .ft-wallet-voice-command-grid {
      display: grid;
      grid-template-columns: 1.05fr 1.6fr;
      gap: 1rem;
      align-items: start;
    }
    .ft-wallet-output-box {
      border-radius: 1.2rem;
      border: 1px solid rgba(191, 219, 254, .52);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.95));
      padding: 1rem 1.05rem;
      min-height: 10.5rem;
    }
    .ft-wallet-output-box strong {
      color: #0f172a;
    }
    .ft-wallet-qr-preview {
      display: flex;
      flex-direction: column;
      gap: .9rem;
    }
    .ft-wallet-qr-canvas {
      width: 168px;
      min-width: 168px;
      height: 168px;
      border-radius: 1rem;
      border: 1px solid rgba(191, 219, 254, .55);
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: .6rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95);
    }
    .ft-wallet-qr-decoded {
      border-radius: 1rem;
      border: 1px solid rgba(191, 219, 254, .45);
      background: rgba(255,255,255,.92);
      padding: .9rem 1rem;
      color: #334155;
      font-size: .88rem;
      line-height: 1.6;
    }
    .ft-cheque-preview-list {
      display: grid;
      gap: 1rem;
      padding: 1.15rem 1rem 1.25rem;
    }
    .ft-cheque-preview-item {
      border: 1px solid rgba(191, 219, 254, .45);
      border-radius: 1.35rem;
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.96));
      padding: 1.2rem 1.35rem;
      box-shadow: 0 14px 30px rgba(15, 23, 42, .06);
    }
    .ft-cheque-preview-grid {
      display: grid;
      grid-template-columns: minmax(220px, 1.55fr) minmax(200px, 1.2fr) minmax(120px, auto) minmax(170px, auto);
      gap: 1rem 1.5rem;
      align-items: center;
    }
    .ft-cheque-preview-field {
      min-width: 0;
    }
    .ft-cheque-preview-label {
      display: block;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: #64748b;
      margin-bottom: .42rem;
      font-weight: 700;
    }
    .ft-cheque-preview-value {
      color: #0f172a;
      font-weight: 700;
      line-height: 1.5;
      font-size: 1.02rem;
    }
    .ft-cheque-preview-value.soft {
      font-weight: 600;
      color: #334155;
    }
    .ft-cheque-preview-value.break {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    @media (max-width: 1199.98px) {
      .ft-wallet-studio-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .ft-wallet-qr-preview {
        align-items: flex-start;
      }
      .ft-cheque-preview-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .ft-wallet-ai-stats,
      .ft-wallet-ai-prompts,
      .ft-wallet-voice-command-grid,
      .ft-wallet-response-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 767.98px) {
      .ft-wallet-studio-grid {
        grid-template-columns: 1fr;
      }
      .ft-wallet-qr-canvas {
        width: 100%;
        min-width: 0;
        max-width: 220px;
      }
      .ft-cheque-preview-list {
        padding: 1rem .9rem 1.05rem;
      }
      .ft-cheque-preview-item {
        padding: 1rem 1rem 1.05rem;
      }
      .ft-cheque-preview-grid {
        grid-template-columns: 1fr;
        gap: .85rem;
      }
      .ft-wallet-ai-box {
        padding: .9rem;
      }
      .ft-wallet-ai-actions .btn,
      .ft-wallet-quick-prompt {
        width: 100%;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div class="ft-app-page">
  <div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="ft-page-icon-lg"><i class="bi bi-wallet2"></i></div>
        <div>
          <h1 class="ft-page-title mb-0">Dashboard wallet</h1>
          <p class="text-muted mb-0 small">Vue claire de votre wallet, de vos transactions et de vos demandes de cheque.</p>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('front_wallet_show') }}" class="btn ft-btn-outline-primary">
          <i class="bi bi-eye me-1"></i>Voir le detail
        </a>
        <a href="{{ path('front_wallet_transactions') }}" class="btn ft-btn-outline-primary">
          <i class="bi bi-arrow-left-right me-1"></i>Transactions
        </a>
        <a href="#wallet-studio" class="btn ft-btn-outline-primary ft-wallet-anchor-btn">
          <i class="bi bi-grid-1x2 me-1"></i>Wallet Studio
        </a>
        <a href="#wallet-ai" class="btn ft-btn-outline-primary ft-wallet-anchor-btn">
          <i class="bi bi-stars me-1"></i>Assistant
        </a>
        <a href="{{ path('front_wallet_cheques') }}" class="btn ft-btn-outline-primary">
          <i class="bi bi-receipt me-1"></i>Cheques
        </a>
<a href="{{ path('front_wallet_cheque_request') }}" class="btn ft-btn-primary{% if wallet and wallet.estBloque %} disabled{% endif %}">
          <i class="bi bi-journal-plus me-1"></i>Demander un chequier
        </a>
      </div>
    </div>

    {% if wallet is null %}
      <div class="ft-app-card ft-premium-card">
        <div class="ft-app-card-body text-center py-5">
          <div class="ft-page-icon-lg mx-auto mb-3"><i class="bi bi-wallet2"></i></div>
          <h2 class="h4 mb-2">Aucun wallet disponible</h2>
          <p class="text-muted mb-0">Votre wallet sera visible ici des qu il sera cree et rattache a votre compte.</p>
        </div>
      </div>
    {% else %}
      <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-blue"><i class="bi bi-cash-stack"></i></div>
            <div class="ft-dash-card-label">Solde</div>
            <div class="ft-dash-card-value">{{ wallet.solde|number_format(2, ',', ' ') }} {{ wallet.devise }}</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-green"><i class="bi bi-arrow-left-right"></i></div>
            <div class="ft-dash-card-label">Transactions</div>
            <div class="ft-dash-card-value">{{ transactionCount }}</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-orange"><i class="bi bi-journal-check"></i></div>
            <div class="ft-dash-card-label">Demandes de cheque</div>
            <div class="ft-dash-card-value">{{ chequeCount }}</div>
          </div>
        </div>
        <div class="col-6 col-xl-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-purple"><i class="bi bi-shield-lock"></i></div>
            <div class="ft-dash-card-label">Etat</div>
            <div class="ft-dash-card-value">
              {% if wallet.estBloque %}
                <span class="badge ft-badge-danger">Bloque</span>
              {% elseif wallet.estActif %}
                <span class="badge ft-badge-success">Actif</span>
              {% else %}
                <span class="badge ft-badge-warning">{{ wallet.statut|title }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-orange"><i class="bi bi-hourglass-split"></i></div>
            <div class="ft-dash-card-label">Cheques en attente</div>
            <div class="ft-dash-card-value">{{ walletStats.pendingCheques }}</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-green"><i class="bi bi-patch-check"></i></div>
            <div class="ft-dash-card-label">Cheques acceptes</div>
            <div class="ft-dash-card-value">{{ walletStats.acceptedCheques }}</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-blue"><i class="bi bi-truck"></i></div>
            <div class="ft-dash-card-label">Cheques livres</div>
            <div class="ft-dash-card-value">{{ walletStats.deliveredCheques }}</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="ft-dash-card ft-dash-card-soft h-100">
            <div class="ft-dash-card-icon ft-dash-icon-red"><i class="bi bi-bell"></i></div>
            <div class="ft-dash-card-label">Notifications wallet</div>
            <div class="ft-dash-card-value">{{ walletNotifications|length }}</div>
          </div>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-xl-8">
          <div class="ft-app-card ft-premium-card h-100">
            <div class="ft-app-card-header d-flex justify-content-between align-items-center">
              <span><i class="bi bi-credit-card-2-front me-2 text-primary"></i>Resume du wallet</span>
              <span class="badge ft-badge-blue">#{{ wallet.idWallet }}</span>
            </div>
            <div class="ft-app-card-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <div class="ft-history-card h-100">
                    <span class="ft-history-icon blue"><i class="bi bi-person-vcard"></i></span>
                    <div>
                      <strong>Proprietaire</strong>
                      <p class="mb-1">{{ wallet.nomProprietaire }}</p>
                      <p class="mb-0">{{ wallet.email ?: 'Email non renseigne' }}</p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="ft-history-card h-100">
                    <span class="ft-history-icon green"><i class="bi bi-telephone"></i></span>
                    <div>
                      <strong>Contact</strong>
                      <p class="mb-1">{{ wallet.telephone ?: 'Telephone non renseigne' }}</p>
                      <p class="mb-0">Creation: {{ wallet.dateCreation|date('d/m/Y H:i') }}</p>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="ft-finance-metric">
                    <span class="ft-finance-label">Devise</span>
                    <strong>{{ wallet.devise }}</strong>
                    <small>Compte principal du client</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="ft-finance-metric ft-finance-metric-soft">
                    <span class="ft-finance-label">Statut</span>
                    <strong>{{ wallet.statut|title }}</strong>
                    <small>{{ wallet.estActif ? 'Operationnel' : 'Sous surveillance' }}</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="ft-finance-metric ft-finance-metric-accent">
                    <span class="ft-finance-label">Blocage</span>
                    <strong>{{ wallet.estBloque ? 'Oui' : 'Non' }}</strong>
                    <small>{{ wallet.estBloque ? 'Actions limitees' : 'Aucune restriction' }}</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-4">
          <div class="ft-app-card ft-premium-card h-100">
            <div class="ft-app-card-header">
              <i class="bi bi-lightning-charge me-2 text-primary"></i>Acces rapides
            </div>
            <div class="ft-app-card-body">
              <div class="ft-shortcuts-grid">
                <a href="{{ path('front_wallet_show') }}" class="ft-shortcut-tile">
                  <i class="bi bi-eye"></i>
                  <span>Detail wallet</span>
                </a>
