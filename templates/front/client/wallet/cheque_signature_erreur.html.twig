{% extends 'front/front.html.twig' %}
{% block title %}Erreur de signature electronique{% endblock %}

{% block body %}
<div class="ft-app-page">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 text-center">
        <div class="ft-app-card ft-premium-card p-5">
          <div class="mb-4">
            <span style="font-size: 4rem; color: #dc3545;">
              <i class="bi bi-exclamation-triangle-fill"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-2" style="color: #dc3545;">Echec de la signature</h2>
          <p class="text-muted mb-4">
            Une erreur est survenue lors du processus de signature electronique via Yousign,
            ou vous avez annule la signature. Vous pouvez reessayer depuis votre liste de cheques.
          </p>
          <a href="{{ path('front_wallet_cheques') }}" class="btn ft-btn-primary">
            <i class="bi bi-arrow-left me-2"></i>Retour a mes cheques
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
