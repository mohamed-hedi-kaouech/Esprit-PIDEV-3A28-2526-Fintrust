{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const filterForm = document.querySelector('.ft-publications-filter-form');

  if (filterForm) {
    const keywordInput = filterForm.querySelector('input[name="keyword"]');
    const categorySelect = filterForm.querySelector('select[name="category"]');
    const sortSelect = filterForm.querySelector('select[name="sort"]');
    const submitButton = filterForm.querySelector('.ft-publications-submit-btn');
    let typingTimer;

    const submitFilters = () => {
      const formData = new FormData(filterForm);
      const params = new URLSearchParams();

      for (const [key, value] of formData.entries()) {
        const normalizedValue = String(value).trim();

        if (normalizedValue !== '') {
          params.set(key, normalizedValue);
        }
      }

      const targetUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;

      if (targetUrl !== `${window.location.pathname}${window.location.search}`) {
        window.location.assign(targetUrl);
      }
    };

    const submitAfterTyping = (event) => {
      if (event.isComposing) {
        return;
      }

      clearTimeout(typingTimer);
      typingTimer = setTimeout(submitFilters, 350);
    };

    keywordInput?.addEventListener('input', submitAfterTyping);
    categorySelect?.addEventListener('change', submitFilters);
    sortSelect?.addEventListener('change', submitFilters);

    if (submitButton) {
      submitButton.classList.add('ft-publications-submit-btn--fallback');
      submitButton.setAttribute('title', 'Recherche automatique active');
      submitButton.closest('.col-lg-1')?.classList.add('d-none');
    }
  }

  const cards = document.querySelectorAll('.ft-publication-card');

  cards.forEach((card) => {
    const button = card.querySelector('.ft-publication-card__analysis-btn');
    const resultBox = card.querySelector('.ft-publication-card__analysis-result');
    const sourceField = card.querySelector('.ft-publication-card__analysis-source');

    if (!button || !resultBox || !sourceField) {
      return;
    }

    button.addEventListener('click', async () => {
      const content = sourceField.value.trim();
      if (!content) {
        resultBox.hidden = false;
        resultBox.innerHTML = '<div class="ft-publication-analysis-block ft-publication-analysis-error"><strong>Analyse indisponible</strong><p>Le contenu de cette publication est vide.</p></div>';
        return;
      }

      button.disabled = true;
      button.textContent = 'Analyse...';
      resultBox.hidden = false;
      resultBox.innerHTML = '<div class="ft-publication-analysis-block"><p>Analyse en cours...</p></div>';

      try {
        const response = await fetch('{{ path('api_publication_analyze') }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            content: content
          })
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.message || 'Analyse indisponible.');
        }

        const keyPoints = Array.isArray(data.key_points) ? data.key_points : [];
        const keyPointsHtml = keyPoints.length
          ? `<ul>${keyPoints.map((point) => `<li>${escapeHtml(point)}</li>`).join('')}</ul>`
          : '<p>Aucun point cle disponible.</p>';

        resultBox.innerHTML = `
          <div class="ft-publication-analysis-meta">
            <i class="bi bi-clock-history"></i>
            ${escapeHtml(data.reading_time || '--')}
          </div>
          <div class="ft-publication-analysis-block">
            <strong>Resume</strong>
            <p>${escapeHtml(data.summary || '')}</p>
          </div>
          <div class="ft-publication-analysis-block">
            <strong>Points cles</strong>
            ${keyPointsHtml}
          </div>
          <div class="ft-publication-analysis-block">
            <strong>Version simplifiee</strong>
            <p>${escapeHtml(data.simplified || '')}</p>
          </div>
        `;
      } catch (error) {
        resultBox.innerHTML = `
          <div class="ft-publication-analysis-block ft-publication-analysis-error">
            <strong>Analyse indisponible</strong>
            <p>${escapeHtml(error.message || 'Une erreur est survenue.')}</p>
          </div>
        `;
      } finally {
        button.disabled = false;
        button.textContent = 'Analyser';
      }
    });
  });

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
});
</script>
{% endblock %}

