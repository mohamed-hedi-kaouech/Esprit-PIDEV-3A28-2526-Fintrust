{% extends 'front/front.html.twig' %}

{% block title %}Publications{% endblock %}

{% block body %}
<div class="ft-publications-page">
  <div class="ft-publications-glow ft-publications-glow--one"></div>
  <div class="ft-publications-glow ft-publications-glow--two"></div>

  <div class="container-fluid px-4 py-4" style="max-width:1240px">
    <section class="ft-publications-hero">
      <div class="ft-publications-hero__content">
        <div class="ft-publications-hero__eyebrow">
          <span class="ft-publications-hero__eyebrow-icon">&#10022;</span>
          <span>Flux editorial premium</span>
        </div>

        <div class="ft-publications-hero__icon">
          <i class="bi bi-newspaper"></i>
        </div>

        <h1 class="ft-publications-hero__title">Publications FinTrust</h1>
        <p class="ft-publications-hero__subtitle">
          Explorez les actualites, analyses et conseils financiers dans une experience plus
          immersive, moderne et digne d'une plateforme fintech haut de gamme.
        </p>

        <div class="ft-publications-hero__chips">
          <span class="ft-publications-chip">Analyses expertes</span>
          <span class="ft-publications-chip">Veille financiere</span>
          <span class="ft-publications-chip">Contenu premium</span>
        </div>
      </div>

      <div class="ft-publications-hero__aside">
        <a href="{{ path('front_dashboard') }}" class="btn ft-publications-dashboard-btn">
          <i class="bi bi-grid me-2"></i>Retour au dashboard
        </a>

        <div class="ft-publications-kpi-card">
          <span class="ft-publications-kpi-card__label">Publications visibles</span>
          <strong class="ft-publications-kpi-card__value">{{ publications|length }}</strong>
          <span class="ft-publications-kpi-card__meta">
            {{ selectedCategory ? selectedCategory : 'Toutes les categories' }}
          </span>
        </div>
      </div>
    </section>

    <section class="ft-publications-filter-card">
      <form method="get" action="" class="row gx-3 gy-3 align-items-end ft-publications-filter-form" novalidate="novalidate">
        <div class="col-lg-5">
          <label class="form-label small fw-semibold ft-publications-filter-label">
            <i class="bi bi-search me-2"></i>Recherche
          </label>
          <div class="ft-publications-input-wrap">
            <input type="text" name="keyword" value="{{ searchTerm }}" class="form-control ft-publications-input" placeholder="Rechercher un titre, une analyse ou une astuce" autocomplete="off">
          </div>
        </div>

        <div class="col-lg-3">
          <label class="form-label small fw-semibold ft-publications-filter-label">
            <i class="bi bi-bullseye me-2"></i>Categorie
          </label>
          <div class="ft-publications-input-wrap">
            <select name="category" class="form-select ft-publications-input">
              <option value="">Toutes les categories</option>
              {% for category in categories %}
                <option value="{{ category }}" {{ selectedCategory == category ? 'selected' : '' }}>{{ category }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="col-lg-3">
          <label class="form-label small fw-semibold ft-publications-filter-label">
            <i class="bi bi-sliders2 me-2"></i>Trier par
          </label>
          <div class="ft-publications-input-wrap">
            <select name="sort" class="form-select ft-publications-input">
              <option value="recentes" {{ sortBy == 'recentes' ? 'selected' : '' }}>Recentes</option>
              <option value="trending" {{ sortBy == 'trending' ? 'selected' : '' }}>Tendance</option>
              <option value="mieux_notees" {{ sortBy == 'mieux_notees' ? 'selected' : '' }}>Mieux notees</option>
            </select>
          </div>
        </div>

        <div class="col-lg-1 d-grid">
          <button type="submit" class="btn ft-publications-submit-btn">OK</button>
        </div>
      </form>
    </section>

    {% if publications|length > 0 %}
      <div class="ft-publications-grid">
        {% for publication in publications %}
          {% set categoryKey = (publication.categorie ?: 'default')|lower %}
          <article class="ft-publication-card ft-publication-card--{{ categoryKey|replace({' ': '-', '�': 'e', '�': 'e', '�': 'e', '�': 'a'}) }}">
            <div class="ft-publication-card__cover">
              <div class="ft-publication-card__cover-orb"></div>
              <div class="ft-publication-card__cover-grid"></div>
              <div class="ft-publication-card__cover-gradient"></div>
              <div class="ft-publication-card__cover-badge">{{ publication.categorie ?: 'Actualite' }}</div>
              <div class="ft-publication-card__cover-status">{{ publication.statut }}</div>
              <div class="ft-publication-card__cover-kicker">Edition {{ "%02d"|format(loop.index) }}</div>
            </div>

            <div class="ft-publication-card__body">
              <div class="ft-publication-card__meta">
                <span class="ft-publication-card__date">
                  <i class="bi bi-calendar3 me-2"></i>
                  {{ publication.datePublication ? publication.datePublication|date('d/m/Y') : 'Date indisponible' }}
                </span>
                <span class="ft-publication-card__meta-chip">
                  <i class="bi bi-chat-left-text me-2"></i>{{ publication.commentCount }} avis
                </span>
              </div>

              <h2 class="ft-publication-card__title">{{ publication.titre }}</h2>

              <p class="ft-publication-card__excerpt">
                {{ publication.contenu|striptags|slice(0, 112) ~ (publication.contenu|length > 112 ? '...' : '') }}
              </p>

              <div class="ft-publication-card__analysis">
                <textarea class="ft-publication-card__analysis-source" hidden>{{ publication.contenu|striptags|trim }}</textarea>
                <div class="ft-publication-card__analysis-header">
                  <div>
                    <div class="ft-publication-card__analysis-title">Analyse intelligente</div>
                    <small class="ft-publication-card__analysis-subtitle">Resume court, points cles utiles et explication simple</small>
                  </div>
                  <div class="ft-publication-card__analysis-actions">
                    <button type="button" class="btn ft-publication-card__analysis-btn">Analyser</button>
                  </div>
                </div>
                <div class="ft-publication-card__analysis-result" hidden></div>
              </div>

              {% set engagementScore = (publication.commentCount * 3) + (publication.likeCount * 2) - publication.dislikeCount %}
              <div class="ft-publication-card__engagement-row">
                <div class="ft-publication-card__engagement">
                  <div class="ft-publication-card__engagement-ring">
                    <span>{{ engagementScore }}</span>
                  </div>
                  <div class="ft-publication-card__engagement-copy">
                    <span class="ft-publication-card__engagement-label">Score d'engagement</span>
                    <small>{{ publication.commentCount }} com. � {{ publication.likeCount }} likes � {{ publication.dislikeCount }} dislikes</small>
                  </div>
                </div>
                <span class="ft-publication-card__engagement-chip">
                  <i class="bi bi-activity"></i>
                  {{ engagementScore > 0 ? 'Tendance' : 'Nouveau' }}
                </span>
              </div>

              <div class="ft-publication-card__footer">
                <div class="ft-publication-card__signals">
                  <span class="ft-publication-card__signal">
                    <i class="bi bi-stars"></i>Contenu premium
                  </span>
                  <span class="ft-publication-card__signal">
                    <i class="bi bi-arrow-up-right-circle"></i>Lecture rapide
                  </span>
                </div>
                <a href="{{ path('front_publications_view', {id: publication.id}) }}" class="btn ft-publication-card__cta">
                  Explorer
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ft-publications-empty-state">
        <div class="ft-publications-empty-state__icon">
          <i class="bi bi-journal-text"></i>
        </div>
        <h3 class="ft-publications-empty-state__title">Aucune publication ne correspond a vos criteres</h3>
        <p class="ft-publications-empty-state__text">
          Essayez une autre recherche ou revenez a toutes les categories pour retrouver
          les analyses et contenus disponibles.
        </p>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.ft-publications-page {
  position: relative;
  min-height: calc(100vh - 72px);
  background:
    linear-gradient(180deg, rgba(241, 247, 255, 0.95) 0%, rgba(255, 255, 255, 0.92) 45%, rgba(245, 243, 255, 0.9) 100%);
  overflow: hidden;
}

.ft-publications-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.55;
  pointer-events: none;
}

.ft-publications-glow--one {
  width: 320px;
  height: 320px;
  top: 70px;
  left: 8%;
  background: rgba(96, 165, 250, 0.22);
}

.ft-publications-glow--two {
  width: 360px;
  height: 360px;
  top: 220px;
  right: 8%;
  background: rgba(167, 139, 250, 0.18);
}

.ft-publications-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 1.5rem;
  margin-bottom: 1.75rem;
  padding: 2rem;
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.48)),
    radial-gradient(circle at top right, rgba(96, 165, 250, 0.18), transparent 34%);
  border: 1px solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 28px 60px rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18px);
}

.ft-publications-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.55rem 0.9rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(191, 219, 254, 0.8);
  color: #1d4ed8;
  font-size: 0.85rem;
  font-weight: 700;
}

.ft-publications-hero__eyebrow-icon {
  color: #3b82f6;
}

.ft-publications-hero__icon {
  width: 4.4rem;
  height: 4.4rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 1.2rem;
  border-radius: 22px;
  background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
  color: #fff;
  font-size: 1.55rem;
  box-shadow: 0 18px 36px rgba(37, 99, 235, 0.22);
}

.ft-publications-hero__title {
  margin: 1.1rem 0 0.5rem;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.02;
  letter-spacing: -0.04em;
  font-weight: 800;
  background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #4f46e5 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.ft-publications-hero__subtitle {
  max-width: 720px;
  margin: 0;
  color: #5b6b85;
  font-size: 1.03rem;
  line-height: 1.8;
}

.ft-publications-hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 1.25rem;
}

.ft-publications-chip {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 0.85rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.75);
  border: 1px solid rgba(219, 234, 254, 0.95);
  color: #334155;
  font-size: 0.84rem;
  font-weight: 700;
}

.ft-publications-hero__aside {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: space-between;
}

.ft-publications-dashboard-btn {
  align-self: flex-end;
  padding: 0.9rem 1.15rem;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(147, 197, 253, 0.75);
  color: #1d4ed8;
  font-weight: 700;
  box-shadow: 0 14px 28px rgba(59, 130, 246, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
}

.ft-publications-dashboard-btn:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18px 34px rgba(37, 99, 235, 0.12);
}

.ft-publications-kpi-card {
  padding: 1.3rem;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(191, 219, 254, 0.8);
  box-shadow: 0 20px 42px rgba(15, 23, 42, 0.07);
}

.ft-publications-kpi-card__label {
  display: block;
  color: #64748b;
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.ft-publications-kpi-card__value {
  display: block;
  margin-top: 0.55rem;
  color: #0f172a;
  font-size: 2.9rem;
  line-height: 1;
}

.ft-publications-kpi-card__meta {
  display: block;
  margin-top: 0.6rem;
  color: #475569;
  font-size: 0.92rem;
}

.ft-publications-filter-card {
  margin-bottom: 1.85rem;
  padding: 1.35rem;
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid rgba(255, 255, 255, 0.58);
  box-shadow: 0 22px 46px rgba(15, 23, 42, 0.07);
  backdrop-filter: blur(18px);
}

.ft-publications-filter-label {
  color: #334155;
}

.ft-publications-input-wrap {
  position: relative;
}

.ft-publications-input {
  min-height: 54px;
  border-radius: 18px;
  border: 1px solid rgba(203, 213, 225, 0.92);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.78);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}

.ft-publications-input:focus {
  border-color: rgba(59, 130, 246, 0.92);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12), 0 16px 32px rgba(37, 99, 235, 0.08);
  transform: translateY(-1px);
}

.ft-publications-submit-btn {
  min-height: 54px;
  border-radius: 18px;
  background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
  color: #fff;
  font-weight: 800;
  border: none;
  box-shadow: 0 18px 30px rgba(37, 99, 235, 0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.ft-publications-submit-btn:hover {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 22px 36px rgba(37, 99, 235, 0.28);
}

.ft-publications-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.1rem;
}

.ft-publication-card {
  --ft-card-accent: #f59e0b;
  --ft-card-accent-soft: rgba(245, 158, 11, 0.16);
  --ft-card-accent-soft-2: rgba(251, 191, 36, 0.12);
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 330px;
  border-radius: 28px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.64);
  box-shadow: 0 22px 52px rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(14px);
  transition: transform 0.32s ease, box-shadow 0.32s ease, border-color 0.32s ease;
  animation: publicationCardFade 0.45s ease both;
}

.ft-publication-card--finance {
  --ft-card-accent: #14b8a6;
  --ft-card-accent-soft: rgba(20, 184, 166, 0.16);
  --ft-card-accent-soft-2: rgba(45, 212, 191, 0.12);
}

.ft-publication-card--assurance {
  --ft-card-accent: #f59e0b;
  --ft-card-accent-soft: rgba(245, 158, 11, 0.18);
  --ft-card-accent-soft-2: rgba(251, 191, 36, 0.12);
}

.ft-publication-card--investissement {
  --ft-card-accent: #ef4444;
  --ft-card-accent-soft: rgba(239, 68, 68, 0.16);
  --ft-card-accent-soft-2: rgba(248, 113, 113, 0.12);
}

.ft-publication-card--information,
.ft-publication-card--actualite,
.ft-publication-card--actualit {
  --ft-card-accent: #8b5cf6;
  --ft-card-accent-soft: rgba(139, 92, 246, 0.16);
  --ft-card-accent-soft-2: rgba(167, 139, 250, 0.12);
}

.ft-publication-card::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 96px;
  background: linear-gradient(180deg, transparent, var(--ft-card-accent-soft-2));
  pointer-events: none;
}

.ft-publication-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 28px 64px rgba(15, 23, 42, 0.12);
  border-color: rgba(147, 197, 253, 0.85);
}

.ft-publication-card__cover {
  position: relative;
  min-height: 132px;
  background:
    radial-gradient(circle at 84% 22%, var(--ft-card-accent-soft), transparent 24%),
    linear-gradient(135deg, rgba(30, 58, 138, 0.95), rgba(59, 130, 246, 0.88) 58%, rgba(129, 140, 248, 0.82));
  overflow: hidden;
}

.ft-publication-card__cover-orb {
  position: absolute;
  width: 140px;
  height: 140px;
  top: -36px;
  right: -20px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.24), transparent 68%);
  filter: blur(4px);
}

.ft-publication-card__cover-grid {
  position: absolute;
  inset: 0;
  opacity: 0.18;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
  background-size: 24px 24px;
  mask-image: linear-gradient(135deg, rgba(0, 0, 0, 0.92), transparent 78%);
}

.ft-publication-card__cover::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(15, 23, 42, 0.12));
  transition: transform 0.45s ease;
}

.ft-publication-card:hover .ft-publication-card__cover::before {
  transform: scale(1.06);
}

.ft-publication-card__cover-orb {
  position: absolute;
  inset: auto 0 0;
  height: 78px;
  background: linear-gradient(180deg, transparent, rgba(15, 23, 42, 0.3));
}

.ft-publication-card__cover-badge,
.ft-publication-card__cover-status {
  position: absolute;
  top: 16px;
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  backdrop-filter: blur(12px);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.ft-publication-card__cover-badge {
  left: 18px;
  background: rgba(255, 255, 255, 0.92);
  color: #0f172a;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
}

.ft-publication-card__cover-status {
  right: 16px;
  background: rgba(15, 23, 42, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
}

.ft-publication-card__cover-kicker {
  position: absolute;
  left: 18px;
  bottom: 16px;
  color: rgba(255, 255, 255, 0.88);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.ft-publication-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.15rem 1.2rem 1.2rem;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(248, 250, 252, 0.95));
  position: relative;
  z-index: 1;
}

.ft-publication-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.8rem;
  flex-wrap: wrap;
  margin-bottom: 0.55rem;
}

.ft-publication-card__date {
  color: #64748b;
  font-size: 0.86rem;
}

.ft-publication-card__meta-chip {
  display: inline-flex;
  align-items: center;
  padding: 0.4rem 0.72rem;
  border-radius: 999px;
  background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--ft-card-accent) 10%, white));
  color: var(--ft-card-accent);
  font-size: 0.76rem;
  font-weight: 700;
}

.ft-publication-card__title {
  margin: 0 0 0.55rem;
  color: #0f172a;
  font-size: 1.02rem;
  line-height: 1.3;
  font-weight: 800;
}

.ft-publication-card__excerpt {
  color: #5b6b85;
  line-height: 1.65;
  font-size: 0.92rem;
  margin: 0 0 0.9rem;
}

.ft-publication-card__analysis {
  margin: 0 0 1rem;
  padding: 0.9rem;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(239,246,255,0.92));
  border: 1px solid rgba(191, 219, 254, 0.85);
}

.ft-publication-card__analysis-header {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 0.8rem;
  margin-bottom: 0.75rem;
}

.ft-publication-card__analysis-title {
  color: #0f172a;
  font-size: 0.88rem;
  font-weight: 800;
}

.ft-publication-card__analysis-subtitle {
  color: #64748b;
}

.ft-publication-card__analysis-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.ft-publication-card__analysis-btn {
  min-height: 38px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
  color: #fff;
  font-size: 0.82rem;
  font-weight: 800;
  padding: 0.6rem 0.95rem;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.16);
}

.ft-publication-card__analysis-btn[disabled] {
  opacity: 0.7;
  cursor: wait;
}

.ft-publication-card__analysis-result {
  display: grid;
  gap: 0.75rem;
}

.ft-publication-analysis-block {
  padding: 0.85rem 0.9rem;
  border-radius: 14px;
  background: rgba(255,255,255,0.9);
  border: 1px solid rgba(219, 234, 254, 0.95);
}

.ft-publication-analysis-block strong {
  display: block;
  margin-bottom: 0.28rem;
  color: #0f172a;
  font-size: 0.8rem;
}

.ft-publication-analysis-block p,
.ft-publication-analysis-block li {
  margin: 0;
  color: #475569;
  font-size: 0.84rem;
  line-height: 1.6;
}

.ft-publication-analysis-block ul {
  margin: 0;
  padding-left: 1.1rem;
}

.ft-publication-analysis-meta {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  width: fit-content;
