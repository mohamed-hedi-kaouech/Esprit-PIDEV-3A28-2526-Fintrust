{% extends 'front/front.html.twig' %}
{% block title %}Actualites pertinentes{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-app-page {
      background:
        radial-gradient(circle at top right, rgba(56, 189, 248, .09), transparent 22%),
        radial-gradient(circle at top left, rgba(37, 99, 235, .06), transparent 18%),
        linear-gradient(180deg, #edf4fb 0%, #f7fbff 36%, #eef4fb 100%);
      min-height: 100vh;
    }
    .ft-analytics-hero {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(147, 197, 253, .76);
      background:
        radial-gradient(circle at top right, rgba(56, 189, 248, .24), transparent 24%),
        radial-gradient(circle at 10% 85%, rgba(34, 197, 94, .12), transparent 22%),
        linear-gradient(135deg, rgba(255,255,255,.99), rgba(236,245,255,.95));
      border-radius: 2.1rem;
      padding: 2.2rem;
      box-shadow: 0 28px 56px rgba(15, 23, 42, .09);
    }
    .ft-analytics-hero::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 5px;
      background: linear-gradient(180deg, #2563eb, #38bdf8, #22c55e);
    }
    .ft-analytics-hero::after {
      content: "";
      position: absolute;
      right: -5rem;
      bottom: -7rem;
      width: 18rem;
      height: 18rem;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37, 99, 235, .14), transparent 65%);
      pointer-events: none;
    }
    .ft-analytics-item {
      position: relative;
      overflow: hidden;
      border-radius: 1.6rem;
      border: 1px solid rgba(203, 213, 225, .82);
      background:
        linear-gradient(145deg, rgba(255,255,255,.98), rgba(244,249,255,.95));
      padding: 1.4rem;
      box-shadow: 0 18px 36px rgba(15, 23, 42, .06);
      height: 100%;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .ft-analytics-item::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: linear-gradient(180deg, #60a5fa, #2563eb, #38bdf8);
    }
    .ft-analytics-item:hover {
      transform: translateY(-4px);
      border-color: rgba(147, 197, 253, .96);
      box-shadow: 0 22px 40px rgba(37, 99, 235, .10);
    }
    .ft-analytics-score {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      padding: .48rem .95rem;
      border-radius: 999px;
      background: rgba(37,99,235,.10);
      color: #1d4ed8;
      font-size: .8rem;
      font-weight: 800;
      box-shadow: inset 0 0 0 1px rgba(191, 219, 254, .7);
    }
    .ft-analytics-side-card {
      border-radius: 1.65rem;
      border: 1px solid rgba(191, 219, 254, .84);
      background:
        radial-gradient(circle at top right, rgba(56, 189, 248, .16), transparent 26%),
        linear-gradient(180deg, rgba(255,255,255,.98), rgba(243,248,255,.96));
      box-shadow: 0 20px 38px rgba(15, 23, 42, .07);
      height: 100%;
    }
    .ft-analytics-side-callout {
      padding: 1.1rem 1.15rem;
      border-radius: 1.2rem;
      background:
        linear-gradient(135deg, rgba(37,99,235,.10), rgba(14,165,233,.10));
      border: 1px solid rgba(191,219,254,.84);
    }
    .ft-analytics-theme-badge {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .42rem .75rem;
      border-radius: 999px;
      background: rgba(255,255,255,.78);
      border: 1px solid rgba(191,219,254,.82);
      color: #1d4ed8;
      font-size: .78rem;
      font-weight: 800;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="ft-app-page">
    <div class="container-fluid px-4 py-4">
      <section class="ft-analytics-hero mb-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
          <div>
            <div class="ft-dash-hero-kicker mb-3"><i class="bi bi-stars"></i> Actualites pertinentes</div>
            <h1 class="ft-dash-hero-title mb-3">Veille personnalisee a fort impact</h1>
            <p class="ft-dash-hero-subtitle mb-0">FinTrust priorise pour vous les contenus economiques et bancaires les plus utiles selon votre profil, votre segment et vos signaux recents.</p>
          </div>
          <a href="{{ path('front_dashboard') }}" class="btn ft-btn-outline-primary">Retour au dashboard</a>
        </div>
      </section>

      <div class="row g-4 mb-4">
        <div class="col-lg-8">
          <div class="row g-3">
            {% for item in relevance.items %}
              <div class="col-md-6">
                <article class="ft-analytics-item">
                  <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <span class="badge {{ item.priority == 'HIGH' ? 'ft-badge-warning' : 'ft-badge-blue' }}">{{ item.category }}</span>
                    <span class="ft-analytics-score">Pertinence {{ item.relevanceScore }}/100</span>
                  </div>
                  <h3 class="h4 mb-2">{{ item.title }}</h3>
                  <p class="text-muted mb-3">{{ item.summary }}</p>
                  <div class="small text-secondary-emphasis mb-2"><strong>Impact estime :</strong> {{ item.impactReason }}</div>
                  <div class="small text-muted">{{ item.sourceName }} · {{ item.publishedAt|date('d/m/Y H:i') }}</div>
                </article>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="col-lg-4">
          <div class="ft-analytics-side-card">
            <div class="ft-app-card-header"><i class="bi bi-sliders me-2 text-primary"></i>Lecture analytique</div>
            <div class="ft-app-card-body">
              <div class="mb-3">
                <div class="text-muted small">Segment suivi</div>
                <div class="fw-semibold">{{ relevance.summary.segment }}</div>
              </div>
              <div class="mb-3">
                <div class="text-muted small">Themes surveilles</div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  {% for theme in relevance.summary.watchThemes %}
                    <span class="ft-analytics-theme-badge"><i class="bi bi-asterisk"></i>{{ theme }}</span>
                  {% endfor %}
                </div>
              </div>
              <div class="ft-analytics-side-callout">
                <div class="text-muted small">Priorite globale</div>
                <div class="fw-bold fs-5">{{ relevance.summary.globalPriority }}</div>
                <div class="small text-muted mt-2">Les articles affiches sont fournis a titre informatif et n ont pas valeur de conseil d investissement.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
