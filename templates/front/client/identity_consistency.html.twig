{% extends 'front/front.html.twig' %}
{% block title %}Cohérence identitaire{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-identity-shell {
      border-radius: 2rem;
      background:
        radial-gradient(circle at top right, rgba(139,92,246,.14), transparent 24%),
        linear-gradient(135deg, rgba(255,255,255,.98), rgba(246,248,255,.96));
      border: 1px solid rgba(196, 181, 253, .7);
      box-shadow: 0 26px 48px rgba(15,23,42,.08);
      padding: 2rem;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="ft-app-page">
    <div class="container-fluid px-4 py-4">
      <section class="ft-identity-shell mb-4">
        <div class="row g-4 align-items-center">
          <div class="col-lg-8">
            <div class="ft-dash-hero-kicker mb-3"><i class="bi bi-shield-check"></i> Cohérence identitaire</div>
            <h1 class="ft-dash-hero-title mb-3">Score global {{ identityConsistency.identityScore }}/100</h1>
            <p class="ft-dash-hero-subtitle mb-0">FinTrust consolide les donnees declarees, les documents disponibles et les signaux de confiance pour mesurer la coherence globale de votre dossier.</p>
          </div>
          <div class="col-lg-4">
            <div class="ft-app-card h-100">
              <div class="ft-app-card-body">
                <div class="small text-muted">Niveau de coherence</div>
                <div class="fw-bold fs-3">{{ identityConsistency.consistencyLevel }}</div>
                <div class="small text-muted mt-3">Niveau de confiance</div>
                <div class="fw-semibold">{{ identityConsistency.confidenceLevel }}</div>
                {% if identityConsistency.manualReviewRequired %}
                  <span class="badge ft-badge-warning mt-3">Revue manuelle recommandee</span>
                {% else %}
                  <span class="badge ft-badge-success mt-3">Cohérence satisfaisante</span>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="ft-app-card h-100">
            <div class="ft-app-card-header"><i class="bi bi-files me-2 text-primary"></i>Cohérence par document</div>
            <div class="ft-app-card-body">
              <div class="row g-3">
                {% for item in identityConsistency.documentConsistency %}
                  <div class="col-md-6">
                    <div class="p-3 rounded-4 border h-100" style="border-color:rgba(203,213,225,.9)!important;background:rgba(255,255,255,.94);">
                      <div class="small text-muted">{{ item.document }}</div>
                      <div class="fw-semibold my-2">{{ item.status }}</div>
                      <span class="badge ft-badge-blue">{{ item.score }}/100</span>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="ft-app-card h-100">
            <div class="ft-app-card-header"><i class="bi bi-exclamation-octagon me-2 text-primary"></i>Anomalies detectees</div>
            <div class="ft-app-card-body">
              {% if identityConsistency.issues is empty %}
                <div class="text-muted">Aucune anomalie majeure detectee sur les donnees actuellement disponibles.</div>
              {% else %}
                <div class="d-grid gap-3">
                  {% for issue in identityConsistency.issues %}
                    <div class="p-3 rounded-4" style="background:rgba(248,250,252,.95);border:1px solid rgba(226,232,240,.95);">
                      <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="fw-semibold">{{ issue.field|title }}</div>
                        <span class="badge ft-badge-warning">{{ issue.issueType }}</span>
                      </div>
                      <div class="text-muted small mt-2">{{ issue.description }}</div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
