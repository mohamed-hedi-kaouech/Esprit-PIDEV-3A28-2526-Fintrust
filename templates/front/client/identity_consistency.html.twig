{% extends 'front/front.html.twig' %}
{% block title %}Cohérence identitaire{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-app-page {
      background:
        radial-gradient(circle at top right, rgba(59, 130, 246, .08), transparent 24%),
        radial-gradient(circle at top left, rgba(139, 92, 246, .06), transparent 18%),
        linear-gradient(180deg, #eef4fb 0%, #f9fbff 40%, #edf3fb 100%);
      min-height: 100vh;
    }
    .ft-identity-shell {
      position: relative;
      overflow: hidden;
      border-radius: 2rem;
      background:
        radial-gradient(circle at top right, rgba(139,92,246,.16), transparent 24%),
        radial-gradient(circle at bottom left, rgba(56,189,248,.12), transparent 28%),
        linear-gradient(135deg, rgba(255,255,255,.99), rgba(243,247,255,.96));
      border: 1px solid rgba(196, 181, 253, .65);
      box-shadow: 0 28px 52px rgba(15,23,42,.08);
      padding: 2.1rem;
    }
    .ft-identity-shell::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 5px;
      background: linear-gradient(180deg, #8b5cf6, #2563eb, #38bdf8);
    }
    .ft-identity-stat-card {
      border-radius: 1.55rem;
      border: 1px solid rgba(196, 181, 253, .48);
      background:
        radial-gradient(circle at top right, rgba(56,189,248,.10), transparent 24%),
        linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,248,255,.96));
      box-shadow: 0 18px 34px rgba(15,23,42,.06);
    }
    .ft-identity-score-ring {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 5.4rem;
      height: 5.4rem;
      border-radius: 50%;
      background:
        radial-gradient(circle at center, #fff 48%, transparent 50%),
        conic-gradient(#2563eb 0 72%, #8b5cf6 72% 100%);
      box-shadow: 0 18px 30px rgba(37,99,235,.12);
      color: #17315c;
      font-weight: 900;
    }
    .ft-identity-doc-card,
    .ft-identity-issue-card {
      position: relative;
      overflow: hidden;
      border-radius: 1.25rem;
      background: linear-gradient(145deg, rgba(255,255,255,.98), rgba(246,249,255,.95));
      border: 1px solid rgba(219,234,254,.88);
      box-shadow: 0 14px 28px rgba(15,23,42,.05);
    }
    .ft-identity-doc-card::before,
    .ft-identity-issue-card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: linear-gradient(180deg, #8b5cf6, #2563eb, #38bdf8);
    }
  </style>
{% endblock %}

{% block body %}
  <div class="ft-app-page">
    <div class="container-fluid px-4 py-4">
      <section class="ft-identity-shell mb-4">
        <div class="row g-4 align-items-center">
          <div class="col-lg-8">
            <div class="ft-dash-hero-kicker mb-3"><i class="bi bi-shield-check"></i> Cohérence identitaire</div>
            <h1 class="ft-dash-hero-title mb-3">Score global {{ identityConsistency.identityScore }}/100</h1>
            <p class="ft-dash-hero-subtitle mb-0">FinTrust consolide les donnees declarees, les documents disponibles et les signaux de confiance pour mesurer la coherence globale de votre dossier.</p>
          </div>
          <div class="col-lg-4">
            <div class="ft-identity-stat-card h-100">
              <div class="ft-app-card-body">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                  <div>
                    <div class="small text-muted">Niveau de coherence</div>
                    <div class="fw-bold fs-3">{{ identityConsistency.consistencyLevel }}</div>
                  </div>
                  <div class="ft-identity-score-ring">{{ identityConsistency.identityScore }}</div>
                </div>
                <div class="small text-muted mt-3">Niveau de confiance</div>
                <div class="fw-semibold">{{ identityConsistency.confidenceLevel }}</div>
                {% if identityConsistency.manualReviewRequired %}
                  <span class="badge ft-badge-warning mt-3">Revue manuelle recommandee</span>
                {% else %}
                  <span class="badge ft-badge-success mt-3">Cohérence satisfaisante</span>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="ft-app-card h-100">
            <div class="ft-app-card-header"><i class="bi bi-files me-2 text-primary"></i>Cohérence par document</div>
            <div class="ft-app-card-body">
              <div class="row g-3">
                {% for item in identityConsistency.documentConsistency %}
                  <div class="col-md-6">
                    <div class="p-3 h-100 ft-identity-doc-card">
                      <div class="small text-muted">{{ item.document }}</div>
                      <div class="fw-semibold my-2">{{ item.status }}</div>
                      <span class="badge ft-badge-blue">{{ item.score }}/100</span>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="ft-app-card h-100">
            <div class="ft-app-card-header"><i class="bi bi-exclamation-octagon me-2 text-primary"></i>Anomalies detectees</div>
            <div class="ft-app-card-body">
              {% if identityConsistency.issues is empty %}
                <div class="text-muted">Aucune anomalie majeure detectee sur les donnees actuellement disponibles.</div>
              {% else %}
                <div class="d-grid gap-3">
                  {% for issue in identityConsistency.issues %}
                    <div class="p-3 ft-identity-issue-card">
                      <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="fw-semibold">{{ issue.field|title }}</div>
                        <span class="badge ft-badge-warning">{{ issue.issueType }}</span>
                      </div>
                      <div class="text-muted small mt-2">{{ issue.description }}</div>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
