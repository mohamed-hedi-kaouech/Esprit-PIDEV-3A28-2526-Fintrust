{% block javascripts %}
  {{ parent() }}
  <script>
    (() => {
      const form = document.querySelector('[data-ft-comment-form]');
      if (!form) {
        return;
      }

      const textarea = form.querySelector('[data-ft-comment-textarea]');
      const submitButton = form.querySelector('[data-ft-comment-submit]');
      const helper = form.querySelector('[data-ft-comment-helper]');
      const notice = document.querySelector('[data-ft-comment-notice]');
      let moderationTimer = null;
      let lastDecision = 'accept';

      if (!textarea || !submitButton || !helper || !notice) {
        return;
      }

      const setBlockedState = (blocked, message = '') => {
        submitButton.disabled = blocked;
        helper.classList.toggle('d-none', message === '');
        helper.classList.toggle('text-danger', blocked);
        helper.classList.toggle('text-muted', !blocked && message !== '');
        helper.textContent = message;

        if (blocked && message !== '') {
          notice.classList.remove('d-none', 'alert-warning');
          notice.classList.add('alert-danger');
          notice.innerHTML = `<i class="bi bi-shield-exclamation me-2"></i>${message}`;
        } else if (!blocked && notice.dataset.serverNotice !== 'true') {
          notice.classList.add('d-none');
          notice.innerHTML = '';
        }
      };

      if (!notice.classList.contains('d-none') && notice.textContent.trim() !== '') {
        notice.dataset.serverNotice = 'true';
      }

      const analyze = async () => {
        const text = textarea.value.trim();

        if (text.length < 2) {
          lastDecision = 'accept';
          setBlockedState(false, '');
          return;
        }

        try {
          const response = await fetch('{{ path('api_comment_moderation_analyze') }}', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ text })
          });

          if (!response.ok) {
            lastDecision = 'accept';
            setBlockedState(false, 'Moderation automatique temporairement indisponible.');
            return;
          }

          const result = await response.json();
          lastDecision = result.decision || 'accept';

          if (lastDecision !== 'accept') {
            setBlockedState(true, 'Commentaire bloque: insultes, violence ou langage inapproprie detectes.');
            return;
          }

          setBlockedState(false, 'Commentaire acceptable.');
        } catch (error) {
          lastDecision = 'accept';
          setBlockedState(false, 'Moderation automatique temporairement indisponible.');
        }
      };

      textarea.addEventListener('input', () => {
        window.clearTimeout(moderationTimer);
        moderationTimer = window.setTimeout(analyze, 350);
      });

      textarea.addEventListener('blur', () => {
        window.clearTimeout(moderationTimer);
        analyze();
      });

      form.addEventListener('submit', async (event) => {
        await analyze();
        if (lastDecision !== 'accept') {
          event.preventDefault();
        }
      });
    })();
  </script>
{% endblock %}
