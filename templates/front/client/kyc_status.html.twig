{% extends 'front/front.html.twig' %}
{% block title %}Statut KYC{% endblock %}

{% block body %}
{% set showRelaxZone = kyc and kyc.statut == 'EN_ATTENTE' %}

<div class="container py-5" style="max-width:1180px">
  <div class="ft-kyc-center-hero mb-4">
    <div>
      <span class="ft-profile-kicker">
        <i class="bi bi-shield-check me-2"></i>KYC Verification Center
      </span>
      <h1 class="ft-page-title mb-2">Verification d'identite</h1>
      <p class="text-muted mb-0">Suivez l'avancement documentaire, la correspondance selfie-document et la decision KYC dans un parcours FinTrust plus fluide.</p>
    </div>
    <div class="ft-kyc-center-badge">
      <span>Statut KYC</span>
      <strong>{{ kycCenter.overallKycStatus }}</strong>
      <small>Progression {{ kycCenter.progression }}%</small>
    </div>
  </div>

  {% if not kyc %}
    <div class="ft-kyc-status-card ft-kyc-none text-center mb-4">
      <div class="ft-kyc-icon"><i class="bi bi-file-earmark-x"></i></div>
      <h2 class="h4 fw-bold mb-2">Aucun dossier soumis</h2>
      <p class="text-muted mb-4">Vous n'avez pas encore depose de dossier KYC.</p>
      <a href="{{ path('front_kyc_submit') }}" class="btn ft-btn-primary">
        <i class="bi bi-upload me-2"></i>Deposer mon dossier
      </a>
    </div>
  {% elseif kyc.statut == 'EN_ATTENTE' %}
    <div class="ft-kyc-status-card ft-kyc-pending ft-kyc-pending-upgraded mb-4">
      <div class="row g-4 align-items-center">
        <div class="col-lg-8">
          <div class="ft-kyc-status-lead">
            <div class="ft-kyc-icon text-warning"><i class="bi bi-hourglass-split"></i></div>
            <div>
              <div class="ft-kyc-status-chip">Verification en cours</div>
              <h2 class="h3 fw-bold mb-2">Votre dossier est actuellement en analyse</h2>
              <p class="text-muted mb-2">Soumis le <strong>{{ kyc.dateSubmission|date('d/m/Y \\a H:i') }}</strong>. Notre equipe poursuit la verification documentaire et la validation des informations fournies.</p>
              <p class="text-muted mb-0">Pendant cette attente, vous pouvez retrouver l espace detente directement depuis l accueil client, sans quitter votre tableau de bord principal.</p>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="ft-kyc-waiting-metrics">
            <div class="ft-kyc-mini-stat">
              <span>Delai habituel</span>
              <strong>24 a 48h</strong>
            </div>
            <div class="ft-kyc-mini-stat">
              <span>Derniere mise a jour</span>
              <strong>{{ kycCenter.lastUpdatedAt ? kycCenter.lastUpdatedAt|date('d/m/Y H:i') : 'En cours' }}</strong>
            </div>
            <div class="ft-kyc-mini-stat">
              <span>Etat actuel</span>
              <strong>{{ kycCenter.decision.status }}</strong>
            </div>
          </div>
        </div>
      </div>
      <div class="ft-kyc-progress ft-kyc-progress-wide mt-4">
        <div class="ft-kyc-progress-bar ft-kyc-progress-pending" style="width: {{ kycCenter.progression|default(58) }}%"></div>
      </div>
      <div class="ft-kyc-progress-labels">
        <span>Reception</span>
        <span>Analyse</span>
        <span>Decision</span>
      </div>
    </div>
  {% elseif kyc.statut == 'APPROUVE' %}
    <div class="ft-kyc-status-card ft-kyc-approved text-center mb-4">
      <div class="ft-kyc-icon text-success"><i class="bi bi-patch-check-fill"></i></div>
      <h2 class="h4 fw-bold mb-2">Dossier approuve</h2>
      <p class="text-muted mb-4">Votre identite a ete verifiee avec succes. Vous avez acces a toutes les fonctionnalites FinTrust.</p>
      {% if kyc.commentaireAdmin %}
        <div class="alert alert-success text-start">
          <i class="bi bi-chat-quote me-2"></i>{{ kyc.commentaireAdmin }}
        </div>
      {% endif %}
      <a href="{{ path('front_dashboard') }}" class="btn ft-btn-primary">
        <i class="bi bi-grid me-2"></i>Acceder au tableau de bord
      </a>
    </div>
  {% elseif kyc.statut == 'REFUSE' %}
    <div class="ft-kyc-status-card ft-kyc-refused text-center mb-4">
      <div class="ft-kyc-icon text-danger"><i class="bi bi-x-circle-fill"></i></div>
      <h2 class="h4 fw-bold mb-2">Dossier refuse</h2>
      {% if kyc.commentaireAdmin %}
        <div class="alert alert-danger text-start mb-3">
          <strong><i class="bi bi-exclamation-triangle me-2"></i>Motif :</strong>
          {{ kyc.commentaireAdmin }}
        </div>
      {% endif %}
      <p class="text-muted mb-4">Vous pouvez soumettre un nouveau dossier avec des documents corrects.</p>
      <a href="{{ path('front_kyc_submit') }}" class="btn ft-btn-primary">
        <i class="bi bi-arrow-repeat me-2"></i>Soumettre un nouveau dossier
      </a>
    </div>
  {% endif %}

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="ft-app-card h-100">
        <div class="ft-app-card-header">
          <i class="bi bi-card-image me-2 text-primary"></i>Verification documentaire
        </div>
        <div class="ft-app-card-body">
          <div class="ft-insight-grid">
            <div class="ft-insight-pill">
              <span>Type</span>
              <strong>{{ kycCenter.document.documentType }}</strong>
            </div>
            <div class="ft-insight-pill">
              <span>Pays</span>
              <strong>{{ kycCenter.document.issuingCountry }}</strong>
            </div>
            <div class="ft-insight-pill">
              <span>Numero</span>
              <strong>{{ kycCenter.document.documentNumberMasked ?? 'Non disponible' }}</strong>
            </div>
            <div class="ft-insight-pill">
              <span>Statut</span>
              <strong>{{ kycCenter.document.documentStatus }}</strong>
            </div>
          </div>
          <div class="ft-soft-panel mt-3">
            <div class="fw-semibold text-primary mb-2">Score documentaire</div>
            <strong>{{ kycCenter.document.confidenceScore }}/100</strong>
            {% if kycCenter.document.issues is not empty %}
              <ul class="ft-list-clean mt-3 mb-0">
                {% for issue in kycCenter.document.issues %}
                  <li>{{ issue }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="ft-app-card h-100">
        <div class="ft-app-card-header">
          <i class="bi bi-person-bounding-box me-2 text-primary"></i>Correspondance selfie-document
        </div>
        <div class="ft-app-card-body">
          <div class="ft-risk-score-wrap mb-3">
            <div class="ft-risk-score-value">{{ kycCenter.selfieMatch.selfieMatchScore ?? '--' }}</div>
            <div class="ft-risk-score-caption">{{ kycCenter.selfieMatch.selfieMatchStatus }}</div>
          </div>
          <div class="ft-soft-panel">
            <div class="fw-semibold text-primary mb-2">Niveau de confiance</div>
            <div class="text-muted small mb-2">{{ kycCenter.selfieMatch.confidenceLevel }}</div>
            <div class="small">{{ kycCenter.selfieMatch.message }}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="ft-app-card h-100">
        <div class="ft-app-card-header">
          <i class="bi bi-clipboard2-check me-2 text-primary"></i>Decision KYC
        </div>
        <div class="ft-app-card-body">
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge ft-badge-blue">{{ kycCenter.decision.status }}</span>
            <span class="badge ft-badge-neutral">Derniere mise a jour {{ kycCenter.lastUpdatedAt ? kycCenter.lastUpdatedAt|date('d/m/Y H:i') : 'Non disponible' }}</span>
          </div>
          <div class="ft-soft-panel">
            <div class="fw-semibold text-primary mb-2">Motifs et recommandations</div>
            <ul class="ft-list-clean mb-0">
              {% for motif in kycCenter.decision.motifs %}
                <li>{{ motif }}</li>
              {% else %}
                <li>Dossier en attente d'instructions complementaires.</li>
              {% endfor %}
              {% for item in kycCenter.decision.recommendations %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="ft-app-card h-100">
        <div class="ft-app-card-header">
          <i class="bi bi-clock-history me-2 text-primary"></i>Historique de verification
        </div>
        <div class="ft-app-card-body">
          <div class="ft-timeline">
            {% for item in kycCenter.history %}
              <div class="ft-timeline-item">
                <div class="ft-timeline-dot ft-timeline-info"></div>
                <div>
                  <div class="fw-semibold small">{{ item.step }}</div>
                  <div class="text-muted small">{{ item.result }} · {{ item.source }}</div>
                  <div class="text-muted x-small">{{ item.date }}</div>
                </div>
              </div>
            {% else %}
              <div class="text-muted small">Aucune etape de verification disponible pour le moment.</div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <style>
    .ft-kyc-center-hero,
    .ft-relax-zone,
    .ft-relax-console,
    .ft-relax-game-card {
      animation: ftFadeUp .45s ease both;
    }
    @keyframes ftFadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .ft-kyc-center-hero {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.4rem;
      border-radius: 1.4rem;
      background: linear-gradient(135deg, #ffffff 0%, #f7fbff 50%, #eef6ff 100%);
      border: 1px solid #dbe7f7;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.06);
      flex-wrap: wrap;
    }
    .ft-kyc-center-badge {
      min-width: 220px;
      padding: 1rem 1.1rem;
      border-radius: 1.2rem;
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid #cfe0fb;
      color: #123c8d;
      display: grid;
      gap: .25rem;
    }
    .ft-kyc-center-badge span {
      text-transform: uppercase;
      letter-spacing: .04em;
      font-size: .76rem;
      font-weight: 700;
      color: #64748b;
    }
    .ft-kyc-center-badge strong { font-size: 1.1rem; }
    .ft-profile-kicker,
    .ft-relax-kicker {
      display: inline-flex;
      align-items: center;
      padding: .45rem .85rem;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.08);
      color: #1d4ed8;
      font-weight: 700;
      font-size: .84rem;
      margin-bottom: .85rem;
    }
    .ft-kyc-pending-upgraded {
      border: 1px solid #d6e5f8;
      background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(245,250,255,.98));
      box-shadow: 0 22px 44px rgba(15, 23, 42, 0.08);
    }
    .ft-kyc-status-lead {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .ft-kyc-status-chip {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .45rem .8rem;
      border-radius: 999px;
      background: rgba(250, 204, 21, 0.16);
      color: #9a6700;
      font-size: .82rem;
      font-weight: 700;
      margin-bottom: .9rem;
    }
    .ft-kyc-waiting-metrics {
      display: grid;
      gap: .75rem;
    }
    .ft-kyc-mini-stat {
      padding: 1rem;
      border-radius: 1.1rem;
      background: rgba(255,255,255,.86);
      border: 1px solid rgba(191, 219, 254, .9);
    }
    .ft-kyc-mini-stat span,
    .ft-relax-status-meta span,
    .ft-relax-mini-kpi span {
      display: block;
      color: #64748b;
      font-size: .76rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-weight: 700;
      margin-bottom: .3rem;
    }
    .ft-kyc-mini-stat strong,
    .ft-relax-status-meta strong,
    .ft-relax-mini-kpi strong {
      color: #0f172a;
      font-size: 1rem;
    }
    .ft-kyc-progress-wide {
      height: 14px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(191, 219, 254, 0.42);
    }
    .ft-kyc-progress-labels {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: .7rem;
      color: #6b7a90;
      font-size: .82rem;
      font-weight: 600;
    }
    .ft-relax-zone {
      border-radius: 1.6rem;
      border: 1px solid #dbe7f7;
      background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.12), transparent 28%),
        radial-gradient(circle at left bottom, rgba(16, 185, 129, 0.10), transparent 24%),
        linear-gradient(135deg, #ffffff, #f7fbff);
      box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
      padding: 1.45rem;
    }
    .ft-relax-zone-intro {
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      align-items: stretch;
      margin-bottom: 1.35rem;
      flex-wrap: wrap;
    }
    .ft-relax-title {
      font-size: clamp(1.65rem, 2vw, 2.15rem);
      font-weight: 800;
      color: #0f172a;
      margin-bottom: .45rem;
    }
    .ft-relax-status-card {
      min-width: 260px;
      display: grid;
      gap: .8rem;
      padding: 1rem 1.05rem;
      border-radius: 1.25rem;
      background: rgba(255,255,255,.88);
      border: 1px solid #d9e7fb;
    }
    .ft-relax-status-badge,
    .ft-relax-console-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      padding: .45rem .8rem;
      border-radius: 999px;
      background: rgba(37, 99, 235, 0.1);
      color: #1d4ed8;
      font-size: .82rem;
      font-weight: 700;
    }
    .ft-relax-game-card {
      height: 100%;
      padding: 1.2rem;
      border-radius: 1.35rem;
      border: 1px solid #dbe7f7;
      background: rgba(255,255,255,.9);
      box-shadow: 0 18px 34px rgba(15, 23, 42, 0.05);
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      display: grid;
      gap: 1rem;
    }
    .ft-relax-game-card:hover,
    .ft-relax-game-card.is-active {
      transform: translateY(-4px);
      box-shadow: 0 24px 40px rgba(37, 99, 235, 0.12);
      border-color: #9ec5fe;
    }
    .ft-relax-game-icon {
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    .ft-relax-game-icon-blue { background: linear-gradient(135deg, rgba(59,130,246,.16), rgba(96,165,250,.24)); color: #1d4ed8; }
    .ft-relax-game-icon-violet { background: linear-gradient(135deg, rgba(139,92,246,.14), rgba(196,181,253,.26)); color: #7c3aed; }
    .ft-relax-game-icon-green { background: linear-gradient(135deg, rgba(16,185,129,.14), rgba(110,231,183,.25)); color: #0f9f6e; }
    .ft-relax-game-topline {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      color: #6b7a90;
      font-size: .76rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 700;
      margin-bottom: .55rem;
    }
    .ft-relax-game-meta h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: .45rem;
    }
    .ft-relax-game-meta p,
    .ft-game-shell-subtitle,
    .ft-relax-placeholder p {
      color: #5b6b81;
      margin-bottom: 0;
    }
    .ft-relax-game-actions {
      margin-top: auto;
    }
    .ft-relax-game-stat {
      display: inline-flex;
      margin-bottom: .7rem;
      color: #6b7a90;
      font-size: .84rem;
      font-weight: 600;
    }
    .ft-relax-console {
      border-radius: 1.35rem;
      border: 1px solid #dbe7f7;
      background: rgba(255,255,255,.88);
      overflow: hidden;
    }
    .ft-relax-console-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.2rem 1.25rem;
      background: linear-gradient(180deg, rgba(239,246,255,.88), rgba(255,255,255,.9));
      border-bottom: 1px solid #dbe7f7;
      flex-wrap: wrap;
    }
    .ft-relax-console-kicker {
      display: inline-flex;
      margin-bottom: .35rem;
      color: #5b6b81;
      font-size: .76rem;
      letter-spacing: .06em;
      text-transform: uppercase;
      font-weight: 700;
    }
    .ft-relax-console-meta {
      display: flex;
      gap: .75rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .ft-btn-soft {
      background: rgba(239,246,255,.88);
      border: 1px solid #cfe0fb;
      color: #123c8d;
      border-radius: .9rem;
      font-weight: 700;
    }
    .ft-btn-soft:hover {
      background: #e8f1ff;
      color: #123c8d;
      border-color: #a9c9fb;
    }
    .ft-relax-console-panels {
      padding: 1.2rem;
    }
    .ft-relax-panel {
      display: none;
    }
    .ft-relax-panel.is-active {
      display: block;
    }
    .ft-relax-placeholder {
      min-height: 260px;
      border-radius: 1.2rem;
      border: 1px dashed #c7d9f7;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 2rem;
      background: linear-gradient(135deg, rgba(248,251,255,.9), rgba(239,246,255,.78));
    }
    .ft-relax-placeholder-icon {
      width: 4rem;
      height: 4rem;
      border-radius: 1.25rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(37,99,235,.08);
      color: #2563eb;
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    .ft-game-shell {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: flex-start;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .ft-game-shell-title {
      font-size: 1.1rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: .25rem;
    }
    .ft-game-shell-badges {
      display: flex;
      gap: .55rem;
      flex-wrap: wrap;
      margin-top: .75rem;
    }
    .ft-game-badge {
      padding: .38rem .72rem;
      border-radius: 999px;
      background: rgba(239,246,255,.9);
      color: #1e40af;
      font-size: .8rem;
      font-weight: 700;
      border: 1px solid #dbe7f7;
    }
    .ft-chess-board-wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 250px;
      gap: 1rem;
      align-items: start;
    }
    .ft-chess-board {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      border-radius: 1.2rem;
      overflow: hidden;
      border: 1px solid #dbe7f7;
      box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
    }
    .ft-chess-cell {
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(1.15rem, 2vw, 1.9rem);
      cursor: pointer;
      user-select: none;
      transition: transform .12s ease, outline-color .12s ease;
      outline: 2px solid transparent;
      outline-offset: -3px;
    }
    .ft-chess-cell:hover {
      transform: scale(0.98);
    }
    .ft-chess-cell-light { background: #eef4fb; }
    .ft-chess-cell-dark { background: #d7e5f6; }
    .ft-chess-cell-selected { outline-color: #2563eb; }
    .ft-chess-cell-target { outline-color: #10b981; }
    .ft-memory-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .85rem;
    }
    .ft-memory-card {
      border: 1px solid #dbe7f7;
      border-radius: 1rem;
      background: linear-gradient(135deg, #ffffff, #f8fbff);
      min-height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      cursor: pointer;
      transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.05);
    }
    .ft-memory-card:hover { transform: translateY(-2px); }
    .ft-memory-card.is-flipped,
    .ft-memory-card.is-matched {
      border-color: #9ec5fe;
      background: linear-gradient(135deg, #eff6ff, #ffffff);
    }
    .ft-memory-card.is-matched {
      box-shadow: 0 14px 28px rgba(16, 185, 129, 0.12);
    }
    .ft-memory-card-face-hidden {
      font-size: 1.2rem;
      color: #1d4ed8;
    }
    .ft-jump-stage {
      position: relative;
      min-height: 240px;
      border-radius: 1.2rem;
      border: 1px solid #dbe7f7;
      background:
        radial-gradient(circle at top left, rgba(59,130,246,.14), transparent 25%),
        linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
      overflow: hidden;
      cursor: pointer;
      outline: none;
    }
    .ft-jump-player,
    .ft-jump-obstacle {
      position: absolute;
      bottom: 34px;
      border-radius: .75rem;
    }
    .ft-jump-player {
      left: 46px;
      width: 28px;
      height: 28px;
      background: linear-gradient(135deg, #2563eb, #60a5fa);
      box-shadow: 0 10px 18px rgba(37, 99, 235, 0.22);
    }
    .ft-jump-obstacle {
      right: 40px;
      width: 22px;
      height: 44px;
      background: linear-gradient(180deg, #0f766e, #34d399);
      box-shadow: 0 8px 16px rgba(15, 118, 110, 0.18);
    }
    .ft-jump-ground {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 24px;
      height: 4px;
      background: linear-gradient(90deg, #bfdbfe, #60a5fa, #bfdbfe);
    }
    .ft-jump-hint {
      position: absolute;
      inset: auto 1rem 1rem 1rem;
      color: #5b6b81;
      font-size: .9rem;
      text-align: center;
    }
    .ft-insight-grid {
      display: grid;
      gap: .85rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ft-insight-pill {
      padding: 1rem;
      border-radius: 1.15rem;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(191, 219, 254, 0.9);
    }
    .ft-insight-pill strong {
      display: block;
      margin-top: .25rem;
      color: #0f172a;
      font-size: 1.05rem;
    }
    .ft-insight-pill span {
      color: #64748b;
      font-size: .78rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 700;
    }
    .ft-soft-panel {
      padding: 1rem 1.05rem;
      border-radius: 1.1rem;
      background: linear-gradient(135deg, #f8fbff, #eff6ff);
      border: 1px solid #dbe7f7;
    }
    .ft-list-clean {
      list-style: none;
      padding: 0;
    }
    .ft-list-clean li {
      display: flex;
      gap: .6rem;
      align-items: flex-start;
      color: #41546f;
      font-size: .92rem;
    }
    .ft-list-clean li + li { margin-top: .5rem; }
    .ft-list-clean li::before {
      content: "";
      width: .5rem;
      height: .5rem;
      border-radius: 999px;
      margin-top: .35rem;
      flex-shrink: 0;
      background: linear-gradient(135deg, #2563eb, #60a5fa);
    }
    .ft-risk-score-wrap {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: .75rem;
      padding-bottom: .8rem;
      border-bottom: 1px solid #e5edf7;
    }
    .ft-risk-score-value {
      font-size: 2rem;
      font-weight: 800;
      color: #0f172a;
    }
    .ft-risk-score-caption {
      color: #64748b;
      font-weight: 600;
    }
    .ft-timeline {
      display: grid;
      gap: 1rem;
    }
    .ft-timeline-item {
      display: grid;
      grid-template-columns: 14px minmax(0, 1fr);
      gap: .8rem;
      align-items: start;
    }
    .ft-timeline-dot {
      width: 14px;
      height: 14px;
      border-radius: 999px;
      margin-top: .25rem;
      box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.08);
      background: #3b82f6;
    }
    .x-small { font-size: .74rem; }
    @media (max-width: 991.98px) {
      .ft-chess-board-wrap {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 767.98px) {
      .ft-insight-grid,
      .ft-memory-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .ft-relax-zone,
      .ft-relax-console-panels,
      .ft-kyc-center-hero {
        padding: 1rem;
      }
      .ft-game-shell,
      .ft-relax-zone-intro {
        flex-direction: column;
      }
    }
  </style>
  <script>
    (function () {
      const root = document.querySelector('[data-ft-relax-zone]');
      if (!root) {
        return;
      }

      const storageKey = 'fintrustRelaxZoneState';
      const consoleNode = root.querySelector('[data-ft-relax-console]');
      const openButtons = root.querySelectorAll('[data-open-game]');
      const gameCards = root.querySelectorAll('[data-game-card]');
      const panels = root.querySelectorAll('[data-game-panel]');
      const lastNode = root.querySelector('[data-ft-relax-last]');
      const resumeButton = root.querySelector('[data-ft-relax-resume]');
      const resetCurrentButton = root.querySelector('[data-ft-reset-current]');
      const currentTitle = root.querySelector('[data-ft-current-title]');
      const currentDescription = root.querySelector('[data-ft-current-description]');
      const sessionStatus = root.querySelector('[data-ft-session-status]');

      const initialState = {
        lastGame: '',
        openCounts: { chess: 0, memory: 0, jump: 0 },
        chess: { board: null, selected: null, lastMove: '' },
        memory: { deck: [], flipped: [], matched: [], moves: 0, pairs: 0 },
        jump: { best: 0, score: 0 }
      };

      let state = loadState();

      function loadState() {
        try {
          const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
          return saved ? {
            ...initialState,
            ...saved,
            openCounts: { ...initialState.openCounts, ...(saved.openCounts || {}) },
            chess: { ...initialState.chess, ...(saved.chess || {}) },
            memory: { ...initialState.memory, ...(saved.memory || {}) },
            jump: { ...initialState.jump, ...(saved.jump || {}) }
          } : structuredClone(initialState);
        } catch (error) {
          return structuredClone(initialState);
        }
      }

      function persistState() {
        localStorage.setItem(storageKey, JSON.stringify(state));
      }

      const gameMeta = {
        chess: {
          title: "Partie d'echecs",
          description: "Un echiquier libre, elegant et discret pour faire une pause strategique pendant l'analyse de votre dossier."
        },
        memory: {
          title: 'Jeu de concentration',
          description: 'Un exercice de memoire court et fluide, avec progression conservee localement sur cet appareil.'
        },
        jump: {
          title: 'Pause reflexe',
          description: "Un mini defi simple a lancer d'un clic pour garder un rythme leger durant l'attente."
        }
      };

      function updateOverview() {
        Object.entries(state.openCounts).forEach(([game, value]) => {
          const node = root.querySelector(`[data-ft-open-count="${game}"]`);
          if (node) {
            node.textContent = value + (value > 1 ? ' ouvertures' : ' ouverture');
          }
        });

        if (lastNode) {
          lastNode.textContent = state.lastGame ? gameMeta[state.lastGame].title : 'Non demarree';
        }

        if (resumeButton) {
          resumeButton.disabled = !state.lastGame;
        }
      }

      function openGame(game) {
        state.lastGame = game;
        state.openCounts[game] = (state.openCounts[game] || 0) + 1;
        persistState();
        updateOverview();

        gameCards.forEach((card) => card.classList.toggle('is-active', card.dataset.gameCard === game));
        panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.gamePanel === game));

        if (currentTitle) {
          currentTitle.textContent = gameMeta[game].title;
        }
        if (currentDescription) {
          currentDescription.textContent = gameMeta[game].description;
        }
        if (sessionStatus) {
          sessionStatus.textContent = 'Activite ouverte';
        }
        if (resetCurrentButton) {
          resetCurrentButton.disabled = false;
          resetCurrentButton.dataset.currentGame = game;
        }

        if (game === 'chess') {
          renderChessBoard();
        } else if (game === 'memory') {
          ensureMemoryDeck();
          renderMemoryBoard();
        } else if (game === 'jump') {
          syncJumpUi();
        }

        consoleNode?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      openButtons.forEach((button) => {
        button.addEventListener('click', () => openGame(button.dataset.openGame));
      });

      resumeButton?.addEventListener('click', () => {
        if (state.lastGame) {
          openGame(state.lastGame);
        }
      });

      resetCurrentButton?.addEventListener('click', () => {
        const currentGame = resetCurrentButton.dataset.currentGame;
        if (!currentGame) {
          return;
        }

        if (currentGame === 'chess') {
          resetChess();
        } else if (currentGame === 'memory') {
          resetMemory();
        } else if (currentGame === 'jump') {
          resetJump();
        }
      });

      const initialChessBoard = [
        ['♜', '♞', '♝', '♛', '♚', '♝', '♞', '♜'],
        ['♟', '♟', '♟', '♟', '♟', '♟', '♟', '♟'],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['♙', '♙', '♙', '♙', '♙', '♙', '♙', '♙'],
        ['♖', '♘', '♗', '♕', '♔', '♗', '♘', '♖']
      ];

      const chessBoardNode = root.querySelector('[data-ft-chess-board]');
      const chessSelectionNode = root.querySelector('[data-ft-chess-selection]');
      const chessLastMoveNode = root.querySelector('[data-ft-chess-last-move]');

      function resetChess() {
        state.chess.board = initialChessBoard.map((row) => [...row]);
        state.chess.selected = null;
        state.chess.lastMove = '';
        persistState();
        renderChessBoard();
      }

      function chessLabel(x, y) {
        return String.fromCharCode(65 + x) + (8 - y);
      }

      function renderChessBoard() {
        if (!state.chess.board) {
          resetChess();
          return;
        }

        chessBoardNode.innerHTML = '';
        state.chess.board.forEach((row, y) => {
          row.forEach((piece, x) => {
            const cell = document.createElement('button');
            cell.type = 'button';
            cell.className = 'ft-chess-cell ' + (((x + y) % 2 === 0) ? 'ft-chess-cell-light' : 'ft-chess-cell-dark');
            if (state.chess.selected && state.chess.selected.x === x && state.chess.selected.y === y) {
              cell.classList.add('ft-chess-cell-selected');
            }
            if (state.chess.selected && !piece && !(state.chess.selected.x === x && state.chess.selected.y === y)) {
              cell.classList.add('ft-chess-cell-target');
            }
            cell.textContent = piece || '';
            cell.setAttribute('aria-label', 'Case ' + chessLabel(x, y));
            cell.addEventListener('click', () => handleChessClick(x, y));
            chessBoardNode.appendChild(cell);
          });
        });

        if (chessSelectionNode) {
          chessSelectionNode.textContent = state.chess.selected
            ? 'Piece selectionnee: ' + chessLabel(state.chess.selected.x, state.chess.selected.y)
            : 'Aucune piece selectionnee';
        }

        if (chessLastMoveNode) {
          chessLastMoveNode.textContent = state.chess.lastMove || 'Aucun';
        }
      }

      function handleChessClick(x, y) {
        const piece = state.chess.board[y][x];
        if (!state.chess.selected) {
          if (!piece) {
            return;
          }
          state.chess.selected = { x, y };
          persistState();
          renderChessBoard();
          return;
        }

        const selected = state.chess.selected;
        if (selected.x === x && selected.y === y) {
          state.chess.selected = null;
          persistState();
          renderChessBoard();
          return;
        }

        state.chess.board[y][x] = state.chess.board[selected.y][selected.x];
        state.chess.board[selected.y][selected.x] = '';
        state.chess.lastMove = chessLabel(selected.x, selected.y) + ' → ' + chessLabel(x, y);
        state.chess.selected = null;
        persistState();
        renderChessBoard();
      }

      root.querySelector('[data-ft-chess-reset]')?.addEventListener('click', resetChess);

      const memoryIcons = ['◆', '◆', '●', '●', '■', '■', '▲', '▲', '✦', '✦', '✳', '✳'];
      const memoryGridNode = root.querySelector('[data-ft-memory-grid]');
      const memoryMovesNode = root.querySelector('[data-ft-memory-moves]');
      const memoryPairsNode = root.querySelector('[data-ft-memory-pairs]');
      let memoryLock = false;

      function shuffledMemoryDeck() {
        const deck = [...memoryIcons];
        for (let i = deck.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [deck[i], deck[j]] = [deck[j], deck[i]];
        }
        return deck;
      }

      function ensureMemoryDeck() {
        if (!Array.isArray(state.memory.deck) || state.memory.deck.length !== memoryIcons.length) {
          state.memory.deck = shuffledMemoryDeck();
          state.memory.flipped = [];
          state.memory.matched = [];
          state.memory.moves = 0;
          state.memory.pairs = 0;
          persistState();
        }
      }

      function resetMemory() {
        state.memory = {
          deck: shuffledMemoryDeck(),
          flipped: [],
          matched: [],
          moves: 0,
          pairs: 0
        };
        persistState();
        renderMemoryBoard();
      }

      function renderMemoryBoard() {
        ensureMemoryDeck();
        memoryGridNode.innerHTML = '';
        state.memory.deck.forEach((icon, index) => {
          const card = document.createElement('button');
          card.type = 'button';
          const visible = state.memory.flipped.includes(index) || state.memory.matched.includes(index);
          card.className = 'ft-memory-card' + (visible ? ' is-flipped' : '') + (state.memory.matched.includes(index) ? ' is-matched' : '');
          card.innerHTML = visible
            ? `<span>${icon}</span>`
            : '<span class="ft-memory-card-face-hidden"><i class="bi bi-diamond"></i></span>';
          card.addEventListener('click', () => flipMemoryCard(index));
          memoryGridNode.appendChild(card);
        });

        if (memoryMovesNode) {
          memoryMovesNode.textContent = state.memory.moves + (state.memory.moves > 1 ? ' mouvements' : ' mouvement');
        }
        if (memoryPairsNode) {
          memoryPairsNode.textContent = state.memory.pairs + '/6 paires';
        }
      }

      function flipMemoryCard(index) {
        if (memoryLock || state.memory.flipped.includes(index) || state.memory.matched.includes(index)) {
          return;
        }

        state.memory.flipped.push(index);
        renderMemoryBoard();

        if (state.memory.flipped.length < 2) {
          persistState();
          return;
        }

        state.memory.moves += 1;
        const [first, second] = state.memory.flipped;
        const isMatch = state.memory.deck[first] === state.memory.deck[second];

        if (isMatch) {
          state.memory.matched.push(first, second);
          state.memory.pairs += 1;
          state.memory.flipped = [];
          persistState();
          renderMemoryBoard();
          return;
        }

        memoryLock = true;
        persistState();
        setTimeout(() => {
          state.memory.flipped = [];
          memoryLock = false;
          persistState();
          renderMemoryBoard();
        }, 700);
      }

      root.querySelector('[data-ft-memory-reset]')?.addEventListener('click', resetMemory);

      const jumpStage = root.querySelector('[data-ft-jump-stage]');
      const jumpPlayer = root.querySelector('[data-ft-jump-player]');
      const jumpObstacle = root.querySelector('[data-ft-jump-obstacle]');
      const jumpScoreNode = root.querySelector('[data-ft-jump-score]');
      const jumpBestNode = root.querySelector('[data-ft-jump-best]');
      const jumpStartButton = root.querySelector('[data-ft-jump-start]');
      let jumpRunning = false;
      let jumpTick = null;
      let playerY = 0;
      let playerVelocity = 0;
      let obstacleX = 320;
      let jumpScore = state.jump.score || 0;

      function syncJumpUi() {
        if (jumpScoreNode) {
          jumpScoreNode.textContent = 'Score ' + jumpScore;
        }
        if (jumpBestNode) {
          jumpBestNode.textContent = 'Meilleur ' + (state.jump.best || 0);
        }
      }

      function paintJump() {
        jumpPlayer.style.transform = `translateY(${-playerY}px)`;
        jumpObstacle.style.transform = `translateX(${-Math.max(0, 320 - obstacleX)}px)`;
      }

      function stopJump() {
        jumpRunning = false;
        if (jumpTick) {
          cancelAnimationFrame(jumpTick);
          jumpTick = null;
        }
        if (jumpStartButton) {
          jumpStartButton.innerHTML = '<i class="bi bi-play-fill me-1"></i>Relancer';
        }
        sessionStatus.textContent = 'Partie terminee';
      }

      function resetJump() {
        stopJump();
        playerY = 0;
        playerVelocity = 0;
        obstacleX = 320;
        jumpScore = 0;
        state.jump.score = 0;
        persistState();
        paintJump();
        syncJumpUi();
      }

      function jumpNow() {
        if (!jumpRunning) {
          return;
        }
        if (playerY === 0) {
          playerVelocity = 12;
        }
      }

      function jumpLoop() {
        if (!jumpRunning) {
          return;
        }

        playerVelocity -= 0.65;
        playerY = Math.max(0, playerY + playerVelocity);
        if (playerY === 0 && playerVelocity < 0) {
          playerVelocity = 0;
        }

        obstacleX -= 5;
        if (obstacleX < -30) {
          obstacleX = 320;
          jumpScore += 1;
          state.jump.score = jumpScore;
          state.jump.best = Math.max(state.jump.best || 0, jumpScore);
          persistState();
          syncJumpUi();
        }

        const obstacleNearPlayer = obstacleX > 30 && obstacleX < 75;
        if (obstacleNearPlayer && playerY < 26) {
          stopJump();
          state.jump.best = Math.max(state.jump.best || 0, jumpScore);
          state.jump.score = jumpScore;
          persistState();
          syncJumpUi();
          return;
        }

        paintJump();
        jumpTick = requestAnimationFrame(jumpLoop);
      }

      function startJump() {
        if (jumpRunning) {
          return;
        }
        resetJump();
        jumpRunning = true;
        if (jumpStartButton) {
          jumpStartButton.innerHTML = '<i class="bi bi-lightning me-1"></i>En cours';
        }
        sessionStatus.textContent = 'Activite ouverte';
        jumpTick = requestAnimationFrame(jumpLoop);
        jumpStage?.focus();
      }

      jumpStartButton?.addEventListener('click', startJump);
      root.querySelector('[data-ft-jump-reset]')?.addEventListener('click', resetJump);
      jumpStage?.addEventListener('click', () => {
        if (!jumpRunning) {
          startJump();
          return;
        }
        jumpNow();
      });
      jumpStage?.addEventListener('keydown', (event) => {
        if (event.code === 'Space') {
          event.preventDefault();
          if (!jumpRunning) {
            startJump();
            return;
          }
          jumpNow();
        }
      });

      ensureMemoryDeck();
      if (!state.chess.board) {
        resetChess();
      } else {
        renderChessBoard();
      }
      renderMemoryBoard();
      paintJump();
      syncJumpUi();
      updateOverview();
    })();
  </script>
{% endblock %}
