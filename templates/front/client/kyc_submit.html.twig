{% extends 'front/front.html.twig' %}
{% block title %}Dépôt KYC{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 820px">

  <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
      <div class="ft-page-icon ft-page-icon-green"><i class="bi bi-shield-check"></i></div>
      <div>
        <h1 class="ft-page-title mb-0">Vérification d'identité (KYC)</h1>
        <p class="text-muted mb-0 small">Complétez votre dossier, ajoutez votre signature et déposez plusieurs justificatifs si nécessaire.</p>
      </div>
    </div>
    <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="voiceGuideBtn">
      <i class="bi bi-volume-up me-2"></i>Lire les infos
    </button>
  </div>

  <div class="ft-steps mb-4">
    <div class="ft-step ft-step-active">
      <div class="ft-step-num">1</div>
      <div class="ft-step-label">Informations</div>
    </div>
    <div class="ft-step-line"></div>
    <div class="ft-step ft-step-active">
      <div class="ft-step-num">2</div>
      <div class="ft-step-label">Documents & signature</div>
    </div>
    <div class="ft-step-line"></div>
    <div class="ft-step">
      <div class="ft-step-num">3</div>
      <div class="ft-step-label">Validation admin</div>
    </div>
  </div>

  <div class="ft-card">
    <div class="ft-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
      <span><i class="bi bi-file-earmark-person me-2 text-primary"></i>Formulaire KYC</span>
      <span class="badge rounded-pill text-bg-light border text-primary px-3 py-2">Plusieurs images autorisées</span>
    </div>
    <div class="ft-card-body">

      {{ form_start(form, {
        attr: {
          novalidate: 'novalidate',
          enctype: 'multipart/form-data',
          id: 'kycForm'
        }
      }) }}

        {{ form_errors(form) }}

        <div class="mb-3">
          {{ form_label(form.cin, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
          {{ form_widget(form.cin, {attr: {class: 'form-control ft-input', placeholder: 'Ex : 12345678'}}) }}
          {% if form.cin.vars.errors|length > 0 %}
            <div class="text-danger small mt-1">{{ form_errors(form.cin) }}</div>
          {% endif %}
          <div class="form-text">Le CIN doit contenir exactement 8 chiffres.</div>
        </div>

        <div class="mb-3">
          {{ form_label(form.adresse, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
          {{ form_widget(form.adresse, {attr: {class: 'form-control ft-input', placeholder: 'Numéro, Rue, Ville, Code postal', rows: 3}}) }}
          {% if form.adresse.vars.errors|length > 0 %}
            <div class="text-danger small mt-1">{{ form_errors(form.adresse) }}</div>
          {% endif %}
        </div>

        <div class="mb-4">
          {{ form_label(form.dateNaissance, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
          {{ form_widget(form.dateNaissance, {attr: {class: 'form-control ft-input'}}) }}
          {% if form.dateNaissance.vars.errors|length > 0 %}
            <div class="text-danger small mt-1">{{ form_errors(form.dateNaissance) }}</div>
          {% endif %}
          <div class="form-text">Vous devez avoir au moins 18 ans.</div>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-lg-7">
            {{ form_label(form.documents, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
            <div class="ft-upload-zone" id="uploadZone">
              {{ form_widget(form.documents, {attr: {class: 'ft-file-input', id: 'kycFiles'}}) }}
              <div class="ft-upload-placeholder" id="uploadPlaceholder">
                <i class="bi bi-images fs-2 text-primary mb-2 d-block"></i>
                <strong>Déposez plusieurs fichiers ici</strong> ou cliquez pour sélectionner
                <div class="text-muted small mt-1">JPG, PNG, PDF — 5 Mo max par fichier</div>
                <div class="text-muted small">Vous pouvez envoyer plusieurs images de vos justificatifs.</div>
              </div>
              <div id="fileList" class="mt-3"></div>
            </div>
            <div class="form-text">Au moins un justificatif est obligatoire pour continuer vers la page d'attente.</div>
            {% if form.documents.vars.errors|length > 0 %}
              <div class="text-danger small mt-1">{{ form_errors(form.documents) }}</div>
            {% endif %}
          </div>

          <div class="col-lg-5">
            <label class="form-label fw-semibold">Signature manuscrite</label>
            <div class="ft-signature-card">
              <canvas id="signaturePad" class="ft-signature-canvas" width="320" height="200"></canvas>
              <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" id="clearSignatureBtn">
                  <i class="bi bi-eraser me-1"></i>Effacer
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm flex-grow-1" id="saveSignatureBtn">
                  <i class="bi bi-check2 me-1"></i>Marquer comme valide
                </button>
              </div>
              <div class="form-text mt-2">Dessinez votre signature avec la souris ou le doigt. Elle est enregistrée automatiquement dès que vous terminez le tracé.</div>
              {{ form_widget(form.signatureData, {attr: {id: 'signatureDataField'}}) }}
              {% if form.signatureData.vars.errors|length > 0 %}
                <div class="text-danger small mt-2">{{ form_errors(form.signatureData) }}</div>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="ft-selfie-card mb-4">
          <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
            <div>
              <div class="ft-selfie-card__eyebrow">Selfie KYC de reference</div>
              <h3 class="ft-selfie-card__title mb-1">Ajoutez le selfie qui servira ensuite pour votre connexion selfie + mot de passe</h3>
              <p class="text-muted mb-0">Le selfie reste range dans vos fichiers KYC existants, sans nouvelle table ni nouvelle colonne.</p>
            </div>
            <button type="button" class="btn btn-outline-primary rounded-pill px-3" id="startSelfieCaptureBtn">
              <i class="bi bi-camera2 me-2"></i>Activer la camera
            </button>
          </div>

          <div class="row g-4 align-items-stretch">
            <div class="col-lg-8">
              <div class="ft-selfie-stage">
                <video id="kycSelfieVideo" class="ft-selfie-stage__video" playsinline autoplay muted></video>
                <canvas id="kycSelfieCanvas" class="d-none"></canvas>
                <img id="kycSelfieStageCapture" class="ft-selfie-stage__capture d-none" alt="Selfie KYC capture">
                <div class="ft-selfie-stage__placeholder" id="kycSelfiePlaceholder">
                  <div class="ft-selfie-stage__icon"><i class="bi bi-person-bounding-box"></i></div>
                  <p class="mb-0">Autorisez la camera, placez votre visage dans le cadre puis capturez votre selfie de reference.</p>
                </div>
                <div class="ft-selfie-stage__frame">
                  <div class="ft-selfie-stage__corners"></div>
                  <div class="ft-selfie-stage__scan"></div>
                </div>
              </div>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary" id="captureSelfieReferenceBtn">
                  <i class="bi bi-camera-fill me-2"></i>Capturer mon selfie
                </button>
                <button type="button" class="btn btn-outline-secondary" id="resetSelfieReferenceBtn">
                  <i class="bi bi-arrow-counterclockwise me-2"></i>Reprendre
                </button>
              </div>

              <div class="ft-selfie-status" id="kycSelfieStatus">Aucun selfie capture pour le moment.</div>
              {{ form_widget(form.selfieData, {attr: {id: 'selfieDataField'}}) }}
            </div>

            <div class="col-lg-4">
              <div class="ft-selfie-preview-card">
                <div class="ft-selfie-preview-card__label">Apercu du selfie</div>
                <img id="kycSelfiePreview" class="ft-selfie-preview-card__image d-none" alt="Selfie KYC capture">
                <div id="kycSelfiePreviewEmpty" class="ft-selfie-preview-card__empty">
                  <i class="bi bi-image-alt"></i>
                  <span>Le selfie capture apparaitra ici.</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="ft-voice-helper mb-4">
          <div class="d-flex align-items-start gap-3">
            <div class="ft-voice-helper-icon"><i class="bi bi-megaphone"></i></div>
            <div>
              <div class="fw-semibold text-primary mb-1">Aide vocale intégrée</div>
              <div class="text-muted small">Le bouton “Lire les infos” peut relire les consignes et les données déjà saisies pour aider l’utilisateur pendant le dépôt.</div>
            </div>
          </div>
        </div>

        <div class="ft-captcha-card mb-4">
          <label class="form-label fw-semibold mb-2">
            <i class="bi bi-shield-lock me-1 text-primary"></i>Verification finale
          </label>
          <input type="hidden" name="captcha_token" value="{{ captcha.token }}">
          <label class="ft-captcha-checkbox" for="captcha_confirm">
            <input type="checkbox" id="captcha_confirm" name="captcha_confirm" value="1">
            <span class="ft-captcha-box"><i class="bi bi-check-lg"></i></span>
            <span class="ft-captcha-label">{{ captcha.label }}</span>
          </label>
          <div class="form-text">Ce CAPTCHA protege la soumission KYC contre les envois automatises.</div>
        </div>

        <button type="submit" class="btn ft-btn-primary w-100 py-2 fw-semibold">
          <i class="bi bi-send me-2"></i>Soumettre mon dossier KYC
        </button>

      {{ form_end(form) }}

    </div>
  </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
  const fileInput = document.getElementById('kycFiles');
  const fileList = document.getElementById('fileList');
  const placeholder = document.getElementById('uploadPlaceholder');
  const signatureCanvas = document.getElementById('signaturePad');
  const signatureField = document.getElementById('signatureDataField');
  const clearSignatureBtn = document.getElementById('clearSignatureBtn');
  const saveSignatureBtn = document.getElementById('saveSignatureBtn');
  const selfieVideo = document.getElementById('kycSelfieVideo');
  const selfieCanvas = document.getElementById('kycSelfieCanvas');
  const selfieField = document.getElementById('selfieDataField')
    || document.querySelector('input[name$="[selfieData]"]');
  const selfieStatus = document.getElementById('kycSelfieStatus');
  const selfiePlaceholder = document.getElementById('kycSelfiePlaceholder');
  const selfiePreview = document.getElementById('kycSelfiePreview');
  const selfiePreviewEmpty = document.getElementById('kycSelfiePreviewEmpty');
  const selfieStageCapture = document.getElementById('kycSelfieStageCapture');
  const startSelfieCaptureBtn = document.getElementById('startSelfieCaptureBtn');
  const captureSelfieReferenceBtn = document.getElementById('captureSelfieReferenceBtn');
  const resetSelfieReferenceBtn = document.getElementById('resetSelfieReferenceBtn');
  const ctx = signatureCanvas?.getContext('2d');
  let drawing = false;
  let hasSignature = false;
  let selfieStream = null;
  let selfieReady = false;

  const waitForSelfieFrame = async () => {
    if (!selfieVideo) {
      return false;
    }

    if (selfieVideo.readyState >= 2 && (selfieVideo.videoWidth || selfieVideo.clientWidth)) {
      return true;
    }

    return new Promise((resolve) => {
      let settled = false;

      const finish = (value) => {
        if (settled) {
          return;
        }

        settled = true;
        resolve(value);
      };

      const onReady = () => finish(true);

      selfieVideo.addEventListener('loadeddata', onReady, { once: true });
      selfieVideo.addEventListener('canplay', onReady, { once: true });

      window.setTimeout(() => {
        finish(selfieVideo.readyState >= 2);
      }, 1400);
    });
  };

  const renderFiles = (files) => {
    fileList.innerHTML = '';

    if (!files.length) {
      placeholder.style.display = '';
      return;
    }

    placeholder.style.display = 'none';

    Array.from(files).forEach((file) => {
      const isPdf = file.type === 'application/pdf';
      const icon = isPdf ? 'bi-file-earmark-pdf text-danger' : 'bi-file-earmark-image text-primary';
      const size = (file.size / 1024).toFixed(1) + ' Ko';

      const item = document.createElement('div');
      item.className = 'd-flex align-items-center gap-2 py-2 px-3 mb-2 rounded-4 border bg-white';
      item.innerHTML = `
        <i class="bi ${icon}"></i>
        <div class="flex-grow-1 min-w-0">
          <div class="small fw-semibold text-truncate">${file.name}</div>
          <div class="text-muted small">${size}</div>
        </div>
        <span class="badge rounded-pill text-bg-light border">${isPdf ? 'PDF' : 'Image'}</span>
      `;
      fileList.appendChild(item);
    });
  };

  fileInput?.addEventListener('change', function() {
    renderFiles(this.files);
  });

  const initializeCanvas = () => {
    if (!ctx || !signatureCanvas) return;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, signatureCanvas.width, signatureCanvas.height);
  };

  const canvasHasDrawing = () => {
    if (!ctx || !signatureCanvas) return false;
    const pixels = ctx.getImageData(0, 0, signatureCanvas.width, signatureCanvas.height).data;
    for (let i = 0; i < pixels.length; i += 4) {
      if (pixels[i] !== 255 || pixels[i + 1] !== 255 || pixels[i + 2] !== 255 || pixels[i + 3] !== 255) {
        return true;
      }
    }
    return false;
  };

  const persistSignature = () => {
    if (!signatureCanvas || !canvasHasDrawing()) return false;
    signatureField.value = signatureCanvas.toDataURL('image/png');
    saveSignatureBtn?.classList.remove('btn-outline-primary');
    saveSignatureBtn?.classList.add('btn-primary');
    hasSignature = true;
    return true;
  };

  const restoreSignature = () => {
    if (!ctx || !signatureCanvas || !signatureField?.value) return;
    const image = new Image();
    image.onload = function() {
      initializeCanvas();
      ctx.drawImage(image, 0, 0, signatureCanvas.width, signatureCanvas.height);
      hasSignature = true;
      saveSignatureBtn?.classList.remove('btn-outline-primary');
      saveSignatureBtn?.classList.add('btn-primary');
    };
    image.src = signatureField.value;
  };

  const getPos = (event) => {
    const rect = signatureCanvas.getBoundingClientRect();
    const touch = event.touches ? event.touches[0] : null;
    const clientX = touch ? touch.clientX : event.clientX;
    const clientY = touch ? touch.clientY : event.clientY;

    return {
      x: clientX - rect.left,
      y: clientY - rect.top
    };
  };

  const startDrawing = (event) => {
    if (!ctx) return;
    drawing = true;
    const pos = getPos(event);
    ctx.beginPath();
    ctx.moveTo(pos.x, pos.y);
    event.preventDefault();
  };

  const draw = (event) => {
    if (!drawing || !ctx) return;
    const pos = getPos(event);
    ctx.lineWidth = 2.2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#123c8d';
    ctx.lineTo(pos.x, pos.y);
    ctx.stroke();
    hasSignature = true;
    event.preventDefault();
  };

  const stopDrawing = () => {
    if (!ctx) return;
    drawing = false;
    ctx.closePath();
    persistSignature();
  };

  initializeCanvas();
  restoreSignature();

  signatureCanvas?.addEventListener('mousedown', startDrawing);
  signatureCanvas?.addEventListener('mousemove', draw);
  window.addEventListener('mouseup', stopDrawing);
  signatureCanvas?.addEventListener('touchstart', startDrawing, { passive: false });
  signatureCanvas?.addEventListener('touchmove', draw, { passive: false });
  window.addEventListener('touchend', stopDrawing);

  clearSignatureBtn?.addEventListener('click', function() {
    initializeCanvas();
    signatureField.value = '';
    hasSignature = false;
    saveSignatureBtn?.classList.remove('btn-primary');
    saveSignatureBtn?.classList.add('btn-outline-primary');
  });

  saveSignatureBtn?.addEventListener('click', function() {
    persistSignature();
  });

  document.getElementById('kycForm')?.addEventListener('submit', function(e) {
    persistSignature();
  });

  const stopSelfieCamera = () => {
    if (selfieStream) {
      selfieStream.getTracks().forEach((track) => track.stop());
      selfieStream = null;
    }
  };

  const startSelfieCamera = async () => {
    if (!navigator.mediaDevices?.getUserMedia) {
      selfieStatus.textContent = 'La camera n est pas disponible sur ce navigateur.';
      return;
    }

    stopSelfieCamera();

    try {
      selfieStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user', width: { ideal: 960 }, height: { ideal: 720 } },
        audio: false
      });

      selfieVideo.onloadedmetadata = null;
      selfieVideo.srcObject = selfieStream;
      selfieReady = false;
      const markSelfieReady = async () => {
        try {
          await selfieVideo.play();
        } catch (error) {
          // La video est deja en lecture sur certains navigateurs.
        }
        selfieReady = true;
        selfieStatus.textContent = 'Camera active. Vous pouvez maintenant capturer votre selfie de reference.';
      };
      selfieVideo.onloadedmetadata = markSelfieReady;
      selfieVideo.onloadeddata = markSelfieReady;

      if (selfieVideo.readyState >= 2) {
        markSelfieReady();
      }

      await waitForSelfieFrame();
      if (selfieVideo.readyState >= 2) {
        selfieReady = true;
        selfieStatus.textContent = 'Camera active. Vous pouvez maintenant capturer votre selfie de reference.';
      }

      selfieStageCapture?.classList.add('d-none');
      selfieStageCapture?.setAttribute('src', '');
      selfieVideo.classList.remove('d-none');
      selfiePlaceholder?.classList.add('d-none');
      if (!selfieReady) {
        selfieStatus.textContent = 'Camera detectee. Si besoin, attendez un instant avant la capture.';
      }
    } catch (error) {
      selfieStatus.textContent = 'Impossible d ouvrir la camera. Verifiez les autorisations du navigateur.';
    }
  };

  const captureSelfieReference = async () => {
    if (!selfieVideo || !selfieCanvas) {
      selfieStatus.textContent = 'Le module selfie n est pas disponible sur cette page.';
      return;
    }

    if (!selfieField) {
      selfieStatus.textContent = 'Le champ de stockage du selfie est introuvable sur la page.';
      return;
    }

    if (selfieVideo.readyState < 2) {
      const frameReady = await waitForSelfieFrame();
      if (!frameReady) {
        selfieStatus.textContent = 'La camera ne fournit pas encore d image exploitable. Reessayez dans une seconde.';
        return;
      }
    }

    const sourceWidth = selfieVideo.videoWidth > 0 ? selfieVideo.videoWidth : Math.max(selfieVideo.clientWidth, 720);
    const sourceHeight = selfieVideo.videoHeight > 0 ? selfieVideo.videoHeight : Math.max(selfieVideo.clientHeight, 540);

    if (!sourceWidth || !sourceHeight) {
      selfieStatus.textContent = 'La camera n est pas encore prete. Attendez encore une seconde puis recommencez.';
      return;
    }

    try {
      const captureCanvas = document.createElement('canvas');
      captureCanvas.width = sourceWidth;
      captureCanvas.height = sourceHeight;
      const selfieContext = captureCanvas.getContext('2d');
      if (!selfieContext) {
        selfieStatus.textContent = 'La capture selfie est indisponible sur ce navigateur.';
        return;
      }

      const videoTrack = selfieStream?.getVideoTracks?.()[0] ?? null;
      const imageCaptureSupported = typeof window.ImageCapture !== 'undefined' && videoTrack;

      if (imageCaptureSupported) {
        try {
          const imageCapture = new window.ImageCapture(videoTrack);
          const frame = await imageCapture.grabFrame();
          selfieContext.save();
          selfieContext.translate(captureCanvas.width, 0);
          selfieContext.scale(-1, 1);
          selfieContext.drawImage(frame, 0, 0, captureCanvas.width, captureCanvas.height);
          selfieContext.restore();
        } catch (imageCaptureError) {
          selfieContext.save();
          selfieContext.translate(captureCanvas.width, 0);
          selfieContext.scale(-1, 1);
          selfieContext.drawImage(selfieVideo, 0, 0, captureCanvas.width, captureCanvas.height);
          selfieContext.restore();
        }
      } else {
        selfieContext.save();
        selfieContext.translate(captureCanvas.width, 0);
        selfieContext.scale(-1, 1);
        selfieContext.drawImage(selfieVideo, 0, 0, captureCanvas.width, captureCanvas.height);
        selfieContext.restore();
      }

      const dataUrl = captureCanvas.toDataURL('image/png');
      selfieCanvas.width = captureCanvas.width;
      selfieCanvas.height = captureCanvas.height;
      const storageContext = selfieCanvas.getContext('2d');
      if (!storageContext) {
        throw new Error('Le canvas de stockage est indisponible.');
      }

      storageContext.drawImage(captureCanvas, 0, 0);

      selfieField.value = dataUrl;
      selfiePreview.src = dataUrl;
      selfiePreview.classList.remove('d-none');
      selfiePreviewEmpty?.classList.add('d-none');
      selfieStageCapture.src = dataUrl;
      selfieStageCapture.classList.remove('d-none');
      selfieVideo.classList.add('d-none');
      selfieVideo.classList.add('ft-selfie-stage__video--captured');
      window.setTimeout(() => {
        selfieVideo.classList.remove('ft-selfie-stage__video--captured');
      }, 280);
      selfieStatus.textContent = 'Selfie KYC capture avec succes. L image figee est maintenant enregistree dans le formulaire.';
    } catch (error) {
      const message = error instanceof Error && error.message ? error.message : 'Erreur de capture inconnue.';
      selfieStatus.textContent = `La capture a echoue : ${message}`;
    }
  };

  const resetSelfieReference = () => {
    if (!selfieField) {
      selfieStatus.textContent = 'Le champ de stockage du selfie est introuvable sur la page.';
      return;
    }

    selfieField.value = '';
    selfiePreview.src = '';
    selfiePreview.classList.add('d-none');
    selfiePreviewEmpty?.classList.remove('d-none');
    selfieStageCapture?.classList.add('d-none');
    selfieStageCapture?.setAttribute('src', '');
    selfieVideo.classList.remove('d-none');
    selfieStatus.textContent = 'Aucun selfie capture pour le moment.';
  };

  startSelfieCaptureBtn?.addEventListener('click', () => {
    startSelfieCamera();
  });

  captureSelfieReferenceBtn?.addEventListener('click', async () => {
    await captureSelfieReference();
  });

  resetSelfieReferenceBtn?.addEventListener('click', () => {
    resetSelfieReference();
  });

  window.addEventListener('beforeunload', () => {
    stopSelfieCamera();
  });

  document.getElementById('voiceGuideBtn')?.addEventListener('click', function() {
    if (!('speechSynthesis' in window)) {
      alert('La lecture vocale n’est pas prise en charge sur ce navigateur.');
      return;
    }

    window.speechSynthesis.cancel();

    const cin = document.getElementById('{{ form.cin.vars.id }}')?.value || 'non renseigné';
    const adresse = document.getElementById('{{ form.adresse.vars.id }}')?.value || 'non renseignée';
    const dateNaissance = document.getElementById('{{ form.dateNaissance.vars.id }}')?.value || 'non renseignée';
    const filesCount = fileInput?.files?.length || 0;

    const message = [
      'Formulaire K Y C FinTrust.',
      'Le numéro C I N doit contenir exactement huit chiffres.',
      'Vous pouvez déposer plusieurs images ou fichiers P D F comme pièces justificatives.',
      'Une signature manuscrite dessinée est demandée avant la soumission.',
      `C I N saisi: ${cin}.`,
      `Adresse saisie: ${adresse}.`,
      `Date de naissance saisie: ${dateNaissance}.`,
      `Nombre de fichiers sélectionnés: ${filesCount}.`
    ].join(' ');

    const utterance = new SpeechSynthesisUtterance(message);
    utterance.lang = 'fr-FR';
    utterance.rate = 0.97;
    window.speechSynthesis.speak(utterance);
  });
</script>

<style>
  .ft-signature-card {
    padding: 1rem;
    border: 1px solid #dbe7f7;
    border-radius: 1.25rem;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .ft-signature-canvas {
    width: 100%;
    height: 200px;
    border: 2px dashed #bfd4f5;
    border-radius: 1rem;
    background: #fff;
    touch-action: none;
    cursor: crosshair;
  }

  .ft-voice-helper {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    border: 1px solid #dbe7f7;
    background: linear-gradient(135deg, #f8fbff, #eef5ff);
  }

  .ft-voice-helper-icon {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #dbeafe, #bfdbfe);
    color: #1d4ed8;
    flex-shrink: 0;
  }

  .ft-captcha-card {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    border: 1px solid #dbe7f7;
    background: linear-gradient(135deg, #f8fbff, #eef5ff);
  }

  .ft-captcha-checkbox {
    display: flex;
    align-items: center;
    gap: .85rem;
    padding: .9rem .95rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px dashed #bfd4f5;
    cursor: pointer;
  }

  .ft-captcha-checkbox input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ft-captcha-box {
    width: 28px;
    height: 28px;
    border-radius: .6rem;
    border: 1.5px solid #93c5fd;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: transparent;
    transition: all .2s ease;
    flex-shrink: 0;
  }

  .ft-captcha-label {
    color: #123c8d;
    font-weight: 700;
  }

  .ft-captcha-checkbox input:checked + .ft-captcha-box {
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #fff;
    border-color: transparent;
  }

  .ft-selfie-card {
    padding: 1.35rem;
    border-radius: 1.6rem;
    border: 1px solid #dbe7f7;
    background:
      radial-gradient(circle at top right, rgba(96, 165, 250, .16), transparent 26%),
      linear-gradient(135deg, #f8fbff, #eef5ff);
    box-shadow: 0 18px 40px rgba(15, 23, 42, .05);
  }

  .ft-selfie-card__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: .42rem .8rem;
    border-radius: 999px;
    background: #ffffff;
    color: #1d4ed8;
    font-size: .76rem;
    font-weight: 700;
    margin-bottom: .7rem;
  }

  .ft-selfie-card__title {
    color: #102a56;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .ft-selfie-stage {
    position: relative;
    overflow: hidden;
    min-height: 330px;
    border-radius: 1.5rem;
    border: 1px solid rgba(59, 130, 246, .14);
    background: linear-gradient(180deg, #eff6ff, #f8fbff);
  }

  .ft-selfie-stage__video,
  .ft-selfie-stage__capture,
  .ft-selfie-stage__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ft-selfie-stage__video {
    object-fit: cover;
    transform: scaleX(-1);
    transition: filter .18s ease, transform .18s ease;
  }

  .ft-selfie-stage__capture {
    object-fit: cover;
    transform: scaleX(-1);
  }

  .ft-selfie-stage__video--captured {
    filter: brightness(1.12) saturate(1.05);
  }

  .ft-selfie-stage__placeholder {
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1.4rem;
    color: #567293;
    background: linear-gradient(180deg, rgba(248,251,255,.94), rgba(239,246,255,.94));
  }

  .ft-selfie-stage__icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 1rem;
    border-radius: 1.4rem;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.92);
    color: #1d4ed8;
    font-size: 1.5rem;
    box-shadow: 0 16px 36px rgba(37, 99, 235, .12);
  }

  .ft-selfie-stage__frame {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .ft-selfie-stage__corners {
    width: min(68%, 320px);
    height: min(76%, 235px);
    border-radius: 1.8rem;
    border: 1.5px solid rgba(59, 130, 246, .26);
  }

  .ft-selfie-stage__scan {
    position: absolute;
    width: 56%;
    height: 2px;
    background: linear-gradient(90deg, rgba(59,130,246,0), rgba(96,165,250,.98), rgba(59,130,246,0));
    box-shadow: 0 0 18px rgba(96, 165, 250, .45);
    animation: ftSelfieScan 2.7s ease-in-out infinite;
  }

  .ft-selfie-status {
    margin-top: .85rem;
    padding: .82rem 1rem;
    border-radius: 1rem;
    background: rgba(255,255,255,.88);
    border: 1px solid rgba(191, 219, 254, .9);
    color: #194287;
    font-weight: 600;
  }

  .ft-selfie-preview-card {
    height: 100%;
    padding: 1rem;
    border-radius: 1.4rem;
    border: 1px solid #dbe7f7;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
  }

  .ft-selfie-preview-card__label {
    color: #40608f;
    font-size: .8rem;
    font-weight: 700;
    margin-bottom: .8rem;
  }

  .ft-selfie-preview-card__image {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 1.1rem;
    border: 1px solid rgba(21, 96, 189, .12);
  }

  .ft-selfie-preview-card__empty {
    min-height: 260px;
    border-radius: 1.1rem;
    border: 1px dashed #bfd4f5;
    background: #f8fbff;
    display: grid;
    place-items: center;
    text-align: center;
    gap: .5rem;
    color: #6b87a6;
    padding: 1rem;
  }

  .ft-selfie-preview-card__empty i {
    font-size: 1.5rem;
    color: #3b82f6;
  }

  @keyframes ftSelfieScan {
    0%, 100% { transform: translateY(-74px); opacity: .68; }
    50% { transform: translateY(74px); opacity: 1; }
  }
</style>
{% endblock %}
