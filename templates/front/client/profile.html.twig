{% extends 'front/front.html.twig' %}
{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="ft-app-page">
  <div class="container-fluid px-4 py-4" style="max-width:1100px">
    <div class="d-flex align-items-center gap-3 mb-4 ft-profile-page-intro">
      <div class="ft-page-icon-lg ft-profile-page-icon"><i class="bi bi-person-circle"></i></div>
      <div>
        <h1 class="ft-page-title mb-0">Mon profil</h1>
        <p class="text-muted mb-0 small">Gerez vos informations personnelles et votre profil intelligent FinTrust.</p>
      </div>
    </div>

    <section class="ft-profile-hero mb-4">
      <div class="ft-profile-hero-orb ft-profile-hero-orb-one"></div>
      <div class="ft-profile-hero-orb ft-profile-hero-orb-two"></div>
      <div class="ft-profile-hero-particles" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="ft-profile-hero-main">
        <div class="ft-profile-hero-identity">
          <div>
            <h2 class="ft-profile-hero-title">{{ user.fullName }}</h2>
            <p class="ft-profile-hero-text mb-0">{{ intelligenceProfile.generatedSummary }}</p>
          </div>
        </div>
      </div>
      <div class="ft-profile-hero-summary">
        <div class="ft-profile-trust-ring-card">
          <div class="ft-profile-ring" style="--ft-ring-value: {{ intelligenceProfile.trustScore }};">
            <div class="ft-profile-ring-inner">
              <span>Trust</span>
              <strong>{{ intelligenceProfile.trustScore }}</strong>
              <small>/100</small>
            </div>
          </div>
          <div class="ft-profile-ring-caption">
            <strong>Indice premium FinTrust</strong>
            <span>Evaluation transversale du profil, du risque et de la stabilite recente.</span>
          </div>
        </div>
        <div class="ft-profile-hero-note">
          <strong>Lecture rapide</strong>
          <span>{{ dropoffRisk.topSignals[0] ?? 'Votre profil reste coherent avec un parcours bancaire stable et bien securise.' }}</span>
        </div>
      </div>
    </section>

    <section class="ft-profile-kpi-strip mb-4">
      <div class="ft-profile-kpi-card">
        <div class="ft-profile-kpi-icon"><i class="bi bi-shield-lock"></i></div>
        <span>Score de confiance</span>
        <strong>{{ intelligenceProfile.trustScore }}/100</strong>
      </div>
      <div class="ft-profile-kpi-card">
        <div class="ft-profile-kpi-icon"><i class="bi bi-bar-chart-line"></i></div>
        <span>Activite</span>
        <strong>{{ intelligenceProfile.activityStatus }}</strong>
      </div>
      <div class="ft-profile-kpi-card">
        <div class="ft-profile-kpi-icon"><i class="bi bi-patch-check"></i></div>
        <span>KYC</span>
        <strong>{{ user.kycStatus }}</strong>
      </div>
      <div class="ft-profile-kpi-card">
        <div class="ft-profile-kpi-icon"><i class="bi bi-calendar3"></i></div>
        <span>Membre depuis</span>
        <strong>{{ user.createdAt|date('d/m/Y') }}</strong>
      </div>
    </section>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="ft-app-card ft-profile-glass-card">
          <div class="ft-app-card-header">
            <i class="bi bi-pencil-square me-2 text-primary"></i>Informations personnelles
          </div>
          <div class="ft-app-card-body">
            {{ form_start(form, {attr: {novalidate: 'novalidate', id: 'profileForm'}}) }}
              {{ form_errors(form) }}

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  {{ form_label(form.nom, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                  {{ form_widget(form.nom, {attr: {class: 'form-control ft-input'}}) }}
                  {% if form.nom.vars.errors|length > 0 %}
                    <div class="text-danger small mt-1">{{ form_errors(form.nom) }}</div>
                  {% endif %}
                </div>
                <div class="col-md-6">
                  {{ form_label(form.prenom, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                  {{ form_widget(form.prenom, {attr: {class: 'form-control ft-input'}}) }}
                  {% if form.prenom.vars.errors|length > 0 %}
                    <div class="text-danger small mt-1">{{ form_errors(form.prenom) }}</div>
                  {% endif %}
                </div>
              </div>

              <div class="mb-3">
                {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.email, {attr: {class: 'form-control ft-input'}}) }}
                {% if form.email.vars.errors|length > 0 %}
                  <div class="text-danger small mt-1">{{ form_errors(form.email) }}</div>
                {% endif %}
              </div>

              <div class="mb-4">
                {{ form_label(form.numTel, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.numTel, {attr: {class: 'form-control ft-input', placeholder: '+216 XX XXX XXX'}}) }}
                {% if form.numTel.vars.errors|length > 0 %}
                  <div class="text-danger small mt-1">{{ form_errors(form.numTel) }}</div>
                {% endif %}
              </div>

              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  {{ form_label(form.preferredLanguage, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                  {{ form_widget(form.preferredLanguage, {attr: {class: 'form-select ft-input'}}) }}
                </div>
                <div class="col-md-6">
                  {{ form_label(form.themeMode, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                  {{ form_widget(form.themeMode, {attr: {class: 'form-select ft-input'}}) }}
                </div>
              </div>

              <button type="submit" class="btn ft-btn-primary">
                <i class="bi bi-check-lg me-2"></i>Enregistrer les modifications
              </button>
            {{ form_end(form) }}
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="ft-app-card mb-4 ft-profile-glass-card">
          <div class="ft-app-card-header">
            <i class="bi bi-info-circle me-2 text-primary"></i>Informations du compte
          </div>
          <div class="ft-app-card-body p-0">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Role</span>
                <span class="badge ft-badge-blue">{{ user.role }}</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Statut</span>
                {% if user.status == 'ACTIF' %}<span class="badge ft-badge-success">Actif</span>
                {% elseif user.status == 'EN_ATTENTE' %}<span class="badge ft-badge-warning">En attente</span>
                {% else %}<span class="badge ft-badge-danger">Suspendu</span>{% endif %}
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">KYC</span>
                {% if user.kycStatus == 'APPROUVE' %}<span class="badge ft-badge-success">Approuve</span>
                {% elseif user.kycStatus == 'EN_ATTENTE' %}<span class="badge ft-badge-warning">En attente</span>
                {% elseif user.kycStatus == 'REFUSE' %}<span class="badge ft-badge-danger">Refuse</span>
                {% else %}<span class="badge ft-badge-neutral">Non soumis</span>{% endif %}
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Membre depuis</span>
                <span class="small fw-semibold">{{ user.createdAt|date('d/m/Y') }}</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="ft-app-card mb-4 ft-profile-glass-card">
          <div class="ft-app-card-header">
            <i class="bi bi-sliders me-2 text-primary"></i>Preferences et profil intelligent
          </div>
          <div class="ft-app-card-body p-0">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Langue</span>
                <span class="badge ft-badge-blue">{{ user.preferredLanguage|upper }}</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Mode</span>
                <span class="badge ft-badge-neutral">{{ user.themeMode == 'dark' ? 'Sombre' : 'Clair' }}</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Frequence transactions</span>
                <span class="small fw-semibold">{{ user.transactionFrequency|number_format(2, ',', ' ') }}/jour</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Montant moyen</span>
                <span class="small fw-semibold">{{ user.averageTransactionAmount|number_format(2, ',', ' ') }} TND</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Score de risque</span>
                <span class="badge {{ user.riskLevel in ['HIGH', 'CRITICAL'] ? 'ft-badge-danger' : (user.riskLevel == 'MEDIUM' ? 'ft-badge-warning' : 'ft-badge-success') }}">{{ user.riskScore|number_format(1, ',', ' ') }}/100 · {{ user.riskLevel }}</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">Fraud score</span>
                <span class="badge {{ user.fraudScore >= 70 ? 'ft-badge-danger' : (user.fraudScore >= 35 ? 'ft-badge-warning' : 'ft-badge-blue') }}">{{ user.fraudScore|number_format(1, ',', ' ') }}/100</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mt-1">
      <div class="col-lg-6">
        <div class="ft-app-card text-center ft-profile-glass-card ft-profile-qr-card h-100">
          <div class="ft-app-card-header">
            <i class="bi bi-qr-code me-2 text-primary"></i>Mon QR Code
          </div>
          <div class="ft-app-card-body">
            {% if qrUrl %}
              <div class="ft-profile-qr-kicker">Acces intelligent et partage securise</div>
              <div class="ft-profile-qr-frame">
                <div class="ft-profile-qr-scan"><i class="bi bi-upc-scan"></i></div>
                <div class="ft-profile-qr-scanline"></div>
                <img src="{{ qrUrl }}" alt="QR Code {{ user.fullName }}" class="img-fluid rounded border bg-white p-2" style="max-width:240px"/>
              </div>
              <p class="text-muted small mt-3 mb-2">Scannez pour voir votre profil public</p>
              {% if publicProfileUrl %}
                <a href="{{ publicProfileUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-box-arrow-up-right me-1"></i>Ouvrir le profil sur cet appareil
                </a>
                <p class="text-muted small mt-2 mb-0 text-break">{{ publicProfileUrl }}</p>
              {% endif %}
              {% if qrNeedsPublicUrl %}
                <div class="alert alert-warning small mt-3 mb-0 text-start">
                  Le QR pointe actuellement vers une adresse locale. Pour le scanner depuis votre telephone,
                  remplacez `FINTRUST_PUBLIC_URL` par l'URL publique ou l'adresse IP de votre machine.
                </div>
              {% endif %}
            {% else %}
              <div class="text-muted py-3">
                <i class="bi bi-qr-code fs-2 d-block mb-2"></i>Non disponible
              </div>
            {% endif %}
          </div>
        </div>

      </div>

      <div class="col-lg-6">
        <div class="ft-app-card ft-profile-deactivation-card ft-profile-glass-card h-100">
          <div class="ft-app-card-header">
            <i class="bi bi-shield-lock me-2 text-primary"></i>Controle de desactivation du compte
          </div>
          <div class="ft-app-card-body">
            <div class="ft-profile-deactivation-hero">
              <div>
                <div class="ft-profile-deactivation-kicker">Analyse de retention FinTrust</div>
                <h3 class="ft-profile-deactivation-title">Demander une desactivation revue par l administration</h3>
                <p class="ft-profile-deactivation-text mb-0">
                  FinTrust analyse vos signaux d engagement avant toute fermeture et exige une justification detaillee pour garantir un traitement serieux, securise et traçable.
                </p>
                <div class="ft-profile-deactivation-badges">
                  <span><i class="bi bi-shield-check"></i>Securite 2FA FinTrust</span>
                  <span><i class="bi bi-person-gear"></i>Validation manuelle admin</span>
                </div>
              </div>
              <div class="ft-profile-deactivation-score">
                <span>Risque d abandon</span>
                <strong>{{ dropoffRisk.dropoffRiskScore }}/100</strong>
                <small>{{ dropoffRisk.riskLevel }}</small>
              </div>
            </div>

            {% if deactivationRequest %}
              <div class="ft-profile-request-state mt-3">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                  <div>
                    <div class="fw-semibold text-dark">Statut actuel de votre demande</div>
                    <div class="small text-muted">Soumise le {{ deactivationRequest.submittedAt|date('d/m/Y H:i') }}</div>
                  </div>
                  <span class="badge {{ deactivationRequest.status == 'PENDING' ? 'ft-badge-warning' : (deactivationRequest.status == 'APPROVED' ? 'ft-badge-danger' : 'ft-badge-blue') }}">
                    {{ deactivationRequest.status == 'PENDING' ? 'En attente de revue' : (deactivationRequest.status == 'APPROVED' ? 'Approuvee' : 'Refusee') }}
                  </span>
                </div>
                <p class="small text-muted mt-3 mb-2">{{ deactivationRequest.reason }}</p>
                {% if deactivationRequest.adminNote %}
                  <div class="ft-soft-panel mt-2">
                    <div class="fw-semibold text-primary mb-1">Note admin</div>
                    <div class="small text-muted">{{ deactivationRequest.adminNote }}</div>
                  </div>
                {% endif %}
              </div>
            {% endif %}

            <form method="post" action="{{ path('front_profile_deactivation_request') }}" class="mt-3">
              <input type="hidden" name="_token" value="{{ csrf_token('profile_deactivation_request') }}">
              <div class="ft-profile-deactivation-steps mb-3">
                <div class="ft-profile-step"><span>1</span><strong>Motif</strong></div>
                <div class="ft-profile-step"><span>2</span><strong>Impact</strong></div>
                <div class="ft-profile-step"><span>3</span><strong>Revue admin</strong></div>
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold small">Justification de la demande</label>
                <textarea name="reason" rows="4" class="form-control ft-input" placeholder="Expliquez pourquoi vous souhaitez desactiver votre compte FinTrust, les blocages rencontres ou votre besoin actuel." {% if deactivationRequest and deactivationRequest.status == 'PENDING' %}disabled{% endif %}></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold small">Impact attendu ou contexte complementaire</label>
                <textarea name="impact_summary" rows="3" class="form-control ft-input" placeholder="Ex: compte temporairement inutilise, changement de situation, besoin de cloture complete..." {% if deactivationRequest and deactivationRequest.status == 'PENDING' %}disabled{% endif %}></textarea>
              </div>
              <div class="ft-profile-request-points mb-3">
                <div class="ft-profile-request-pill"><span>Revue admin obligatoire</span><strong>Oui</strong></div>
                <div class="ft-profile-request-pill"><span>Justification utilisateur</span><strong>Tracee</strong></div>
                <div class="ft-profile-request-pill"><span>Securite</span><strong>Renforcee</strong></div>
              </div>
              <button type="submit" class="btn ft-btn-primary w-100" {% if deactivationRequest and deactivationRequest.status == 'PENDING' %}disabled{% endif %}>
                <i class="bi bi-send-check me-2"></i>Transmettre ma demande de desactivation
              </button>
            </form>
          </div>
        </div>

      </div>

      <div class="col-lg-6">
        <div class="ft-app-card ft-profile-glass-card h-100">
          <div class="ft-app-card-header">
            <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Resume du profil
          </div>
          <div class="ft-app-card-body">
            <div class="ft-insight-grid">
              <div class="ft-insight-pill">
                <span>Derniere analyse</span>
                <strong>{{ intelligenceProfile.lastAnalyzedAt|date('d/m/Y H:i') }}</strong>
              </div>
              <div class="ft-insight-pill">
                <span>Activite</span>
                <strong>{{ intelligenceProfile.activityStatus }}</strong>
              </div>
              <div class="ft-insight-pill">
                <span>Stabilite</span>
                <strong>{{ intelligenceProfile.stability }}</strong>
              </div>
              <div class="ft-insight-pill">
                <span>KYC</span>
                <strong>{{ intelligenceProfile.lastKycStatus ?? 'Aucun depot' }}</strong>
              </div>
            </div>
            <div class="ft-soft-panel mt-3 ft-profile-ai-panel">
              <div class="fw-semibold text-primary mb-2">Signaux de vigilance</div>
              {% if intelligenceProfile.monitoringFlags is empty %}
                <div class="text-muted small">Aucun signal majeur detecte actuellement.</div>
              {% else %}
                <div class="d-flex flex-wrap gap-2">
                  {% for flag in intelligenceProfile.monitoringFlags %}
                    <span class="badge ft-badge-neutral">{{ flag }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

      </div>

      <div class="col-lg-6">
        <div class="ft-app-card ft-profile-glass-card h-100">
          <div class="ft-app-card-header">
            <i class="bi bi-shield-exclamation me-2 text-primary"></i>Profil de risque
          </div>
          <div class="ft-app-card-body">
            <div class="ft-risk-score-wrap mb-3">
              <div class="ft-risk-score-value">{{ riskProfile.globalRiskScore|number_format(1, ',', ' ') }}/100</div>
              <div class="ft-risk-score-caption">Niveau {{ riskProfile.riskLevel|lower }}</div>
            </div>
            <div class="ft-risk-bar mb-3">
              <div class="ft-risk-bar-fill ft-risk-{{ riskProfile.riskLevel|lower }}" style="width: {{ min(riskProfile.globalRiskScore, 100) }}%;"></div>
            </div>
            <div class="ft-risk-glow-stat mb-3">
              <span>Evaluation dynamique</span>
              <strong>{{ riskProfile.globalRiskScore|number_format(1, ',', ' ') }} / 100</strong>
              <small>Actualise selon vos signaux comportementaux et la coherence du compte.</small>
            </div>
            <div class="ft-soft-panel">
              <div class="fw-semibold text-primary mb-2">Facteurs clefs</div>
              <ul class="ft-list-clean mb-0">
                {% for factor in riskProfile.keyRiskFactors %}
                  <li>{{ factor }}</li>
                {% endfor %}
              </ul>
            </div>
            {% if riskProfile.alerts is not empty %}
              <div class="ft-soft-panel ft-soft-panel-warning mt-3 ft-profile-alert-panel">
                <div class="fw-semibold mb-2">Alertes</div>
                <ul class="ft-list-clean mb-0">
                  {% for alert in riskProfile.alerts %}
                    <li>{{ alert }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mt-1">
      <div class="col-lg-6">
        <div class="ft-app-card h-100 ft-profile-glass-card">
          <div class="ft-app-card-header">
            <i class="bi bi-cash-coin me-2 text-primary"></i>Comportement financier
          </div>
          <div class="ft-app-card-body">
            <div class="ft-insight-grid">
              <div class="ft-insight-pill">
                <span>Frequence</span>
                <strong>{{ financialBehavior.transactionFrequency|number_format(2, ',', ' ') }}/jour</strong>
              </div>
              <div class="ft-insight-pill">
                <span>Montant moyen</span>
                <strong>{{ financialBehavior.avgTransactionAmount|number_format(2, ',', ' ') }} TND</strong>
              </div>
              <div class="ft-insight-pill">
                <span>Tendance</span>
                <strong>{{ financialBehavior.activityTrend }}</strong>
              </div>
              <div class="ft-insight-pill">
                <span>Stabilite</span>
                <strong>{{ financialBehavior.stabilityScore }}/100</strong>
              </div>
            </div>
            <div class="ft-profile-sparkline mt-3" aria-hidden="true">
              <span style="height: 28%"></span>
              <span style="height: 44%"></span>
              <span style="height: 32%"></span>
              <span style="height: 63%"></span>
              <span style="height: 56%"></span>
              <span style="height: 78%"></span>
              <span style="height: 70%"></span>
              <span style="height: 84%"></span>
            </div>
            <div class="ft-profile-finance-panel mt-3">
              <div class="ft-profile-finance-panel-icon"><i class="bi bi-graph-up-arrow"></i></div>
              <div>
                <div class="fw-semibold text-dark mb-1">Lecture comportementale</div>
                <p class="text-muted small mb-0">{{ financialBehavior.summary }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="ft-app-card h-100 ft-profile-glass-card">
          <div class="ft-app-card-header">
            <i class="bi bi-clock-history me-2 text-primary"></i>Historique et surveillance
          </div>
          <div class="ft-app-card-body">
            <div class="ft-timeline">
              {% for item in monitoringTimeline %}
                <div class="ft-timeline-item">
                  <div class="ft-timeline-dot ft-timeline-{{ item.tone }}"></div>
                  <div>
                    <div class="fw-semibold small">{{ item.label }}</div>
                    <div class="text-muted small">{{ item.detail }}</div>
                    <div class="text-muted x-small">{{ item.date }}</div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <style>
    .ft-profile-hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
      gap: 1rem;
      padding: 1.8rem;
      border-radius: 2rem;
      background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.28), transparent 34%),
        radial-gradient(circle at 15% 15%, rgba(6, 182, 212, 0.18), transparent 22%),
        linear-gradient(135deg, rgba(30,58,138,.96) 0%, rgba(37,99,235,.94) 56%, rgba(59,130,246,.88) 100%);
      border: 1px solid rgba(255,255,255,.28);
      box-shadow: 0 24px 60px rgba(30, 58, 138, 0.22);
      backdrop-filter: blur(14px);
      overflow: hidden;
    }
    .ft-profile-hero-orb {
      position: absolute;
      border-radius: 999px;
      filter: blur(8px);
      opacity: .55;
      pointer-events: none;
    }
    .ft-profile-hero-orb-one {
      width: 220px;
      height: 220px;
      top: -70px;
      right: -30px;
      background: radial-gradient(circle, rgba(255,255,255,.34), rgba(255,255,255,0));
    }
    .ft-profile-hero-orb-two {
      width: 180px;
      height: 180px;
      left: -40px;
      bottom: -60px;
      background: radial-gradient(circle, rgba(6,182,212,.24), rgba(6,182,212,0));
    }
    .ft-profile-hero-particles span {
      position: absolute;
