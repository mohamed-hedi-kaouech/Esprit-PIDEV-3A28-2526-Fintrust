{% extends 'front/front.html.twig' %}
{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="ft-app-page">
  <div class="container-fluid px-4 py-4">

    <section class="ft-dash-hero mb-4">
      <div class="ft-dash-hero-copy">
        <div class="ft-dash-hero-kicker">
          <i class="bi bi-stars"></i>
          Espace client intelligent
        </div>
        <h1 class="ft-dash-hero-title">
          Bonjour, <span>{{ user.prenom }}</span>
        </h1>
        <p class="ft-dash-hero-subtitle">
          {{ "now"|date("l d F Y") }} ·
          {% if user.kycStatus == 'APPROUVE' %}
            <strong class="text-success-emphasis"><i class="bi bi-patch-check-fill me-1"></i>Compte verifie</strong>
          {% else %}
            <strong class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>KYC en attente</strong>
          {% endif %}
        </p>
        <div class="ft-hero-badge-row">
          <span class="ft-royal-badge ft-royal-badge-{{ user.engagementBadgeTone }}">
            <i class="bi {{ user.engagementBadge == 'ROI FINTRUST' ? 'bi-stars' : (user.engagementBadge == 'ELITE' ? 'bi-gem' : (user.engagementBadge == 'ACTIF+' ? 'bi-lightning-charge-fill' : 'bi-award')) }}"></i>
            {{ user.engagementBadge }}
          </span>
          <span class="ft-hero-badge-note">
            {% if user.engagementBadge == 'ROI FINTRUST' %}
              Client premium a forte activite et forte valeur.
            {% elseif user.engagementBadge == 'ELITE' %}
              Tres bon niveau d'activite et usage regulier des services.
            {% elseif user.engagementBadge == 'ACTIF+' %}
              Client engage avec une activite bancaire soutenue.
            {% else %}
              Badge evolutif qui monte avec votre activite FinTrust.
            {% endif %}
          </span>
        </div>
      </div>

      <div class="ft-dash-hero-side">
        <div class="ft-theme-switcher">
          <form method="post" action="{{ path('front_theme_switch', {mode: 'light'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('switch_theme') }}">
            <button type="submit" class="ft-theme-pill {{ user.themeMode == 'light' ? 'active' : '' }}">
              <i class="bi bi-sun-fill"></i> Clair
            </button>
          </form>
          <form method="post" action="{{ path('front_theme_switch', {mode: 'dark'}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('switch_theme') }}">
            <button type="submit" class="ft-theme-pill {{ user.themeMode == 'dark' ? 'active' : '' }}">
              <i class="bi bi-moon-stars-fill"></i> Sombre
            </button>
          </form>
        </div>

        <a href="{{ path('front_profile') }}" class="btn ft-btn-outline-primary btn-sm ft-dash-profile-btn">
          <i class="bi bi-person-gear me-1"></i>Profile
        </a>
      </div>
    </section>

    {% if not user.kycApproved %}
      <div class="ft-kyc-banner mb-4">
        <div class="ft-kyc-banner-icon"><i class="bi bi-shield-exclamation"></i></div>
        <div class="flex-grow-1">
          <div class="fw-semibold">Verification d'identite requise</div>
          <div class="small mt-1">
            {% if user.kycStatus == 'EN_ATTENTE' %}
              Votre dossier KYC est <strong>en cours d'examen</strong> par notre equipe. Vous serez notifie des validation.
            {% elseif user.kycStatus == 'REFUSE' %}
              Votre dossier a ete <strong>refuse</strong>. Soumettez un nouveau dossier avec des documents corrects.
            {% else %}
              Deposez vos documents pour debloquer l'acces complet a la plateforme.
            {% endif %}
          </div>
        </div>
        <a href="{{ user.kycStatus == 'EN_ATTENTE' ? path('front_kyc_status') : path('front_kyc_submit') }}" class="btn ft-btn-primary btn-sm text-nowrap">
          {% if user.kycStatus == 'EN_ATTENTE' %}
            <i class="bi bi-clock me-1"></i>Voir le statut
          {% else %}
            <i class="bi bi-upload me-1"></i>Deposer mon KYC
          {% endif %}
        </a>
      </div>
    {% endif %}

    {% if user.riskLevel in ['HIGH', 'CRITICAL'] %}
      <div class="ft-kyc-banner mb-4 {{ user.riskLevel == 'CRITICAL' ? 'ft-risk-banner-critical' : 'ft-risk-banner-high' }}">
        <div class="ft-kyc-banner-icon"><i class="bi bi-radar"></i></div>
        <div class="flex-grow-1">
          <div class="fw-semibold">Surveillance renforcée du compte</div>
          <div class="small mt-1">
            Risk level: <strong>{{ user.riskLevel }}</strong> · Fraud score: <strong>{{ user.fraudScore|number_format(1, ',', ' ') }}/100</strong>.
            {% if user.riskLevel == 'CRITICAL' %}
              Certaines actions sensibles sont temporairement restreintes pour protéger votre compte.
            {% else %}
              Une vigilance supplémentaire est activée sur vos opérations sensibles.
            {% endif %}
          </div>
        </div>
        <a href="{{ path('front_notifications') }}" class="btn ft-btn-primary btn-sm text-nowrap">
          <i class="bi bi-bell me-1"></i>Voir les alertes
        </a>
      </div>
    {% endif %}

    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="ft-dash-card ft-dash-card-accent ft-dash-card-status">
          <div class="ft-dash-card-icon ft-dash-icon-blue"><i class="bi bi-person-check-fill"></i></div>
          <div class="ft-dash-card-label">Statut compte</div>
          <div class="ft-dash-card-value">
            {% if user.status == 'ACTIF' %}<span class="badge ft-badge-success">Actif</span>
            {% elseif user.status == 'EN_ATTENTE' %}<span class="badge ft-badge-warning">En attente</span>
            {% else %}<span class="badge ft-badge-danger">Suspendu</span>{% endif %}
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ft-dash-card ft-dash-card-accent ft-dash-card-kyc">
          <div class="ft-dash-card-icon ft-dash-icon-green" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3.2L18.5 5.7V11.4C18.5 15.48 15.83 19.27 12 20.8C8.17 19.27 5.5 15.48 5.5 11.4V5.7L12 3.2Z" fill="currentColor" fill-opacity="0.16"/>
              <path d="M12 3.2L18.5 5.7V11.4C18.5 15.48 15.83 19.27 12 20.8C8.17 19.27 5.5 15.48 5.5 11.4V5.7L12 3.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M9.4 11.7L11.25 13.55L14.85 9.95" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="ft-dash-card-label">Statut KYC</div>
          <div class="ft-dash-card-value">
            {% if user.kycStatus == 'APPROUVE' %}<span class="badge ft-badge-success">Approuve</span>
            {% elseif user.kycStatus == 'EN_ATTENTE' %}<span class="badge ft-badge-warning">En attente</span>
            {% elseif user.kycStatus == 'REFUSE' %}<span class="badge ft-badge-danger">Refuse</span>
            {% else %}<span class="badge ft-badge-neutral">Non soumis</span>{% endif %}
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ft-dash-card ft-dash-card-accent ft-dash-card-member">
          <div class="ft-dash-card-icon ft-dash-icon-purple"><i class="bi bi-calendar-check-fill"></i></div>
          <div class="ft-dash-card-label">Membre depuis</div>
          <div class="ft-dash-card-value fw-semibold small">{{ user.createdAt|date('d/m/Y') }}</div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="ft-dash-card ft-dash-card-accent ft-dash-card-role">
          <div class="ft-dash-card-icon ft-dash-icon-orange"><i class="bi bi-award-fill"></i></div>
          <div class="ft-dash-card-label">Role</div>
          <div class="ft-dash-card-value"><span class="badge ft-badge-blue">{{ user.role }}</span></div>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6 col-xl-3">
        <div class="ft-dash-card ft-dash-card-soft">
          <div class="ft-dash-card-icon ft-dash-icon-blue"><i class="bi bi-translate"></i></div>
          <div class="ft-dash-card-label">Langue</div>
          <div class="ft-dash-card-value">{{ user.preferredLanguage|upper }}</div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ft-dash-card ft-dash-card-soft">
          <div class="ft-dash-card-icon ft-dash-icon-purple"><i class="bi bi-circle-half"></i></div>
          <div class="ft-dash-card-label">Theme</div>
          <div class="ft-dash-card-value">{{ user.themeMode == 'dark' ? 'Sombre' : 'Clair' }}</div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ft-dash-card ft-dash-card-soft">
          <div class="ft-dash-card-icon ft-dash-icon-green"><i class="bi bi-arrow-left-right"></i></div>
          <div class="ft-dash-card-label">Frequence transactions</div>
          <div class="ft-dash-card-value">{{ user.transactionFrequency|number_format(2, ',', ' ') }}/jour</div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ft-dash-card ft-dash-card-soft">
          <div class="ft-dash-card-icon ft-dash-icon-orange"><i class="bi bi-activity"></i></div>
          <div class="ft-dash-card-label">Score de risque</div>
          <div class="ft-dash-card-value">{{ user.riskScore|number_format(1, ',', ' ') }}/100 · {{ user.riskLevel }}</div>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ft-dash-card ft-dash-card-soft">
          <div class="ft-dash-card-icon ft-dash-icon-red"><i class="bi bi-shield-fill-exclamation"></i></div>
          <div class="ft-dash-card-label">Fraud score</div>
          <div class="ft-dash-card-value">{{ user.fraudScore|number_format(1, ',', ' ') }}/100</div>
        </div>
      </div>
    </div>

    <div class="ft-app-card mb-4 ft-premium-card ft-news-widget-card">
      <div class="ft-app-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Actualites financieres</span>
        <a href="{{ path('front_news') }}" class="btn ft-btn-outline-primary btn-sm">
          Voir plus
        </a>
      </div>
      <div class="ft-app-card-body">
        <div class="ft-news-widget-hero">
          <div>
            <span class="ft-news-widget-kicker">FinTrust Market News</span>
            <h3 class="ft-news-widget-title">Veille marches & banques</h3>
            <p class="mb-0 text-muted">Une selection premium d actualites financieres pour enrichir votre experience client, avec un angle informatif et une lecture rapide.</p>
          </div>
          <div class="ft-news-widget-note">
            Les actualites affichees sont fournies a titre informatif.
          </div>
        </div>

        <div class="row g-3 mt-1">
          {% for article in newsFeed %}
            <div class="col-lg-4">
              <article class="ft-news-mini-card h-100">
                <div class="ft-news-mini-topline">
                  <span class="badge {{ article.importanceLevel in ['HIGH', 'BREAKING'] ? 'ft-badge-warning' : 'ft-badge-blue' }}">{{ article.category }}</span>
                  <span class="ft-news-mini-date">{{ article.publishedAt|date('d/m/Y H:i') }}</span>
                </div>
                <h4>{{ article.title }}</h4>
                <p>{{ article.summary }}</p>
                <div class="ft-news-mini-meta">
                  <span>{{ article.sourceName }}</span>
                  <a href="{{ path('front_news', {category: article.category}) }}">Explorer</a>
                </div>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="ft-app-card mb-4 ft-premium-card ft-market-widget-card">
      <div class="ft-app-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-bar-chart-line me-2 text-primary"></i>Marches & watchlist</span>
        <a href="{{ path('front_markets') }}" class="btn ft-btn-outline-primary btn-sm">Voir plus</a>
      </div>
      <div class="ft-app-card-body">
        <div class="row g-3">
          <div class="col-xl-4">
            <div class="ft-market-overview-card">
              <div class="ft-market-overview-kicker">Vue d ensemble economique</div>
              <h3>{{ economyOverview.summary }}</h3>
              <div class="ft-market-overview-grid">
                <div class="ft-market-overview-item">
                  <span>Inflation</span>
                  <strong>{{ economyOverview.inflationRate|number_format(1, ',', ' ') }}%</strong>
                </div>
                <div class="ft-market-overview-item">
                  <span>Taux</span>
                  <strong>{{ economyOverview.interestRate|number_format(2, ',', ' ') }}%</strong>
                </div>
                <div class="ft-market-overview-item">
                  <span>Devise</span>
                  <strong>{{ economyOverview.primaryCurrency }}</strong>
                </div>
              </div>
            </div>
          </div>
          <div class="col-xl-8">
            <div class="row g-3">
              {% for item in watchlistHighlights %}
                <div class="col-md-4">
                  <div class="ft-market-mini-card">
                    <div class="ft-market-mini-top">
                      <span class="badge ft-badge-neutral">{{ item.category }}</span>
                      <span class="ft-market-mini-symbol">{{ item.symbol }}</span>
                    </div>
                    <strong>{{ item.name }}</strong>
                    <div class="ft-market-mini-value">{{ item.currentValue|number_format(2, ',', ' ') }}</div>
                    <div class="ft-market-mini-trend {{ item.trend == 'UP' ? 'up' : (item.trend == 'DOWN' ? 'down' : 'stable') }}">
                      {{ item.changePercent >= 0 ? '+' : '' }}{{ item.changePercent|number_format(2, ',', ' ') }}%
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

      <div class="ft-app-card mb-4 ft-premium-card ft-relax-dashboard-card" data-ft-dash-relax>
        <div class="ft-app-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span><i class="bi bi-stars me-2 text-primary"></i>Espace detente</span>
          {% if user.kycStatus == 'EN_ATTENTE' %}
            <span class="badge ft-badge-warning">Disponible pendant l'analyse de votre dossier</span>
          {% else %}
            <span class="badge ft-badge-blue">Pause premium</span>
          {% endif %}
        </div>
        <div class="ft-app-card-body">
          <div class="ft-relax-dash-hero">
            <div>
              <div class="ft-relax-dash-kicker">Moment detente</div>
              <h3 class="ft-relax-dash-title">Profitez d'une pause legere avec quelques jeux elegants</h3>
              <p class="mb-0 text-muted">
                {% if user.kycStatus == 'EN_ATTENTE' %}
                  Votre verification est en cours. En attendant, decouvrez quelques activites discretes integrees naturellement a votre experience FinTrust.
                {% else %}
                  Quelques activites discretes sont disponibles pour enrichir votre dashboard avec une touche plus premium et plus agreable.
                {% endif %}
              </p>
            </div>
            <div class="ft-relax-dash-hero-side">
              <div class="ft-relax-dash-mini-note">
                <span>Acces</span>
                <strong>{{ user.kycStatus == 'EN_ATTENTE' ? 'Conseille pendant l attente KYC' : 'Disponible a tout moment' }}</strong>
              </div>
              <a href="{{ path('front_kyc_status') }}" class="btn ft-btn-outline-primary btn-sm">
                <i class="bi bi-arrow-up-right-circle me-2"></i>Voir le centre KYC
              </a>
            </div>
          </div>

          <div class="row g-3 mt-1 mb-3">
            <div class="col-md-4">
              <button type="button" class="ft-relax-mini-card" data-ft-dash-game-open="chess">
                <span class="ft-relax-mini-icon blue"><i class="bi bi-grid-3x3-gap"></i></span>
                <div class="ft-relax-mini-topline">
                  <strong>Jeu d'echecs</strong>
                  <span class="ft-relax-mini-badge">Partie rapide</span>
                </div>
                <small>Une pause strategique dans un cadre elegant.</small>
                <span class="ft-relax-mini-open">Ouvrir <i class="bi bi-arrow-right-short"></i></span>
              </button>
            </div>
            <div class="col-md-4">
              <button type="button" class="ft-relax-mini-card" data-ft-dash-game-open="memory">
                <span class="ft-relax-mini-icon violet"><i class="bi bi-app-indicator"></i></span>
                <div class="ft-relax-mini-topline">
                  <strong>Jeu de concentration</strong>
                  <span class="ft-relax-mini-badge">2 a 3 min</span>
                </div>
                <small>Testez votre memoire avec une experience legere et fluide.</small>
                <span class="ft-relax-mini-open">Ouvrir <i class="bi bi-arrow-right-short"></i></span>
              </button>
            </div>
            <div class="col-md-4">
              <button type="button" class="ft-relax-mini-card" data-ft-dash-game-open="jump">
                <span class="ft-relax-mini-icon green"><i class="bi bi-lightning-charge"></i></span>
                <div class="ft-relax-mini-topline">
                  <strong>Jeu de saut</strong>
                  <span class="ft-relax-mini-badge">1 a 2 min</span>
                </div>
                <small>Un mini defi simple et rythme pour patienter agreablement.</small>
                <span class="ft-relax-mini-open">Ouvrir <i class="bi bi-arrow-right-short"></i></span>
              </button>
            </div>
          </div>

          <div class="ft-relax-dash-console">
            <div class="ft-relax-dash-console-head">
              <div>
                <div class="ft-relax-dash-console-kicker">Activite en cours</div>
                <h4 class="mb-1" data-ft-dash-game-title>Selectionnez un jeu</h4>
                <p class="mb-0 text-muted" data-ft-dash-game-desc>Les activites restent discretionnaires, bien espacees et coherentes avec l'experience bancaire FinTrust.</p>
              </div>
              <button type="button" class="btn ft-btn-soft btn-sm" data-ft-dash-game-reset disabled>
                <i class="bi bi-arrow-clockwise me-1"></i>Relancer
              </button>
            </div>

            <div class="ft-relax-dash-panel is-active" data-ft-dash-panel="placeholder">
              <div class="ft-relax-dash-placeholder">
                <div class="ft-relax-dash-placeholder-icon"><i class="bi bi-controller"></i></div>
                <strong>Un espace de detente integre a votre dashboard</strong>
                <p class="mb-0">Choisissez une activite ci-dessus pour commencer sans quitter votre tableau de bord FinTrust.</p>
              </div>
            </div>

            <div class="ft-relax-dash-panel" data-ft-dash-panel="chess">
              <div class="ft-relax-dash-toolbar">
                <span class="ft-game-badge" data-ft-dash-chess-selection>Aucune piece selectionnee</span>
                <span class="ft-game-badge" data-ft-dash-chess-last>Aucun mouvement</span>
              </div>
              <div class="ft-chess-board ft-chess-board-compact" data-ft-dash-chess-board></div>
            </div>

            <div class="ft-relax-dash-panel" data-ft-dash-panel="memory">
              <div class="ft-relax-dash-toolbar">
                <span class="ft-game-badge" data-ft-dash-memory-moves>0 mouvement</span>
                <span class="ft-game-badge" data-ft-dash-memory-pairs>0/6 paires</span>
              </div>
              <div class="ft-memory-grid ft-memory-grid-compact" data-ft-dash-memory-grid></div>
            </div>

            <div class="ft-relax-dash-panel" data-ft-dash-panel="jump">
              <div class="ft-relax-dash-toolbar">
                <span class="ft-game-badge" data-ft-dash-jump-score>Score 0</span>
                <span class="ft-game-badge" data-ft-dash-jump-best>Meilleur 0</span>
              </div>
              <div class="ft-jump-stage ft-jump-stage-compact" data-ft-dash-jump-stage tabindex="0" role="button" aria-label="Pause reflexe">
                <div class="ft-jump-player" data-ft-dash-jump-player></div>
                <div class="ft-jump-obstacle" data-ft-dash-jump-obstacle></div>
                <div class="ft-jump-ground"></div>
                <div class="ft-jump-hint">Cliquez ici ou appuyez sur Espace pour sauter.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    <div class="ft-app-card mb-4 ft-insight-panel">
      <div class="ft-app-card-header">
        <i class="bi bi-cpu me-2 text-primary"></i>Profil intelligent FinTrust
      </div>
      <div class="ft-app-card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <div class="ft-action-card h-100">
              <div class="ft-action-icon"><i class="bi bi-cash-coin"></i></div>
              <div>
                <div class="ft-module-title">Montant moyen</div>
                <div class="ft-module-desc">{{ user.averageTransactionAmount|number_format(2, ',', ' ') }} TND</div>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-action-card h-100">
              <div class="ft-action-icon"><i class="bi bi-diagram-3"></i></div>
              <div>
                <div class="ft-module-title">Segment automatique</div>
                <div class="ft-module-desc">{{ user.clientSegment == 'A_RISQUE' ? 'A risque' : user.clientSegment }}</div>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-action-card h-100">
              <div class="ft-action-icon"><i class="bi bi-clock-history"></i></div>
              <div>
                <div class="ft-module-title">Score evolutif</div>
                <div class="ft-module-desc">Mis a jour {{ user.behaviorUpdatedAt ? user.behaviorUpdatedAt|date('d/m/Y H:i') : 'automatiquement' }}</div>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-action-card h-100">
              <div class="ft-action-icon"><i class="bi bi-patch-check"></i></div>
              <div>
                <div class="ft-module-title">Badge de prestige</div>
                <div class="ft-module-desc">
                  <span class="ft-royal-badge ft-royal-badge-{{ user.engagementBadgeTone }}">
                    <i class="bi {{ user.engagementBadge == 'ROI FINTRUST' ? 'bi-stars' : (user.engagementBadge == 'ELITE' ? 'bi-gem' : (user.engagementBadge == 'ACTIF+' ? 'bi-lightning-charge-fill' : 'bi-award')) }}"></i>
                    {{ user.engagementBadge }}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-12 col-xl-8">
        <div class="ft-app-card ft-premium-card h-100">
          <div class="ft-app-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-wallet2 me-2 text-primary"></i>Resume financier</span>
            <span class="badge ft-badge-blue">Vue globale</span>
          </div>
          <div class="ft-app-card-body">
            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <div class="ft-finance-metric">
