{#
  LAYOUT PRINCIPAL — FRONT OFFICE
  Toutes les pages client héritent de ce layout.
  Bootstrap 5 + thème bleu FinTrust.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% block title %}FinTrust{% endblock %} — FinTrust Banking</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="{{ asset('css/fintrust-front.css') }}"/>
  <style>
    .ft-app-icon-btn-alert {
      box-shadow: 0 0 0 .18rem rgba(220, 38, 38, .12), 0 12px 24px rgba(37, 99, 235, .16);
    }
    .ft-notif-nav-badge {
      min-width: 1.15rem;
      height: 1.15rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: .66rem;
      border: 2px solid #fff;
    }
  </style>
  {% block stylesheets %}{% endblock %}
</head>
<body class="ft-front-body{% if app.user and app.user.themeMode == 'dark' %} ft-theme-dark{% endif %}">

  {# ---- NAVBAR ---- #}
  {% if app.user %}
    {# Navbar connecté avec tous les modules #}
    <nav class="navbar navbar-expand-lg ft-navbar-app sticky-top">
      <div class="container-fluid px-4">

        <a class="navbar-brand ft-brand" href="{{ path('front_dashboard') }}">
          <svg viewBox="0 0 40 40" fill="none" width="32" height="32">
            <rect width="40" height="40" rx="10" fill="#1560BD"/>
            <path d="M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z" fill="white"/>
          </svg>
          <span class="ft-brand-name ms-2">FinTrust</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#appNav">
          <i class="bi bi-list fs-4"></i>
        </button>

        <div class="collapse navbar-collapse" id="appNav">
          <ul class="navbar-nav me-auto ms-3 gap-1">

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_profile' %}active{% endif %}"
                 href="{{ path('front_profile') }}">
                <i class="bi bi-person-circle me-1"></i>Profile
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if 'front_kyc' in app.request.attributes.get('_route') %}active{% endif %}"
                 href="{% if app.user.kycStatus in ['EN_ATTENTE', 'APPROUVE'] %}{{ path('front_kyc_status') }}{% else %}{{ path('front_kyc_submit') }}{% endif %}">
                <i class="bi bi-shield-check me-1"></i>KYC
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') starts with 'front_wallet_' and app.request.attributes.get('_route') not in ['front_wallet_transactions', 'front_wallet_cheques', 'front_wallet_cheque_request', 'front_wallet_assistant'] and not (app.request.attributes.get('_route') starts with 'front_wallet_international_transfer_') %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_wallet_dashboard') : path('front_kyc_status') }}">
                <i class="bi bi-wallet2 me-1"></i>Wallet
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_wallet_transactions' %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_wallet_transactions') : path('front_kyc_status') }}">
                <i class="bi bi-arrow-left-right me-1"></i>Transactions
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') starts with 'front_wallet_international_transfer_' %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_wallet_international_transfer_new') : path('front_kyc_status') }}">
                <i class="bi bi-globe-americas me-1"></i>International
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') in ['front_wallet_cheques', 'front_wallet_cheque_request'] %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_wallet_cheques') : path('front_kyc_status') }}">
                <i class="bi bi-journal-check me-1"></i>Cheques
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_wallet_assistant' %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_wallet_assistant') : path('front_kyc_status') }}">
                <i class="bi bi-stars me-1"></i>Assistant
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'product' %}active{% endif %}" href="{{ app.user.kycApproved ? path('Client_product_list') : path('front_kyc_status') }}">
                <i class="bi bi-box-seam me-1"></i>Product
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'product' %}active{% endif %}" href="{{ app.user.kycApproved ? path('Client_subscription_list') : path('front_kyc_status') }}">
                <i class="bi bi-box-seam me-1"></i>Product Subscriptions
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'loan' %}active{% endif %}" href="{{ app.user.kycApproved ? path('loan_my_loans', {slug: 'loan'}) : path('front_kyc_status') }}">
                <i class="bi bi-bank me-1"></i>Loan
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') starts with 'front_budget_' or (app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'budget') %}active{% endif %}" href="{{ app.user.kycApproved ? path('front_budget_home') : path('front_kyc_status') }}">
                <i class="bi bi-calculator me-1"></i>Budget
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') starts with 'front_publications_' or (app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'publications') %}active{% endif %}" href="{{ path('front_publications_index') }}">
                <i class="bi bi-newspaper me-1"></i>Publications
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_news' %}active{% endif %}" href="{{ path('front_news') }}">
                <i class="bi bi-graph-up-arrow me-1"></i>Actualites
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_markets' %}active{% endif %}" href="{{ path('front_markets') }}">
                <i class="bi bi-bar-chart-line me-1"></i>Marches
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link {% if app.request.attributes.get('_route') in ['front_relevant_news', 'front_recommended_actions', 'front_identity_consistency'] %}active{% endif %}" href="{{ path('front_recommended_actions') }}">
                <i class="bi bi-stars me-1"></i>Insights
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link ft-app-link text-danger" href="{{ path('app_logout') }}?from=client">
                <i class="bi bi-box-arrow-right me-1"></i>Log Out
              </a>
            </li>

          </ul>

          {# Droite : notifications + avatar #}
          <div class="d-flex align-items-center gap-2">

            {# Notifications #}
            {% set unreadNotifications = unread_notifications_count(app.user) %}
            <a href="{{ path('front_notifications') }}"
               class="btn ft-app-icon-btn position-relative {% if unreadNotifications > 0 %}ft-app-icon-btn-alert{% endif %} {% if app.request.attributes.get('_route') == 'front_notifications' %}active{% endif %}"
               title="{{ unreadNotifications > 0 ? unreadNotifications ~ ' notification(s) non lue(s)' : 'Notifications' }}">
              <i class="bi bi-bell"></i>
              <span id="frontNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size:.62rem">0</span>
              {% if unreadNotifications > 0 %}
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger ft-notif-nav-badge">
                  {{ unreadNotifications > 9 ? '9+' : unreadNotifications }}
                  <span class="visually-hidden">notifications non lues</span>
                </span>
              {% endif %}
            </a>

            {# Avatar + dropdown #}
            <div class="dropdown">
              <button class="btn ft-app-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <div class="ft-app-avatar">
                  {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                </div>
                <span class="d-none d-lg-inline ms-2 small fw-semibold">{{ app.user.prenom }}</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end ft-app-dropdown shadow-lg">
                <li>
                  <div class="px-3 py-2 border-bottom">
                    <div class="fw-semibold small">{{ app.user.fullName }}</div>
                    <div class="text-muted" style="font-size:.75rem">{{ app.user.email }}</div>
                    <div class="mt-2 small text-muted" data-ft-location-status>
                      Localisation exacte en cours de verification...
                    </div>
                    <button type="button" class="btn btn-link p-0 mt-1 small text-primary text-decoration-none" data-ft-confirm-location>
                      Actualiser ma localisation exacte
                    </button>
                    <div class="mt-1">
                      {% if app.user.kycStatus == 'APPROUVE' %}
                        <span class="badge ft-badge-success" style="font-size:.65rem">KYC Vérifié</span>
                      {% elseif app.user.kycStatus == 'EN_ATTENTE' %}
                        <span class="badge ft-badge-warning" style="font-size:.65rem">KYC En attente</span>
                      {% else %}
                        <span class="badge ft-badge-neutral" style="font-size:.65rem">KYC Non soumis</span>
                      {% endif %}
                    </div>
                  </div>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_profile') }}">
                    <i class="bi bi-person me-2 text-primary"></i>Profile
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{% if app.user.kycStatus in ['EN_ATTENTE', 'APPROUVE'] %}{{ path('front_kyc_status') }}{% else %}{{ path('front_kyc_submit') }}{% endif %}">
                    <i class="bi bi-shield-check me-2 text-primary"></i>KYC
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_wallet_dashboard') : path('front_kyc_status') }}">
                    <i class="bi bi-wallet2 me-2 text-primary"></i>Wallet
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_wallet_transactions') : path('front_kyc_status') }}">
                    <i class="bi bi-arrow-left-right me-2 text-primary"></i>Transactions
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_wallet_international_transfer_new') : path('front_kyc_status') }}">
                    <i class="bi bi-globe-americas me-2 text-primary"></i>International
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_wallet_cheques') : path('front_kyc_status') }}">
                    <i class="bi bi-journal-check me-2 text-primary"></i>Cheques
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_wallet_assistant') : path('front_kyc_status') }}">
                    <i class="bi bi-stars me-2 text-primary"></i>Assistant
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_module', {slug: 'product'}) : path('front_kyc_status') }}">
                    <i class="bi bi-box-seam me-2 text-primary"></i>Product
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_module', {slug: 'loan'}) : path('front_kyc_status') }}">
                    <i class="bi bi-bank me-2 text-primary"></i>Loan
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ app.user.kycApproved ? path('front_budget_home') : path('front_kyc_status') }}">
                    <i class="bi bi-calculator me-2 text-primary"></i>Budget
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_publications_index') }}">
                    <i class="bi bi-newspaper me-2 text-primary"></i>Publications
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_news') }}">
                    <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Actualites financieres
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_markets') }}">
                    <i class="bi bi-bar-chart-line me-2 text-primary"></i>Marches & economie
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_recommended_actions') }}">
                    <i class="bi bi-stars me-2 text-primary"></i>Actions recommandees
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_relevant_news') }}">
                    <i class="bi bi-lightning-charge me-2 text-primary"></i>Actualites pertinentes
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="{{ path('front_identity_consistency') }}">
                    <i class="bi bi-shield-check me-2 text-primary"></i>Coherence identitaire
                  </a>
                </li>
                <li><hr class="dropdown-divider my-1"/></li>
                <li>
                  <a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}?from=client">
                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                  </a>
                </li>
              </ul>
            </div>

          </div>
        </div>
      </div>
    </nav>

  {% else %}
    {# Navbar publique (landing page, login, register) #}
    <nav class="navbar navbar-expand-lg ft-navbar sticky-top">
      <div class="container-xl">
        <a class="navbar-brand ft-brand" href="{{ path('app') }}">
          <svg viewBox="0 0 40 40" fill="none" width="32" height="32">
            <rect width="40" height="40" rx="10" fill="#1560BD"/>
            <path d="M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z" fill="white"/>
          </svg>
          <span class="ft-brand-name ms-2">FinTrust</span>
        </a>
        <div class="ms-auto d-flex gap-2">
          <a href="{{ path('app_login') }}" class="btn ft-btn-outline-primary btn-sm">Connexion</a>
          <a href="{{ path('app_register') }}" class="btn ft-btn-primary btn-sm">S'inscrire</a>
        </div>
      </div>
    </nav>
  {% endif %}

  {# ---- FLASH MESSAGES ---- #}
  {% if app.flashes|length > 0 %}
    <div class="position-fixed top-0 end-0 p-3" style="z-index:1100;margin-top:70px">
      {% for type, messages in app.flashes %}
        {% set bsType = type == 'error' ? 'danger' : type %}
        {% for message in messages %}
          <div class="toast align-items-center text-bg-{{ bsType }} border-0 show mb-2" role="alert">
            <div class="d-flex">
              <div class="toast-body fw-semibold">
                {% if type == 'success' %}<i class="bi bi-check-circle me-2"></i>
                {% elseif type == 'error' %}<i class="bi bi-x-circle me-2"></i>
                {% elseif type == 'warning' %}<i class="bi bi-exclamation-triangle me-2"></i>
                {% else %}<i class="bi bi-info-circle me-2"></i>{% endif %}
                {{ message }}
              </div>
              <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}

  {# ---- CONTENU ---- #}
  <main class="ft-main">
    {% block body %}{% endblock %}
  </main>

  {% if app.user %}
  <style>
    .ft-app-icon-btn {
      position: relative;
    }

    .ft-app-icon-badge {
      position: absolute;
      top: -0.35rem;
      right: -0.15rem;
      min-width: 1.2rem;
      height: 1.2rem;
      padding: 0 0.28rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, #ef4444, #f97316);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      box-shadow: 0 10px 18px rgba(239, 68, 68, 0.28);
      border: 2px solid #fff;
    }
  </style>
  {% endif %}

  {# ---- FOOTER (uniquement si non connecté) ---- #}
  {% if not app.user %}
  <footer class="ft-footer mt-auto">
    <div class="container-xl">
      <div class="row align-items-center py-3">
        <div class="col-md-6">
          <p class="text-muted small mb-0">© {{ "now"|date("Y") }} FinTrust. Tous droits réservés.</p>
        </div>
        <div class="col-md-6 text-md-end">
          <a href="#" class="text-muted small me-3">Confidentialité</a>
          <a href="#" class="text-muted small">Contact</a>
        </div>
      </div>
    </div>
  </footer>
  {% endif %}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.querySelectorAll('.toast').forEach(function(el) {
      new bootstrap.Toast(el, { delay: 5000 }).show();
    });

    const frontNotificationBadge = document.getElementById('frontNotificationBadge');
    if (frontNotificationBadge) {
      fetch('/api/notifications/me/unread-count')
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          const count = Number(payload?.unread_count || 0);
          if (count > 0) {
            frontNotificationBadge.textContent = count > 99 ? '99+' : String(count);
            frontNotificationBadge.classList.remove('d-none');
          }
        })
        .catch(() => {});
    }
  </script>
  {% if app.user %}
    <script>
      (() => {
        const endpoint = '{{ path('front_security_browser_location') }}';
        const statusEndpoint = '{{ path('front_security_browser_location_status') }}';
        const csrfToken = '{{ csrf_token('browser_location') }}';

        function setLocationStatus(message, state = 'info') {
          document.querySelectorAll('[data-ft-location-status]').forEach((status) => {
            status.textContent = message;
            status.dataset.state = state;
            status.classList.toggle('text-danger', state === 'error');
            status.classList.toggle('text-success', state === 'success');
            status.classList.toggle('text-muted', state !== 'error' && state !== 'success');
          });
        }

        function setLocationButtons(disabled) {
          document.querySelectorAll('[data-ft-confirm-location]').forEach((button) => {
            button.disabled = disabled;
            button.classList.toggle('disabled', disabled);
          });
        }

        function sendBrowserLocation(force = false) {
          if (!('geolocation' in navigator)) {
            setLocationStatus('Geolocalisation navigateur non disponible sur cet appareil.', 'error');
            if (force) {
              alert('La geolocalisation navigateur n est pas disponible sur cet appareil.');
            }
            return;
          }

          if (force) {
            setLocationStatus('Recherche de votre position precise...', 'loading');
            setLocationButtons(true);
          }

          navigator.geolocation.getCurrentPosition(
            (position) => {
              fetch(endpoint, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': csrfToken,
                  'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                  latitude: position.coords.latitude,
                  longitude: position.coords.longitude,
                  accuracy: position.coords.accuracy,
                  force: force
                })
              })
                .then((response) => response.ok ? response.json() : null)
                .then((payload) => {
                  if (payload && payload.ok) {
                    const meta = [];
                    if (payload.detail) {
                      meta.push(payload.detail);
                    }
                    if (payload.coordinates) {
                      meta.push(payload.coordinates);
                    }
                    if (payload.accuracy) {
                      meta.push(`precision ${Math.round(Number(payload.accuracy))} m`);
                    }
                    const detail = meta.length ? ` (${meta.join(' | ')})` : '';
                    const prefix = payload.changed ? 'Nouvelle position exacte :' : 'Position exacte :';
                    const locationLabel = payload.label ? `${prefix} ${payload.label}${detail}` : 'Position confirmee.';
                    setLocationStatus(locationLabel, 'success');
                    if (force) {
                      window.location.reload();
                    }
                  } else if (force) {
                    setLocationStatus('Localisation recue, mais le serveur n a pas confirme la mise a jour.', 'error');
                  }
                })
                .catch(() => {
                  if (force) {
                    setLocationStatus('Impossible d envoyer la localisation au serveur.', 'error');
                    alert('Impossible d envoyer la localisation au serveur.');
                  }
                })
                .finally(() => {
                  if (force) {
                    setLocationButtons(false);
                  }
                });
            },
            () => {
              if (force) {
                setLocationStatus('Autorisation refusee. Activez la localisation dans le navigateur.', 'error');
                setLocationButtons(false);
                alert('Autorisez la localisation dans votre navigateur pour confirmer votre position exacte.');
              }
            },
            {
              enableHighAccuracy: true,
              timeout: 15000,
              maximumAge: 0
            }
          );
        }

        function checkBrowserLocationStatus() {
          fetch(statusEndpoint, {
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
            .then((response) => response.ok ? response.json() : null)
            .then((payload) => {
              if (!payload) {
                return;
              }

              if (payload.needsLocation) {
                sendBrowserLocation(false);
                return;
              }

              if (payload.label) {
                const meta = [];
                if (payload.detail) {
                  meta.push(payload.detail);
                }
                if (payload.coordinates) {
                  meta.push(payload.coordinates);
                }
                if (payload.accuracy) {
                  meta.push(`precision ${Math.round(Number(payload.accuracy))} m`);
                }
                const detail = meta.length ? ` (${meta.join(' | ')})` : '';
                setLocationStatus(`Position exacte : ${payload.label}${detail}`, 'success');
              }

              sendBrowserLocation(false);
            })
            .catch(() => {});
        }

        document.querySelectorAll('[data-ft-confirm-location]').forEach((button) => {
          button.addEventListener('click', () => sendBrowserLocation(true));
        });

        window.addEventListener('load', () => {
          checkBrowserLocationStatus();
        });
      })();
    </script>
  {% endif %}
  {% if app.user %}
  <script>
    (function () {
      const badge = document.getElementById('ftFrontNotificationBadge');
      if (!badge) {
        return;
      }

      const refreshNotificationCount = async () => {
        try {
          const response = await fetch('{{ path('front_notifications_count') }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });

          if (!response.ok) {
            return;
          }

          const payload = await response.json();
          const count = Number(payload.count || 0);

          badge.textContent = String(count);
          badge.classList.toggle('d-none', count <= 0);
        } catch (error) {
        }
      };

      window.setInterval(refreshNotificationCount, 10000);
    })();
  </script>
  {% endif %}
  {% block javascripts %}{% endblock %}
</body>
</html>
