{% extends 'admin/back.html.twig' %}
{% block title %}Cheque #{{ cheque.idCheque }}{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <a href="{{ path('admin_cheque_index') }}" class="text-muted small text-decoration-none">Cheques</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <span class="fw-semibold small">Cheque #{{ cheque.idCheque }}</span>
{% endblock %}

{% block admin_content %}
{% set chequeStatus = cheque.statut|lower %}
{% set chequeBadge = chequeStatus == 'accepte' ? 'ft-badge-success' : (chequeStatus == 'refuse' ? 'ft-badge-danger' : (chequeStatus == 'livre' ? 'ft-badge-blue' : 'ft-badge-warning')) %}
{% set yousignStatus = cheque.yousignStatus %}
{% set yousignBadge = yousignStatus == 'signed' ? 'ft-badge-success' : (yousignStatus == 'pending' ? 'ft-badge-warning' : (yousignStatus in ['failed', 'expired', 'refused'] ? 'ft-badge-danger' : 'ft-badge-neutral')) %}
{% set yousignLabel = yousignStatus == 'signed' ? 'Signe electroniquement' : (yousignStatus == 'pending' ? 'En attente de signature' : (yousignStatus == 'expired' ? 'Expire' : (yousignStatus == 'refused' ? 'Refuse par le signataire' : (yousignStatus == 'failed' ? 'Echec' : 'Non initie')))) %}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="ft-admin-page-title mb-1">
      <i class="bi bi-journal-richtext me-2 text-primary"></i>Detail du cheque #{{ cheque.idCheque }}
    </h1>
    <p class="text-muted mb-0">Visualisez les informations du cheque, du wallet associe et appliquez les actions admin appropriees.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="{{ path('admin_cheque_index') }}" class="btn ft-btn-outline-primary">
      <i class="bi bi-arrow-left me-2"></i>Retour
    </a>
    <a href="{{ path('admin_wallet_show', {id: cheque.wallet.idWallet}) }}" class="btn btn-outline-secondary">
      <i class="bi bi-wallet2 me-2"></i>Voir le wallet
    </a>
  </div>
</div>

<section class="row g-4">
  <div class="col-12 col-xl-8">
    <article class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-info-circle me-2 text-primary"></i>Informations du cheque
      </div>
      <div class="ft-admin-card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4 text-muted">ID cheque</dt>
          <dd class="col-sm-8 fw-semibold">#{{ cheque.idCheque }}</dd>

          <dt class="col-sm-4 text-muted">Numero cheque</dt>
          <dd class="col-sm-8">{{ cheque.numeroCheque }}</dd>

          <dt class="col-sm-4 text-muted">Beneficiaire</dt>
          <dd class="col-sm-8">{{ cheque.beneficiaire ?: '-' }}</dd>

          <dt class="col-sm-4 text-muted">Montant</dt>
          <dd class="col-sm-8 fw-semibold">{{ cheque.montant }}</dd>

          <dt class="col-sm-4 text-muted">Statut</dt>
          <dd class="col-sm-8"><span class="badge {{ chequeBadge }}">{{ cheque.statut|upper }}</span></dd>

          <dt class="col-sm-4 text-muted">Date emission</dt>
          <dd class="col-sm-8">{{ cheque.dateEmission|date('d/m/Y H:i') }}</dd>

          <dt class="col-sm-4 text-muted">Date presentation</dt>
          <dd class="col-sm-8">{{ cheque.datePresentation ? cheque.datePresentation|date('d/m/Y H:i') : '-' }}</dd>

          <dt class="col-sm-4 text-muted">Motif de rejet</dt>
          <dd class="col-sm-8">{{ cheque.motifRejet ?: '-' }}</dd>

          <dt class="col-sm-4 text-muted">Validation signee</dt>
          <dd class="col-sm-8">
            {% if signature.signed %}
              <span class="badge {{ signature.valid ? 'ft-badge-success' : 'ft-badge-warning' }}">
                {{ signature.valid ? 'VALIDE' : 'A RECONTROLER' }}
              </span>
              <span class="small text-muted ms-2">{{ signature.fingerprint }}</span>
            {% else %}
              <span class="badge ft-badge-neutral">NON SIGNE</span>
            {% endif %}
          </dd>

          <dt class="col-sm-4 text-muted">Signature electronique (Yousign)</dt>
          <dd class="col-sm-8">
            <span class="badge {{ yousignBadge }}">{{ yousignLabel }}</span>
            {% if yousignStatus == 'signed' and cheque.yousignSignedAt %}
              <span class="small text-muted ms-2">le {{ cheque.yousignSignedAt|date('d/m/Y H:i') }}</span>
            {% endif %}
            {% if yousignStatus == 'pending' and cheque.yousignSigningLink %}
              <a href="{{ cheque.yousignSigningLink }}" target="_blank" class="btn btn-sm btn-outline-secondary ms-2">
                <i class="bi bi-box-arrow-up-right me-1"></i>Lien de signature
              </a>
            {% endif %}
          </dd>
        </dl>
      </div>
    </article>
  </div>

  <div class="col-12 col-xl-4">
    <article class="ft-admin-card mb-4">
      <div class="ft-admin-card-header">
        <i class="bi bi-wallet2 me-2 text-primary"></i>Wallet associe
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-insight-list">
          <div class="ft-admin-insight-item">
            <strong>Wallet</strong>
            <span>#{{ cheque.wallet.idWallet }} - {{ cheque.wallet.nomProprietaire }}</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Email</strong>
            <span>{{ cheque.wallet.email ?: '-' }}</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Etat du wallet</strong>
            <span>
              <span class="badge {{ cheque.wallet.estBloque ? 'ft-badge-danger' : 'ft-badge-success' }}">
                {{ cheque.wallet.estBloque ? 'Bloque' : 'Disponible' }}
              </span>
            </span>
          </div>
        </div>
      </div>
    </article>

    <article class="ft-admin-card">
      <div class="ft-admin-card-header">
        <i class="bi bi-lightning-charge me-2 text-primary"></i>Actions admin
      </div>
      <div class="ft-admin-card-body d-grid gap-2">
        {% if chequeStatus == 'en_attente' %}
          {# --- Signature electronique Yousign --- #}
          {% if yousignStatus == 'signed' %}
            <div class="alert alert-success small mb-2 py-2">
              <i class="bi bi-patch-check-fill me-1"></i>
              Signe electroniquement via Yousign le {{ cheque.yousignSignedAt|date('d/m/Y H:i') }}
            </div>
          {% elseif yousignStatus == 'pending' %}
            <div class="alert alert-warning small mb-2 py-2">
              <i class="bi bi-hourglass-split me-1"></i>
              Demande Yousign envoyee. En attente de signature du client.
            </div>
          {% elseif yousignStatus in ['failed', 'expired', 'refused'] %}
            <div class="alert alert-danger small mb-2 py-2">
              <i class="bi bi-exclamation-triangle me-1"></i>
              La signature Yousign est en statut {{ yousignLabel|lower }}. Vous pouvez relancer.
            </div>
          {% endif %}

          {% if yousignStatus != 'signed' %}
            {% if not yousignConfigured %}
              <div class="alert alert-warning border border-warning small py-2 mb-1" style="font-size:.82rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Yousign non configure.</strong>
                Ajoutez <code>YOUSIGN_API_KEY=votre_cle</code> dans <code>.env.local</code> puis relancez le serveur.
              </div>
            {% endif %}
            <form method="post" action="{{ path('admin_cheque_initiate_yousign', {id: cheque.idCheque}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('yousign_cheque_' ~ cheque.idCheque) }}">
              <button type="submit" class="btn btn-outline-info w-100" {{ not yousignConfigured ? 'title="YOUSIGN_API_KEY manquant dans .env.local"' : '' }}>
                <i class="bi bi-pen-fill me-2"></i>
                {{ yousignStatus == 'pending' ? 'Relancer signature Yousign' : 'Demander signature electronique (Yousign)' }}
              </button>
            </form>
          {% endif %}

          <form method="post" action="{{ path('admin_cheque_sign', {id: cheque.idCheque}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sign_cheque_' ~ cheque.idCheque) }}">
            <button type="submit" class="btn btn-outline-primary w-100">
              <i class="bi bi-pen me-2"></i>Generer validation signee (admin)
            </button>
          </form>

          {% if cheque.wallet.estBloque %}
            <button type="button" class="btn btn-outline-secondary" disabled>
              <i class="bi bi-lock me-2"></i>Approbation impossible : wallet bloque
            </button>
          {% else %}
            <form method="post" action="{{ path('admin_cheque_approve', {id: cheque.idCheque}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('approve_cheque_' ~ cheque.idCheque) }}">
              <button type="submit" class="btn btn-success w-100">
                <i class="bi bi-check2-circle me-2"></i>Approuver le cheque
              </button>
            </form>
          {% endif %}

          <a href="{{ path('admin_cheque_reject', {id: cheque.idCheque}) }}" class="btn btn-danger">
            <i class="bi bi-x-circle me-2"></i>Refuser le cheque
          </a>
        {% elseif chequeStatus == 'accepte' %}
          {% if signature.signed %}
            <div class="alert alert-success small mb-2">
              Validation signee: {{ signature.fingerprint }}
            </div>
          {% else %}
            <div class="alert alert-warning small mb-2">
              La livraison est bloquee tant que la validation signee n existe pas.
            </div>
          {% endif %}
          <form method="post" action="{{ path('admin_cheque_deliver', {id: cheque.idCheque}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('deliver_cheque_' ~ cheque.idCheque) }}">
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-truck me-2"></i>Marquer comme livre
            </button>
          </form>
        {% else %}
          <div class="alert alert-light border mb-0">
            Ce cheque a deja ete traite.
          </div>
        {% endif %}
      </div>
    </article>
  </div>
</section>

{% block javascripts %}
{{ parent() }}
<script>
  // Si des messages flash sont présents, scroller jusqu'à eux immédiatement
  document.addEventListener('DOMContentLoaded', function () {
    var flash = document.querySelector('.alert[role="alert"]');
    if (flash) {
      flash.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
</script>
{% endblock %}
{% endblock %}
