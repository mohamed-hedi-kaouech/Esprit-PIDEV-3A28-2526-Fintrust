{% extends 'admin/back.html.twig' %}

{% block title %}Alertes budgetaires - FinTrust{% endblock %}

{% block admin_content %}
{% set unreadCount = 0 %}
{% set readCount = 0 %}
{% set criticalCount = 0 %}
{% for alerte in alertes %}
    {% if alerte.read %}
        {% set readCount = readCount + 1 %}
    {% else %}
        {% set unreadCount = unreadCount + 1 %}
    {% endif %}
    {% if alerte.categorie and alerte.categorie.budgetPrevu > 0 and alerte.seuil >= (alerte.categorie.budgetPrevu * 0.8) %}
        {% set criticalCount = criticalCount + 1 %}
    {% endif %}
{% endfor %}

<div class="container-fluid mt-4 ft-admin-alert-page">
    <div class="ft-alert-hero">
        <div>
            <span class="ft-alert-kicker">Surveillance budget</span>
            <h1>Alertes budgetaires</h1>
            <p>Suivi en temps reel des seuils franchis, des categories sensibles et des actions a traiter rapidement.</p>
            <div class="ft-alert-hero-metrics">
                <span><i class="fas fa-radar me-2"></i>{{ criticalCount }} zone(s) chaude(s)</span>
                <span><i class="fas fa-layer-group me-2"></i>{{ alertes|length }} signal(s) actifs</span>
            </div>
        </div>
        <div class="ft-alert-hero-side">
            <div class="ft-alert-hero-badge">
                <i class="fas fa-bolt"></i>
                <span>{{ unreadCount }} action(s) prioritaires</span>
            </div>
            <a href="{{ path('admin_categorie_stats') }}" class="btn ft-btn-primary ft-alert-hero-cta">
                <i class="fas fa-chart-line me-2"></i>Voir les stats budget
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="ft-alert-kpi is-blue">
                <div class="ft-alert-kpi-top">
                    <div class="ft-alert-kpi-icon is-blue"><i class="fas fa-bell"></i></div>
                    <div>
                        <span>Total alertes</span>
                        <strong>{{ alertes|length }}</strong>
                    </div>
                </div>
                <small>Toutes les alertes enregistrees</small>
                <div class="ft-alert-kpi-spark blue"></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-alert-kpi is-orange">
                <div class="ft-alert-kpi-top">
                    <div class="ft-alert-kpi-icon is-orange"><i class="fas fa-hourglass-half"></i></div>
                    <div>
                        <span>Non lues</span>
                        <strong>{{ unreadCount }}</strong>
                    </div>
                </div>
                <small>Demandent une verification</small>
                <div class="ft-alert-kpi-spark orange"></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-alert-kpi is-green">
                <div class="ft-alert-kpi-top">
                    <div class="ft-alert-kpi-icon is-green"><i class="fas fa-square-check"></i></div>
                    <div>
                        <span>Traitees</span>
                        <strong>{{ readCount }}</strong>
                    </div>
                </div>
                <small>Historique lu et suivi</small>
                <div class="ft-alert-kpi-spark green"></div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-alert-kpi is-pink">
                <div class="ft-alert-kpi-top">
                    <div class="ft-alert-kpi-icon is-pink"><i class="fas fa-fire-flame-curved"></i></div>
                    <div>
                        <span>Zones chaudes</span>
                        <strong>{{ criticalCount }}</strong>
                    </div>
                </div>
                <small>Seuils tres proches du budget</small>
                <div class="ft-alert-kpi-spark pink"></div>
            </div>
        </div>
    </div>

    <div class="ft-alert-toolbar">
        <div class="ft-alert-filter-group">
            <button type="button" class="ft-alert-filter active" data-alert-filter="all">Toutes</button>
            <button type="button" class="ft-alert-filter" data-alert-filter="unread">Non lues</button>
            <button type="button" class="ft-alert-filter" data-alert-filter="read">Lues</button>
        </div>
        <div class="ft-alert-toolbar-actions">
            <div class="ft-alert-search-wrap">
                <i class="fas fa-search"></i>
                <input type="search" id="adminAlertSearch" class="form-control" placeholder="Rechercher une categorie...">
            </div>
            <button type="button" class="ft-alert-filter ft-alert-filter-tools">
                <i class="fas fa-sliders me-2"></i>Filtres
            </button>
        </div>
    </div>

    {% if alertes is empty %}
        <div class="ft-alert-empty">
            <div class="ft-alert-empty-icon"><i class="fas fa-shield-heart"></i></div>
            <h3>Aucune alerte active</h3>
            <p>Tous les seuils budgetaires sont respectes. Le tableau de surveillance est au vert.</p>        </div>
    {% else %}
        <div class="ft-alert-list" id="adminAlertList">
            {% for alerte in alertes %}
                {% set categoryName = alerte.categorie ? alerte.categorie.nomCategorie : 'Categorie inconnue' %}
                {% set usage = alerte.categorie and alerte.categorie.budgetPrevu > 0 ? (alerte.seuil / alerte.categorie.budgetPrevu) * 100 : 0 %}
                {% set totalSpent = 0 %}
                {% if alerte.categorie %}
                    {% for item in alerte.categorie.items %}
                        {% set totalSpent = totalSpent + item.montant %}
                    {% endfor %}
                {% endif %}
                {% set budgetTotal = alerte.categorie ? alerte.categorie.budgetPrevu : 0 %}
                {% set spentUsage = budgetTotal > 0 ? (totalSpent / budgetTotal) * 100 : 0 %}
                {% set progressWidth = spentUsage > 100 ? 100 : spentUsage %}
                {% set severity = usage >= 90 or spentUsage >= 95 ? 'critical' : (usage >= 75 or spentUsage >= 80 ? 'high' : 'moderate') %}
                {% set severityLabel = severity == 'critical' ? 'Critique' : (severity == 'high' ? 'Eleve' : 'Modere') %}
                {% set riskScore = ((usage * 0.45) + (spentUsage * 0.55))|round %}
                {% set categoryKey = categoryName|lower %}
                {% set alertIcon = 'fa-wallet' %}
                {% if 'aliment' in categoryKey or 'food' in categoryKey or 'restauration' in categoryKey %}
                    {% set alertIcon = 'fa-utensils' %}
                {% elseif 'transport' in categoryKey or 'carbur' in categoryKey or 'car' in categoryKey %}
                    {% set alertIcon = 'fa-car-side' %}
                {% elseif 'shopping' in categoryKey or 'loisir' in categoryKey or 'mode' in categoryKey %}
                    {% set alertIcon = 'fa-bag-shopping' %}
                {% endif %}
                <article class="ft-alert-card {{ alerte.read ? 'is-read' : 'is-unread' }} is-{{ severity }}"
                         data-alert-card
                         data-alert-state="{{ alerte.read ? 'read' : 'unread' }}"
                         data-alert-search="{{ (categoryName ~ ' ' ~ alerte.message)|lower }}">
                    <div class="ft-alert-card-head">
                        <div class="ft-alert-avatar is-{{ severity }}">
                            <i class="fas {{ alertIcon }}"></i>
                        </div>
                        <div class="ft-alert-card-meta">
                            <div class="ft-alert-card-title-row">
                                <div class="ft-alert-state-stack">
                                    <span class="ft-alert-risk-badge is-{{ severity }}">{{ severityLabel }}</span>
                                    <h3>{{ categoryName }}</h3>
                                </div>
                            </div>
                            <div class="ft-alert-card-subtitle">
                                <span><i class="fas fa-clock me-2"></i>{{ alerte.createdAt|date('d/m/Y a H:i') }}</span>
                                <span><i class="fas fa-chart-pie me-2"></i>{{ usage|number_format(0) }}% du budget utilise</span>
                            </div>
                        </div>
                    </div>

                    <div class="ft-alert-card-layout">
                        <div class="ft-alert-card-body">
                            <div class="ft-alert-inline-metrics">
                                <span>Score risque {{ riskScore }}/100</span>
                            </div>
                            <div class="ft-alert-progress-track compact">
                                <span class="is-{{ severity }}" style="width: {{ progressWidth }}%;"></span>
                            </div>
                            <p class="ft-alert-message">{{ alerte.message }}</p>
                        </div>

                        <div class="ft-alert-side-panel">
                            <div class="ft-alert-highlight">
                                <span>Seuil surveille</span>
                                <strong>{{ alerte.seuil|number_format(2, ',', ' ') }} DT</strong>
                                <small>Objectif: {{ budgetTotal|number_format(2, ',', ' ') }} DT</small>
                            </div>
                        </div>

                        <div class="ft-alert-card-actions">
                            <a href="{{ alerte.categorie ? path('admin_categorie_show', {'idCategorie': alerte.categorie.idCategorie}) : path('admin_categorie_stats') }}" class="btn ft-btn-soft-primary">
                                <i class="fas fa-eye me-2"></i>Details
                            </a>

                            <a href="{{ path('admin_categorie_stats') }}" class="btn ft-btn-soft-primary is-main">
                                <i class="fas fa-chart-column me-2"></i>Analyser la zone
                            </a>

                            {% if not alerte.read %}
                                <form method="post" action="{{ path('admin_alerte_mark_read', {'idAlerte': alerte.idAlerte}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark_read' ~ alerte.idAlerte) }}">
                                    <button type="submit" class="btn ft-btn-soft-info">
                                        <i class="fas fa-eye me-2"></i>Marquer comme lue
                                    </button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_alerte_mark_unread', {'idAlerte': alerte.idAlerte}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark_unread' ~ alerte.idAlerte) }}">
                                    <button type="submit" class="btn ft-btn-soft-info">
                                        <i class="fas fa-envelope me-2"></i>Marquer non lue
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </article>            {% endfor %}
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('adminAlertSearch');
    const filterButtons = document.querySelectorAll('[data-alert-filter]');
    const cards = document.querySelectorAll('[data-alert-card]');
    let currentFilter = 'all';

    const applyFilters = () => {
        const query = (searchInput?.value || '').trim().toLowerCase();

        cards.forEach((card) => {
            const state = card.dataset.alertState || 'all';
            const haystack = card.dataset.alertSearch || '';
            const matchesFilter = currentFilter === 'all' || state === currentFilter;
            const matchesSearch = query === '' || haystack.includes(query);
            card.style.display = matchesFilter && matchesSearch ? '' : 'none';
        });
    };

    filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
            currentFilter = button.dataset.alertFilter || 'all';
            filterButtons.forEach((item) => item.classList.remove('active'));
            button.classList.add('active');
            applyFilters();
        });
    });

    searchInput?.addEventListener('input', applyFilters);
});
</script>

