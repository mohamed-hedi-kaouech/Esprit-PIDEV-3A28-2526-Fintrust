{% extends 'admin/back.html.twig' %}
{% block title %}Wallet #{{ wallet.idWallet }}{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <a href="{{ path('admin_wallet_index') }}" class="text-muted small text-decoration-none">Pilotage Wallet</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <span class="fw-semibold small">Wallet #{{ wallet.idWallet }}</span>
{% endblock %}

{% block admin_content %}
{% set metrics = analytics.metrics %}
{% set transactionBreakdown = analytics.breakdown.transaction_types %}
{% set anomalies = anomalyReport.anomalies_detected ?? [] %}
{% set riskTone = riskAnalysis.level == 'critique' ? 'danger' : (riskAnalysis.level == 'eleve' ? 'danger' : (riskAnalysis.level == 'moyen' ? 'warning' : 'success')) %}
{% set classTone = classification.class_number >= 5 ? 'danger' : (classification.class_number == 4 ? 'danger' : (classification.class_number == 3 ? 'warning' : (classification.class_number == 2 ? 'amber' : 'success'))) %}
{% set recommendationTone = prediction.admin_recommendation == 'bloquer conseille' ? 'red' : (prediction.admin_recommendation == 'risque eleve' ? 'amber' : 'blue') %}

