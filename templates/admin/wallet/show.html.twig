<section class="row g-4">
  <div class="col-12 col-xl-8">
    <article class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-info-circle me-2 text-primary"></i>Informations du wallet
      </div>
      <div class="ft-admin-card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4 text-muted">ID wallet</dt>
          <dd class="col-sm-8 fw-semibold">{{ wallet.idWallet }}</dd>

          <dt class="col-sm-4 text-muted">ID client lie</dt>
          <dd class="col-sm-8">
            {% if wallet.idUser %}
              <span class="badge ft-badge-blue">Client #{{ wallet.idUser }}</span>
            {% else %}
              <span class="badge ft-badge-neutral">Aucun client lie</span>
            {% endif %}
          </dd>

          <dt class="col-sm-4 text-muted">Nom proprietaire</dt>
          <dd class="col-sm-8">{{ wallet.nomProprietaire }}</dd>

          <dt class="col-sm-4 text-muted">Email</dt>
          <dd class="col-sm-8">{{ wallet.email ?: '-' }}</dd>

          <dt class="col-sm-4 text-muted">Telephone</dt>
          <dd class="col-sm-8">{{ wallet.telephone ?: '-' }}</dd>

          <dt class="col-sm-4 text-muted">Solde</dt>
          <dd class="col-sm-8 fw-semibold">{{ wallet.solde }} {{ wallet.devise }}</dd>

          <dt class="col-sm-4 text-muted">Statut</dt>
          <dd class="col-sm-8">
            <span class="badge {{ wallet.statut == 'actif' ? 'ft-badge-success' : (wallet.statut == 'bloque' ? 'ft-badge-danger' : 'ft-badge-warning') }}">
              {{ wallet.statut|upper }}
            </span>
          </dd>

          <dt class="col-sm-4 text-muted">Bloque</dt>
          <dd class="col-sm-8">
            <span class="badge {{ wallet.estBloque ? 'ft-badge-danger' : 'ft-badge-success' }}">
              {{ wallet.estBloque ? 'Oui' : 'Non' }}
            </span>
          </dd>

          <dt class="col-sm-4 text-muted">Tentatives echouees</dt>
          <dd class="col-sm-8">{{ wallet.tentativesEchouees ?? 0 }}</dd>

          <dt class="col-sm-4 text-muted">Date creation</dt>
          <dd class="col-sm-8">{{ wallet.dateCreation ? wallet.dateCreation|date('d/m/Y H:i') : '-' }}</dd>

          <dt class="col-sm-4 text-muted">Derniere tentative</dt>
          <dd class="col-sm-8">{{ wallet.dateDerniereTentative ? wallet.dateDerniereTentative|date('d/m/Y H:i') : '-' }}</dd>
        </dl>
      </div>
    </article>
  </div>

  <div class="col-12 col-xl-4">
    <article class="ft-admin-card mb-4">
      <div class="ft-admin-card-header">
        <i class="bi bi-bar-chart-line me-2 text-primary"></i>Statistiques rapides
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-insight-list">
          <div class="ft-admin-insight-item">
            <strong>Transactions</strong>
            <span>{{ metrics.total_transactions }} total, {{ metrics.transactions_last_24h }} sur 24h, {{ metrics.transactions_last_7d }} sur 7 jours.</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Cheques</strong>
            <span>{{ metrics.total_cheques }} cheque(s), dont {{ metrics.refused_cheques }} refuse(s).</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Type dominant</strong>
            <span>{{ metrics.dominant_transaction_type ?: 'Aucune dominante' }}</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Activite recente</strong>
            <span>{{ metrics.recent_activity_label|upper }} avec indice historique {{ metrics.recent_vs_historical_activity_index|number_format(2, '.', ' ') }}.</span>
          </div>
        </div>
      </div>
    </article>

    <article class="ft-admin-card">
      <div class="ft-admin-card-header">
        <i class="bi bi-lightning-charge me-2 text-primary"></i>Actions rapides
      </div>
      <div class="ft-admin-card-body d-grid gap-2">
        {% if wallet.estBloque %}
          <form method="post" action="{{ path('admin_wallet_unblock', {id: wallet.idWallet}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('wallet_unblock_' ~ wallet.idWallet) }}">
            <button type="submit" class="btn btn-success w-100">
              <i class="bi bi-unlock me-2"></i>Debloquer le wallet
            </button>
          </form>
        {% else %}
          <form method="post" action="{{ path('admin_wallet_block', {id: wallet.idWallet}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('wallet_block_' ~ wallet.idWallet) }}">
            <button type="submit" class="btn btn-danger w-100">
              <i class="bi bi-lock me-2"></i>Bloquer le wallet
            </button>
          </form>
        {% endif %}

        <a href="{{ path('admin_wallet_edit', {id: wallet.idWallet}) }}" class="btn btn-outline-secondary">
          <i class="bi bi-pencil-square me-2"></i>Modifier les informations
        </a>

        <a href="{{ path('admin_cheque_index', {wallet: wallet.idWallet}) }}" class="btn btn-outline-secondary">
          <i class="bi bi-journal-check me-2"></i>Gerer les cheques lies
        </a>
      </div>
    </article>
  </div>
</section>

<section class="row g-3 mt-1">
  <div class="col-12 col-md-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue h-100">
      <div class="ft-admin-kpi-mini-label">Score de risque</div>
      <div class="ft-admin-kpi-mini-value">{{ riskAnalysis.score }}/100</div>
      <div class="ft-admin-kpi-mini-text">Niveau {{ riskAnalysis.level|upper }}</div>
    </article>
  </div>

  <div class="col-12 col-md-3">
    <article class="ft-admin-kpi-mini {{ classification.class_number >= 4 ? 'ft-admin-kpi-mini-red' : (classification.class_number == 3 ? 'ft-admin-kpi-mini-amber' : 'ft-admin-kpi-mini-green') }} h-100">
      <div class="ft-admin-kpi-mini-label">Classe wallet</div>
      <div class="ft-admin-kpi-mini-value">C{{ classification.class_number }}</div>
      <div class="ft-admin-kpi-mini-text">{{ classification.class_label }}</div>
    </article>
  </div>

  <div class="col-12 col-md-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-amber h-100">
      <div class="ft-admin-kpi-mini-label">Probabilite de blocage</div>
      <div class="ft-admin-kpi-mini-value">{{ prediction.block_probability }}%</div>
      <div class="ft-admin-kpi-mini-text">Projection sur signaux locaux</div>
    </article>
  </div>

  <div class="col-12 col-md-3">
    <article class="ft-admin-kpi-mini {{ prediction.admin_recommendation == 'bloquer conseille' ? 'ft-admin-kpi-mini-red' : 'ft-admin-kpi-mini-blue' }} h-100">
      <div class="ft-admin-kpi-mini-label">Recommendation admin</div>
      <div class="ft-admin-kpi-mini-value">{{ prediction.admin_recommendation|upper }}</div>
      <div class="ft-admin-kpi-mini-text">Risque futur 7 jours {{ prediction.future_risk_7d|upper }}</div>
    </article>
  </div>
</section>

<section class="row g-4 mt-1">
  <div class="col-12 col-xl-8">
    <article class="ft-admin-card h-100">
      <div class="ft-admin-card-header d-flex flex-wrap justify-content-between gap-2 align-items-center">
        <span><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Resume analytique backend</span>
        <div class="d-flex gap-2">
          <span class="badge ft-badge-{{ riskTone }}">{{ riskAnalysis.level|upper }}</span>
          <span class="badge {{ classification.class_number >= 4 ? 'ft-badge-danger' : (classification.class_number == 3 ? 'ft-badge-warning' : 'ft-badge-success') }}">
            CLASSE {{ classification.class_number }} - {{ classification.class_label|upper }}
          </span>
        </div>
      </div>
      <div class="ft-admin-card-body">
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Activite</strong>
              <span>{{ metrics.transactions_last_24h }} sur 24h, {{ metrics.transactions_last_7d }} sur 7 jours, {{ metrics.transactions_last_30d }} sur 30 jours.</span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Montants</strong>
              <span>Moyenne {{ metrics.average_transaction_amount|number_format(2, '.', ' ') }}, min {{ metrics.min_transaction_amount|number_format(2, '.', ' ') }}, max {{ metrics.max_transaction_amount|number_format(2, '.', ' ') }} {{ wallet.devise }}.</span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Comportement</strong>
              <span>{{ metrics.night_transaction_count }} transaction(s) nocturne(s) et {{ metrics.rapid_transaction_count }} transaction(s) engagee(s) dans des sequences rapides.</span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Ratios de flux</strong>
              <span>Retraits/depots montant {{ metrics.withdrawal_to_deposit_amount_ratio|number_format(2, '.', ' ') }}, volumique {{ metrics.withdrawal_to_deposit_count_ratio|number_format(2, '.', ' ') }}.</span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Cheques</strong>
              <span>{{ metrics.refused_cheques }} refuse(s), taux {{ metrics.cheque_rejection_rate|number_format(2, '.', ' ') }}%.</span>
            </div>
          </div>
          <div class="col-md-4">
            <div class="ft-admin-insight-item h-100">
              <strong>Stabilite du solde</strong>
              <span>Indice de volatilite {{ metrics.balance_instability_index|number_format(2, '.', ' ') }} avec tendance {{ prediction.balance_trend.label|upper }}.</span>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <h5 class="fw-bold">Lecture de risque</h5>
          <p class="mb-0">{{ riskAnalysis.explanation }}</p>
        </div>

        <div class="mb-4">
          <h5 class="fw-bold">Classification du wallet</h5>
          <p class="mb-0">Classe {{ classification.class_number }} - {{ classification.class_label }}. {{ classification.recommendation }}</p>
        </div>

        <div class="mb-4">
          <h5 class="fw-bold">Prediction backend</h5>
          <div class="ft-admin-insight-list">
            {% for item in prediction.rationale %}
              <div class="ft-admin-insight-item">
                <span>{{ item }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

        <div>
          <h5 class="fw-bold">Facteurs qui augmentent le score</h5>
          {% if riskAnalysis.factors is empty %}
            <p class="text-muted mb-0">Aucun facteur de risque majeur n a augmente le score de facon significative.</p>
          {% else %}
            <div class="ft-admin-insight-list">
              {% for factor in riskAnalysis.factors %}
                <div class="ft-admin-insight-item">
                  <strong>{{ factor.label }} (+{{ factor.points }})</strong>
                  <span>{{ factor.reason }}</span>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </article>
  </div>

  <div class="col-12 col-xl-4">
    <article class="ft-admin-card h-100">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center gap-2">
        <span><i class="bi bi-shield-exclamation me-2 text-primary"></i>Anomalies detectees</span>
        <span class="badge {{ anomalyReport.severity == 'critical' or anomalyReport.severity == 'high' ? 'ft-badge-danger' : (anomalyReport.severity == 'medium' ? 'ft-badge-warning' : 'ft-badge-success') }}">
          {{ anomalyReport.severity|upper }}
        </span>
      </div>
      <div class="ft-admin-card-body">
        {% if anomalies is empty %}
          <p class="text-muted mb-0">Aucune anomalie metier significative n a ete detectee.</p>
        {% else %}
          <div class="ft-admin-insight-list">
            {% for anomaly in anomalies %}
              {% set anomalyTone = anomaly.severity in ['critical', 'high'] ? 'danger' : 'warning' %}
              <div class="ft-admin-insight-item">
                <div class="d-flex justify-content-between gap-2 align-items-start mb-1">
                  <strong>{{ anomaly.title }}</strong>
                  <span class="badge ft-badge-{{ anomalyTone }}">{{ anomaly.severity|upper }}</span>
                </div>
                <span>{{ anomaly.details }}</span>
                {% if anomaly.examples is not empty %}
                  <div class="small text-muted mt-2">
                    Exemple : {{ anomaly.examples|first|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </article>
  </div>
</section>

<section class="ft-admin-card mt-4">
  <div class="ft-admin-card-header d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div>
      <i class="bi bi-journal-bookmark me-2 text-primary"></i>Derniers cheques lies au wallet
    </div>
    <a href="{{ path('admin_cheque_index', {wallet: wallet.idWallet}) }}" class="btn btn-sm ft-btn-outline-primary">
      Voir tout
    </a>
  </div>
  <div class="ft-admin-card-body p-0">
    <div class="table-responsive">
      <table class="table ft-admin-table align-middle mb-0">
        <thead>
          <tr>
            <th>ID cheque</th>
            <th>Numero</th>
            <th>Beneficiaire</th>
            <th>Montant</th>
            <th>Statut</th>
            <th>Date emission</th>
          </tr>
        </thead>
        <tbody>
          {% for cheque in latestCheques %}
            {% set chequeStatus = cheque.statut|lower %}
            <tr>
              <td>
                <a href="{{ path('admin_cheque_show', {id: cheque.idCheque}) }}" class="text-decoration-none fw-bold">
                  #{{ cheque.idCheque }}
                </a>
              </td>
              <td>{{ cheque.numeroCheque }}</td>
              <td>{{ cheque.beneficiaire ?: '-' }}</td>
              <td class="fw-semibold">{{ cheque.montant }}</td>
              <td>
                <span class="badge {{ chequeStatus == 'accepte' ? 'ft-badge-success' : (chequeStatus == 'refuse' ? 'ft-badge-danger' : 'ft-badge-warning') }}">
                  {{ cheque.statut|upper }}
                </span>
              </td>
              <td>{{ cheque.dateEmission|date('d/m/Y H:i') }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">Aucun cheque associe a ce wallet.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="row g-3 mt-1">
  <div class="col-12 col-md-4">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-green h-100">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-arrow-down-circle"></i></span>
      <div class="ft-admin-kpi-mini-label">Depots</div>
      <div class="ft-admin-kpi-mini-value">{{ transactionStats.depotCount }}</div>
      <div class="ft-admin-kpi-mini-text">
        Montant cumule : {{ transactionStats.depotAmount|number_format(2, '.', ' ') }} {{ wallet.devise }}
      </div>
    </article>
  </div>

  <div class="col-12 col-md-4">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-amber h-100">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-arrow-up-circle"></i></span>
      <div class="ft-admin-kpi-mini-label">Retraits</div>
      <div class="ft-admin-kpi-mini-value">{{ transactionStats.retraitCount }}</div>
      <div class="ft-admin-kpi-mini-text">
        Montant cumule : {{ transactionStats.retraitAmount|number_format(2, '.', ' ') }} {{ wallet.devise }}
      </div>
    </article>
  </div>

  <div class="col-12 col-md-4">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue h-100">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-arrow-left-right"></i></span>
      <div class="ft-admin-kpi-mini-label">Transferts</div>
      <div class="ft-admin-kpi-mini-value">{{ transactionStats.transfertCount }}</div>
      <div class="ft-admin-kpi-mini-text">
        Montant cumule : {{ transactionStats.transfertAmount|number_format(2, '.', ' ') }} {{ wallet.devise }}
      </div>
    </article>
  </div>
</section>

<section class="ft-admin-card mt-4">
  <div class="ft-admin-card-header">
    <i class="bi bi-pie-chart me-2 text-primary"></i>Repartition par type de transaction
  </div>
  <div class="ft-admin-card-body">
    <div class="row g-3">
      {% for type, stats in transactionBreakdown %}
        <div class="col-12 col-md-3">
          <div class="ft-admin-insight-item h-100">
            <strong>{{ type|upper }}</strong>
            <span>{{ stats.count }} transaction(s), {{ stats.amount|number_format(2, '.', ' ') }} {{ wallet.devise }}, {{ stats.ratio_count|number_format(2, '.', ' ') }}% du volume.</span>
          </div>
        </div>
      {% else %}
        <div class="col-12">
          <p class="text-muted mb-0">Aucune transaction disponible pour etablir une repartition.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="ft-admin-card mt-4">
  <div class="ft-admin-card-header">
    <i class="bi bi-activity me-2 text-primary"></i>Activite recente analysee
  </div>
  <div class="ft-admin-card-body p-0">
    <div class="table-responsive">
      <table class="table ft-admin-table align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Montant</th>
            <th>Flux signe</th>
            <th>Description</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          {% for item in analytics.recent_activity %}
            <tr>
              <td class="fw-bold">#{{ item.id }}</td>
              <td>
                {% set typeClass = item.type == 'depot' ? 'ft-badge-success' : (item.type == 'retrait' ? 'ft-badge-warning' : (item.type == 'transfert' ? 'ft-badge-blue' : 'ft-badge-neutral')) %}
                <span class="badge {{ typeClass }}">{{ item.type|upper }}</span>
              </td>
              <td>{{ item.amount|number_format(2, '.', ' ') }} {{ wallet.devise }}</td>
              <td class="{{ item.signed_amount < 0 ? 'text-danger' : 'text-success' }}">
                {{ item.signed_amount|number_format(2, '.', ' ') }} {{ wallet.devise }}
              </td>
              <td>{{ item.description ?: '-' }}</td>
              <td>{{ item.date|date('d/m/Y H:i') }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">Aucune activite recente disponible.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="ft-admin-card mt-4">
  <div class="ft-admin-card-header d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div>
      <i class="bi bi-clock-history me-2 text-primary"></i>10 dernieres transactions
    </div>
    <span class="ft-admin-status-chip ft-admin-status-info">
      <i class="bi bi-arrow-down-up"></i>Plus recent au plus ancien
    </span>
  </div>
  <div class="ft-admin-card-body p-0">
    <div class="table-responsive">
      <table class="table ft-admin-table align-middle mb-0">
        <thead>
          <tr>
            <th>ID transaction</th>
            <th>Type</th>
            <th>Montant</th>
            <th>Description</th>
            <th>Date transaction</th>
          </tr>
        </thead>
        <tbody>
          {% for transaction in latestTransactions %}
            <tr>
              <td class="fw-bold">#{{ transaction.idTransaction }}</td>
              <td>
                {% set type = transaction.type|lower %}
                {% set typeClass = type == 'depot' ? 'ft-badge-success' : (type == 'retrait' ? 'ft-badge-warning' : (type == 'transfert' ? 'ft-badge-blue' : 'ft-badge-neutral')) %}
                <span class="badge {{ typeClass }}">{{ transaction.type|upper }}</span>
              </td>
              <td class="fw-semibold">{{ transaction.montant }}</td>
              <td>{{ transaction.description ?: '-' }}</td>
              <td>{{ transaction.dateTransaction ? transaction.dateTransaction|date('d/m/Y H:i') : '-' }}</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                Aucune transaction trouvee pour ce wallet.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
