{% extends 'admin/back.html.twig' %}
{% block title %}Tableau de bord{% endblock %}

{% block breadcrumb %}
  <i class="bi bi-speedometer2 me-1 text-primary"></i>
  <span class="fw-semibold">Tableau de bord</span>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-admin-copilot-shell {
      position: relative;
    }
    .ft-admin-copilot-main,
    .ft-admin-copilot-side {
      overflow: hidden;
      border-color: rgba(191, 219, 254, 0.92);
      box-shadow: 0 22px 42px rgba(15, 23, 42, 0.06);
      background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.11), transparent 24%),
        linear-gradient(180deg, rgba(255,255,255,.99), rgba(247,251,255,.98));
    }
    .ft-admin-copilot-main::before,
    .ft-admin-copilot-side::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: linear-gradient(180deg, #2563eb, #38bdf8, #22c55e);
      opacity: .95;
    }
    .ft-admin-copilot-main .ft-admin-card-header,
    .ft-admin-copilot-side .ft-admin-card-header {
      position: relative;
      z-index: 1;
      background: linear-gradient(180deg, rgba(239,246,255,.95), rgba(255,255,255,.9));
    }
    .ft-admin-copilot-intro {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: flex-start;
      flex-wrap: wrap;
      margin-bottom: 1.4rem;
      padding: 1.2rem 1.3rem;
      border-radius: 1.35rem;
      border: 1px solid rgba(191, 219, 254, 0.9);
      background:
        radial-gradient(circle at right top, rgba(56,189,248,.16), transparent 28%),
        linear-gradient(135deg, rgba(239,246,255,.98), rgba(255,255,255,.96));
    }
    .ft-admin-copilot-intro-kicker {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .42rem .8rem;
      border-radius: 999px;
      background: rgba(255,255,255,.9);
      border: 1px solid rgba(191, 219, 254, 0.9);
      color: #1d4ed8;
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .03em;
      margin-bottom: .7rem;
    }
    .ft-admin-copilot-intro-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: .35rem;
    }
    .ft-admin-copilot-intro-copy {
      max-width: 760px;
      color: #64748b;
      font-size: .95rem;
      line-height: 1.65;
    }
    .ft-admin-copilot-api-chip {
      display: inline-flex;
      align-items: center;
      padding: .48rem .85rem;
      border-radius: 999px;
      background: rgba(15,23,42,.04);
      color: #475569;
      font-size: .74rem;
      font-weight: 700;
      border: 1px solid rgba(203, 213, 225, .9);
      white-space: nowrap;
    }
    .ft-admin-copilot-case {
      padding: 1.2rem;
      border-radius: 1.4rem;
      border: 1px solid rgba(203, 213, 225, .9);
      background: rgba(255,255,255,.9);
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.04);
    }
    .ft-admin-copilot-case + .ft-admin-copilot-case {
      margin-top: 1rem;
    }
    .ft-admin-copilot-case-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .ft-admin-copilot-user {
      display: flex;
      gap: .85rem;
      align-items: center;
    }
    .ft-admin-copilot-avatar {
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(59,130,246,.16), rgba(125,211,252,.26));
      color: #1d4ed8;
      font-weight: 800;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
    }
    .ft-admin-copilot-user-name {
      font-weight: 800;
      color: #0f172a;
      margin-bottom: .1rem;
    }
    .ft-admin-copilot-user-meta {
      color: #64748b;
      font-size: .82rem;
    }
    .ft-admin-copilot-badges {
      display: flex;
      gap: .45rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .ft-admin-copilot-summary {
      padding: .95rem 1rem;
      border-radius: 1rem;
      background: linear-gradient(180deg, rgba(248,250,252,.95), rgba(255,255,255,.92));
      border: 1px solid rgba(226, 232, 240, .95);
      margin-bottom: 1rem;
      color: #334155;
      line-height: 1.6;
    }
    .ft-admin-copilot-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .ft-admin-copilot-panel {
      padding: 1rem;
      border-radius: 1rem;
      background: rgba(255,255,255,.86);
      border: 1px solid rgba(226, 232, 240, .95);
    }
    .ft-admin-copilot-panel-title {
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #64748b;
      margin-bottom: .75rem;
    }
    .ft-admin-copilot-list {
      margin: 0;
      padding-left: 1rem;
      color: #334155;
      font-size: .9rem;
    }
    .ft-admin-copilot-list li + li {
      margin-top: .3rem;
    }
    .ft-admin-copilot-justification {
      margin-bottom: .85rem;
      color: #334155;
      line-height: 1.65;
    }
    .ft-admin-copilot-review {
      padding: 1rem 1.05rem;
      border-radius: 1rem;
      border: 1px solid rgba(191, 219, 254, 0.88);
      background:
        radial-gradient(circle at right top, rgba(59,130,246,.08), transparent 26%),
        linear-gradient(180deg, rgba(255,255,255,.98), rgba(244,248,255,.96));
      color: #475569;
      line-height: 1.7;
    }
    .ft-admin-copilot-side-stack {
      display: grid;
      gap: .95rem;
    }
    .ft-admin-copilot-sample {
      padding: 1rem;
      border-radius: 1.15rem;
      border: 1px solid rgba(203, 213, 225, .9);
      background: rgba(255,255,255,.88);
      box-shadow: 0 12px 24px rgba(15, 23, 42, 0.035);
    }
    .ft-admin-copilot-sample-head {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      align-items: flex-start;
      margin-bottom: .55rem;
    }
    .ft-admin-copilot-sample-title {
      font-weight: 800;
      color: #0f172a;
    }
    .ft-admin-copilot-sample-risk {
      color: #64748b;
      font-size: .82rem;
      margin-bottom: .7rem;
    }
    .ft-admin-copilot-sample-copy {
      color: #334155;
      font-size: .9rem;
      line-height: 1.6;
      margin-bottom: .7rem;
    }
    @media (max-width: 991.98px) {
      .ft-admin-copilot-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endblock %}

{% block admin_content %}
<section class="ft-admin-hero">
  <div class="ft-admin-hero-grid">
    <div>
      <div class="ft-admin-hero-kicker">
        <i class="bi bi-lightning-charge-fill"></i>
        Pilotage admin FinTrust
      </div>
      <h1 class="ft-admin-page-title mb-3 text-white">Un dashboard plus vivant, plus utile, plus convaincant</h1>
      <p class="ft-admin-hero-subtitle mb-0">
        Suivez les comptes actifs, l'énergie des nouvelles inscriptions, les dossiers KYC à risque et les actions admin importantes depuis une seule console beaucoup plus claire.
      </p>
    </div>

    <div class="d-flex flex-column gap-3">
      <div class="ft-admin-hero-panel">
        <div class="ft-admin-hero-panel-label">Priorité du jour</div>
        <div class="ft-admin-hero-panel-value">{{ stats.kycPend }}</div>
        <div class="ft-admin-hero-panel-text">dossier{{ stats.kycPend > 1 ? 's' : '' }} KYC en attente de validation immédiate</div>
      </div>
      <div class="ft-admin-meta">
        <i class="bi bi-clock-history"></i>{{ "now"|date("d/m/Y H:i") }}
      </div>
    </div>
  </div>
</section>

<div class="row g-4 mb-5">
  <div class="col-sm-6 col-xl-3">
    <div class="ft-admin-stat-card ft-admin-stat-blue">
      <div class="ft-admin-stat-icon"><i class="bi bi-people-fill"></i></div>
      <div class="ft-admin-stat-body">
        <div class="ft-admin-stat-value">{{ stats.clients }}</div>
        <div class="ft-admin-stat-label">Clients enregistrés sur la plateforme</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="ft-admin-stat-card ft-admin-stat-green">
      <div class="ft-admin-stat-icon"><i class="bi bi-person-check-fill"></i></div>
      <div class="ft-admin-stat-body">
        <div class="ft-admin-stat-value">{{ stats.actifs }}</div>
        <div class="ft-admin-stat-label">Comptes actifs prêts à utiliser les services</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="ft-admin-stat-card ft-admin-stat-yellow">
      <div class="ft-admin-stat-icon"><i class="bi bi-person-dash-fill"></i></div>
      <div class="ft-admin-stat-body">
        <div class="ft-admin-stat-value">{{ stats.inactifs }}</div>
        <div class="ft-admin-stat-label">Comptes non actifs à relancer ou débloquer</div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="ft-admin-stat-card ft-admin-stat-red">
      <div class="ft-admin-stat-icon"><i class="bi bi-shield-exclamation"></i></div>
      <div class="ft-admin-stat-body">
        <div class="ft-admin-stat-value">{{ stats.kycPend }}</div>
        <div class="ft-admin-stat-label">KYC en attente de revue admin</div>
      </div>
      {% if stats.kycPend > 0 %}
        <a href="{{ path('admin_kyc_list') }}" class="ft-admin-stat-action">Examiner →</a>
      {% endif %}
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-xl-7">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-exclamation-diamond me-2 text-primary"></i>Top utilisateurs a risque</span>
        <span class="badge ft-badge-danger rounded-pill px-3">Top 5</span>
      </div>
      <div class="ft-admin-card-body p-0">
        {% if topRiskUsers is empty %}
          <div class="text-center text-muted py-4">
            <i class="bi bi-check2-all fs-2 d-block mb-2 text-success"></i>
            Aucun profil a risque eleve pour le moment
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table ft-admin-table align-middle mb-0">
              <thead>
                <tr>
                  <th class="ps-4">Utilisateur</th>
                  <th>Risk score</th>
                  <th>Nb alertes</th>
                  <th>Statut</th>
                  <th class="text-end pe-4">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for item in topRiskUsers %}
                  <tr>
                    <td class="ps-4">
                      <div class="d-flex align-items-center gap-3">
                        <div class="ft-admin-avatar-sm">
                          {{ item.user.prenom|first|upper }}{{ item.user.nom|first|upper }}
                        </div>
                        <div>
                          <div class="fw-semibold">{{ item.user.fullName }}</div>
                          <div class="text-muted small">#{{ item.user.id }} · {{ item.riskLevel }}</div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="fw-bold text-danger">{{ item.riskScore|number_format(1, ',', ' ') }}/100</div>
                    </td>
                    <td>
                      <span class="badge {{ item.alertCount >= 5 ? 'ft-badge-danger' : (item.alertCount >= 2 ? 'ft-badge-warning' : 'ft-badge-blue') }}">
                        {{ item.alertCount }} alerte{{ item.alertCount > 1 ? 's' : '' }}
                      </span>
                    </td>
                    <td>
                      {% if item.status == 'ACTIF' %}
                        <span class="badge ft-badge-success">Actif</span>
                      {% elseif item.status == 'EN_ATTENTE' %}
                        <span class="badge ft-badge-warning">En attente</span>
                      {% else %}
                        <span class="badge ft-badge-danger">Suspendu</span>
                      {% endif %}
                    </td>
                    <td class="text-end pe-4">
                      <a href="{{ path('admin_user_edit', {id: item.user.id}) }}" class="btn btn-sm ft-btn-outline-primary">
                        Analyser
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-xl-5">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-heart-pulse me-2 text-primary"></i>Sante du systeme</span>
        <span class="badge rounded-pill px-3 {{ systemHealth.globalTone == 'success' ? 'ft-badge-success' : (systemHealth.globalTone == 'warning' ? 'ft-badge-warning' : 'ft-badge-danger') }}">
          {{ systemHealth.globalStatus }}
        </span>
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-system-card ft-admin-system-{{ systemHealth.globalTone }}">
          <div class="ft-admin-system-icon">
            <i class="bi {{ systemHealth.globalTone == 'success' ? 'bi-shield-check' : (systemHealth.globalTone == 'warning' ? 'bi-activity' : 'bi-exclamation-triangle') }}"></i>
          </div>
          <div>
            <div class="ft-admin-system-title">{{ systemHealth.headline }}</div>
            <div class="ft-admin-system-subtitle">
              {{ systemHealth.globalTone == 'success' ? 'La plateforme reste dans une zone saine et maitrisee.' : (systemHealth.globalTone == 'warning' ? 'Un drift moyen merite une surveillance rapprochee.' : 'Le systeme montre des signaux de risque plus eleves que la normale.') }}
            </div>
          </div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-sm-6">
            <div class="ft-admin-system-metric">
              <span>Fraude stable ou non</span>
              <strong>{{ systemHealth.avgFraudScore|number_format(1, ',', ' ') }}/100</strong>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="ft-admin-system-metric">
              <span>Drift moyen</span>
              <strong>{{ systemHealth.avgDrift|number_format(1, ',', ' ') }}</strong>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="ft-admin-system-metric">
              <span>Alertes critiques</span>
              <strong>{{ systemHealth.criticalAlerts }}</strong>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="ft-admin-system-metric">
              <span>Statut global</span>
              <strong>{{ systemHealth.globalStatus }}</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-lg-8">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Inscriptions hebdomadaires
        <span class="text-muted small ms-2">(8 dernières semaines)</span>
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-chart-container ft-chart-container-medium">
          <canvas id="weeklyChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-pie-chart-fill me-2 text-primary"></i>Répartition des comptes
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-chart-container ft-chart-container-small">
          <canvas id="statusChart"></canvas>
        </div>
        <div class="ft-admin-chart-legend">
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-green"></span>Actifs: {{ stats.actifs }}</div>
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-yellow"></span>En attente: {{ stats.attente }}</div>
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-red"></span>Suspendus: {{ stats.suspendus }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-lg-6">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-shield-fill-exclamation me-2 text-primary"></i>Répartition du risque client
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-chart-container ft-chart-container-small">
          <canvas id="riskChart"></canvas>
        </div>
        <div class="ft-admin-chart-legend">
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-green"></span>LOW: {{ riskBreakdown.LOW }}</div>
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-yellow"></span>MEDIUM: {{ riskBreakdown.MEDIUM }}</div>
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-red"></span>HIGH: {{ riskBreakdown.HIGH }}</div>
          <div class="ft-admin-legend-item"><span class="ft-admin-dot ft-admin-dot-red"></span>CRITICAL: {{ riskBreakdown.CRITICAL }}</div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-gem me-2 text-primary"></i>Segmentation automatique
      </div>
      <div class="ft-admin-card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="ft-admin-insight-card ft-admin-insight-card-approved">
              <div class="ft-admin-insight-icon"><i class="bi bi-gem"></i></div>
              <div class="ft-admin-insight-title">Clients VIP</div>
              <div class="ft-admin-insight-value">{{ stats.vip }}</div>
              <div class="ft-admin-insight-text">Clients à forte valeur, actifs et KYC approuvés.</div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ft-admin-insight-card ft-admin-insight-card-refused">
              <div class="ft-admin-insight-icon"><i class="bi bi-exclamation-triangle"></i></div>
              <div class="ft-admin-insight-title">Clients à risque</div>
              <div class="ft-admin-insight-value">{{ stats.atRisk }}</div>
              <div class="ft-admin-insight-text">À surveiller en priorité côté fraude, KYC ou activité inhabituelle.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-lg-6">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header">
        <i class="bi bi-bar-chart-line me-2 text-primary"></i>Inscriptions mensuelles
        <span class="text-muted small ms-2">(12 derniers mois)</span>
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-chart-container ft-chart-container-medium">
          <canvas id="monthlyChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="ft-admin-card h-100">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-check me-2 text-primary"></i>KYC en attente</span>
        {% if pendingKyc|length > 0 %}
          <span class="badge bg-warning text-dark rounded-pill px-3">{{ pendingKyc|length }}</span>
        {% endif %}
      </div>
      <div class="ft-admin-card-body p-0">
        {% if pendingKyc is empty %}
          <div class="text-center text-muted py-4">
            <i class="bi bi-check-circle fs-2 d-block mb-2 text-success"></i>
            Aucun dossier en attente
          </div>
        {% else %}
          <ul class="list-group list-group-flush">
            {% for kyc in pendingKyc|slice(0, 5) %}
              <li class="list-group-item d-flex align-items-center gap-3 py-3 px-4">
                <div class="ft-admin-avatar-sm">
                  {{ kyc.user.prenom|first|upper }}{{ kyc.user.nom|first|upper }}
                </div>
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-semibold small text-truncate">{{ kyc.user.fullName }}</div>
                  <div class="text-muted" style="font-size:.8rem">{{ kyc.dateSubmission|date('d/m/Y') }}</div>
                </div>
                <a href="{{ path('admin_kyc_view', {id: kyc.id}) }}" class="btn btn-sm ft-btn-outline-primary">
                  Examiner
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-xl-8">
    <div class="ft-admin-card h-100 ft-admin-copilot-main">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-shield-lock me-2 text-primary"></i>FinTrust Compliance Copilot</span>
        <span class="badge ft-badge-blue rounded-pill px-3">Analyse sans base additionnelle</span>
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-copilot-intro">
          <div>
            <div class="ft-admin-copilot-intro-kicker">
              <i class="bi bi-stars"></i>
              Assistant data analyst
            </div>
            <div class="ft-admin-copilot-intro-title">Analyses de conformite plus lisibles, plus rapides et plus credibles</div>
            <div class="ft-admin-copilot-intro-copy">Draft automatique, synthese des signaux, justification analytique et proposition de decision finale a partir des donnees deja presentes dans FinTrust.</div>
          </div>
          <span class="ft-admin-copilot-api-chip">API: POST /compliance/generate-review</span>
        </div>

        {% if complianceCases is empty %}
          <div class="text-center text-muted py-4">
            <i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>
            Aucun dossier n est disponible pour le copilot pour le moment.
          </div>
        {% else %}
          <div class="ft-admin-copilot-shell">
            {% for review in complianceCases %}
              <article class="ft-admin-copilot-case">
                <div class="ft-admin-copilot-case-head">
                  <div class="ft-admin-copilot-user">
                    <div class="ft-admin-copilot-avatar">
                      {{ review.profileName|split(' ')|map(v => v|first)|join('')|slice(0, 2)|upper }}
                    </div>
                    <div>
                      <div class="ft-admin-copilot-user-name">{{ review.profileName }}</div>
                      <div class="ft-admin-copilot-user-meta">{{ review.caseId }}{% if review.userId %} · Client #{{ review.userId }}{% endif %}</div>
                    </div>
                  </div>
                  <div class="ft-admin-copilot-badges">
                    <span class="badge {{ review.recommendedDecision == 'APPROVE' ? 'ft-badge-success' : (review.recommendedDecision == 'REJECT' ? 'ft-badge-danger' : 'ft-badge-warning') }}">{{ review.recommendedDecision }}</span>
                    <span class="badge {{ review.riskLevel in ['HIGH', 'CRITICAL'] ? 'ft-badge-danger' : (review.riskLevel == 'MEDIUM' ? 'ft-badge-warning' : 'ft-badge-blue') }}">{{ review.riskLevel }}</span>
                  </div>
                </div>

                <div class="ft-admin-copilot-summary">
                  <strong>Resume du dossier :</strong> {{ review.summary }}
                </div>

                <div class="ft-admin-copilot-grid">
                  <div class="ft-admin-copilot-panel">
                    <div class="ft-admin-copilot-panel-title">Signaux cles observes</div>
                    <ul class="ft-admin-copilot-list">
                      {% for signal in review.keySignals %}
                        <li>{{ signal }}</li>
                      {% endfor %}
                    </ul>
                  </div>
                  <div class="ft-admin-copilot-panel">
                    <div class="ft-admin-copilot-panel-title">Elements de vigilance</div>
                    {% if review.elementsOfVigilance is empty %}
                      <div class="small text-muted">Aucun element de vigilance majeur detecte.</div>
                    {% else %}
                      <ul class="ft-admin-copilot-list">
                        {% for item in review.elementsOfVigilance %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>

                <div class="ft-admin-copilot-justification">
                  <strong>Justification :</strong> {{ review.justification }}
                </div>
                <div class="ft-admin-copilot-review">{{ review.generatedReview }}</div>
              </article>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="ft-admin-card h-100 ft-admin-copilot-side">
      <div class="ft-admin-card-header">
        <i class="bi bi-journal-text me-2 text-primary"></i>Cas analytiques de reference
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-copilot-side-stack">
          {% for sample in complianceSamples|slice(0, 4) %}
            <article class="ft-admin-copilot-sample">
              <div class="ft-admin-copilot-sample-head">
                <div class="ft-admin-copilot-sample-title">{{ sample.label }}</div>
                <span class="badge {{ sample.recommendedDecision == 'APPROVE' ? 'ft-badge-success' : (sample.recommendedDecision == 'REJECT' ? 'ft-badge-danger' : 'ft-badge-warning') }}">{{ sample.recommendedDecision }}</span>
              </div>
              <div class="ft-admin-copilot-sample-risk">Risque {{ sample.riskLevel }}</div>
              <div class="ft-admin-copilot-sample-copy">{{ sample.justification }}</div>
              <ul class="ft-admin-copilot-list">
                {% for signal in sample.keySignals|slice(0, 2) %}
                  <li>{{ signal }}</li>
                {% endfor %}
              </ul>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-xl-5">
    <div class="ft-admin-card ft-admin-accent-card ft-admin-accent-card-notify h-100">
      <div class="ft-admin-card-header ft-admin-notify-header">
