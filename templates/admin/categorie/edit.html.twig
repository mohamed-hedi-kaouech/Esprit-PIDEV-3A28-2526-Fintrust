{% extends 'admin/back.html.twig' %}

{% block title %}Modifier la categorie{% endblock %}

{% block admin_content %}
{% set safetyMargin = categorie.budgetPrevu - categorie.seuilAlerte %}

<div class="container-fluid mt-4 ft-category-form-page">
    <section class="ft-category-form-hero mb-4">
        <div class="ft-category-form-hero-grid">
            <div>
                <span class="ft-category-form-kicker">
                    <i class="bi bi-pencil-square me-1"></i>Budget admin / edition
                </span>
                <h1 class="ft-category-form-title mb-3">Modifier la categorie</h1>
                <p class="ft-category-form-subtitle mb-0">
                    Ajustez les parametres budgetaires de {{ categorie.nomCategorie }} tout en gardant une vue immediate sur l impact.
                </p>
            </div>
            <div class="ft-category-form-hero-actions">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a href="{{ path('admin_categorie_show', {'idCategorie': categorie.idCategorie}) }}" class="btn ft-btn-primary">
                        <i class="fas fa-eye me-2"></i>Voir les details
                    </a>
                    <a href="{{ path('admin_categorie_list') }}" class="btn ft-btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Retour a la liste
                    </a>
                </div>
            </div>
        </div>
    </section>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="ft-category-form-card">
                <div class="ft-category-form-card-head">
                    <div>
                        <span class="ft-category-form-card-kicker">Mise a jour</span>
                        <h2>Parametres budgetaires</h2>
                    </div>
                    <span class="ft-category-form-chip">ID {{ categorie.idCategorie }}</span>
                </div>

                <div class="ft-category-form-fields">
                    <div class="ft-category-field">
                        <label for="{{ form.nomCategorie.vars.id }}" class="ft-category-label">
                            Nom de la categorie <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="fas fa-tag"></i></span>
                            {{ form_widget(form.nomCategorie, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Nom de la categorie'
                                }
                            }) }}
                        </div>
                        {{ form_errors(form.nomCategorie) }}
                        <small class="ft-category-help">Conservez un libelle simple a lire dans les alertes et les statistiques.</small>
                    </div>

                    <div class="ft-category-field">
                        <label for="{{ form.budgetPrevu.vars.id }}" class="ft-category-label">
                            Budget prevu (DT) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="fas fa-wallet"></i></span>
                            {{ form_widget(form.budgetPrevu, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': '0.00',
                                    'step': '0.01'
                                }
                            }) }}
                            <span class="input-group-text">DT</span>
                        </div>
                        {{ form_errors(form.budgetPrevu) }}
                        <small class="ft-category-help">Toute modification peut affecter les alertes existantes et la marge de securite.</small>
                    </div>

                    <div class="ft-category-field">
                        <label for="{{ form.seuilAlerte.vars.id }}" class="ft-category-label">
                            Seuil d alerte (DT) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="fas fa-bell"></i></span>
                            {{ form_widget(form.seuilAlerte, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': '0.00',
                                    'step': '0.01'
                                }
                            }) }}
                            <span class="input-group-text">DT</span>
                        </div>
                        {{ form_errors(form.seuilAlerte) }}
                        <small class="ft-category-help">Gardez le seuil sous le budget prevu pour proteger le pilotage budgetaire.</small>
                    </div>
                </div>

                <div class="ft-category-form-actions">
                    <button type="submit" class="btn ft-btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>Mettre a jour
                    </button>
                    <a href="{{ path('admin_categorie_show', {'idCategorie': categorie.idCategorie}) }}" class="btn ft-btn-outline-primary btn-lg">
                        <i class="fas fa-eye me-2"></i>Voir les details
                    </a>
                    <a href="{{ path('admin_categorie_list') }}" class="btn ft-btn-outline-primary btn-lg">
                        <i class="fas fa-times me-2"></i>Annuler
                    </a>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="ft-category-form-card ft-category-form-side">
                <div class="ft-category-form-card-head">
                    <div>
                        <span class="ft-category-form-card-kicker">Apercu instantane</span>
                        <h2>Projection des changements</h2>
                    </div>
                </div>

                <div class="ft-category-preview-stack">
                    <div class="ft-category-preview-box">
                        <span>Budget prevu</span>
                        <strong id="budget-preview">{{ categorie.budgetPrevu|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                    <div class="ft-category-preview-box">
                        <span>Seuil d alerte</span>
                        <strong id="seuil-preview">{{ categorie.seuilAlerte|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                    <div class="ft-category-preview-box">
                        <span>Marge de securite</span>
                        <strong id="marge-preview">{{ safetyMargin|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                    <div class="ft-category-preview-status" id="preview-status">
                        Ajustez le budget et le seuil pour maintenir une marge de securite cohérente.
                    </div>
                </div>
            </section>

            <section class="ft-category-form-card mt-4">
                <div class="ft-category-form-card-head">
                    <div>
                        <span class="ft-category-form-card-kicker">Reference actuelle</span>
                        <h2>Valeurs en place</h2>
                    </div>
                </div>

                <div class="ft-category-preview-stack">
                    <div class="ft-category-preview-box">
                        <span>Nom actuel</span>
                        <strong>{{ categorie.nomCategorie }}</strong>
                    </div>
                    <div class="ft-category-preview-box">
                        <span>Budget actuel</span>
                        <strong>{{ categorie.budgetPrevu|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                    <div class="ft-category-preview-box">
                        <span>Seuil actuel</span>
                        <strong>{{ categorie.seuilAlerte|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                </div>
            </section>
        </div>
    </div>
    {{ form_end(form) }}
</div>

<style>
.ft-category-form-page {
    padding-bottom: 2rem;
}

.ft-category-form-hero {
    border-radius: 28px;
    border: 1px solid rgba(59, 130, 246, 0.14);
    background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.18), transparent 28%),
        radial-gradient(circle at left center, rgba(37, 99, 235, 0.08), transparent 26%),
        linear-gradient(135deg, #ffffff 0%, #f8fbff 40%, #eef5ff 100%);
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    padding: 1.75rem;
}

.ft-category-form-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto;
    gap: 1.5rem;
    align-items: center;
}

.ft-category-form-kicker,
.ft-category-form-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: #2563eb;
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.ft-category-form-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -.04em;
}

.ft-category-form-subtitle {
    color: #64748b;
    max-width: 48rem;
    line-height: 1.7;
}

.ft-category-form-card {
    border-radius: 28px;
    border: 1px solid rgba(191, 219, 254, 0.9);
    background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(247,250,255,.96));
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    padding: 1.45rem;
}

.ft-category-form-card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.35rem;
}

.ft-category-form-card-head h2 {
    margin: .35rem 0 0;
    color: #0f172a;
    font-size: 1.35rem;
    font-weight: 800;
}

.ft-category-form-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .55rem .9rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
    font-size: .82rem;
    font-weight: 800;
}

.ft-category-form-fields {
    display: grid;
    gap: 1.25rem;
}

.ft-category-field {
    padding: 1rem 1.05rem;
    border-radius: 22px;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid rgba(219, 234, 254, 0.95);
}

.ft-category-label {
    display: block;
    margin-bottom: .7rem;
    color: #0f172a;
    font-weight: 800;
}

.ft-category-help {
    display: block;
    margin-top: .55rem;
    color: #64748b;
}

.ft-category-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
    margin-top: 1.35rem;
}

.ft-category-preview-stack {
    display: grid;
    gap: 1rem;
}

.ft-category-preview-box {
    padding: 1rem 1.05rem;
    border-radius: 20px;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid rgba(219, 234, 254, 0.95);
}

.ft-category-preview-box span {
    display: block;
    color: #64748b;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: .35rem;
}

.ft-category-preview-box strong {
    color: #0f172a;
    font-size: 1.2rem;
    font-weight: 800;
}

.ft-category-preview-status {
    padding: 1rem 1.05rem;
    border-radius: 20px;
    background: linear-gradient(135deg, #eff6ff, #eefcfb);
    border: 1px solid rgba(125, 211, 252, 0.55);
    color: #36527b;
    line-height: 1.65;
    font-weight: 600;
}

@media (max-width: 991.98px) {
    .ft-category-form-hero-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 575.98px) {
    .ft-category-form-hero,
    .ft-category-form-card {
        padding: 1.15rem;
        border-radius: 22px;
    }

    .ft-category-form-title {
        font-size: 1.8rem;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const budgetInput = document.getElementById('{{ form.budgetPrevu.vars.id }}');
    const seuilInput = document.getElementById('{{ form.seuilAlerte.vars.id }}');
    const budgetPreview = document.getElementById('budget-preview');
    const seuilPreview = document.getElementById('seuil-preview');
    const margePreview = document.getElementById('marge-preview');
    const statusPreview = document.getElementById('preview-status');

    const formatAmount = (value) => `${Number.parseFloat(value || '0').toFixed(2).replace('.', ',')} DT`;

    const updatePreview = () => {
        const budget = Number.parseFloat(budgetInput?.value || '0');
        const seuil = Number.parseFloat(seuilInput?.value || '0');
        const marge = budget - seuil;

        if (budgetPreview) budgetPreview.textContent = formatAmount(budget);
        if (seuilPreview) seuilPreview.textContent = formatAmount(seuil);
        if (margePreview) margePreview.textContent = formatAmount(marge);

        if (!statusPreview) {
            return;
        }

        if (budget > 0 && seuil >= budget) {
            statusPreview.textContent = 'Attention: le seuil atteint ou depasse le budget prevu.';
        } else if (budget > 0 && seuil >= budget * 0.8) {
            statusPreview.textContent = 'Zone de vigilance forte. Les prochaines depenses declencheront vite une alerte.';
        } else if (budget > 0) {
            statusPreview.textContent = 'La categorie conserve une marge de securite raisonnable apres modification.';
        } else {
            statusPreview.textContent = 'Renseignez les valeurs pour visualiser l impact budgetaire.';
        }
    };

    budgetInput?.addEventListener('input', updatePreview);
    seuilInput?.addEventListener('input', updatePreview);
    updatePreview();
});
</script>
{% endblock %}
