{% extends 'admin/back.html.twig' %}

{% block title %}Statistiques Budget Admin{% endblock %}

{% block admin_content %}
<div class="container-fluid mt-4 ft-admin-budget-page">
    <div class="ft-budget-hero">
        <div>
            <div class="ft-budget-eyebrow">Budget admin</div>
            <h1>Centre de pilotage budgetaire</h1>
            <p>Suivi global des categories, des seuils d alerte, des performances et de la recompense client.</p>
        </div>
        <div class="ft-budget-hero-actions">
            <a href="{{ path('admin_categorie_list') }}" class="btn ft-btn-outline-primary">
                <i class="fas fa-arrow-left me-2"></i>Retour categories
            </a>
            <a href="{{ path('admin_item_list') }}" class="btn ft-btn-primary">
                <i class="fas fa-list me-2"></i>Voir les items
            </a>
        </div>
    </div>

    <div class="ft-reward-banner {{ isEligible ? 'is-open' : 'is-locked' }}">
        <div class="ft-reward-banner-icon">
            <i class="fas {{ isEligible ? 'fa-gift' : 'fa-lock' }}"></i>
        </div>
        <div class="ft-reward-banner-content">
            <strong>{{ isEligible ? 'Recompense debloquee' : 'Recompense non encore debloquee' }}</strong>
            <p>{{ rewardReason }}</p>
        </div>
        {% if isEligible %}
            <form method="post" action="{{ path('admin_categorie_send_reward_sms') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('send_reward_sms') }}">
                <button type="submit" class="btn ft-reward-btn">
                    <i class="fas fa-sms me-2"></i>Envoyer le code promo
                </button>
            </form>
        {% else %}
            <div class="ft-reward-chip">{{ rewardSnapshot.blockedCount }} blocage(s)</div>
        {% endif %}
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xxl-8">
            <div class="ft-command-panel">
                <div class="ft-section-head">
                    <div>
                        <span class="ft-section-kicker">Pilotage</span>
                        <h3>Vue d ensemble instantanee</h3>
                    </div>
                    <span class="ft-command-state {{ isEligible ? 'is-live' : 'is-locked' }}">
                        {{ isEligible ? 'Tout est conforme' : 'Action admin requise' }}
                    </span>
                </div>
                <div class="ft-command-grid">
                    <div class="ft-command-box is-cyan">
                        <span>Score sante moyen</span>
                        <strong>{{ overview.averageHealth|number_format(1) }}/100</strong>
                        <small>{{ overview.healthyCount }} categorie(s) saines</small>
                    </div>
                    <div class="ft-command-box is-violet">
                        <span>Taux de conformite</span>
                        <strong>{{ rewardSnapshot.completionRate|number_format(0) }}%</strong>
                        <small>{{ rewardSnapshot.safeCount }}/{{ rewardSnapshot.categoriesChecked }} categorie(s) conformes</small>
                    </div>
                    <div class="ft-command-box is-orange">
                        <span>Seuils franchis</span>
                        <strong>{{ overview.overThresholdCount }}</strong>
                        <small>{{ overview.vigilanceCount }} en vigilance</small>
                    </div>
                    <div class="ft-command-box is-rose">
                        <span>Alertes actives</span>
                        <strong>{{ overview.totalAlertes }}</strong>
                        <small>{{ overview.criticalCount }} categorie(s) critiques</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xxl-4">
            <div class="ft-side-card">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Checklist</span>
                        <h3>Conditions de recompense</h3>
                    </div>
                </div>
                <div class="ft-checklist">
                    {% for check in rewardChecklist %}
                        <div class="ft-check-item {{ check.ok ? 'is-ok' : 'is-ko' }}">
                            <i class="fas {{ check.ok ? 'fa-check-circle' : 'fa-circle-exclamation' }}"></i>
                            <div>
                                <strong>{{ check.label }}</strong>
                                <p>{{ check.detail }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="ft-kpi-card is-green">
                <span>Budget total</span>
                <strong>{{ overview.totalBudget|number_format(2, ',', ' ') }} DT</strong>
                <small>Planification globale</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-kpi-card is-blue">
                <span>Total depense</span>
                <strong>{{ overview.totalSpent|number_format(2, ',', ' ') }} DT</strong>
                <small>{{ overview.globalUsage|number_format(1) }}% du budget</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-kpi-card is-purple">
                <span>Reste global</span>
                <strong>{{ overview.remainingBudget|number_format(2, ',', ' ') }} DT</strong>
                <small>{{ overview.averageSpend|number_format(0, ',', ' ') }} DT depense moyenne</small>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ft-kpi-card is-gold">
                <span>Items suivis</span>
                <strong>{{ overview.totalItems }}</strong>
                <small>{{ stats|length }} categorie(s)</small>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xxl-8">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Graphique mixte</span>
                        <h3>Budget vs depense vs seuil</h3>
                    </div>
                </div>
                <div class="ft-chart-wrap"><canvas id="budgetMixChart" height="110"></canvas></div>
            </div>
        </div>
        <div class="col-12 col-xxl-4">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Donut</span>
                        <h3>Repartition des depenses</h3>
                    </div>
                </div>
                <div class="ft-chart-wrap"><canvas id="budgetDonutAdminChart" height="220"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Courbe</span>
                        <h3>Usage budgetaire</h3>
                    </div>
                </div>
                <div class="ft-chart-wrap"><canvas id="budgetUsageLineChart" height="120"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Radar</span>
                        <h3>Performance par categorie</h3>
                    </div>
                </div>
                <div class="ft-chart-wrap"><canvas id="budgetRadarChart" height="120"></canvas></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Polar</span>
                        <h3>Pression des alertes</h3>
                    </div>
                </div>
                <div class="ft-chart-wrap"><canvas id="budgetPolarChart" height="160"></canvas></div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="ft-chart-card h-100">
                <div class="ft-section-head compact">
                    <div>
                        <span class="ft-section-kicker">Insights</span>
                        <h3>Lecture rapide</h3>
                    </div>
                </div>
                <div class="ft-insights-grid">
                    <div class="ft-insight-box">
                        <span class="ft-insight-label">Categorie la plus tendue</span>
                        <strong>{{ overview.topSpender ? overview.topSpender.categorie.nomCategorie : 'Aucune' }}</strong>
                        <p>{{ overview.topSpender ? overview.topSpender.totalAmount|number_format(2, ',', ' ') ~ ' DT pour ' ~ overview.topSpender.budgetUsage|number_format(1) ~ '% d usage.' : 'Pas assez de donnees.' }}</p>
                    </div>
                    <div class="ft-insight-box">
                        <span class="ft-insight-label">Categorie la mieux geree</span>
                        <strong>{{ overview.bestManaged ? overview.bestManaged.categorie.nomCategorie : 'Aucune' }}</strong>
                        <p>{{ overview.bestManaged ? 'Score sante ' ~ overview.bestManaged.healthScore|number_format(1) ~ '/100 avec ' ~ overview.bestManaged.alertesCount ~ ' alerte(s).' : 'Pas assez de donnees.' }}</p>
                    </div>
                    <div class="ft-mini-kpi"><span>Vigilance</span><strong>{{ overview.vigilanceCount }}</strong></div>
                    <div class="ft-mini-kpi"><span>Critiques</span><strong>{{ overview.criticalCount }}</strong></div>
                    <div class="ft-mini-kpi"><span>Sans depense</span><strong>{{ overview.zeroSpendCount }}</strong></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const labels = {{ chartData.labels|json_encode|raw }};
    const budgets = {{ chartData.budgets|json_encode|raw }};
    const spent = {{ chartData.spent|json_encode|raw }};
    const thresholds = {{ chartData.thresholds|json_encode|raw }};
    const usage = {{ chartData.usage|json_encode|raw }};
    const alerts = {{ chartData.alerts|json_encode|raw }};
    const items = {{ chartData.items|json_encode|raw }};
    const health = {{ chartData.health|json_encode|raw }};

    const palette = ['#2563eb', '#8b5cf6', '#06b6d4', '#f97316', '#10b981', '#ef4444', '#f59e0b', '#0ea5e9'];

    const sharedLegend = {
        labels: {
            usePointStyle: true,
            boxWidth: 10,
            color: '#475569',
            font: { family: 'Inter, sans-serif', size: 12, weight: '600' }
        }
    };

    const sharedScales = {
        x: {
            ticks: { color: '#64748b', font: { family: 'Inter, sans-serif' } },
            grid: { display: false }
        },
        y: {
            ticks: { color: '#64748b', font: { family: 'Inter, sans-serif' } },
            grid: { color: 'rgba(148, 163, 184, 0.18)' }
        }
    };

    const mixCanvas = document.getElementById('budgetMixChart');
    if (mixCanvas) {
        new Chart(mixCanvas, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Budget', data: budgets, backgroundColor: 'rgba(37,99,235,0.72)', borderRadius: 12 },
                    { label: 'Depense', data: spent, backgroundColor: 'rgba(6,182,212,0.82)', borderRadius: 12 },
                    { label: 'Seuil', data: thresholds, type: 'line', borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: 0.35, pointRadius: 4 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: sharedLegend }, scales: sharedScales }
        });
    }

    const donutCanvas = document.getElementById('budgetDonutAdminChart');
    if (donutCanvas) {
        new Chart(donutCanvas, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{ data: spent, backgroundColor: palette, borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', ...sharedLegend } } }
        });
    }

    const usageCanvas = document.getElementById('budgetUsageLineChart');
    if (usageCanvas) {
        new Chart(usageCanvas, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'Usage %',
                    data: usage,
                    borderColor: '#8b5cf6',
                    backgroundColor: 'rgba(139,92,246,0.16)',
                    fill: true,
                    tension: 0.36,
                    pointBackgroundColor: '#8b5cf6',
                    pointRadius: 4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: sharedLegend }, scales: sharedScales }
        });
    }

    const radarCanvas = document.getElementById('budgetRadarChart');
    if (radarCanvas) {
        new Chart(radarCanvas, {
            type: 'radar',
            data: {
                labels,
                datasets: [{
                    label: 'Score sante',
                    data: health,
                    borderColor: '#0ea5e9',
                    backgroundColor: 'rgba(14,165,233,0.18)',
                    pointBackgroundColor: '#0ea5e9'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: sharedLegend },
                scales: {
                    r: {
                        angleLines: { color: 'rgba(148,163,184,0.18)' },
                        grid: { color: 'rgba(148,163,184,0.18)' },
                        pointLabels: { color: '#475569' },
                        ticks: { backdropColor: 'transparent', color: '#64748b' },
                        suggestedMin: 0,
                        suggestedMax: 100
                    }
                }
            }
        });
    }

    const polarCanvas = document.getElementById('budgetPolarChart');
    if (polarCanvas) {
        new Chart(polarCanvas, {
            type: 'polarArea',
            data: {
                labels,
                datasets: [{
                    label: 'Pression',
                    data: labels.map((_, index) => (alerts[index] * 20) + (items[index] * 5) + usage[index]),
                    backgroundColor: palette.map((color) => color + 'bb'),
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', ...sharedLegend } },
                scales: {
                    r: {
                        ticks: { backdropColor: 'transparent', color: '#64748b' },
                        grid: { color: 'rgba(148,163,184,0.18)' }
                    }
                }
            }
        });
    }
});
</script>

