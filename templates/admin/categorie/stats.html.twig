{% extends 'admin/back.html.twig' %}

{% block title %}Statistiques Budgétaires{% endblock %}

{% block admin_content %}
<div class="container-fluid mt-5">
    <!-- Header avec navigation -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_dashboard') }}" class="text-decoration-none">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_categorie_list') }}" class="text-decoration-none">Catégories</a>
                    </li>
                    <li class="breadcrumb-item active">Statistiques</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark mb-2">
                <i class="fas fa-chart-bar text-primary me-3"></i>
                Statistiques Budgétaires
            </h1>
            <p class="text-muted">Analyse détaillée des budgets et performances par catégorie</p>
        </div>
        <div class="d-flex gap-3">
            <a href="{{ path('admin_categorie_list') }}" class="btn btn-secondary btn-lg">
                <i class="fas fa-arrow-left me-2"></i>Retour aux catégories
            </a>
            <a href="{{ path('admin_item_list') }}" class="btn btn-success btn-lg">
                <i class="fas fa-list me-2"></i>Voir tous les items
            </a>
        </div>
    </div>

    {# Bannière récompense SMS #}
    {% if isEligible %}
    <div class="alert d-flex align-items-center justify-content-between mb-4" style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); border: 2px solid #10b981; border-radius: 16px; padding: 1.25rem 1.5rem;">
        <div class="d-flex align-items-center gap-3">
            <span style="font-size: 2rem;">🎉</span>
            <div>
                <strong style="color: #065f46; font-size: 1.1rem;">Félicitations ! Vous êtes éligible à une récompense</strong>
                <p class="mb-0 text-muted small">Vous avez respecté votre budget et tous vos seuils de catégories ce mois-ci.</p>
            </div>
        </div>
        <form method="post" action="{{ path('admin_categorie_send_reward_sms') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('send_reward_sms') }}">
            <button type="submit" class="btn btn-lg" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 12px; font-weight: 700; white-space: nowrap;">
                <i class="fas fa-sms me-2"></i>Recevoir mon code promo par SMS
            </button>
        </form>
    </div>
    {% else %}
    <div class="alert d-flex align-items-center gap-3 mb-4" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border: 2px solid #f59e0b; border-radius: 16px; padding: 1.25rem 1.5rem;">
        <span style="font-size: 2rem;">📊</span>
        <div>
            <strong style="color: #92400e;">Récompense non encore débloquée</strong>
            <p class="mb-0 text-muted small">Respectez votre budget total et les seuils de chaque catégorie pour recevoir un code promo par SMS.</p>
        </div>
    </div>
    {% endif %}

    <!-- Statistiques globales -->
    <div class="row g-4 mb-5">
        {% set totalBudget = 0 %}
        {% set totalSpent = 0 %}
        {% set totalItems = 0 %}
        {% set totalAlertes = 0 %}
        {% for stat in stats %}
            {% set totalBudget = totalBudget + stat.categorie.budgetPrevu %}
            {% set totalSpent = totalSpent + stat.totalAmount %}
            {% set totalItems = totalItems + stat.itemCount %}
            {% set totalAlertes = totalAlertes + stat.alertesCount %}
        {% endfor %}
        {% set globalUsage = totalBudget > 0 ? (totalSpent / totalBudget * 100) : 0 %}

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="stats-overview-card budget-card">
                <div class="stats-icon">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ totalBudget|number_format(2, ',', ' ') }} DT</div>
                    <div class="stats-label">Budget Total</div>
                    <div class="stats-trend">
                        <i class="fas fa-coins text-success"></i>
                        Prévu global
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="stats-overview-card spent-card">
                <div class="stats-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ totalSpent|number_format(2, ',', ' ') }} DT</div>
                    <div class="stats-label">Total Dépensé</div>
                    <div class="stats-trend">
                        <i class="fas fa-arrow-up text-primary"></i>
                        {{ globalUsage|number_format(1) }}% utilisé
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="stats-overview-card items-card">
                <div class="stats-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ totalItems }}</div>
                    <div class="stats-label">Articles Total</div>
                    <div class="stats-trend">
                        <i class="fas fa-list text-info"></i>
                        {{ stats|length }} catégories
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="stats-overview-card categories-card">
                <div class="stats-icon">
                    <i class="fas fa-folder"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ stats|length }}</div>
                    <div class="stats-label">Total Catégories</div>
                    <div class="stats-trend">
                        <i class="fas fa-layer-group text-purple"></i>
                        Budgétaires
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Graphique global -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="global-chart-card">
                <div class="card-header-custom">
                    <div class="card-icon">
                        <i class="fas fa-chart-pie"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">Répartition Budgétaire Globale</h5>
                        <small class="text-muted">Utilisation par catégorie</small>
                    </div>
                </div>

                <div class="card-body-custom">
                    <div class="global-progress">
                        <div class="progress-legend">
                            {% for stat in stats %}
                                {% set percentage = stat.categorie.budgetPrevu > 0 ? (stat.totalAmount / stat.categorie.budgetPrevu * 100) : 0 %}
                                <div class="legend-item">
                                    <div class="legend-color" style="background: linear-gradient(135deg, #3b82f6, #1f6feb);"></div>
                                    <div class="legend-text">
                                        <strong>{{ stat.categorie.nomCategorie }}</strong>
                                        <small>{{ stat.totalAmount|number_format(2, ',', ' ') }} DT / {{ stat.categorie.budgetPrevu|number_format(2, ',', ' ') }} DT ({{ percentage|number_format(1) }}%)</small>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques par catégorie -->
    <div class="row g-4">
        {% for stat in stats %}
            <div class="col-xl-6 col-lg-6">
                <div class="category-stats-card">
                    <div class="card-header-custom">
                        <div class="card-icon">
                            <i class="fas fa-folder"></i>
                        </div>
                        <div class="category-info">
                            <h5 class="mb-0">{{ stat.categorie.nomCategorie }}</h5>
                            <small class="text-muted">ID: {{ stat.categorie.idCategorie }}</small>
                        </div>
                        <div class="category-status">
                            {% if stat.alertesCount > 0 %}
                                <span class="badge bg-danger">
                                    <i class="fas fa-exclamation-triangle me-1"></i>{{ stat.alertesCount }} alerte(s)
                                </span>
                            {% else %}
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>OK
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card-body-custom">
                        <div class="stats-grid">
                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-coins text-success"></i>
                                </div>
                                <div class="stat-details">
                                    <div class="stat-value">{{ stat.categorie.budgetPrevu|number_format(2, ',', ' ') }} DT</div>
                                    <div class="stat-label">Budget prévu</div>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-shopping-cart text-primary"></i>
                                </div>
                                <div class="stat-details">
                                    <div class="stat-value">{{ stat.totalAmount|number_format(2, ',', ' ') }} DT</div>
                                    <div class="stat-label">Total dépensé</div>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-tags text-info"></i>
                                </div>
                                <div class="stat-details">
                                    <div class="stat-value">{{ stat.itemCount }}</div>
                                    <div class="stat-label">Nombre d'items</div>
                                </div>
                            </div>

                            <div class="stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-exclamation-triangle text-warning"></i>
                                </div>
                                <div class="stat-details">
                                    <div class="stat-value">{{ stat.alertesCount }}</div>
                                    <div class="stat-label">Alertes actives</div>
                                </div>
                            </div>
                        </div>

                        <div class="budget-analysis">
                            <div class="analysis-header">
                                <span class="analysis-title">Utilisation du budget</span>
                                <span class="analysis-percentage">{{ stat.budgetUsage|number_format(1) }}%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar {{ stat.budgetUsage > 90 ? 'bg-danger' : (stat.budgetUsage > 75 ? 'bg-warning' : 'bg-success') }}"
                                     role="progressbar"
                                     style="width: {{ stat.budgetUsage }}%"
                                     aria-valuenow="{{ stat.budgetUsage }}"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <div class="analysis-details">
                                <div class="remaining-budget">
                                    {% set remaining = stat.categorie.budgetPrevu - stat.totalAmount %}
                                    <span class="remaining-label">Restant :</span>
                                    <span class="remaining-value {{ remaining < 0 ? 'text-danger' : 'text-success' }}">
                                        {{ remaining|number_format(2, ',', ' ') }} DT
                                    </span>
                                </div>
                                <div class="threshold-info">
                                    {% set threshold = stat.categorie.seuilAlerte %}
                                    <span class="threshold-label">Seuil d'alerte :</span>
                                    <span class="threshold-value">{{ threshold|number_format(2, ',', ' ') }} DT</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <a href="{{ path('admin_categorie_show', {'idCategorie': stat.categorie.idCategorie}) }}"
                               class="btn btn-sm btn-outline-info action-btn">
                                <i class="fas fa-eye me-1"></i>Voir détails
                            </a>
                            <a href="{{ path('admin_categorie_edit', {'idCategorie': stat.categorie.idCategorie}) }}"
                               class="btn btn-sm btn-outline-warning action-btn">
                                <i class="fas fa-edit me-1"></i>Modifier
                            </a>
                            <a href="{{ path('admin_item_list') }}?categorie={{ stat.categorie.idCategorie }}"
                               class="btn btn-sm btn-outline-primary action-btn">
                                <i class="fas fa-list me-1"></i>Voir items
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-4 mt-2 mb-5">
        <div class="col-xl-3 col-lg-6">
            <div class="stats-overview-card" style="background:linear-gradient(135deg,#ffffff 0%,#f8fafc 100%); border:2px solid rgba(15,23,42,.08);">
                <div class="stats-icon" style="background:linear-gradient(135deg,#0f172a,#334155); box-shadow:0 8px 20px rgba(15,23,42,.28);">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ overview.remainingBudget|number_format(2, ',', ' ') }} DT</div>
                    <div class="stats-label">Reste Global</div>
                    <div class="stats-trend">
                        <i class="fas fa-shield-heart {{ overview.remainingBudget >= 0 ? 'text-success' : 'text-danger' }}"></i>
                        {{ overview.averageBudget|number_format(0, ',', ' ') }} DT budget moyen
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6">
            <div class="stats-overview-card" style="background:linear-gradient(135deg,#ffffff 0%,#f5f3ff 100%); border:2px solid rgba(124,58,237,.14);">
                <div class="stats-icon" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9); box-shadow:0 8px 20px rgba(109,40,217,.25);">
                    <i class="fas fa-gauge-high"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ overview.averageUsage|number_format(1) }}%</div>
                    <div class="stats-label">Usage Moyen</div>
                    <div class="stats-trend">
                        <i class="fas fa-wave-square text-primary"></i>
                        {{ overview.engagementPerItem|number_format(2, ',', ' ') }} DT par item
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6">
            <div class="stats-overview-card" style="background:linear-gradient(135deg,#ffffff 0%,#fff7ed 100%); border:2px solid rgba(234,88,12,.14);">
                <div class="stats-icon" style="background:linear-gradient(135deg,#f97316,#ea580c); box-shadow:0 8px 20px rgba(234,88,12,.25);">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ overview.overThresholdCount }}</div>
                    <div class="stats-label">Seuils Franchis</div>
                    <div class="stats-trend">
                        <i class="fas fa-bell {{ overview.criticalCount > 0 ? 'text-danger' : 'text-success' }}"></i>
                        {{ overview.vigilanceCount }} vigilance
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6">
            <div class="stats-overview-card" style="background:linear-gradient(135deg,#ffffff 0%,#ecfeff 100%); border:2px solid rgba(6,182,212,.14);">
                <div class="stats-icon" style="background:linear-gradient(135deg,#06b6d4,#0ea5e9); box-shadow:0 8px 20px rgba(6,182,212,.25);">
                    <i class="fas fa-seedling"></i>
                </div>
                <div class="stats-content">
                    <div class="stats-value">{{ overview.healthyCount }}</div>
                    <div class="stats-label">Categories Saines</div>
                    <div class="stats-trend">
                        <i class="fas fa-circle-notch text-info"></i>
                        {{ overview.zeroSpendCount }} sans depense
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xxl-8">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-chart-column"></i></div>
                    <div><h5 class="mb-0">Budget vs Depense vs Seuil</h5><small class="text-muted">Vue mixte par categorie</small></div>
                </div>
                <div class="card-body-custom"><canvas id="budgetMixChart" height="110"></canvas></div>
            </div>
        </div>
        <div class="col-12 col-xxl-4">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-chart-pie"></i></div>
                    <div><h5 class="mb-0">Repartition des depenses</h5><small class="text-muted">Poids de chaque categorie</small></div>
                </div>
                <div class="card-body-custom"><canvas id="budgetDonutAdminChart" height="240"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-wave-square"></i></div>
                    <div><h5 class="mb-0">Courbe d'utilisation</h5><small class="text-muted">Evolution du taux d'usage</small></div>
                </div>
                <div class="card-body-custom"><canvas id="budgetUsageLineChart" height="120"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-compass-drafting"></i></div>
                    <div><h5 class="mb-0">Radar de performance</h5><small class="text-muted">Score de sante par categorie</small></div>
                </div>
                <div class="card-body-custom"><canvas id="budgetRadarChart" height="120"></canvas></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-bullseye"></i></div>
                    <div><h5 class="mb-0">Pression des alertes</h5><small class="text-muted">Alertes et densite d'items</small></div>
                </div>
                <div class="card-body-custom"><canvas id="budgetPolarChart" height="160"></canvas></div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="global-chart-card h-100">
                <div class="card-header-custom">
                    <div class="card-icon"><i class="fas fa-sparkles"></i></div>
                    <div><h5 class="mb-0">Insights rapides</h5><small class="text-muted">Lecture instantanee de la sante budgetaire</small></div>
                </div>
                <div class="card-body-custom">
                    <div class="row g-3">
                        <div class="col-md-6"><div class="insight-box"><span class="insight-kicker">Categorie la plus tendue</span><strong>{{ overview.topSpender ? overview.topSpender.categorie.nomCategorie : 'Aucune' }}</strong><p class="mb-0 text-muted small">{{ overview.topSpender ? overview.topSpender.totalAmount|number_format(2, ',', ' ') ~ ' DT pour ' ~ overview.topSpender.budgetUsage|number_format(1) ~ '% d usage.' : 'Pas assez de donnees.' }}</p></div></div>
                        <div class="col-md-6"><div class="insight-box"><span class="insight-kicker">Categorie la mieux geree</span><strong>{{ overview.bestManaged ? overview.bestManaged.categorie.nomCategorie : 'Aucune' }}</strong><p class="mb-0 text-muted small">{{ overview.bestManaged ? 'Score sante ' ~ overview.bestManaged.healthScore|number_format(1) ~ '/100 avec ' ~ overview.bestManaged.alertesCount ~ ' alerte(s).' : 'Pas assez de donnees.' }}</p></div></div>
                        <div class="col-md-4"><div class="mini-kpi"><span>Vigilance</span><strong>{{ overview.vigilanceCount }}</strong></div></div>
                        <div class="col-md-4"><div class="mini-kpi"><span>Critiques</span><strong>{{ overview.criticalCount }}</strong></div></div>
                        <div class="col-md-4"><div class="mini-kpi"><span>Depense moyenne</span><strong>{{ overview.averageSpend|number_format(0, ',', ' ') }} DT</strong></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const labels = {{ chartData.labels|json_encode|raw }};
    const budgets = {{ chartData.budgets|json_encode|raw }};
    const spent = {{ chartData.spent|json_encode|raw }};
    const thresholds = {{ chartData.thresholds|json_encode|raw }};
    const usage = {{ chartData.usage|json_encode|raw }};
    const alerts = {{ chartData.alerts|json_encode|raw }};
    const items = {{ chartData.items|json_encode|raw }};
    const health = {{ chartData.health|json_encode|raw }};

    const sharedLegend = {
        labels: {
            usePointStyle: true,
            boxWidth: 10,
            color: '#475569',
            font: { family: 'Inter, sans-serif', size: 12, weight: '600' }
        }
    };

    const sharedScales = {
        x: {
            ticks: { color: '#64748b', font: { family: 'Inter, sans-serif' } },
            grid: { display: false }
        },
        y: {
            ticks: { color: '#64748b', font: { family: 'Inter, sans-serif' } },
            grid: { color: 'rgba(148, 163, 184, 0.18)' }
        }
    };

    const mixCanvas = document.getElementById('budgetMixChart');
    if (mixCanvas) {
        new Chart(mixCanvas, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Budget', data: budgets, backgroundColor: 'rgba(59,130,246,0.72)', borderRadius: 10 },
                    { label: 'Depense', data: spent, backgroundColor: 'rgba(6,182,212,0.82)', borderRadius: 10 },
                    { label: 'Seuil', data: thresholds, type: 'line', borderColor: '#f59e0b', backgroundColor: '#f59e0b', tension: 0.35, pointRadius: 4, pointHoverRadius: 5 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: sharedLegend }, scales: sharedScales }
        });
    }

    const donutCanvas = document.getElementById('budgetDonutAdminChart');
    if (donutCanvas) {
        new Chart(donutCanvas, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{
                    data: spent,
                    backgroundColor: ['#2563eb', '#7c3aed', '#06b6d4', '#f97316', '#10b981', '#ef4444', '#8b5cf6', '#14b8a6'],
                    borderWidth: 0
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', ...sharedLegend } } }
        });
    }

    const usageCanvas = document.getElementById('budgetUsageLineChart');
    if (usageCanvas) {
        new Chart(usageCanvas, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'Usage %',
                    data: usage,
                    borderColor: '#7c3aed',
                    backgroundColor: 'rgba(124,58,237,0.16)',
                    fill: true,
                    tension: 0.36,
                    pointBackgroundColor: '#7c3aed',
                    pointRadius: 4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: sharedLegend }, scales: sharedScales }
        });
    }

    const radarCanvas = document.getElementById('budgetRadarChart');
    if (radarCanvas) {
        new Chart(radarCanvas, {
            type: 'radar',
            data: {
                labels,
                datasets: [{
                    label: 'Score sante',
                    data: health,
                    borderColor: '#0ea5e9',
                    backgroundColor: 'rgba(14,165,233,0.18)',
                    pointBackgroundColor: '#0ea5e9'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: sharedLegend },
                scales: { r: { angleLines: { color: 'rgba(148,163,184,0.18)' }, grid: { color: 'rgba(148,163,184,0.18)' }, pointLabels: { color: '#475569' }, ticks: { backdropColor: 'transparent', color: '#64748b' }, suggestedMin: 0, suggestedMax: 100 } }
            }
        });
    }

    const polarCanvas = document.getElementById('budgetPolarChart');
    if (polarCanvas) {
        new Chart(polarCanvas, {
            type: 'polarArea',
            data: {
                labels,
                datasets: [{
                    label: 'Pression',
