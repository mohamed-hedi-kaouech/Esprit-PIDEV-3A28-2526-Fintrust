{% extends 'admin/back.html.twig' %}

{% block title %}Gestion des Cat&eacute;gories{% endblock %}

{% block admin_content %}
<div class="container-fluid mt-4 ft-budget-admin-page">
    {% set totalItems = 0 %}
    {% for categorie in categories %}
        {% if categorie.items is iterable %}
            {% set totalItems = totalItems + categorie.items|length %}
        {% endif %}
    {% endfor %}

    <section class="ft-admin-hero ft-budget-admin-hero mb-4">
        <div class="ft-admin-hero-grid">
            <div>
                <span class="ft-admin-hero-kicker">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Budget admin / categories
                </span>
                <h1 class="ft-admin-page-title mb-3">Gestion des cat&eacute;gories</h1>
                <p class="ft-admin-hero-subtitle mb-0">
                    Organisez les postes budg&eacute;taires, surveillez les seuils d alerte et gardez une lecture claire des items relies.
                </p>
            </div>
            <div class="ft-admin-hero-panel">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end mb-3">
                    <a href="{{ path('admin_categorie_stats') }}" class="btn ft-btn-outline-primary">
                        <i class="fas fa-chart-bar me-2"></i>Statistiques
                    </a>
                    <a href="{{ path('admin_categorie_create') }}" class="btn ft-btn-primary">
                        <i class="fas fa-plus me-2"></i>Nouvelle cat&eacute;gorie
                    </a>
                    <a href="{{ path('admin_item_list') }}" class="btn ft-btn-outline-primary">
                        <i class="fas fa-list me-2"></i>Voir les items
                    </a>
                    <a href="{{ path('admin_categorie_pdf') }}" class="btn ft-btn-outline-primary">
                        <i class="fas fa-file-pdf me-2"></i>T&eacute;l&eacute;charger PDF
                    </a>
                </div>
                <div class="ft-admin-meta justify-content-lg-end">
                    <span><i class="bi bi-folder2-open"></i>{{ categories|length }} cat&eacute;gorie(s)</span>
                    <span><i class="bi bi-journal-text"></i>{{ totalItems }} item(s)</span>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue">
                <span class="ft-admin-kpi-mini-icon"><i class="bi bi-folder2-open"></i></span>
                <div class="ft-admin-kpi-mini-label">Total categories</div>
                <div class="ft-admin-kpi-mini-value">{{ categories|length }}</div>
                <div class="ft-admin-kpi-mini-text">Structure budgetaire actuellement disponible.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue">
                <span class="ft-admin-kpi-mini-icon"><i class="bi bi-journals"></i></span>
                <div class="ft-admin-kpi-mini-label">Total items</div>
                <div class="ft-admin-kpi-mini-value">{{ totalItems }}</div>
                <div class="ft-admin-kpi-mini-text">Volume total des lignes rattachees aux categories.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue-soft">
                <span class="ft-admin-kpi-mini-icon"><i class="bi bi-exclamation-diamond"></i></span>
                <div class="ft-admin-kpi-mini-label">Sous surveillance</div>
                <div class="ft-admin-kpi-mini-value">
                    {{ categories|filter(c => c.seuilAlerte > 0)|length }}
                </div>
                <div class="ft-admin-kpi-mini-text">Categories avec seuil d alerte configure.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-admin-kpi-mini ft-admin-kpi-mini-slate">
                <span class="ft-admin-kpi-mini-icon"><i class="bi bi-speedometer2"></i></span>
                <div class="ft-admin-kpi-mini-label">Vue budget</div>
                <div class="ft-admin-kpi-mini-value">FinTrust</div>
                <div class="ft-admin-kpi-mini-text">Meme langage visuel que le pilotage wallet.</div>
            </article>
        </div>
    </section>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if categories|length > 0 %}
        <section class="row g-4">
            {% for categorie in categories %}
                {% set usedBudget = 0 %}
                {% for item in categorie.items %}
                    {% set usedBudget = usedBudget + item.montant %}
                {% endfor %}
                {% set budgetPercentage = categorie.budgetPrevu > 0 ? (usedBudget / categorie.budgetPrevu * 100) : 0 %}
                {% set progressWidth = budgetPercentage > 100 ? 100 : budgetPercentage %}
                {% set progressState = budgetPercentage > 90 ? 'danger' : (budgetPercentage > 75 ? 'warning' : 'healthy') %}

                <div class="col-xl-4 col-lg-6">
                    <article class="ft-budget-category-card h-100">
                        <div class="ft-budget-category-head">
                            <div class="ft-budget-category-icon">
                                <i class="fas fa-folder"></i>
                            </div>
                            <div class="ft-budget-category-meta">
                                <h3>{{ categorie.nomCategorie }}</h3>
                                <span>ID: {{ categorie.idCategorie }}</span>
                            </div>
                            <span class="ft-budget-chip">{{ categorie.items|length }} item(s)</span>
                        </div>

                        <div class="ft-budget-category-body">
                            <div class="ft-budget-stat-row">
                                <span>Budget pr&eacute;vu</span>
                                <strong>{{ categorie.budgetPrevu|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                            <div class="ft-budget-stat-row">
                                <span>Seuil d alerte</span>
                                <strong class="is-accent">{{ categorie.seuilAlerte|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                            <div class="ft-budget-stat-row">
                                <span>D&eacute;pens&eacute;</span>
                                <strong>{{ usedBudget|number_format(2, ',', ' ') }} DT</strong>
                            </div>

                            <div class="ft-budget-progress-zone">
                                <div class="ft-budget-progress-head">
                                    <span>Budget utilis&eacute;</span>
                                    <span>{{ budgetPercentage|number_format(1) }}%</span>
                                </div>
                                <div class="ft-budget-progress-track">
                                    <span class="is-{{ progressState }}" style="width: {{ progressWidth }}%;"></span>
                                </div>
                                <div class="ft-budget-progress-note">
                                    {{ usedBudget|number_format(2, ',', ' ') }} DT / {{ categorie.budgetPrevu|number_format(2, ',', ' ') }} DT
                                </div>
                            </div>
                        </div>

                        <div class="ft-budget-category-actions">
                            <a href="{{ path('admin_categorie_show', {'idCategorie': categorie.idCategorie}) }}"
                               class="btn ft-btn-outline-primary btn-sm" title="Voir les details">
                                <i class="fas fa-eye me-2"></i>Voir
                            </a>
                            <a href="{{ path('admin_categorie_edit', {'idCategorie': categorie.idCategorie}) }}"
                               class="btn ft-btn-outline-primary btn-sm" title="Modifier">
                                <i class="fas fa-edit me-2"></i>Modifier
                            </a>
                            <form method="post"
                                  action="{{ path('admin_categorie_delete', {'idCategorie': categorie.idCategorie}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Etes-vous sur de vouloir supprimer cette categorie ? Cela supprimera egalement les items associes.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.idCategorie) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                    <i class="fas fa-trash me-2"></i>Supprimer
                                </button>
                            </form>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </section>
    {% else %}
        <section class="ft-admin-card">
            <div class="ft-admin-card-body text-center py-5">
                <div class="ft-budget-empty-icon mx-auto mb-3">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h2 class="h4 mb-2">Aucune cat&eacute;gorie</h2>
                <p class="text-muted mb-4">Commencez par cr&eacute;er votre premi&egrave;re cat&eacute;gorie budg&eacute;taire.</p>
                <a href="{{ path('admin_categorie_create') }}" class="btn ft-btn-primary">
                    <i class="fas fa-plus me-2"></i>Cr&eacute;er une cat&eacute;gorie
                </a>
            </div>
        </section>
    {% endif %}
</div>

<style>
.ft-budget-admin-page {
    padding-bottom: 2rem;
}

.ft-budget-admin-hero {
    background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.12), transparent 30%),
        linear-gradient(135deg, #ffffff 0%, #f8fbff 36%, #eef5ff 100%);
    border: 1px solid rgba(59, 130, 246, 0.14);
}

.ft-admin-kpi-mini-blue-soft {
    background: linear-gradient(135deg, #ffffff, #eff6ff);
    border: 1px solid rgba(59, 130, 246, 0.14);
}

.ft-admin-kpi-mini-blue-soft .ft-admin-kpi-mini-icon {
    background: linear-gradient(135deg, #60a5fa, #2563eb);
    color: #fff;
}

.ft-admin-kpi-mini-slate {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #fff;
}

.ft-admin-kpi-mini-slate .ft-admin-kpi-mini-icon {
    background: linear-gradient(135deg, #2563eb, #60a5fa);
    color: #fff;
}

.ft-admin-kpi-mini-slate .ft-admin-kpi-mini-label,
.ft-admin-kpi-mini-slate .ft-admin-kpi-mini-text {
    color: rgba(255, 255, 255, 0.82);
}

.ft-admin-kpi-mini-slate .ft-admin-kpi-mini-value {
    color: #fff;
}

.ft-budget-category-card {
    background: #fff;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 24px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ft-budget-category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 50px rgba(37, 99, 235, 0.14);
}

.ft-budget-category-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.4rem;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
}

.ft-budget-category-icon {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #fff;
    box-shadow: 0 10px 22px rgba(37, 99, 235, 0.18);
    font-size: 1.15rem;
}

.ft-budget-category-meta {
    flex: 1;
}

.ft-budget-category-meta h3 {
    margin: 0 0 0.2rem;
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
}

.ft-budget-category-meta span {
    color: #64748b;
    font-size: 0.9rem;
}

.ft-budget-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.12);
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 800;
}

.ft-budget-category-body {
    padding: 1.35rem 1.4rem 1.1rem;
}

.ft-budget-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.78);
}

.ft-budget-stat-row:last-of-type {
    border-bottom: none;
}

.ft-budget-stat-row span {
    color: #334155;
    font-weight: 600;
}

.ft-budget-stat-row strong {
    color: #0f172a;
    font-weight: 800;
    font-size: 1rem;
}

.ft-budget-stat-row strong.is-accent {
    color: #2563eb;
}

.ft-budget-progress-zone {
    margin-top: 1rem;
    padding: 1rem 1.05rem;
    border-radius: 18px;
    background: linear-gradient(135deg, #f8fbff, #eef4ff);
    border: 1px solid rgba(191, 219, 254, 0.8);
}

.ft-budget-progress-head,
.ft-budget-progress-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
}

.ft-budget-progress-head {
    margin-bottom: 0.6rem;
    font-size: 0.88rem;
    color: #475569;
    font-weight: 700;
}

.ft-budget-progress-track {
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(191, 219, 254, 0.55);
    margin-bottom: 0.55rem;
}

.ft-budget-progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #1d4ed8, #2563eb, #38bdf8);
}

.ft-budget-progress-track span.is-warning {
    background: linear-gradient(90deg, #2563eb, #60a5fa);
}

.ft-budget-progress-track span.is-danger {
    background: linear-gradient(90deg, #1e3a8a, #1d4ed8);
}

.ft-budget-progress-note {
    justify-content: center;
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 700;
}

.ft-budget-category-actions {
    padding: 1rem 1.4rem 1.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    border-top: 1px solid rgba(226, 232, 240, 0.78);
    background: linear-gradient(180deg, #ffffff, #f8fbff);
}

.ft-budget-category-actions .btn {
    border-radius: 14px;
    font-weight: 700;
}

.ft-budget-empty-icon {
    width: 86px;
    height: 86px;
    border-radius: 24px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #dbeafe, #eff6ff);
    color: #2563eb;
    font-size: 2rem;
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% include 'admin/budget_ai/_widget.html.twig' %}
{% endblock %}
