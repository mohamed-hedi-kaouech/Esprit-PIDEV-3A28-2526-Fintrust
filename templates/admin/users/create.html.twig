{% extends 'admin/back.html.twig' %}
{% block title %}Ajouter un client{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <a href="{{ path('admin_user_list') }}" class="text-muted small text-decoration-none">Utilisateurs</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <span class="fw-semibold small">Ajouter un client</span>
{% endblock %}

{% block admin_content %}
<section class="ft-admin-hero mb-4">
  <div class="ft-admin-hero-grid">
    <div>
      <span class="ft-admin-hero-kicker">
        <i class="bi bi-person-plus-fill me-1"></i>Onboarding admin
      </span>
      <h1 class="ft-admin-page-title mb-3">Ajouter un nouveau client</h1>
      <p class="ft-admin-hero-subtitle mb-0">
        Creez un compte client proprement, fixez son statut initial et preparez des le depart un parcours d activation clair.
      </p>
    </div>
    <div class="ft-admin-hero-panel">
      <div class="d-flex flex-wrap gap-2 justify-content-lg-end mb-3">
        <a href="{{ path('admin_user_list') }}" class="btn ft-btn-outline-primary">
          <i class="bi bi-arrow-left me-2"></i>Retour a la liste
        </a>
      </div>
      <div class="ft-admin-meta justify-content-lg-end">
        <span><i class="bi bi-shield-check"></i>Creation encadree par validation Symfony</span>
        <span><i class="bi bi-lightning-charge"></i>Redirection directe vers la fiche client</span>
      </div>
    </div>
  </div>
</section>

<section class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue">
      <div class="ft-admin-kpi-mini-icon"><i class="bi bi-person-vcard"></i></div>
      <div class="ft-admin-kpi-mini-label">Identite client</div>
      <div class="ft-admin-kpi-mini-value">Nom + prenom</div>
      <div class="ft-admin-kpi-mini-text">Base du profil client et des communications futures.</div>
    </article>
  </div>
  <div class="col-sm-6 col-xl-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-green">
      <div class="ft-admin-kpi-mini-icon"><i class="bi bi-envelope-check"></i></div>
      <div class="ft-admin-kpi-mini-label">Coordonnees</div>
      <div class="ft-admin-kpi-mini-value">Email + tel</div>
      <div class="ft-admin-kpi-mini-text">Permet les echanges et les validations du compte.</div>
    </article>
  </div>
  <div class="col-sm-6 col-xl-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-amber">
      <div class="ft-admin-kpi-mini-icon"><i class="bi bi-key"></i></div>
      <div class="ft-admin-kpi-mini-label">Acces initial</div>
      <div class="ft-admin-kpi-mini-value">Mot de passe</div>
      <div class="ft-admin-kpi-mini-text">Un acces provisoire est defini des la creation.</div>
    </article>
  </div>
  <div class="col-sm-6 col-xl-3">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-red">
      <div class="ft-admin-kpi-mini-icon"><i class="bi bi-sliders"></i></div>
      <div class="ft-admin-kpi-mini-label">Cadre de suivi</div>
      <div class="ft-admin-kpi-mini-value">Statut + KYC</div>
      <div class="ft-admin-kpi-mini-text">Vous donnez le ton du workflow des le premier ecran.</div>
    </article>
  </div>
</section>

<div class="row g-4">
  <div class="col-xl-8">
    <div class="ft-admin-card">
      <div class="ft-admin-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-person-plus-fill me-2 text-primary"></i>Informations du client</span>
        <span class="ft-admin-status-chip ft-admin-status-info">Creation guidee</span>
      </div>
      <div class="ft-admin-card-body">
        {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'ft-user-create-form'}}) }}
          {{ form_errors(form) }}

          <div class="ft-user-create-section">
            <div class="ft-user-create-section-head">
              <div>
                <h2 class="ft-user-create-section-title">Identite et contact</h2>
                <p class="ft-user-create-section-text mb-0">Saisissez les informations qui serviront de base au profil public et aux interactions clients.</p>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                {{ form_label(form.prenom, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.prenom, {attr: {class: 'form-control ft-input', placeholder: 'Ex: Ines'}}) }}
                <div class="form-text">Le prenom apparaitra sur la fiche client et dans les notifications.</div>
                <div class="text-danger small mt-1">{{ form_errors(form.prenom) }}</div>
              </div>
              <div class="col-md-6">
                {{ form_label(form.nom, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.nom, {attr: {class: 'form-control ft-input', placeholder: 'Ex: Ben Ali'}}) }}
                <div class="form-text">Le nom complet servira pour le suivi back-office et les exports.</div>
                <div class="text-danger small mt-1">{{ form_errors(form.nom) }}</div>
              </div>
            </div>

            <div class="mb-3">
              {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
              {{ form_widget(form.email, {attr: {class: 'form-control ft-input', placeholder: 'client@fintrust.tn'}}) }}
              <div class="form-text">Utilisez une adresse active pour faciliter la verification et les recuperations futures.</div>
              <div class="text-danger small mt-1">{{ form_errors(form.email) }}</div>
            </div>

            <div class="mb-0">
              {{ form_label(form.numTel, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
              {{ form_widget(form.numTel, {attr: {class: 'form-control ft-input', placeholder: '+216 12 345 678'}}) }}
              <div class="form-text">Le numero permet un suivi plus rapide des echanges et du support client.</div>
              <div class="text-danger small mt-1">{{ form_errors(form.numTel) }}</div>
            </div>
          </div>

          <div class="ft-user-create-section">
            <div class="ft-user-create-section-head">
              <div>
                <h2 class="ft-user-create-section-title">Acces et statut initial</h2>
                <p class="ft-user-create-section-text mb-0">Cadrez l acces initial du client ainsi que son point de depart dans le workflow KYC.</p>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                {{ form_label(form.plainPassword, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.plainPassword, {attr: {class: 'form-control ft-input', placeholder: 'Minimum 8 caracteres'}}) }}
                <div class="form-text">Choisissez un mot de passe provisoire que le client pourra modifier ensuite.</div>
                <div class="text-danger small mt-1">{{ form_errors(form.plainPassword) }}</div>
              </div>
              <div class="col-md-6">
                <div class="ft-user-create-password-note">
                  <div class="ft-user-create-password-icon"><i class="bi bi-shield-lock"></i></div>
                  <div>
                    <strong>Bonne pratique</strong>
                    <p class="mb-0">Combinez un mot de passe temporaire fiable avec une verification e-mail rapide apres creation.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="row g-3 mb-0">
              <div class="col-md-6">
                {{ form_label(form.status, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.status, {attr: {class: 'form-select ft-input'}}) }}
                <div class="form-text">Definit la disponibilite immediate du compte apres creation.</div>
                <div class="text-danger small mt-1">{{ form_errors(form.status) }}</div>
              </div>
              <div class="col-md-6">
                {{ form_label(form.kycStatus, null, {label_attr: {class: 'form-label fw-semibold small'}}) }}
                {{ form_widget(form.kycStatus, {attr: {class: 'form-select ft-input'}}) }}
                <div class="form-text">Positionne le client dans le bon niveau de suivi KYC des le depart.</div>
                <div class="text-danger small mt-1">{{ form_errors(form.kycStatus) }}</div>
              </div>
            </div>
          </div>

          <div class="ft-user-create-actions">
            <button type="submit" class="btn ft-btn-primary">
              <i class="bi bi-check2-circle me-2"></i>Creer le client
            </button>
            <a href="{{ path('admin_user_list') }}" class="btn ft-btn-outline-primary">
              <i class="bi bi-arrow-left me-2"></i>Retour a la liste
            </a>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="d-grid gap-4">
      <div class="ft-admin-card">
        <div class="ft-admin-card-header">
          <i class="bi bi-stars me-2 text-primary"></i>Ce que l admin controle
        </div>
        <div class="ft-admin-card-body">
          <div class="ft-admin-insight-list">
            <div class="ft-admin-insight-item">
              <strong>Activation immediate</strong>
              <span>Le client peut etre cree directement actif, en attente ou suspendu selon le contexte.</span>
            </div>
            <div class="ft-admin-insight-item">
              <strong>KYC prepare</strong>
              <span>Vous pouvez definir un statut KYC initial pour cadrer le workflow des verifications.</span>
            </div>
            <div class="ft-admin-insight-item">
              <strong>Suivi rapide</strong>
              <span>Apres creation, vous arrivez directement sur la fiche complete du client pour poursuivre les actions.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="ft-admin-card">
        <div class="ft-admin-card-header">
          <i class="bi bi-check2-square me-2 text-primary"></i>Checklist avant creation
        </div>
        <div class="ft-admin-card-body">
          <ul class="ft-user-create-checklist mb-0">
            <li>Verifier que l e-mail n existe pas deja dans la base clients.</li>
            <li>Choisir un statut de compte coherent avec la situation du client.</li>
            <li>Positionner le bon niveau KYC pour eviter les blocages de workflow.</li>
            <li>Prevoir un mot de passe provisoire suffisamment fiable.</li>
          </ul>
        </div>
      </div>

      <div class="ft-admin-card ft-user-create-aside-card">
        <div class="ft-admin-card-body">
          <div class="ft-user-create-aside-icon"><i class="bi bi-lightning-charge-fill"></i></div>
          <h3 class="h5 fw-bold mb-2">Creation admin acceleree</h3>
          <p class="text-muted mb-0">
            Cette page est pensee pour un onboarding rapide sans sacrifier la qualite du suivi client dans FinTrust.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ft-user-create-form {
    display: grid;
    gap: 1.4rem;
  }

  .ft-user-create-section {
    padding: 1.2rem;
    border-radius: 22px;
    border: 1px solid rgba(21, 96, 189, .08);
    background:
      radial-gradient(circle at top right, rgba(59, 130, 246, .16), transparent 30%),
      radial-gradient(circle at bottom left, rgba(14, 165, 233, .08), transparent 28%),
      linear-gradient(180deg, #ffffff, #f7fbff);
    box-shadow: 0 18px 40px rgba(15, 23, 42, .06);
  }

  .ft-user-create-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .ft-user-create-section-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f2f6b;
    margin-bottom: .25rem;
  }

  .ft-user-create-section-text {
    color: #64748b;
    font-size: .94rem;
  }

  .ft-user-create-password-note {
    height: 100%;
    display: flex;
    gap: .9rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: 18px;
    border: 1px solid rgba(37, 99, 235, .14);
    background:
      radial-gradient(circle at top right, rgba(59, 130, 246, .18), transparent 35%),
      linear-gradient(135deg, #f8fbff, #edf4ff 58%, #e0efff);
    color: #24456f;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
  }

  .ft-user-create-password-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #dbeafe, #93c5fd 55%, #60a5fa);
    color: #1e40af;
    flex-shrink: 0;
    box-shadow: 0 14px 26px rgba(37, 99, 235, .16);
  }

  .ft-user-create-actions {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .ft-user-create-checklist {
    list-style: none;
    padding: 0;
    display: grid;
    gap: .85rem;
  }

  .ft-user-create-checklist li {
    position: relative;
    padding-left: 1.7rem;
    color: #475569;
    line-height: 1.55;
  }

  .ft-user-create-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
    box-shadow: 0 0 0 7px rgba(37, 99, 235, .1);
  }

  .ft-user-create-aside-card {
    background:
      radial-gradient(circle at top right, rgba(59,130,246,.2), transparent 34%),
      radial-gradient(circle at bottom left, rgba(16,185,129,.14), transparent 26%),
      linear-gradient(135deg, #ffffff, #eef5ff 55%, #e8f7f1);
    border-color: rgba(37, 99, 235, .12);
  }

  .ft-user-create-aside-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #bfdbfe, #60a5fa 58%, #34d399);
    color: #1e3a8a;
    font-size: 1.35rem;
    margin-bottom: 1rem;
    box-shadow: 0 16px 30px rgba(37, 99, 235, .18);
  }

  .ft-user-create-form .form-text {
    color: #4f6686;
  }

  .ft-user-create-form .ft-input,
  .ft-user-create-form .form-select {
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    border-color: rgba(148, 163, 184, .34);
  }

  .ft-user-create-form .ft-input:focus,
  .ft-user-create-form .form-select:focus {
    border-color: #60a5fa;
    box-shadow:
      0 0 0 4px rgba(59, 130, 246, .12),
      0 10px 24px rgba(37, 99, 235, .08);
  }

  .ft-user-create-actions .ft-btn-primary {
    padding-inline: 1.4rem;
    box-shadow: 0 14px 28px rgba(37, 99, 235, .2);
  }

  .ft-user-create-actions .ft-btn-outline-primary {
    background: rgba(255,255,255,.72);
  }

  .ft-user-create-section:first-of-type {
    background:
      radial-gradient(circle at top right, rgba(59, 130, 246, .18), transparent 28%),
      radial-gradient(circle at left bottom, rgba(168, 85, 247, .08), transparent 24%),
      linear-gradient(180deg, #ffffff, #f7fbff);
  }

  .ft-user-create-section:last-of-type {
    background:
      radial-gradient(circle at top right, rgba(59, 130, 246, .14), transparent 30%),
      radial-gradient(circle at bottom left, rgba(16, 185, 129, .12), transparent 24%),
      linear-gradient(180deg, #ffffff, #f8fcff);
  }

  @media (max-width: 767.98px) {
    .ft-user-create-section {
      padding: 1rem;
      border-radius: 18px;
    }

    .ft-user-create-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
{% endblock %}