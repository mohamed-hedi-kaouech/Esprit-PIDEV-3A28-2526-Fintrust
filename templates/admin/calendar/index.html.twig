{% extends 'admin/back.html.twig' %}

{% block title %}Calendrier admin{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <span class="text-muted small mx-2">/</span>
  <span class="fw-semibold text-primary small">Calendrier</span>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-calendar-page {
      --ft-cal-navy: #0f2f78;
      --ft-cal-blue: #2166f3;
      --ft-cal-sky: #eef5ff;
      --ft-cal-border: rgba(205, 222, 252, .96);
      --ft-cal-shadow: 0 24px 60px rgba(15, 40, 98, .08);
      --ft-cal-text-soft: #7589b0;
    }

    .ft-calendar-kpi {
      border-radius: 22px;
      border: 1px solid var(--ft-cal-border);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,255,.96));
      box-shadow: var(--ft-cal-shadow);
      padding: 1.1rem 1.15rem;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-kpi:hover,
    .ft-calendar-main-card:hover,
    .ft-calendar-todo-card:hover,
    .ft-calendar-quick-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 28px 64px rgba(15, 40, 98, .11);
    }

    .ft-calendar-kpi-head {
      display: flex;
      align-items: center;
      gap: .95rem;
    }

    .ft-calendar-kpi-icon {
      width: 54px;
      height: 54px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.25rem;
      box-shadow: 0 14px 26px rgba(17,24,39,.10);
      flex-shrink: 0;
    }

    .ft-calendar-kpi-icon.blue { background: linear-gradient(135deg, #2166f3, #0f56e8); }
    .ft-calendar-kpi-icon.orange { background: linear-gradient(135deg, #ffb11f, #ff8c00); }
    .ft-calendar-kpi-icon.green { background: linear-gradient(135deg, #24c777, #14a85e); }
    .ft-calendar-kpi-icon.red { background: linear-gradient(135deg, #ff6074, #ff3b57); }
    .ft-calendar-kpi-icon.indigo { background: linear-gradient(135deg, #265cf2, #2341d0); }

    .ft-calendar-kpi-label {
      color: #7e90b6;
      font-weight: 700;
      font-size: .92rem;
      margin-bottom: .2rem;
    }

    .ft-calendar-kpi-value {
      font-size: 2.1rem;
      line-height: 1;
      font-weight: 800;
      color: #112756;
      letter-spacing: -.04em;
    }

    .ft-calendar-kpi-foot {
      margin-top: .75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .5rem;
      color: var(--ft-cal-text-soft);
      font-size: .88rem;
    }

    .ft-calendar-kpi-delta {
      font-weight: 800;
    }

    .ft-calendar-kpi-delta.up { color: #16a34a; }
    .ft-calendar-kpi-delta.down { color: #f97316; }

    .ft-calendar-main-card,
    .ft-calendar-todo-card,
    .ft-calendar-quick-card {
      border-radius: 24px;
      border: 1px solid var(--ft-cal-border);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,251,255,.96));
      box-shadow: var(--ft-cal-shadow);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-main-card {
      padding: 1.25rem;
    }

    .ft-calendar-todo-card {
      padding: 1.15rem;
    }

    .ft-calendar-topline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .ft-calendar-title-wrap h1 {
      margin: 0;
      font-size: 1.55rem;
      font-weight: 800;
      color: #112756;
    }

    .ft-calendar-title-wrap p {
      margin: .35rem 0 0;
      color: var(--ft-cal-text-soft);
      max-width: 40rem;
      line-height: 1.6;
    }

    .ft-calendar-filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
    }

    .ft-calendar-pill {
      border: 1px solid rgba(216,228,255,.96);
      background: #fff;
      color: #5e7298;
      font-size: .8rem;
      font-weight: 800;
      border-radius: 999px;
      padding: .48rem .8rem;
      box-shadow: 0 8px 20px rgba(15, 40, 98, .05);
    }

    .ft-calendar-pill.active {
      background: linear-gradient(135deg, #2166f3, #0f56e8);
      color: #fff;
      border-color: transparent;
    }

    .ft-calendar-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(320px, .9fr);
      gap: 1.4rem;
      align-items: start;
    }

    .ft-calendar-shell {
      border-radius: 20px;
      border: 1px solid rgba(216,228,255,.96);
      background: #fff;
      padding: 1rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .ft-calendar-todo-shell {
      margin-top: 1.4rem;
      border: 1px solid rgba(191, 219, 254, .95);
      border-radius: 1.7rem;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, .11), transparent 24%),
        radial-gradient(circle at top left, rgba(255, 255, 255, .95), transparent 28%),
        linear-gradient(135deg, #ffffff, #f8fbff 58%, #eef5ff 100%);
      box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
      padding: 1.55rem;
    }

    .ft-calendar-todo-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 520px;
      align-items: start;
      gap: 1.4rem;
      margin-bottom: 1.5rem;
    }

    .ft-calendar-todo-kicker {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      color: #7c3aed;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      font-size: .72rem;
      margin-bottom: .45rem;
    }

    .ft-calendar-todo-title {
      color: #0f172a;
      font-weight: 900;
      margin: 0 0 .35rem;
      font-size: clamp(2rem, 3vw, 3.15rem);
      line-height: 1.04;
    }

    .ft-calendar-todo-subtitle {
      margin: 0;
      color: #64748b;
      font-size: 1rem;
    }

    .ft-calendar-energy {
      min-height: 245px;
      padding: 1.45rem 1.55rem;
      border-radius: 1.8rem;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,.18), transparent 24%),
        linear-gradient(135deg, #2449f4, #4c42ec 54%, #6d28d9 100%);
      color: #fff;
      box-shadow: 0 22px 44px rgba(37, 99, 235, .24);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .ft-calendar-energy-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      font-size: .82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
      opacity: .95;
    }

    .ft-calendar-energy strong {
      display: block;
      margin-top: .6rem;
      font-size: 4rem;
      line-height: 1;
    }

    .ft-calendar-energy-bar {
      margin-top: 1rem;
      height: .9rem;
      border-radius: 999px;
      background: rgba(255,255,255,.22);
      overflow: hidden;
    }

    .ft-calendar-energy-bar > span {
      display: block;
      height: 100%;
      width: 36%;
      border-radius: inherit;
      background: linear-gradient(90deg, #facc15, #f97316, #fb7185);
      transition: width .25s ease;
    }

    .ft-calendar-energy-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-top: 1.2rem;
      color: rgba(255,255,255,.92);
      font-weight: 700;
    }

    .ft-calendar-energy-bolt {
      width: 4.25rem;
      height: 4.25rem;
      border-radius: 1.4rem;
      display: grid;
      place-items: center;
      background: rgba(255,255,255,.14);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
      font-size: 2rem;
    }

    .ft-calendar-todo-topline {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
      gap: 1rem;
      margin-bottom: 1.35rem;
    }

    .ft-calendar-selector-card,
    .ft-calendar-detected-card {
      border: 1px solid rgba(191, 219, 254, .88);
      border-radius: 1.15rem;
      background: rgba(255,255,255,.92);
      box-shadow: 0 16px 34px rgba(15, 23, 42, .05);
      padding: 1rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .ft-calendar-selector-copy,
    .ft-calendar-detected-copy {
      display: flex;
      align-items: center;
      gap: .9rem;
      color: #0f172a;
      font-weight: 800;
    }

    .ft-calendar-selector-copy i,
    .ft-calendar-detected-copy i {
      width: 2.55rem;
      height: 2.55rem;
      border-radius: .95rem;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #f8fbff, #eef4ff);
      color: #4f46e5;
      font-size: 1.15rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .ft-calendar-selector-date {
      font-size: 1rem;
      font-weight: 800;
    }

    .ft-calendar-selector-chevron,
    .ft-calendar-detected-pill {
      color: #64748b;
      font-weight: 800;
    }

    .ft-calendar-detected-card {
      background: linear-gradient(135deg, rgba(244,247,255,.96), rgba(239,246,255,.96));
    }

    .ft-calendar-detected-pill {
      border-radius: 999px;
      background: #e0e7ff;
      color: #4f46e5;
      padding: .32rem .72rem;
      font-size: .8rem;
    }

    .ft-calendar-todo-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(420px, .92fr);
      gap: 1.1rem;
    }

    .ft-calendar-todo-panel,
    .ft-calendar-day-brief {
      border: 1px solid rgba(191, 219, 254, .65);
      border-radius: 1.45rem;
      background: rgba(255,255,255,.9);
      padding: 1.3rem;
      box-shadow: 0 18px 38px rgba(15, 23, 42, .05);
    }

    .ft-calendar-day-brief {
      background: linear-gradient(135deg, rgba(248, 251, 255, .98), rgba(255,255,255,.98));
    }

    .ft-calendar-day-brief h3,
    .ft-calendar-todo-panel h3 {
      margin: 0 0 .35rem;
      color: #0f172a;
      font-size: 1rem;
      font-weight: 900;
    }

    .ft-calendar-day-brief p,
    .ft-calendar-todo-panel p {
      margin: 0;
      color: #64748b;
      font-size: .9rem;
      line-height: 1.55;
    }

    .ft-calendar-day-brief-list {
      display: grid;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .ft-calendar-brief-item {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1rem;
      border-radius: 1.2rem;
      background: rgba(255,255,255,.95);
      border: 1px solid rgba(191, 219, 254, .7);
      box-shadow: 0 16px 34px rgba(15, 23, 42, .04);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-brief-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 38px rgba(15, 23, 42, .08);
    }

    .ft-calendar-brief-icon {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 1rem;
      display: grid;
      place-items: center;
      font-size: 1.55rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95);
    }

    .ft-calendar-brief-icon.events {
      background: linear-gradient(135deg, rgba(59,130,246,.12), rgba(99,102,241,.14));
      color: #4338ca;
    }

    .ft-calendar-brief-icon.done {
      background: linear-gradient(135deg, rgba(34,197,94,.10), rgba(16,185,129,.14));
      color: #16a34a;
    }

    .ft-calendar-brief-icon.pending {
      background: linear-gradient(135deg, rgba(251,191,36,.14), rgba(249,115,22,.16));
      color: #f59e0b;
    }

    .ft-calendar-brief-item strong {
      display: block;
      color: #0f172a;
      font-size: 1rem;
    }

    .ft-calendar-brief-item span {
      color: #64748b;
      font-size: .9rem;
    }

    .ft-calendar-brief-pill {
      border-radius: 999px;
      padding: .7rem .92rem;
      font-size: 1.05rem;
      font-weight: 800;
      min-width: 3.7rem;
      text-align: center;
      background: linear-gradient(135deg, #eff6ff, #e0e7ff);
      color: #2563eb;
      white-space: nowrap;
    }

    .ft-calendar-brief-arrow {
      color: #64748b;
      font-size: 1.55rem;
      line-height: 1;
    }

    .ft-calendar-todo-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: .75rem;
      margin: 1rem 0;
    }

    .ft-calendar-todo-actions {
      display: grid;
      grid-template-columns: 220px auto;
      gap: .75rem;
      align-items: center;
    }

    .ft-calendar-todo-input,
    .ft-calendar-todo-select {
      border-radius: 1rem;
      border: 1px solid rgba(191, 219, 254, .95);
      background: #fff;
      min-height: 54px;
      padding: .9rem 1rem;
      color: #0f172a;
      font-weight: 600;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .ft-calendar-todo-btn {
      border: 0;
      border-radius: 1rem;
      min-height: 54px;
      padding: .85rem 1.1rem;
      font-weight: 800;
      color: #fff;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      box-shadow: 0 16px 28px rgba(37, 99, 235, .18);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-todo-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 34px rgba(37, 99, 235, .24);
    }

    .ft-calendar-todo-list {
      display: grid;
      gap: .75rem;
      margin-top: .8rem;
    }

    .ft-calendar-todo-illustration {
      margin-top: 1.2rem;
      padding-top: 1rem;
      text-align: center;
      color: #64748b;
    }

    .ft-calendar-todo-illustration-graphic {
      width: 9rem;
      height: 9rem;
      margin: 0 auto 1rem;
      border-radius: 2rem;
      position: relative;
      background:
        radial-gradient(circle at center, rgba(99,102,241,.12), transparent 62%),
        linear-gradient(135deg, rgba(239,246,255,.95), rgba(248,250,252,.95));
      display: grid;
      place-items: center;
    }

    .ft-calendar-todo-illustration-graphic::before {
      content: '\f4ca';
      font-family: "bootstrap-icons";
      font-size: 3.4rem;
      color: #818cf8;
    }

    .ft-calendar-todo-illustration strong {
      display: block;
      color: #0f172a;
      font-size: 1.25rem;
      margin-bottom: .35rem;
    }

    .ft-calendar-todo-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: .8rem;
      align-items: center;
      padding: .9rem;
      border-radius: 1rem;
      background: #fff;
      border: 1px solid rgba(191, 219, 254, .75);
      box-shadow: 0 14px 26px rgba(15, 23, 42, .05);
    }

    .ft-calendar-todo-item.is-done {
      opacity: .72;
      background: linear-gradient(135deg, rgba(236,253,245,.85), rgba(255,255,255,.96));
    }

    .ft-calendar-todo-check {
      width: 1.15rem;
      height: 1.15rem;
      accent-color: #2563eb;
    }

    .ft-calendar-todo-copy strong {
      display: block;
      color: #0f172a;
      font-size: .95rem;
      font-weight: 800;
    }

    .ft-calendar-todo-copy span {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      margin-top: .35rem;
      color: #64748b;
      font-size: .8rem;
      flex-wrap: wrap;
    }

    .ft-calendar-priority {
      display: inline-flex;
      align-items: center;
      padding: .22rem .55rem;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 800;
    }

    .ft-calendar-priority.low { background: rgba(34, 197, 94, .14); color: #15803d; }
    .ft-calendar-priority.medium { background: rgba(245, 158, 11, .16); color: #b45309; }
    .ft-calendar-priority.high { background: rgba(239, 68, 68, .14); color: #b91c1c; }

    .ft-calendar-todo-remove {
      width: 2.3rem;
      height: 2.3rem;
      border: 0;
      border-radius: .8rem;
      background: #f8fafc;
      color: #ef4444;
      font-size: 1rem;
      transition: all .2s ease;
    }

    .ft-calendar-todo-remove:hover {
      background: #fee2e2;
      transform: translateY(-1px);
    }

    .ft-calendar-todo-empty {
      padding: 1rem;
      border: 1px dashed rgba(191, 219, 254, .95);
      border-radius: 1rem;
      text-align: center;
      color: #64748b;
      background: rgba(248, 250, 252, .85);
      font-weight: 600;
    }

    #calendar-holder {
      min-height: 740px;
    }

    .fc {
      color: #102657;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .fc .fc-toolbar-title {
      color: #102657;
      font-size: 1.45rem;
      font-weight: 800;
    }

    .fc .fc-button-primary {
      background: linear-gradient(135deg, #2166f3, #0f56e8);
      border-color: #1754d2;
      border-radius: 12px;
      font-weight: 800;
      box-shadow: 0 10px 22px rgba(33,102,243,.16);
    }

    .fc .fc-button-primary:hover,
    .fc .fc-button-primary:focus {
      background: linear-gradient(135deg, #175de7, #0a4fdd);
      border-color: #144ccf;
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active {
      background: linear-gradient(135deg, #ffae24, #ff8d18);
      border-color: #f08a00;
      color: #fff;
    }

    .fc .fc-daygrid-day.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
      background: rgba(238,245,255,.95);
    }

    .fc .fc-event {
      border-radius: 8px;
      border-width: 0;
      padding: .1rem .2rem;
      font-weight: 700;
      box-shadow: 0 8px 20px rgba(15, 40, 98, .10);
    }

    .fc .fc-col-header-cell-cushion,
    .fc .fc-daygrid-day-number {
      color: #38527f;
      text-decoration: none;
      font-weight: 800;
    }

    .ft-calendar-energy {
      border-radius: 24px;
      padding: 1.25rem 1.3rem;
      color: #fff;
      background: linear-gradient(135deg, #294ee8, #6a36e8);
      box-shadow: 0 24px 60px rgba(42, 78, 232, .25);
      margin-bottom: 1rem;
    }

    .ft-calendar-energy-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: .75rem;
    }

    .ft-calendar-energy-kicker {
      text-transform: uppercase;
      font-size: .92rem;
      letter-spacing: .04em;
      font-weight: 800;
      opacity: .95;
    }

    .ft-calendar-energy-value {
      font-size: 3.3rem;
      line-height: 1;
      font-weight: 800;
      letter-spacing: -.05em;
    }

    .ft-calendar-energy-icon {
      width: 66px;
      height: 66px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,.18);
      font-size: 1.6rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.22);
    }

    .ft-calendar-energy-bar {
      height: 14px;
      border-radius: 999px;
      background: rgba(255,255,255,.18);
      overflow: hidden;
      margin: .9rem 0 1rem;
    }

    .ft-calendar-energy-bar > span {
      display: block;
      height: 100%;
      width: 18%;
      border-radius: 999px;
      background: linear-gradient(90deg, #ffb423, #ff7b78);
    }

    .ft-calendar-energy-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: .95rem;
      opacity: .96;
    }

    .ft-calendar-mini-stats {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.15rem;
    }

    .ft-calendar-stat {
      display: grid;
      grid-template-columns: 72px 1fr 54px 20px;
      align-items: center;
      gap: 1rem;
      border-radius: 20px;
      border: 1px solid rgba(220,230,255,.98);
      background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,251,255,.96));
      padding: 1rem 1rem;
      box-shadow: 0 16px 38px rgba(15, 40, 98, .05);
    }

    .ft-calendar-stat-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

    .ft-stat-blue { background: linear-gradient(145deg, #eff4ff, #dde9ff); color: #365bf3; }
    .ft-stat-green { background: linear-gradient(145deg, #ecfff5, #d7f9e8); color: #1da562; }
    .ft-stat-orange { background: linear-gradient(145deg, #fff5e9, #ffe7cf); color: #f08b1c; }

    .ft-calendar-stat-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #102657;
      margin-bottom: .25rem;
    }

    .ft-calendar-stat-copy {
      color: var(--ft-cal-text-soft);
      line-height: 1.45;
    }

    .ft-calendar-stat-count {
      width: 54px;
      height: 54px;
      border-radius: 16px;
