{% extends 'admin/back.html.twig' %}

{% block title %}Calendrier admin{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <span class="text-muted small mx-2">/</span>
  <span class="fw-semibold text-primary small">Calendrier</span>
{% endblock %}

{% block stylesheets %}
  <style>
    .ft-calendar-hero {
      border: 1px solid rgba(191, 219, 254, .95);
      border-radius: 1.25rem;
      background:
        radial-gradient(circle at top right, rgba(37, 99, 235, .12), transparent 28%),
        linear-gradient(135deg, #ffffff, #f8fbff);
      box-shadow: 0 22px 42px rgba(15, 23, 42, .06);
      padding: 1.35rem;
    }

    .ft-calendar-kicker {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      color: #1d4ed8;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      font-size: .74rem;
      margin-bottom: .55rem;
    }

    .ft-calendar-title {
      color: #0f172a;
      font-weight: 900;
      letter-spacing: 0;
      margin-bottom: .35rem;
    }

    .ft-calendar-chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      margin-top: 1rem;
    }

    .ft-calendar-chip {
      display: inline-flex;
      align-items: center;
      gap: .42rem;
      border: 1px solid rgba(191, 219, 254, .95);
      border-radius: 999px;
      background: rgba(255, 255, 255, .9);
      color: #334155;
      font-size: .82rem;
      font-weight: 800;
      padding: .42rem .74rem;
    }

    .ft-calendar-dot {
      width: .65rem;
      height: .65rem;
      border-radius: 999px;
      background: #2563eb;
    }

    .ft-calendar-dot.kyc { background: #f59e0b; }
    .ft-calendar-dot.ok { background: #16a34a; }
    .ft-calendar-dot.danger { background: #dc2626; }
    .ft-calendar-dot.advice { background: #f97316; }

    .ft-calendar-shell {
      border: 1px solid rgba(191, 219, 254, .95);
      border-radius: 1.25rem;
      background: #ffffff;
      box-shadow: 0 22px 44px rgba(15, 23, 42, .07);
      padding: 1rem;
    }

    .ft-calendar-todo-shell {
      margin-top: 1.4rem;
      border: 1px solid rgba(191, 219, 254, .95);
      border-radius: 1.7rem;
      background:
        radial-gradient(circle at top right, rgba(14, 165, 233, .11), transparent 24%),
        radial-gradient(circle at top left, rgba(255, 255, 255, .95), transparent 28%),
        linear-gradient(135deg, #ffffff, #f8fbff 58%, #eef5ff 100%);
      box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
      padding: 1.55rem;
    }

    .ft-calendar-todo-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 520px;
      align-items: start;
      gap: 1.4rem;
      margin-bottom: 1.5rem;
    }

    .ft-calendar-todo-kicker {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      color: #7c3aed;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      font-size: .72rem;
      margin-bottom: .45rem;
    }

    .ft-calendar-todo-title {
      color: #0f172a;
      font-weight: 900;
      margin: 0 0 .35rem;
      font-size: clamp(2rem, 3vw, 3.15rem);
      line-height: 1.04;
    }

    .ft-calendar-todo-subtitle {
      margin: 0;
      color: #64748b;
      font-size: 1rem;
    }

    .ft-calendar-energy {
      min-height: 245px;
      padding: 1.45rem 1.55rem;
      border-radius: 1.8rem;
      background:
        radial-gradient(circle at top right, rgba(255,255,255,.18), transparent 24%),
        linear-gradient(135deg, #2449f4, #4c42ec 54%, #6d28d9 100%);
      color: #fff;
      box-shadow: 0 22px 44px rgba(37, 99, 235, .24);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .ft-calendar-energy-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      font-size: .82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
      opacity: .95;
    }

    .ft-calendar-energy strong {
      display: block;
      margin-top: .6rem;
      font-size: 4rem;
      line-height: 1;
    }

    .ft-calendar-energy-bar {
      margin-top: 1rem;
      height: .9rem;
      border-radius: 999px;
      background: rgba(255,255,255,.22);
      overflow: hidden;
    }

    .ft-calendar-energy-bar > span {
      display: block;
      height: 100%;
      width: 36%;
      border-radius: inherit;
      background: linear-gradient(90deg, #facc15, #f97316, #fb7185);
      transition: width .25s ease;
    }

    .ft-calendar-energy-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-top: 1.2rem;
      color: rgba(255,255,255,.92);
      font-weight: 700;
    }

    .ft-calendar-energy-bolt {
      width: 4.25rem;
      height: 4.25rem;
      border-radius: 1.4rem;
      display: grid;
      place-items: center;
      background: rgba(255,255,255,.14);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
      font-size: 2rem;
    }

    .ft-calendar-todo-topline {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr);
      gap: 1rem;
      margin-bottom: 1.35rem;
    }

    .ft-calendar-selector-card,
    .ft-calendar-detected-card {
      border: 1px solid rgba(191, 219, 254, .88);
      border-radius: 1.15rem;
      background: rgba(255,255,255,.92);
      box-shadow: 0 16px 34px rgba(15, 23, 42, .05);
      padding: 1rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .ft-calendar-selector-copy,
    .ft-calendar-detected-copy {
      display: flex;
      align-items: center;
      gap: .9rem;
      color: #0f172a;
      font-weight: 800;
    }

    .ft-calendar-selector-copy i,
    .ft-calendar-detected-copy i {
      width: 2.55rem;
      height: 2.55rem;
      border-radius: .95rem;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #f8fbff, #eef4ff);
      color: #4f46e5;
      font-size: 1.15rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .ft-calendar-selector-date {
      font-size: 1rem;
      font-weight: 800;
    }

    .ft-calendar-selector-chevron,
    .ft-calendar-detected-pill {
      color: #64748b;
      font-weight: 800;
    }

    .ft-calendar-detected-card {
      background: linear-gradient(135deg, rgba(244,247,255,.96), rgba(239,246,255,.96));
    }

    .ft-calendar-detected-pill {
      border-radius: 999px;
      background: #e0e7ff;
      color: #4f46e5;
      padding: .32rem .72rem;
      font-size: .8rem;
    }

    .ft-calendar-todo-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(420px, .92fr);
      gap: 1.1rem;
    }

    .ft-calendar-todo-panel,
    .ft-calendar-day-brief {
      border: 1px solid rgba(191, 219, 254, .65);
      border-radius: 1.45rem;
      background: rgba(255,255,255,.9);
      padding: 1.3rem;
      box-shadow: 0 18px 38px rgba(15, 23, 42, .05);
    }

    .ft-calendar-day-brief {
      background: linear-gradient(135deg, rgba(248, 251, 255, .98), rgba(255,255,255,.98));
    }

    .ft-calendar-day-brief h3,
    .ft-calendar-todo-panel h3 {
      margin: 0 0 .35rem;
      color: #0f172a;
      font-size: 1rem;
      font-weight: 900;
    }

    .ft-calendar-day-brief p,
    .ft-calendar-todo-panel p {
      margin: 0;
      color: #64748b;
      font-size: .9rem;
      line-height: 1.55;
    }

    .ft-calendar-day-brief-list {
      display: grid;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .ft-calendar-brief-item {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1rem;
      border-radius: 1.2rem;
      background: rgba(255,255,255,.95);
      border: 1px solid rgba(191, 219, 254, .7);
      box-shadow: 0 16px 34px rgba(15, 23, 42, .04);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-brief-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 38px rgba(15, 23, 42, .08);
    }

    .ft-calendar-brief-icon {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 1rem;
      display: grid;
      place-items: center;
      font-size: 1.55rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.95);
    }

    .ft-calendar-brief-icon.events {
      background: linear-gradient(135deg, rgba(59,130,246,.12), rgba(99,102,241,.14));
      color: #4338ca;
    }

    .ft-calendar-brief-icon.done {
      background: linear-gradient(135deg, rgba(34,197,94,.10), rgba(16,185,129,.14));
      color: #16a34a;
    }

    .ft-calendar-brief-icon.pending {
      background: linear-gradient(135deg, rgba(251,191,36,.14), rgba(249,115,22,.16));
      color: #f59e0b;
    }

    .ft-calendar-brief-item strong {
      display: block;
      color: #0f172a;
      font-size: 1rem;
    }

    .ft-calendar-brief-item span {
      color: #64748b;
      font-size: .9rem;
    }

    .ft-calendar-brief-pill {
      border-radius: 999px;
      padding: .7rem .92rem;
      font-size: 1.05rem;
      font-weight: 800;
      min-width: 3.7rem;
      text-align: center;
      background: linear-gradient(135deg, #eff6ff, #e0e7ff);
      color: #2563eb;
      white-space: nowrap;
    }

    .ft-calendar-brief-arrow {
      color: #64748b;
      font-size: 1.55rem;
      line-height: 1;
    }

    .ft-calendar-todo-form {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: .75rem;
      margin: 1rem 0;
    }

    .ft-calendar-todo-actions {
      display: grid;
      grid-template-columns: 220px auto;
      gap: .75rem;
      align-items: center;
    }

    .ft-calendar-todo-input,
    .ft-calendar-todo-select {
      border-radius: 1rem;
      border: 1px solid rgba(191, 219, 254, .95);
      background: #fff;
      min-height: 54px;
      padding: .9rem 1rem;
      color: #0f172a;
      font-weight: 600;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    .ft-calendar-todo-btn {
      border: 0;
      border-radius: 1rem;
      min-height: 54px;
      padding: .85rem 1.1rem;
      font-weight: 800;
      color: #fff;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      box-shadow: 0 16px 28px rgba(37, 99, 235, .18);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-todo-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 34px rgba(37, 99, 235, .24);
    }

    .ft-calendar-todo-list {
      display: grid;
      gap: .75rem;
      margin-top: .8rem;
    }

    .ft-calendar-todo-illustration {
      margin-top: 1.2rem;
      padding-top: 1rem;
      text-align: center;
      color: #64748b;
    }

    .ft-calendar-todo-illustration-graphic {
      width: 9rem;
      height: 9rem;
      margin: 0 auto 1rem;
      border-radius: 2rem;
      position: relative;
      background:
        radial-gradient(circle at center, rgba(99,102,241,.12), transparent 62%),
        linear-gradient(135deg, rgba(239,246,255,.95), rgba(248,250,252,.95));
      display: grid;
      place-items: center;
    }

    .ft-calendar-todo-illustration-graphic::before {
      content: '\f4ca';
      font-family: "bootstrap-icons";
      font-size: 3.4rem;
      color: #818cf8;
    }

    .ft-calendar-todo-illustration strong {
      display: block;
      color: #0f172a;
      font-size: 1.25rem;
      margin-bottom: .35rem;
    }

    .ft-calendar-todo-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: .8rem;
      align-items: center;
      padding: .9rem;
      border-radius: 1rem;
      background: #fff;
      border: 1px solid rgba(191, 219, 254, .75);
      box-shadow: 0 14px 26px rgba(15, 23, 42, .05);
    }

    .ft-calendar-todo-item.is-done {
      opacity: .72;
      background: linear-gradient(135deg, rgba(236,253,245,.85), rgba(255,255,255,.96));
    }

    .ft-calendar-todo-check {
      width: 1.15rem;
      height: 1.15rem;
      accent-color: #2563eb;
    }

    .ft-calendar-todo-copy strong {
      display: block;
      color: #0f172a;
      font-size: .95rem;
      font-weight: 800;
    }

    .ft-calendar-todo-copy span {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      margin-top: .35rem;
      color: #64748b;
      font-size: .8rem;
      flex-wrap: wrap;
    }

    .ft-calendar-priority {
      display: inline-flex;
      align-items: center;
      padding: .22rem .55rem;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 800;
    }

    .ft-calendar-priority.low { background: rgba(34, 197, 94, .14); color: #15803d; }
    .ft-calendar-priority.medium { background: rgba(245, 158, 11, .16); color: #b45309; }
    .ft-calendar-priority.high { background: rgba(239, 68, 68, .14); color: #b91c1c; }

    .ft-calendar-todo-remove {
      width: 2.3rem;
      height: 2.3rem;
      border: 0;
      border-radius: .8rem;
      background: #f8fafc;
      color: #ef4444;
      font-size: 1rem;
      transition: all .2s ease;
    }

    .ft-calendar-todo-remove:hover {
      background: #fee2e2;
      transform: translateY(-1px);
    }

    .ft-calendar-todo-empty {
      padding: 1rem;
      border: 1px dashed rgba(191, 219, 254, .95);
      border-radius: 1rem;
      text-align: center;
      color: #64748b;
      background: rgba(248, 250, 252, .85);
      font-weight: 600;
    }

    #calendar-holder {
      min-height: 720px;
    }

    .fc {
      color: #0f172a;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .fc .fc-toolbar-title {
      color: #0f172a;
      font-size: 1.35rem;
      font-weight: 900;
    }

    .fc .fc-button-primary {
      background: #2563eb;
      border-color: #1d4ed8;
      border-radius: .65rem;
      font-weight: 800;
      box-shadow: 0 10px 18px rgba(37, 99, 235, .14);
    }

    .fc .fc-button-primary:hover,
    .fc .fc-button-primary:focus {
      background: #1d4ed8;
      border-color: #1e40af;
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active {
      background: #f59e0b;
      border-color: #d97706;
      color: #111827;
    }

    .fc .fc-daygrid-day.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
      background: rgba(239, 246, 255, .85);
    }

    .fc .fc-event {
      border-radius: .55rem;
      border-width: 1px;
      padding: .08rem .18rem;
      font-weight: 800;
    }

    .fc .fc-col-header-cell-cushion,
    .fc .fc-daygrid-day-number {
      color: #334155;
      text-decoration: none;
      font-weight: 800;
    }

    @media (max-width: 767.98px) {
      .ft-calendar-todo-head,
      .ft-calendar-todo-grid,
      .ft-calendar-todo-topline {
        grid-template-columns: 1fr;
        display: grid;
      }

      .ft-calendar-todo-form {
        grid-template-columns: 1fr;
      }

      .ft-calendar-todo-actions,
      .ft-calendar-brief-item {
        grid-template-columns: 1fr;
      }

      #calendar-holder {
        min-height: 620px;
      }

      .fc .fc-toolbar {
        align-items: flex-start;
        flex-direction: column;
        gap: .75rem;
      }
    }
  </style>
{% endblock %}

{% block admin_content %}
  <section class="ft-calendar-hero mb-4">
    <div class="row g-3 align-items-center">
      <div class="col-lg-8">
        <span class="ft-calendar-kicker"><i class="bi bi-calendar-week"></i> Bundle externe FullCalendar</span>
        <h1 class="ft-calendar-title">Calendrier operationnel admin</h1>
        <p class="text-muted mb-0">
          Visualisez les inscriptions clients, les dossiers KYC, les routines de controle et les conseils d'action par client.
        </p>
      </div>
      <div class="col-lg-4">
        <div class="ft-calendar-chip-row justify-content-lg-end">
          <span class="ft-calendar-chip"><span class="ft-calendar-dot"></span>Clients</span>
          <span class="ft-calendar-chip"><span class="ft-calendar-dot kyc"></span>KYC en attente</span>
          <span class="ft-calendar-chip"><span class="ft-calendar-dot ok"></span>Approuve</span>
          <span class="ft-calendar-chip"><span class="ft-calendar-dot danger"></span>Refuse</span>
          <span class="ft-calendar-chip"><span class="ft-calendar-dot advice"></span>Conseil admin</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ft-calendar-shell">
    <div id="calendar-holder" data-events-url="{{ path('fc_load_events') }}"></div>
  </section>

  <section class="ft-calendar-todo-shell">
    <div class="ft-calendar-todo-head">
      <div>
        <span class="ft-calendar-todo-kicker"><i class="bi bi-lightning-charge-fill"></i> To do dynamique</span>
        <h2 class="ft-calendar-todo-title">Tableau d’action relié au calendrier</h2>
        <p class="ft-calendar-todo-subtitle">Sélectionnez une date pour afficher l’énergie du jour, les événements reliés et vos tâches admin.</p>
      </div>
      <div class="ft-calendar-energy">
        <div class="ft-calendar-energy-top">
          <span>Energie du jour</span>
          <span id="todoEnergyLabel">Charge modérée</span>
        </div>
        <strong id="todoEnergyValue">46%</strong>
        <div class="ft-calendar-energy-bar"><span id="todoEnergyBar"></span></div>
        <div class="ft-calendar-energy-bottom">
          <div>
            <div>Continuez ainsi 💪</div>
            <small>Progression saine</small>
          </div>
          <div class="ft-calendar-energy-bolt"><i class="bi bi-lightning-charge-fill"></i></div>
        </div>
      </div>
    </div>

    <div class="ft-calendar-todo-topline">
      <div class="ft-calendar-selector-card">
        <div class="ft-calendar-selector-copy">
          <i class="bi bi-calendar3"></i>
          <span id="todoSelectedDateTitle" class="ft-calendar-selector-date">Aujourd hui</span>
        </div>
        <span class="ft-calendar-selector-chevron"><i class="bi bi-chevron-down"></i></span>
      </div>
      <div class="ft-calendar-detected-card">
        <div class="ft-calendar-detected-copy">
          <i class="bi bi-stars"></i>
          <span id="todoSelectedDateHint">Cliquez sur un jour du calendrier pour synchroniser les tâches.</span>
        </div>
        <span class="ft-calendar-detected-pill" id="todoEventCount">0</span>
      </div>
    </div>

    <div class="ft-calendar-todo-grid">
      <aside class="ft-calendar-day-brief">
        <div class="ft-calendar-day-brief-list">
          <div class="ft-calendar-brief-item">
            <div class="ft-calendar-brief-icon events"><i class="bi bi-calendar-week"></i></div>
            <div>
              <strong>Evénements du jour</strong>
              <span>Elements remontes par FullCalendar</span>
            </div>
            <span class="ft-calendar-brief-pill" id="todoEventCountSecondary">0</span>
            <span class="ft-calendar-brief-arrow"><i class="bi bi-chevron-right"></i></span>
          </div>
          <div class="ft-calendar-brief-item">
            <div class="ft-calendar-brief-icon done"><i class="bi bi-calendar-check"></i></div>
            <div>
              <strong>Tâches complétées</strong>
              <span>Progression du planning admin</span>
            </div>
            <span class="ft-calendar-brief-pill" id="todoDoneCount">0</span>
            <span class="ft-calendar-brief-arrow"><i class="bi bi-chevron-right"></i></span>
          </div>
          <div class="ft-calendar-brief-item">
            <div class="ft-calendar-brief-icon pending"><i class="bi bi-list-task"></i></div>
            <div>
              <strong>Tâches restantes</strong>
              <span>Actions à mener avant clôture</span>
            </div>
            <span class="ft-calendar-brief-pill" id="todoPendingCount">0</span>
            <span class="ft-calendar-brief-arrow"><i class="bi bi-chevron-right"></i></span>
          </div>
        </div>
      </aside>

      <div class="ft-calendar-todo-panel">
        <h3>To do list admin</h3>
        <p>Ajoutez des tâches manuelles et combinez-les avec les événements du calendrier pour construire votre plan de journée.</p>

        <form class="ft-calendar-todo-form" id="calendarTodoForm">
          <input type="text" id="calendarTodoInput" class="ft-calendar-todo-input" placeholder="Ex: relancer les KYC en attente de cette date">
          <div class="ft-calendar-todo-actions">
            <select id="calendarTodoPriority" class="ft-calendar-todo-select">
              <option value="medium">Priorité moyenne</option>
              <option value="high">Priorité haute</option>
              <option value="low">Priorité basse</option>
            </select>
            <button type="submit" class="ft-calendar-todo-btn"><i class="bi bi-plus-lg me-2"></i>Ajouter</button>
          </div>
        </form>

        <div class="ft-calendar-todo-list" id="calendarTodoList"></div>

        <div class="ft-calendar-todo-illustration">
          <div class="ft-calendar-todo-illustration-graphic"></div>
          <strong>Organisez vos tâches et restez à jour</strong>
          <span>La planification est la clé de la productivité.</span>
        </div>
      </div>
    </div>
  </section>
{% endblock %}

{% block javascripts %}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/locales-all.global.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const calendarEl = document.getElementById('calendar-holder');
      const todoStorageKey = 'ft-admin-calendar-todos';
      const todoListEl = document.getElementById('calendarTodoList');
      const todoForm = document.getElementById('calendarTodoForm');
      const todoInput = document.getElementById('calendarTodoInput');
      const todoPriority = document.getElementById('calendarTodoPriority');
      const todoSelectedDateTitle = document.getElementById('todoSelectedDateTitle');
      const todoSelectedDateHint = document.getElementById('todoSelectedDateHint');
      const todoEventCount = document.getElementById('todoEventCount');
      const todoEventCountSecondary = document.getElementById('todoEventCountSecondary');
      const todoDoneCount = document.getElementById('todoDoneCount');
      const todoPendingCount = document.getElementById('todoPendingCount');
      const todoEnergyValue = document.getElementById('todoEnergyValue');
      const todoEnergyLabel = document.getElementById('todoEnergyLabel');
      const todoEnergyBar = document.getElementById('todoEnergyBar');
      let selectedDate = new Date().toISOString().slice(0, 10);
      let loadedEvents = [];

      if (!calendarEl || typeof FullCalendar === 'undefined') {
        return;
      }

      const readTodos = () => {
        try {
          return JSON.parse(localStorage.getItem(todoStorageKey) || '{}');
        } catch (error) {
          return {};
        }
      };

      const writeTodos = (payload) => {
        localStorage.setItem(todoStorageKey, JSON.stringify(payload));
      };

      const getDateLabel = (dateString) => {
        const date = new Date(dateString + 'T08:00:00');
        return new Intl.DateTimeFormat('fr-FR', {
          weekday: 'long',
          day: '2-digit',
          month: 'long',
          year: 'numeric'
        }).format(date);
      };

      const getEventTodosForDate = (dateString) => {
        return loadedEvents
          .filter((event) => (event.start || '').slice(0, 10) === dateString)
          .map((event, index) => ({
            id: `event-${dateString}-${index}`,
            text: event.title || 'Evenement admin',
            priority: event.extendedProps?.priority === 'high' ? 'high' : 'medium',
            done: false,
            readonly: true,
            meta: event.extendedProps?.type || 'Calendrier'
          }));
      };

      const renderTodos = () => {
        const todoState = readTodos();
        const customTodos = todoState[selectedDate] || [];
        const eventTodos = getEventTodosForDate(selectedDate);
        const todos = [...eventTodos, ...customTodos];
        const doneCount = todos.filter((item) => item.done).length;
        const pendingCount = todos.length - doneCount;
        const eventCount = eventTodos.length;
        const energy = todos.length === 0 ? 28 : Math.max(18, Math.min(100, Math.round((doneCount / todos.length) * 100 + (eventCount * 6))));

        todoSelectedDateTitle.textContent = getDateLabel(selectedDate);
        todoSelectedDateHint.textContent = eventCount > 0
          ? `${eventCount} événement(s) détecté(s) sur cette date`
          : 'Aucun événement remonté pour cette date';
        todoEventCount.textContent = String(eventCount);
        if (todoEventCountSecondary) {
          todoEventCountSecondary.textContent = String(eventCount);
        }
        todoDoneCount.textContent = String(doneCount);
        todoPendingCount.textContent = String(pendingCount);
        todoEnergyValue.textContent = `${energy}%`;
        todoEnergyBar.style.width = `${energy}%`;
        todoEnergyLabel.textContent = energy >= 80 ? 'Charge intense' : (energy >= 50 ? 'Focus bien lancé' : 'Charge modérée');

        if (todos.length === 0) {
          todoListEl.innerHTML = '<div class="ft-calendar-todo-empty">Aucune tâche pour cette date. Commencez par ajouter une action admin.</div>';
          return;
        }

        todoListEl.innerHTML = todos.map((todo) => `
          <div class="ft-calendar-todo-item ${todo.done ? 'is-done' : ''}" data-todo-id="${todo.id}" data-readonly="${todo.readonly ? '1' : '0'}">
            <input type="checkbox" class="ft-calendar-todo-check" ${todo.done ? 'checked' : ''} ${todo.readonly ? 'disabled' : ''}>
            <div class="ft-calendar-todo-copy">
              <strong>${todo.text}</strong>
              <span>
                <em class="ft-calendar-priority ${todo.priority}">${todo.priority === 'high' ? 'Priorité haute' : (todo.priority === 'low' ? 'Priorité basse' : 'Priorité moyenne')}</em>
                <small>${todo.meta || 'Action manuelle'}</small>
              </span>
            </div>
            ${todo.readonly ? '<span class="ft-calendar-brief-pill">Auto</span>' : '<button type="button" class="ft-calendar-todo-remove" aria-label="Supprimer"><i class="bi bi-trash3"></i></button>'}
          </div>
        `).join('');
      };

      const updateTodoItem = (todoId, changes) => {
        const todoState = readTodos();
        const current = todoState[selectedDate] || [];
        todoState[selectedDate] = current.map((todo) => todo.id === todoId ? { ...todo, ...changes } : todo);
        writeTodos(todoState);
        renderTodos();
      };

      const removeTodoItem = (todoId) => {
        const todoState = readTodos();
        todoState[selectedDate] = (todoState[selectedDate] || []).filter((todo) => todo.id !== todoId);
        writeTodos(todoState);
        renderTodos();
      };

      todoForm?.addEventListener('submit', function (event) {
        event.preventDefault();
        const text = (todoInput?.value || '').trim();
        if (!text) {
          return;
        }

        const todoState = readTodos();
        const current = todoState[selectedDate] || [];
        current.unshift({
          id: `${Date.now()}`,
          text,
          priority: todoPriority?.value || 'medium',
          done: false,
          readonly: false,
          meta: 'Action admin'
        });
        todoState[selectedDate] = current;
        writeTodos(todoState);
        todoForm.reset();
        renderTodos();
      });

      todoListEl?.addEventListener('click', function (event) {
        const target = event.target;
        const card = target.closest('[data-todo-id]');
        if (!card) {
          return;
        }

        if (target.closest('.ft-calendar-todo-remove')) {
          removeTodoItem(card.dataset.todoId);
        }
      });

      todoListEl?.addEventListener('change', function (event) {
        const target = event.target;
        const card = target.closest('[data-todo-id]');
        if (!card || card.dataset.readonly === '1' || !target.classList.contains('ft-calendar-todo-check')) {
          return;
        }

        updateTodoItem(card.dataset.todoId, { done: target.checked });
      });

      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        firstDay: 1,
        height: 'auto',
        nowIndicator: true,
        navLinks: true,
        dayMaxEvents: 3,
        eventDisplay: 'block',
        eventSources: [
          {
            url: calendarEl.dataset.eventsUrl,
            method: 'POST',
            extraParams: {
              filters: JSON.stringify({ 'calendar-id': 'admin-calendar' })
            },
            success: function (content) {
              loadedEvents = Array.isArray(content) ? content : [];
              renderTodos();
            },
            failure: function () {
              calendarEl.insertAdjacentHTML('beforebegin', '<div class="alert alert-warning mb-3">Impossible de charger les evenements du calendrier.</div>');
            }
          }
        ],
        headerToolbar: {
          start: 'prev,next today',
          center: 'title',
          end: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        buttonText: {
          today: "Aujourd'hui",
          month: 'Mois',
          week: 'Semaine',
          day: 'Jour',
          list: 'Liste'
        },
        eventClick: function (info) {
          selectedDate = (info.event.startStr || '').slice(0, 10) || selectedDate;
          renderTodos();
          if (info.event.url) {
            info.jsEvent.preventDefault();
            window.location.href = info.event.url;
          }
        },
        dateClick: function (info) {
          selectedDate = info.dateStr;
          renderTodos();
        },
        eventDidMount: function (info) {
          const description = info.event.extendedProps.description || '';
          const type = info.event.extendedProps.type || 'Evenement';
          const priority = info.event.extendedProps.priority ? ' [' + info.event.extendedProps.priority + ']' : '';
          info.el.setAttribute('title', type + priority + (description ? ' - ' + description : ''));
        }
      });

      calendar.render();
      renderTodos();
    });
  </script>
{% endblock %}
