          </div>
        </div>
      </div>
      <div class="col-sm-6 col-xl">
        <div class="ft-calendar-kpi">
          <div class="ft-calendar-kpi-head">
            <span class="ft-calendar-kpi-icon indigo"><i class="bi bi-lightbulb"></i></span>
            <div>
              <div class="ft-calendar-kpi-label">Conseils admin</div>
              <div class="ft-calendar-kpi-value">9</div>
            </div>
          </div>
          <div class="ft-calendar-kpi-foot">
            <span class="ft-calendar-kpi-delta up">+12%</span>
            <span>ce mois</span>
          </div>
        </div>
      </div>
    </div>

    <div class="ft-calendar-layout">
      <section class="ft-calendar-main-card">
        <div class="ft-calendar-topline">
          <div class="ft-calendar-title-wrap">
            <h1><i class="bi bi-calendar-week text-primary me-2"></i>Calendrier operationnel</h1>
            <p>Visualisez les inscriptions clients, les dossiers KYC, les routines de controle et les conseils d'action.</p>
          </div>
          <div class="ft-calendar-filter-pills">
            <span class="ft-calendar-pill">Tous</span>
            <span class="ft-calendar-pill active">Clients</span>
            <span class="ft-calendar-pill" style="background:#fff5df;color:#c57a00;border-color:#ffe1a9;">KYC</span>
            <span class="ft-calendar-pill" style="background:#f3ecff;color:#7541f0;border-color:#e0d0ff;">Conseils</span>
            <span class="ft-calendar-pill" style="background:#eef4ff;color:#1d3f8e;border-color:#dbe6ff;">Controles</span>
          </div>
        </div>

        <div class="ft-calendar-selected-row">
          <div class="ft-calendar-selected-card">
            <strong id="selected-date-label">dimanche 26 avril 2026</strong>
            <span id="selected-date-copy">Selection active pour le pilotage admin journalier.</span>
          </div>
          <div class="ft-calendar-selected-card">
            <strong><span id="selected-events-count">0</span> evenement(s) detecte(s) sur cette date</strong>
            <span>Synchronise avec FullCalendar et les taches de la colonne droite.</span>
          </div>
        </div>

        <div class="ft-calendar-shell">
          <div id="calendar-holder" data-events-url="{{ path('fc_load_events') }}"></div>
        </div>

        <div class="d-flex flex-wrap gap-3 mt-4 small text-muted fw-semibold">
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#2563eb;"></span>Inscription</span>
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#f59e0b;"></span>KYC en attente</span>
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#16a34a;"></span>KYC approuvee</span>
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#dc2626;"></span>KYC refusee</span>
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#7c3aed;"></span>Conseil admin</span>
          <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle" style="width:.7rem;height:.7rem;background:#f97316;"></span>Controle conformite</span>
        </div>
      </section>

      <div class="d-grid gap-4">
        <section class="ft-calendar-energy">
          <div class="ft-calendar-energy-top">
            <div>
              <div class="ft-calendar-energy-kicker">Energie du jour &nbsp; Charge moderee</div>
              <div class="ft-calendar-energy-value" id="energy-value">18%</div>
            </div>
            <span class="ft-calendar-energy-icon"><i class="bi bi-lightning-charge-fill"></i></span>
          </div>
          <div class="ft-calendar-energy-bar"><span id="energy-bar"></span></div>
          <div class="ft-calendar-energy-foot">
            <span id="energy-message">Continuez ainsi</span>
            <span>Progression saine</span>
          </div>
        </section>

        <section class="ft-calendar-todo-card">
          <div class="ft-calendar-todo-top">
            <div class="ft-calendar-todo-head">
              <span class="ft-calendar-todo-head-icon"><i class="bi bi-clipboard-check"></i></span>
              <div>
                <div class="ft-calendar-todo-title">Ma to-do list</div>
                <p class="ft-calendar-todo-sub">Gerez vos taches et actions prioritaires en lien direct avec la date choisie.</p>
              </div>
            </div>
            <span class="ft-calendar-progress-badge"><span id="done-count">0</span>/<span id="total-count">0</span> terminees</span>
          </div>

          <div class="ft-calendar-todo-tabs">
            <span class="ft-calendar-todo-tab active">Toutes <span id="tab-all-count">0</span></span>
            <span class="ft-calendar-todo-tab">A faire <span id="tab-open-count">0</span></span>
            <span class="ft-calendar-todo-tab">En cours <span id="tab-progress-count">0</span></span>
            <span class="ft-calendar-todo-tab">Terminees <span id="tab-done-count">0</span></span>
          </div>

          <div class="ft-calendar-task-list" id="task-list"></div>

          <form class="ft-calendar-task-form" id="task-form">
            <div class="ft-calendar-form-grid">
              <input type="text" class="ft-calendar-field" id="task-input" placeholder="Ex: verifier les nouveaux dossiers KYC">
            </div>
            <div class="ft-calendar-form-grid-secondary">
              <select class="ft-calendar-select" id="task-status">
                <option value="todo" selected>Pas encore</option>
                <option value="progress">En cours</option>
                <option value="done">Terminee</option>
              </select>
              <input type="datetime-local" class="ft-calendar-field" id="task-reminder" title="Delai et rappel">
              <button type="submit" class="ft-calendar-add-btn"><i class="bi bi-plus-lg me-1"></i>Nouvelle tache</button>
            </div>
          </form>
        </section>

        <section class="ft-calendar-quick-card p-3">
          <div class="ft-calendar-title-wrap mb-3">
            <h1 style="font-size:1.15rem;"><i class="bi bi-lightning-charge text-primary me-2"></i>Actions rapides</h1>
          </div>
          <div class="ft-calendar-quick-grid">
            <a href="{{ path('admin_user_create') }}" class="ft-calendar-quick-btn"><i class="bi bi-person-plus"></i>Nouvelle inscription</a>
            <a href="{{ path('admin_analytics_intelligence') }}" class="ft-calendar-quick-btn"><i class="bi bi-lightbulb"></i>Nouveau conseil</a>
            <a href="{{ path('admin_kyc_list') }}" class="ft-calendar-quick-btn"><i class="bi bi-shield-check"></i>Lancer controle</a>
            <a href="{{ path('admin_calendar_export_report_pdf') }}" class="ft-calendar-quick-btn" target="_blank"><i class="bi bi-download"></i>Exporter rapport</a>
          </div>
        </section>
      </div>
    </div>

    <div class="ft-calendar-reminder-toast-wrap" id="reminder-toast-wrap"></div>
  </div>
{% endblock %}

{% block javascripts %}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/locales-all.global.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const calendarEl = document.getElementById('calendar-holder');
      const selectedDateLabel = document.getElementById('selected-date-label');
      const selectedDateCopy = document.getElementById('selected-date-copy');
      const selectedEventsCount = document.getElementById('selected-events-count');
      const taskList = document.getElementById('task-list');
      const taskForm = document.getElementById('task-form');
      const taskInput = document.getElementById('task-input');
      const taskStatus = document.getElementById('task-status');
      const taskReminder = document.getElementById('task-reminder');
      const doneCount = document.getElementById('done-count');
      const totalCount = document.getElementById('total-count');
      const tabAllCount = document.getElementById('tab-all-count');
      const tabOpenCount = document.getElementById('tab-open-count');
      const tabProgressCount = document.getElementById('tab-progress-count');
      const tabDoneCount = document.getElementById('tab-done-count');
      const energyValue = document.getElementById('energy-value');
      const energyBar = document.getElementById('energy-bar');
      const energyMessage = document.getElementById('energy-message');
      const reminderToastWrap = document.getElementById('reminder-toast-wrap');

      if (!calendarEl || typeof FullCalendar === 'undefined') {
        return;
      }

      const storageKey = 'ft-admin-calendar-tasks-v2';
      const frenchDateFormatter = new Intl.DateTimeFormat('fr-FR', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      });

      const shortDateFormatter = new Intl.DateTimeFormat('fr-FR', {
        day: 'numeric',
        month: 'short'
      });

      let selectedDate = FullCalendar.formatDate(new Date(), {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).replace(/\//g, '-');
      let cachedEvents = [];

      const defaultTasksByType = {
        inscription: {
          title: 'Verifier les nouveaux dossiers clients',
          priority: 'high',
          tag: 'Clients'
        },
        kyc_pending: {
          title: 'Relancer les dossiers KYC en attente',
          priority: 'medium',
          tag: 'KYC'
        },
        kyc_approved: {
          title: 'Valider le suivi post-approbation KYC',
          priority: 'low',
          tag: 'KYC'
        },
        kyc_refused: {
          title: 'Revoir les refus KYC sensibles',
          priority: 'high',
          tag: 'KYC'
        },
        advice: {
          title: 'Envoyer un conseil admin cible',
          priority: 'medium',
          tag: 'Conseils'
        },
        control: {
          title: 'Executer le controle conformite programme',
          priority: 'medium',
          tag: 'Conformite'
        }
      };

      function loadTasks() {
        try {
          return JSON.parse(localStorage.getItem(storageKey) || '{}');
        } catch (e) {
          return {};
        }
      }

      function saveTasks(tasks) {
        localStorage.setItem(storageKey, JSON.stringify(tasks));
      }

      function getTasksForDate(dateKey) {
        const store = loadTasks();
        return Array.isArray(store[dateKey]) ? store[dateKey] : [];
      }

      function setTasksForDate(dateKey, tasks) {
        const store = loadTasks();
        store[dateKey] = tasks;
        saveTasks(store);
      }

      function eventTypeToTask(event) {
        const typeRaw = String(event.extendedProps?.type || '').toLowerCase();
        if (typeRaw.includes('refus')) return 'kyc_refused';
        if (typeRaw.includes('approuv')) return 'kyc_approved';
        if (typeRaw.includes('attente') || typeRaw.includes('kyc')) return 'kyc_pending';
        if (typeRaw.includes('conseil')) return 'advice';
        if (typeRaw.includes('controle')) return 'control';
        return 'inscription';
      }

      function ensureAutoTasks(dateKey) {
        const tasks = getTasksForDate(dateKey);
        const dayEvents = cachedEvents.filter((event) => event.startStr.slice(0, 10) === dateKey);

        dayEvents.forEach((event) => {
          const autoId = 'auto-' + event.id;
          if (tasks.some((task) => task.id === autoId)) {
            return;
          }

          const taskModel = defaultTasksByType[eventTypeToTask(event)] || defaultTasksByType.inscription;
          tasks.push({
            id: autoId,
            title: taskModel.title,
            priority: taskModel.priority,
            tag: taskModel.tag,
            status: 'todo',
            auto: true,
            sourceTitle: event.title,
            date: dateKey
          });
        });

        setTasksForDate(dateKey, tasks);
      }

      function getPriorityLabel(priority, status) {
        if (status === 'done') return { text: 'Terminee', className: 'ft-tag-done' };
        if (priority === 'high') return { text: 'Haute', className: 'ft-tag-high' };
        if (priority === 'low') return { text: 'Faible', className: 'ft-tag-low' };
        return { text: 'Moyenne', className: 'ft-tag-medium' };
      }

      function getStatusLabel(status) {
        if (status === 'done') return 'Terminee';
        if (status === 'progress') return 'En cours';
        return 'Pas encore';
      }

      function showReminderToast(task) {
        if (!reminderToastWrap) {
          return;
        }

        const toast = document.createElement('div');
        toast.className = 'ft-calendar-reminder-toast';
        toast.innerHTML = `
          <strong>Rappel admin</strong>
          <p>${task.title}</p>
          <p class="mt-1"><small class="text-muted">Rappel ${task.reminder ? new Date(task.reminder).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'non defini'}</small></p>
        `;
        reminderToastWrap.appendChild(toast);
        window.setTimeout(() => toast.remove(), 6000);
      }

      function checkDueReminders() {
        const store = loadTasks();
        const now = new Date();
        let mutated = false;

        Object.keys(store).forEach((dateKey) => {
          if (!Array.isArray(store[dateKey])) {
            return;
          }

          store[dateKey] = store[dateKey].map((task) => {
            if (!task.reminder || task.reminded) {
              return task;
            }

            const reminderDate = new Date(task.reminder);
            if (!Number.isNaN(reminderDate.getTime()) && reminderDate <= now) {
              showReminderToast(task);
              mutated = true;
              return { ...task, reminded: true };
            }

            return task;
          });
        });

        if (mutated) {
          saveTasks(store);
          renderTasks();
        }
      }

      function updateEnergy(tasks, eventsCount) {
        const completed = tasks.filter((task) => task.status === 'done').length;
        const inProgress = tasks.filter((task) => task.status === 'progress').length;
        const total = tasks.length || 1;
        const score = Math.min(100, Math.round(((completed * 55) + (inProgress * 30) + (eventsCount * 15)) / total));
        const normalized = Math.max(18, score);

        energyValue.textContent = normalized + '%';
        energyBar.style.width = normalized + '%';
        energyMessage.textContent = normalized >= 70 ? 'Rythme excellent' : (normalized >= 40 ? 'Charge moderee' : 'Continuez ainsi');
      }

      function renderTasks() {
        ensureAutoTasks(selectedDate);
        const tasks = getTasksForDate(selectedDate);
        const dayEvents = cachedEvents.filter((event) => event.startStr.slice(0, 10) === selectedDate);

        selectedEventsCount.textContent = dayEvents.length;
        totalCount.textContent = tasks.length;
        doneCount.textContent = tasks.filter((task) => task.status === 'done').length;
        tabAllCount.textContent = tasks.length;
        tabOpenCount.textContent = tasks.filter((task) => task.status === 'todo').length;
        tabProgressCount.textContent = tasks.filter((task) => task.status === 'progress').length;
        tabDoneCount.textContent = tasks.filter((task) => task.status === 'done').length;

        updateEnergy(tasks, dayEvents.length);

        if (tasks.length === 0) {
          taskList.innerHTML = '<div class="text-muted small py-3">Aucune tache sur cette date. Ajoutez une action admin avec son statut, son delai ou son rappel.</div>';
          return;
        }

        taskList.innerHTML = tasks.map((task, index) => {
          const priority = getPriorityLabel(task.priority, task.status);
          const isComplete = task.status === 'done';
          const dateText = shortDateFormatter.format(new Date(task.date + 'T10:00:00'));
          const statusLabel = getStatusLabel(task.status);
          const reminderLabel = task.reminder ? ` · rappel ${new Date(task.reminder).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}` : '';

          return `
            <div class="ft-calendar-task-row ${isComplete ? 'is-complete' : ''}" data-index="${index}">
              <span class="ft-calendar-task-check" data-action="toggle"><i class="bi bi-check-lg"></i></span>
              <div class="ft-calendar-task-main">
                <div class="ft-calendar-task-title">${task.title}</div>
                <div class="ft-calendar-task-meta">
                  <span class="ft-calendar-tag ${priority.className}">${priority.text}</span>
                  ${task.tag ? `<span>${task.tag}</span>` : ''}
                  <span>${statusLabel}</span>
                  ${task.auto ? '<span class="ft-calendar-tag ft-tag-auto">Auto</span>' : ''}
                  ${task.reminder && !task.reminded ? '<span class="ft-calendar-tag ft-tag-low">Rappel</span>' : ''}
                </div>
              </div>
              <span class="ft-calendar-task-date">${dateText}</span>
              <span class="ft-calendar-task-more">${reminderLabel.trim() || (task.status === 'progress' ? 'En cours' : '')}</span>
              <i class="bi bi-three-dots-vertical ft-calendar-task-more"></i>
            </div>
          `;
        }).join('');
      }

      function setSelectedDate(dateKey) {
        selectedDate = dateKey;
        const displayDate = new Date(dateKey + 'T10:00:00');
        selectedDateLabel.textContent = frenchDateFormatter.format(displayDate);
        selectedDateCopy.textContent = 'Selection active pour le pilotage admin journalier.';
        renderTasks();
      }

      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        firstDay: 1,
        height: 'auto',
        nowIndicator: true,
        navLinks: true,
        dayMaxEvents: 3,
        eventDisplay: 'block',
        eventSources: [
          {
            url: calendarEl.dataset.eventsUrl,
            method: 'POST',
            extraParams: {
              filters: JSON.stringify({ 'calendar-id': 'admin-calendar' })
            },
            failure: function () {
              calendarEl.insertAdjacentHTML('beforebegin', '<div class="alert alert-warning mb-3">Impossible de charger les evenements du calendrier.</div>');
            }
          }
        ],
        headerToolbar: {
          start: 'prev,next today',
          center: 'title',
          end: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
        },
        buttonText: {
          today: "Aujourd'hui",
          month: 'Mois',
          week: 'Semaine',
          day: 'Jour',
          list: 'Liste'
        },
        dateClick: function (info) {
          setSelectedDate(info.dateStr);
        },
        eventClick: function (info) {
          setSelectedDate(info.event.startStr.slice(0, 10));
          if (info.event.url) {
            info.jsEvent.preventDefault();
            window.location.href = info.event.url;
          }
        },
        eventsSet: function (events) {
          cachedEvents = events;
          renderTasks();
        },
        eventDidMount: function (info) {
          const description = info.event.extendedProps.description || '';
          const type = info.event.extendedProps.type || 'Evenement';
          const priority = info.event.extendedProps.priority ? ' [' + info.event.extendedProps.priority + ']' : '';
          info.el.setAttribute('title', type + priority + (description ? ' - ' + description : ''));
        }
      });

      calendar.render();
      setSelectedDate(selectedDate);
      checkDueReminders();
      window.setInterval(checkDueReminders, 60000);

      taskForm?.addEventListener('submit', function (event) {
        event.preventDefault();
        const label = taskInput.value.trim();
        if (!label) {
          return;
        }

        const chosenDate = selectedDate;
        const tasks = getTasksForDate(chosenDate);
        const reminderValue = taskReminder.value ? new Date(taskReminder.value).toISOString() : null;
        tasks.unshift({
          id: 'manual-' + Date.now(),
          title: label,
          priority: 'medium',
          tag: 'Admin',
          status: taskStatus.value,
          auto: false,
          date: chosenDate,
          reminder: reminderValue,
          reminded: false
        });
        setTasksForDate(chosenDate, tasks);
        taskInput.value = '';
        taskStatus.value = 'todo';
        taskReminder.value = '';

        renderTasks();
      });

      taskList?.addEventListener('click', function (event) {
        const toggle = event.target.closest('[data-action="toggle"]');
        const row = event.target.closest('.ft-calendar-task-row');
        if (!toggle || !row) {
          return;
        }

        const index = Number(row.dataset.index);
        const tasks = getTasksForDate(selectedDate);
        const task = tasks[index];
        if (!task) {
          return;
        }

        task.status = task.status === 'done' ? 'todo' : 'done';
        tasks[index] = task;
        setTasksForDate(selectedDate, tasks);
        renderTasks();
      });
    });
  </script>
{% endblock %}
