            <span class="ft-calendar-kpi-icon green"><i class="bi bi-check-circle"></i></span>
            <div>
              <div class="ft-calendar-kpi-label">KYC approuvees</div>
              <div class="ft-calendar-kpi-value">16</div>
            </div>
          </div>
          <div class="ft-calendar-kpi-foot">
            <span class="ft-calendar-kpi-delta up">+22%</span>
            <span>vs mois dernier</span>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-xl">
        <div class="ft-calendar-kpi">
          <div class="ft-calendar-kpi-head">
            <span class="ft-calendar-kpi-icon red"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="ft-calendar-kpi-label">KYC refusees</div>
              <div class="ft-calendar-kpi-value">5</div>
            </div>
          </div>
          <div class="ft-calendar-kpi-foot">
