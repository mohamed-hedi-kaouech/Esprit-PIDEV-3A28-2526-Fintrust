{% extends 'admin/back.html.twig' %}

{% block title %}Calendrier admin{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <span class="text-muted small mx-2">/</span>
  <span class="fw-semibold text-primary small">Calendrier</span>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-calendar-page {
      --ft-cal-navy: #0f2f78;
      --ft-cal-blue: #2166f3;
      --ft-cal-sky: #eef5ff;
      --ft-cal-border: rgba(205, 222, 252, .96);
      --ft-cal-shadow: 0 24px 60px rgba(15, 40, 98, .08);
      --ft-cal-text-soft: #7589b0;
    }

    .ft-calendar-kpi {
      border-radius: 22px;
      border: 1px solid var(--ft-cal-border);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,255,.96));
      box-shadow: var(--ft-cal-shadow);
      padding: 1.1rem 1.15rem;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-kpi:hover,
    .ft-calendar-main-card:hover,
    .ft-calendar-todo-card:hover,
    .ft-calendar-quick-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 28px 64px rgba(15, 40, 98, .11);
    }

    .ft-calendar-kpi-head {
      display: flex;
      align-items: center;
      gap: .95rem;
    }

    .ft-calendar-kpi-icon {
      width: 54px;
      height: 54px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.25rem;
      box-shadow: 0 14px 26px rgba(17,24,39,.10);
      flex-shrink: 0;
    }

    .ft-calendar-kpi-icon.blue { background: linear-gradient(135deg, #2166f3, #0f56e8); }
    .ft-calendar-kpi-icon.orange { background: linear-gradient(135deg, #ffb11f, #ff8c00); }
    .ft-calendar-kpi-icon.green { background: linear-gradient(135deg, #24c777, #14a85e); }
    .ft-calendar-kpi-icon.red { background: linear-gradient(135deg, #ff6074, #ff3b57); }
    .ft-calendar-kpi-icon.indigo { background: linear-gradient(135deg, #265cf2, #2341d0); }

    .ft-calendar-kpi-label {
      color: #7e90b6;
      font-weight: 700;
      font-size: .92rem;
      margin-bottom: .2rem;
    }

    .ft-calendar-kpi-value {
      font-size: 2.1rem;
      line-height: 1;
      font-weight: 800;
      color: #112756;
      letter-spacing: -.04em;
    }

    .ft-calendar-kpi-foot {
      margin-top: .75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .5rem;
      color: var(--ft-cal-text-soft);
      font-size: .88rem;
    }

    .ft-calendar-kpi-delta {
      font-weight: 800;
    }

    .ft-calendar-kpi-delta.up { color: #16a34a; }
    .ft-calendar-kpi-delta.down { color: #f97316; }

    .ft-calendar-main-card,
    .ft-calendar-todo-card,
    .ft-calendar-quick-card {
      border-radius: 24px;
      border: 1px solid var(--ft-cal-border);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,251,255,.96));
      box-shadow: var(--ft-cal-shadow);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-main-card {
      padding: 1.25rem;
    }

    .ft-calendar-todo-card {
      padding: 1.15rem;
    }

    .ft-calendar-topline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .ft-calendar-title-wrap h1 {
      margin: 0;
      font-size: 1.55rem;
      font-weight: 800;
      color: #112756;
    }

    .ft-calendar-title-wrap p {
      margin: .35rem 0 0;
      color: var(--ft-cal-text-soft);
      max-width: 40rem;
      line-height: 1.6;
    }

    .ft-calendar-filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
    }

    .ft-calendar-pill {
      border: 1px solid rgba(216,228,255,.96);
      background: #fff;
      color: #5e7298;
      font-size: .8rem;
      font-weight: 800;
      border-radius: 999px;
      padding: .48rem .8rem;
      box-shadow: 0 8px 20px rgba(15, 40, 98, .05);
    }

    .ft-calendar-pill.active {
      background: linear-gradient(135deg, #2166f3, #0f56e8);
      color: #fff;
      border-color: transparent;
    }

    .ft-calendar-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(320px, .9fr);
      gap: 1.4rem;
      align-items: start;
    }

    .ft-calendar-shell {
      border-radius: 20px;
      border: 1px solid rgba(216,228,255,.96);
      background: #fff;
      padding: 1rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    }

    #calendar-holder {
      min-height: 740px;
    }

    .fc {
      color: #102657;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .fc .fc-toolbar-title {
      color: #102657;
      font-size: 1.45rem;
      font-weight: 800;
    }

    .fc .fc-button-primary {
      background: linear-gradient(135deg, #2166f3, #0f56e8);
      border-color: #1754d2;
      border-radius: 12px;
      font-weight: 800;
      box-shadow: 0 10px 22px rgba(33,102,243,.16);
    }

    .fc .fc-button-primary:hover,
    .fc .fc-button-primary:focus {
      background: linear-gradient(135deg, #175de7, #0a4fdd);
      border-color: #144ccf;
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active {
      background: linear-gradient(135deg, #ffae24, #ff8d18);
      border-color: #f08a00;
      color: #fff;
    }

    .fc .fc-daygrid-day.fc-day-today,
    .fc .fc-timegrid-col.fc-day-today {
      background: rgba(238,245,255,.95);
    }

    .fc .fc-event {
      border-radius: 8px;
      border-width: 0;
      padding: .1rem .2rem;
      font-weight: 700;
      box-shadow: 0 8px 20px rgba(15, 40, 98, .10);
    }

    .fc .fc-col-header-cell-cushion,
    .fc .fc-daygrid-day-number {
      color: #38527f;
      text-decoration: none;
      font-weight: 800;
    }

    .ft-calendar-energy {
      border-radius: 24px;
      padding: 1.25rem 1.3rem;
      color: #fff;
      background: linear-gradient(135deg, #294ee8, #6a36e8);
      box-shadow: 0 24px 60px rgba(42, 78, 232, .25);
      margin-bottom: 1rem;
    }

    .ft-calendar-energy-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: .75rem;
    }

    .ft-calendar-energy-kicker {
      text-transform: uppercase;
      font-size: .92rem;
      letter-spacing: .04em;
      font-weight: 800;
      opacity: .95;
    }

    .ft-calendar-energy-value {
      font-size: 3.3rem;
      line-height: 1;
      font-weight: 800;
      letter-spacing: -.05em;
    }

    .ft-calendar-energy-icon {
      width: 66px;
      height: 66px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,.18);
      font-size: 1.6rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.22);
    }

    .ft-calendar-energy-bar {
      height: 14px;
      border-radius: 999px;
      background: rgba(255,255,255,.18);
      overflow: hidden;
      margin: .9rem 0 1rem;
    }

    .ft-calendar-energy-bar > span {
      display: block;
      height: 100%;
      width: 18%;
      border-radius: 999px;
      background: linear-gradient(90deg, #ffb423, #ff7b78);
    }

    .ft-calendar-energy-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: .95rem;
      opacity: .96;
    }

    .ft-calendar-mini-stats {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.15rem;
    }

    .ft-calendar-stat {
      display: grid;
      grid-template-columns: 72px 1fr 54px 20px;
      align-items: center;
      gap: 1rem;
      border-radius: 20px;
      border: 1px solid rgba(220,230,255,.98);
      background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,251,255,.96));
      padding: 1rem 1rem;
      box-shadow: 0 16px 38px rgba(15, 40, 98, .05);
    }

    .ft-calendar-stat-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

    .ft-stat-blue { background: linear-gradient(145deg, #eff4ff, #dde9ff); color: #365bf3; }
    .ft-stat-green { background: linear-gradient(145deg, #ecfff5, #d7f9e8); color: #1da562; }
    .ft-stat-orange { background: linear-gradient(145deg, #fff5e9, #ffe7cf); color: #f08b1c; }

    .ft-calendar-stat-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #102657;
      margin-bottom: .25rem;
    }

    .ft-calendar-stat-copy {
      color: var(--ft-cal-text-soft);
      line-height: 1.45;
    }

    .ft-calendar-stat-count {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -.04em;
      background: linear-gradient(145deg, #eff4ff, #dde8ff);
      color: #2862ef;
    }

    .ft-calendar-stat:nth-child(2) .ft-calendar-stat-count {
      background: linear-gradient(145deg, #ecfff5, #d7f9e8);
      color: #1da562;
    }

    .ft-calendar-stat:nth-child(3) .ft-calendar-stat-count {
      background: linear-gradient(145deg, #fff5e9, #ffe7cf);
      color: #f08b1c;
    }

    .ft-calendar-todo-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .ft-calendar-todo-head {
      display: flex;
      align-items: center;
      gap: .8rem;
    }

    .ft-calendar-todo-head-icon {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #4e46e5;
      background: linear-gradient(145deg, #f1f0ff, #e2e0ff);
      font-size: 1.25rem;
    }

    .ft-calendar-todo-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #102657;
      margin-bottom: .15rem;
    }

    .ft-calendar-todo-sub {
      color: var(--ft-cal-text-soft);
      margin: 0;
      line-height: 1.6;
    }

    .ft-calendar-progress-badge {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .45rem .8rem;
      border-radius: 999px;
      border: 1px solid rgba(214,225,255,.96);
      background: #fff;
      color: #5f7399;
      font-size: .82rem;
      font-weight: 800;
    }

    .ft-calendar-todo-tabs {
      display: flex;
      gap: .9rem;
      padding-bottom: .65rem;
      border-bottom: 1px solid rgba(226,236,255,.95);
      margin-bottom: .8rem;
      font-size: .86rem;
      flex-wrap: wrap;
    }

    .ft-calendar-todo-tab {
      color: #7187b0;
      font-weight: 700;
    }

    .ft-calendar-todo-tab.active {
      color: #215ff1;
      position: relative;
    }

    .ft-calendar-todo-tab.active::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -.75rem;
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, #2166f3, #4e46e5);
    }

    .ft-calendar-task-list {
      display: grid;
      gap: .35rem;
      margin-bottom: 1rem;
    }

    .ft-calendar-task-row {
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr) auto auto 14px;
      align-items: center;
      gap: .8rem;
      padding: .65rem 0;
      border-bottom: 1px solid rgba(236,242,255,.96);
    }

    .ft-calendar-task-row:last-child {
      border-bottom: 0;
    }

    .ft-calendar-task-check {
      width: 18px;
      height: 18px;
      border-radius: 6px;
      border: 2px solid rgba(202,216,255,.98);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: transparent;
      font-size: .7rem;
      transition: all .2s ease;
      cursor: pointer;
    }

    .ft-calendar-task-row.is-complete .ft-calendar-task-check {
      background: #16a34a;
      border-color: #16a34a;
      color: #fff;
    }

    .ft-calendar-task-main {
      min-width: 0;
    }

    .ft-calendar-task-title {
      font-weight: 700;
      color: #102657;
      line-height: 1.35;
      margin-bottom: .18rem;
    }

    .ft-calendar-task-row.is-complete .ft-calendar-task-title {
      color: #6f83a9;
      text-decoration: line-through;
    }

    .ft-calendar-task-meta {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      font-size: .75rem;
      color: #8798b8;
    }

    .ft-calendar-tag {
      display: inline-flex;
      align-items: center;
      padding: .18rem .5rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: .73rem;
    }

    .ft-tag-high { background: rgba(255,102,129,.12); color: #ef4b64; }
    .ft-tag-medium { background: rgba(255,183,72,.15); color: #d98604; }
    .ft-tag-low { background: rgba(59,130,246,.12); color: #1d63f2; }
    .ft-tag-done { background: rgba(29,165,98,.12); color: #1d9a63; }
    .ft-tag-auto { background: rgba(78,70,229,.10); color: #4e46e5; }

    .ft-calendar-task-date {
      font-size: .8rem;
      color: #8596b5;
      white-space: nowrap;
    }

    .ft-calendar-task-more {
      color: #97a8c7;
    }

    .ft-calendar-task-form {
      display: flex;
      flex-direction: column;
      gap: .7rem;
      margin-top: 1rem;
      width: 100%;
    }

    .ft-calendar-field,
    .ft-calendar-select {
      width: 100%;
      border-radius: 16px;
      border: 1px solid rgba(210,224,255,.96);
      background: #fff;
      min-height: 54px;
      padding: .95rem 1rem;
      color: #1d315f;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.92);
    }

    .ft-calendar-field::placeholder {
      color: #98a8c6;
    }

    .ft-calendar-add-btn {
      border: 0;
      border-radius: 16px;
      min-height: 54px;
      padding: .9rem 1.35rem;
      min-width: 122px;
      background: linear-gradient(135deg, #4f46e5, #2563eb);
      color: #fff;
      font-weight: 800;
      box-shadow: 0 16px 32px rgba(79, 70, 229, .22);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .ft-calendar-add-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 38px rgba(79, 70, 229, .26);
    }

    .ft-calendar-quick-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .7rem;
    }

    .ft-calendar-form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: .7rem;
      width: 100%;
    }

    .ft-calendar-form-grid-secondary {
      display: grid;
      grid-template-columns: minmax(150px, .8fr) minmax(0, 1.2fr) auto;
      gap: .7rem;
      width: 100%;
      align-items: stretch;
    }

    .ft-calendar-reminder-toast-wrap {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 1080;
      display: grid;
      gap: .75rem;
      width: min(360px, calc(100vw - 2rem));
    }

    .ft-calendar-reminder-toast {
      border-radius: 18px;
      border: 1px solid rgba(197, 214, 255, .96);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(245,249,255,.96));
      box-shadow: 0 26px 50px rgba(15, 40, 98, .16);
      padding: 1rem 1rem;
      animation: ftToastIn .22s ease;
    }

    .ft-calendar-reminder-toast strong {
      display: block;
      color: #14316f;
      margin-bottom: .25rem;
      font-size: 1rem;
    }

    .ft-calendar-reminder-toast p {
      margin: 0;
      color: #6f84aa;
      line-height: 1.45;
    }

    @keyframes ftToastIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .ft-calendar-quick-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .55rem;
      min-height: 54px;
      border-radius: 16px;
      border: 1px solid rgba(216,228,255,.96);
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,250,255,.95));
      color: #215ff1;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 14px 30px rgba(15, 40, 98, .05);
    }

    .ft-calendar-quick-btn:hover {
      color: #184ec9;
      transform: translateY(-2px);
    }

    .ft-calendar-selected-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, .8fr);
      gap: 1rem;
      margin-bottom: 1.1rem;
    }

    .ft-calendar-selected-card {
      border-radius: 20px;
      border: 1px solid rgba(214,226,255,.96);
      background: linear-gradient(180deg, rgba(255,255,255,.99), rgba(248,251,255,.96));
      padding: 1rem 1.1rem;
      box-shadow: 0 14px 30px rgba(15, 40, 98, .05);
    }

    .ft-calendar-selected-card strong {
      display: block;
      color: #13306a;
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: .2rem;
    }

    .ft-calendar-selected-card span {
      color: var(--ft-cal-text-soft);
    }

    @media (max-width: 1199.98px) {
      .ft-calendar-layout,
      .ft-calendar-selected-row,
      .ft-calendar-task-form {
        grid-template-columns: 1fr;
      }

      .ft-calendar-form-grid,
      .ft-calendar-form-grid-secondary {
        grid-template-columns: 1fr;
      }

      .ft-calendar-quick-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 767.98px) {
      #calendar-holder {
        min-height: 620px;
      }

      .fc .fc-toolbar {
        align-items: flex-start;
        flex-direction: column;
        gap: .75rem;
      }

      .ft-calendar-stat {
        grid-template-columns: 64px 1fr 52px;
      }

      .ft-calendar-stat > i:last-child {
        display: none;
      }

      .ft-calendar-task-row {
        grid-template-columns: 20px minmax(0, 1fr);
      }
    }
  </style>
{% endblock %}

{% block admin_content %}
