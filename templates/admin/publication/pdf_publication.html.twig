<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ publication.titre }} - FinTrust</title>
    <style>
        @page {
            margin: 28px 34px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "DejaVu Sans", Arial, sans-serif;
            color: #172033;
            background: #f4f7fb;
            font-size: 12px;
            line-height: 1.6;
        }

        .document {
            background: #ffffff;
            border: 1px solid #d9e5f7;
        }

        .header {
            padding: 24px 28px;
            color: #ffffff;
            background: #173b8f;
        }

        .brand-row {
            width: 100%;
            margin-bottom: 24px;
        }

        .brand-mark {
            display: inline-block;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #ffffff;
            color: #173b8f;
            text-align: center;
            line-height: 42px;
            font-weight: 800;
            font-size: 16px;
            margin-right: 10px;
        }

        .brand-text {
            display: inline-block;
            vertical-align: top;
            padding-top: 2px;
        }

        .brand-name {
            display: block;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.04em;
        }

        .brand-subtitle {
            display: block;
            font-size: 10px;
            opacity: 0.78;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .category {
            display: inline-block;
            margin-bottom: 12px;
            padding: 5px 10px;
            border-radius: 999px;
            background: #dbeafe;
            color: #173b8f;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        h1 {
            margin: 0 0 12px;
            font-size: 28px;
            line-height: 1.15;
            color: #ffffff;
        }

        .meta {
            color: #dbeafe;
            font-size: 11px;
        }

        .meta span {
            display: inline-block;
            margin-right: 16px;
        }

        .content {
            padding: 26px 28px 20px;
        }

        .summary-grid {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 12px;
            margin-bottom: 12px;
        }

        .summary-grid td {
            vertical-align: top;
        }

        .summary-box {
            padding: 16px;
            border: 1px solid #c7d8f2;
            border-radius: 14px;
            background: #f8fbff;
        }

        .reading-box {
            width: 118px;
            padding: 16px;
            border-radius: 14px;
            background: #eaf4ff;
            border: 1px solid #c7d8f2;
            text-align: center;
        }

        .reading-value {
            display: block;
            font-size: 20px;
            font-weight: 800;
            color: #173b8f;
        }

        .reading-label {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .section {
            margin-top: 18px;
            padding: 18px;
            border: 1px solid #dbe7f7;
            border-radius: 14px;
            background: #ffffff;
        }

        .section-title {
            margin: 0 0 10px;
            color: #173b8f;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .section p {
            margin: 0;
        }

        .key-points {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .key-points li {
            margin-bottom: 8px;
            padding-left: 16px;
            position: relative;
        }

        .key-points li:before {
            content: "";
            position: absolute;
            left: 0;
            top: 8px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #2563eb;
        }

        .content-body {
            color: #334155;
            font-size: 12px;
        }

        .content-body p {
            margin: 0 0 10px;
        }

        .fallback {
            margin-top: 10px;
            padding: 10px 12px;
            border: 1px solid #fde68a;
            border-radius: 10px;
            background: #fffbeb;
            color: #92400e;
            font-size: 11px;
        }

        .footer {
            margin-top: 24px;
            padding: 14px 28px;
            border-top: 1px solid #dbe7f7;
            color: #64748b;
            font-size: 10px;
        }

        .footer strong {
            color: #173b8f;
        }
    </style>
</head>
<body>
    <div class="document">
        <header class="header">
            <div class="brand-row">
                <span class="brand-mark">FT</span>
                <span class="brand-text">
                    <span class="brand-name">FinTrust</span>
                    <span class="brand-subtitle">Publication intelligence report</span>
                </span>
            </div>

            <span class="category">{{ publication.categorie ?: 'Non definie' }}</span>
            <h1>{{ publication.titre }}</h1>
            <div class="meta">
                <span>Date publication : {{ publication.datePublication ? publication.datePublication|date('d/m/Y H:i') : 'Non definie' }}</span>
                <span>Document genere le : {{ generated_at|date('d/m/Y H:i') }}</span>
            </div>
        </header>

        <main class="content">
            {% if not analysis_available %}
                <div class="fallback">
                    L'analyse intelligente n'a pas pu etre generee. Le PDF contient tout de meme les informations principales de la publication.
                </div>
            {% endif %}

            <table class="summary-grid">
                <tr>
                    <td>
                        <div class="summary-box">
                            <h2 class="section-title">Resume intelligent</h2>
                            <p>{{ analysis.summary }}</p>
                        </div>
                    </td>
                    <td style="width: 132px; padding-left: 12px;">
                        <div class="reading-box">
                            <span class="reading-value">{{ analysis.reading_time }}</span>
                            <span class="reading-label">Lecture</span>
                        </div>
                    </td>
                </tr>
            </table>

            <section class="section">
                <h2 class="section-title">Points cles</h2>
                <ul class="key-points">
                    {% for point in analysis.key_points %}
                        <li>{{ point }}</li>
                    {% else %}
                        <li>Points cles non disponibles.</li>
                    {% endfor %}
                </ul>
            </section>

            <section class="section">
                <h2 class="section-title">Version simplifiee</h2>
                <p>{{ analysis.simplified }}</p>
            </section>

            <section class="section">
                <h2 class="section-title">Contenu complet</h2>
                <div class="content-body">
                    {{ publication.contenu|striptags('<p><br><strong><b><em><i><ul><ol><li>')|raw }}
                </div>
            </section>
        </main>

        <footer class="footer">
            <strong>FinTrust</strong> - Rapport PDF intelligent genere pour usage administratif. Les analyses automatiques servent d'aide a la lecture et ne remplacent pas une validation humaine.
        </footer>
    </div>
</body>
</html>
