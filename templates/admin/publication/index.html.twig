{% extends 'admin/back.html.twig' %}

{% block title %}Gestion des Publications{% endblock %}

{% block admin_content %}
<div class="admin-publications-container">
    <!-- En-tete avec bouton d'ajout -->
    <div class="publications-header">
        <div class="header-info">
            <h1 class="page-title">
                <svg class="icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5h16a2.5 2.5 0 0 0 2.5-2.5V6.5H1.5v10.5a2.5 2.5 0 0 0 2.5 2.5z"/>
                    <path d="M1.5 6.5h21M9 11h6M9 15h6"/>
                </svg>
                Publications Bancaires
            </h1>
            <p class="header-subtitle">G&eacute;rez vos publications, offres et contenus financiers dans une interface plus claire, plus fluide et plus premium.</p>
        </div>
        <div class="publication-actions">
            <a href="{{ path('admin_publications_create') }}" class="btn btn-primary btn-lg">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Nouvelle Publication
            </a>
            <div class="export-buttons">
                <a href="{{ path('admin_publications_export_csv', {search: search, category: current_category, sort: sort_by}) }}" class="btn btn-secondary btn-lg">Export CSV</a>
                <a href="{{ path('admin_publications_export_pdf', {search: search, category: current_category, sort: sort_by}) }}" class="btn btn-secondary btn-lg">Export PDF</a>
            </div>
        </div>
    </div>

    <!-- Statistiques elegantes -->
    <div class="stats-grid">
        <div class="stat-card stat-card-primary">
            <div class="stat-icon">&#128240;</div>
            <div class="stat-content">
                <h3 class="stat-value">{{ stats.total_publications }}</h3>
                <p class="stat-label">Publications totales</p>
            </div>
        </div>
        <div class="stat-card stat-card-success">
            <div class="stat-icon">&#9989;</div>
            <div class="stat-content">
                <h3 class="stat-value">{{ stats.published_publications }}</h3>
                <p class="stat-label">Publications publi&eacute;es</p>
            </div>
        </div>
        <div class="stat-card stat-card-info">
            <div class="stat-icon">&#128172;</div>
            <div class="stat-content">
                <h3 class="stat-value">{{ stats.total_comments }}</h3>
                <p class="stat-label">Commentaires totaux</p>
            </div>
        </div>
        <div class="stat-card stat-card-warning">
            <div class="stat-icon">&#11088;</div>
            <div class="stat-content">
                <h3 class="stat-value">{{ stats.total_feedbacks }}</h3>
                <p class="stat-label">Interactions totales</p>
            </div>
        </div>
    </div>

    <!-- Filtres et recherche -->
    <div class="filters-section">
        <form method="GET" class="filters-form">
            <div class="filter-group">
                <label for="search" class="filter-label">&#128269; Rechercher</label>
                <input 
                    type="text" 
                    id="search" 
                    name="search" 
                    value="{{ search }}" 
                    placeholder="Titre ou extrait..."
                    class="filter-input"
                >
            </div>

            <div class="filter-group">
                <label for="category" class="filter-label">&#128194; Cat&eacute;gorie</label>
                <select id="category" name="category" class="filter-select">
                    <option value="">Toutes les cat&eacute;gories</option>
                    {% for cat in categories %}
                        <option value="{{ cat }}" {% if current_category == cat %}selected{% endif %}>
                            {{ cat starts with 'Actualit' ? 'Actualit&eacute;' : (cat == 'CYBERSECURITE' ? 'Cybers&eacute;curit&eacute;' : (cat == 'TECH' ? 'Tech' : (cat == 'assurance' ? 'Assurance' : cat))) }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group">
                <label for="sort" class="filter-label">&#128202; Tri</label>
                <select id="sort" name="sort" class="filter-select">
                    <option value="newest" {% if sort_by == 'newest' %}selected{% endif %}>Plus r&eacute;centes</option>
                    <option value="likes" {% if sort_by == 'likes' %}selected{% endif %}>Plus lik&eacute;es</option>
                    <option value="comments" {% if sort_by == 'comments' %}selected{% endif %}>Plus comment&eacute;es</option>
                    <option value="engagement" {% if sort_by == 'engagement' %}selected{% endif %}>Tendance</option>
                </select>
            </div>

            <button type="submit" class="btn btn-secondary">Filtrer</button>
        </form>
    </div>

    <!-- Tableau des publications -->
    <div class="publications-table-shell">
        <div class="publications-table-shell__head">
            <div>
                <h2 class="publications-table-shell__title">Liste des publications</h2>
                <p class="publications-table-shell__subtitle">Une lecture plus claire des contenus, des statuts et des actions admin.</p>
            </div>
            <span class="publications-table-shell__badge">{{ total }} publication{{ total > 1 ? 's' : '' }}</span>
        </div>

        <div class="publications-table-wrapper">
            {% if publications|length > 0 %}
                <table class="publications-table publications-table--premium">
                    <thead>
                        <tr>
                            <th>Publication</th>
                            <th>Cat&eacute;gorie</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th class="text-center">Likes</th>
                            <th class="text-center">Dislikes</th>
                            <th class="text-center">Commentaires</th>
                            <th class="text-center">Note</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pub in publications %}
                            <tr class="publication-row">
                                <td class="title-cell">
                                    <div class="publication-primary-cell">
                                        <strong class="publication-primary-cell__title">{{ pub.titre|slice(0, 42) }}{{ pub.titre|length > 42 ? '...' : '' }}</strong>
                                        <span class="publication-primary-cell__meta">#{{ pub.id }} &bull; {{ pub.contenu|striptags|slice(0, 72) }}{{ pub.contenu|length > 72 ? '...' : '' }}</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-category badge-category--soft">
                                        {{ pub.categorie ? (pub.categorie starts with 'Actualit' ? 'Actualit&eacute;' : (pub.categorie == 'CYBERSECURITE' ? 'Cybers&eacute;curit&eacute;' : (pub.categorie == 'TECH' ? 'Tech' : (pub.categorie == 'assurance' ? 'Assurance' : pub.categorie)))) : 'Non d&eacute;finie' }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-{{ pub.statut == 'PUBLIE' ? 'published' : 'draft' }} badge-status">
                                        {% if pub.statut == 'PUBLIE' %}Publi&eacute;{% elseif pub.statut == 'BROUILLON' %}Brouillon{% else %}{{ pub.statut }}{% endif %}
                                    </span>
                                </td>
                                <td>
                                    <div class="date-pill">
                                        <strong>{{ pub.datePublication ? pub.datePublication|date('d/m') : '--/--' }}</strong>
                                        <span>{{ pub.datePublication ? pub.datePublication|date('Y') : '----' }}</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="metric-pill metric-pill--success" title="Likes">
                                        <i class="bi bi-hand-thumbs-up"></i>
                                        <strong>{{ pub.likeCount }}</strong>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="metric-pill metric-pill--danger" title="Dislikes">
                                        <i class="bi bi-hand-thumbs-down"></i>
                                        <strong>{{ pub.dislikeCount }}</strong>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="{{ path('admin_publications_comments', {id: pub.id}) }}" class="stat-badge stat-badge-info stat-badge-link" title="Voir les commentaires">
                                        <i class="bi bi-chat-left-text"></i>
                                        <span>{{ pub.commentCount }} avis</span>
                                    </a>
                                </td>
                                <td class="text-center">
                                    {% if pub.averageRating is not null %}
                                        <span class="rating-pill">
                                            <i class="bi bi-star-fill"></i>
                                            <strong>{{ pub.averageRating }}</strong>
                                            <small>/5</small>
                                        </span>
                                    {% else %}
                                        <span class="rating-placeholder">Aucune note</span>
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    <div class="action-buttons">
                                        <a href="{{ path('admin_publications_comments', {id: pub.id}) }}" class="btn-icon btn-info" title="Commentaires">
                                            <span class="btn-icon__glyph"><i class="bi bi-chat-left-text"></i></span>
                                            <span class="btn-icon__text">Avis</span>
                                        </a>
                                        <a href="{{ path('admin_publications_export_single_pdf', {id: pub.id}) }}" class="btn-icon btn-primary" title="Telecharger PDF intelligent">
                                            <span class="btn-icon__glyph"><i class="bi bi-file-earmark-pdf"></i></span>
                                            <span class="btn-icon__text">PDF intelligent</span>
                                        </a>
                                        <a href="{{ path('admin_publications_edit', {id: pub.id}) }}" class="btn-icon btn-warning" title="Modifier">
                                            <span class="btn-icon__glyph"><i class="bi bi-pencil-square"></i></span>
                                            <span class="btn-icon__text">Modifier</span>
                                        </a>
                                        <form method="POST" action="{{ path('admin_publications_delete', {id: pub.id}) }}" style="display:inline-flex;" onsubmit="return confirm('Confirmer la suppression?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pub.id) }}">
                                            <button type="submit" class="btn-icon btn-danger" title="Supprimer">
                                                <span class="btn-icon__glyph"><i class="bi bi-trash3"></i></span>
                                                <span class="btn-icon__text">Supprimer</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">&#128236;</div>
                    <h3>Aucune publication trouv&eacute;e</h3>
                    <p>Cr&eacute;ez votre premi&egrave;re publication pour commencer.</p>
                    <a href="{{ path('admin_publications_create') }}" class="btn btn-primary">Cr&eacute;er une publication</a>
                </div>
            {% endif %}
        </div>
    </div>
    <!-- Pagination -->
    {% if total_pages > 1 %}
        <div class="pagination">
            {% if current_page > 1 %}
                <a href="{{ path('admin_publications_index', {page: 1, search: search, category: current_category, sort: sort_by}) }}" class="page-link">&laquo; Premi&egrave;re</a>
                <a href="{{ path('admin_publications_index', {page: current_page - 1, search: search, category: current_category, sort: sort_by}) }}" class="page-link">&lsaquo; Pr&eacute;c&eacute;dente</a>
            {% endif %}

            {% for page in range(1, total_pages) %}
                <a 
                    href="{{ path('admin_publications_index', {page: page, search: search, category: current_category, sort: sort_by}) }}" 
                    class="page-link {% if page == current_page %}active{% endif %}"
                >
                    {{ page }}
                </a>
            {% endfor %}

            {% if current_page < total_pages %}
                <a href="{{ path('admin_publications_index', {page: current_page + 1, search: search, category: current_category, sort: sort_by}) }}" class="page-link">Suivante &rsaquo;</a>
                <a href="{{ path('admin_publications_index', {page: total_pages, search: search, category: current_category, sort: sort_by}) }}" class="page-link">Derni&egrave;re &raquo;</a>
            {% endif %}
        </div>
    {% endif %}

    <div class="publication-analytics publication-analytics--advanced">
        <div class="analytics-header">
            <div>
                <h2>Statistiques avancees</h2>
                <p class="analytics-subtitle">
                    Deux analyses plus pratiques : repartition editoriale par categorie et lecture claire du feedback.
                </p>
            </div>
            <span class="analytics-chip">Publication + Feedback</span>
        </div>

        <div class="analytics-summary-grid">
            <div class="analytics-summary-card">
                <span class="analytics-summary-card__label">Commentaires</span>
                <strong class="analytics-summary-card__value">{{ feedback_insights.totals.comments }}</strong>
            </div>
            <div class="analytics-summary-card analytics-summary-card--success">
                <span class="analytics-summary-card__label">Likes</span>
                <strong class="analytics-summary-card__value">{{ feedback_insights.totals.likes }}</strong>
            </div>
            <div class="analytics-summary-card analytics-summary-card--danger">
                <span class="analytics-summary-card__label">Dislikes</span>
                <strong class="analytics-summary-card__value">{{ feedback_insights.totals.dislikes }}</strong>
            </div>
            <div class="analytics-summary-card analytics-summary-card--accent">
                <span class="analytics-summary-card__label">Score engagement</span>
                <strong class="analytics-summary-card__value">{{ (feedback_insights.totals.comments * 3) + (feedback_insights.totals.likes * 2) - feedback_insights.totals.dislikes }}</strong>
            </div>
        </div>

        <div class="advanced-analytics-grid">
            <section class="advanced-panel">
                <div class="advanced-panel__head">
                    <div>
                        <h3>Chart des publications par categorie</h3>
                        <p>Mesurez le poids editorial et l'engagement de chaque categorie.</p>
                    </div>
                    <span class="advanced-panel__badge">{{ category_performance|length }} categories</span>
                </div>

                <div class="category-performance-list">
                    {% for item in category_performance %}
                        <article class="category-performance-item">
                            <div class="category-performance-item__top">
                                <div>
                                    <h4>{{ item.category starts with 'Actualit' ? 'Actualit&eacute;' : (item.category in ['CYBERSECURITE', 'Cybersecurite', 'Cybers?curit?'] ? 'Cybers&eacute;curit&eacute;' : item.category) }}</h4>
                                    <p>{{ item.publications }} publication{{ item.publications > 1 ? 's' : '' }} &bull; {{ item.engagement }} signal{{ item.engagement > 1 ? 's' : '' }}</p>
                                </div>
                                <div class="category-performance-item__metrics">
                                    <span>&#128077; {{ item.likes }} likes</span>
                                    <span>&#128172; {{ item.comments }} commentaires</span>
                                    <span>&#128078; {{ item.dislikes }} dislikes</span>
                                </div>
                            </div>

                            <div class="performance-bar-group">
                                <div class="performance-bar-row">
                                    <span class="performance-bar-row__label">Part des publications</span>
                                    <span class="performance-bar-row__value">{{ item.publication_ratio }}%</span>
                                </div>
                                <div class="performance-bar-track">
                                    <div class="performance-bar-track__fill" style="width: {{ item.publication_ratio }}%"></div>
                                </div>
                            </div>

                            <div class="performance-bar-group">
                                <div class="performance-bar-row">
                                    <span class="performance-bar-row__label">Intensite feedback</span>
                                    <span class="performance-bar-row__value">{{ item.engagement_ratio }}%</span>
                                </div>
                                <div class="performance-bar-track performance-bar-track--engagement">
                                    <div class="performance-bar-track__fill performance-bar-track__fill--engagement" style="width: {{ item.engagement_ratio }}%"></div>
                                </div>
                            </div>
                        </article>
                    {% else %}
                        <div class="advanced-empty-state">
                            <h4>Aucune categorie exploitable</h4>
                            <p>Les statistiques par categorie apparaitront ici des que les publications seront mieux structurees.</p>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="advanced-panel">
                {% set commentImpact = feedback_insights.totals.comments * 3 %}
                {% set likeImpact = feedback_insights.totals.likes * 2 %}
                {% set dislikeImpact = feedback_insights.totals.dislikes %}
                {% set engagementChartTotal = commentImpact + likeImpact + dislikeImpact %}
                {% set commentShare = engagementChartTotal > 0 ? ((commentImpact / engagementChartTotal) * 100)|round(2, 'floor') : 0 %}
                {% set likeShare = engagementChartTotal > 0 ? ((likeImpact / engagementChartTotal) * 100)|round(2, 'floor') : 0 %}
                {% set dislikeShare = engagementChartTotal > 0 ? (100 - commentShare - likeShare)|round(2, 'floor') : 0 %}
                <div class="advanced-panel__head">
                    <div>
                        <h3>Vue globale du score d'engagement</h3>
                        <p>Lecture visuelle de la formule engagement = commentaires x3 + likes x2 - dislikes.</p>
                    </div>
                    <span class="advanced-panel__badge">Synthese generale</span>
                </div>

                <div class="engagement-overview-card">
                    <div
                        class="engagement-overview-card__chart"
                        style="--comments-share: {{ commentShare }}; --likes-share: {{ likeShare }}; --dislikes-share: {{ dislikeShare }};"
                    >
                        <div class="engagement-overview-card__chart-inner">
                            <span class="engagement-overview-card__eyebrow">Score global</span>
                            <strong>{{ (feedback_insights.totals.comments * 3) + (feedback_insights.totals.likes * 2) - feedback_insights.totals.dislikes }}</strong>
                            <small>{{ feedback_insights.totals.comments + feedback_insights.totals.likes + feedback_insights.totals.dislikes }} interactions</small>
                        </div>
                    </div>

                    <div class="engagement-overview-card__legend">
                        <div class="engagement-overview-card__legend-head">
                            <h4>Composition du score</h4>
                            <p>Le cercle montre l’impact de chaque type d’interaction sur le score global.</p>
                        </div>

                        <div class="engagement-overview-card__legend-list">
                            <div class="engagement-legend-item engagement-legend-item--comments">
                                <span class="engagement-legend-item__dot"></span>
                                <div>
                                    <strong>Commentaires x3</strong>
                                    <small>{{ feedback_insights.totals.comments }} commentaire{{ feedback_insights.totals.comments > 1 ? 's' : '' }} • impact {{ commentImpact }}</small>
                                </div>
                                <span class="engagement-legend-item__value">{{ commentShare|round(0, 'common') }}%</span>
                            </div>

                            <div class="engagement-legend-item engagement-legend-item--likes">
                                <span class="engagement-legend-item__dot"></span>
                                <div>
                                    <strong>Likes x2</strong>
                                    <small>{{ feedback_insights.totals.likes }} like{{ feedback_insights.totals.likes > 1 ? 's' : '' }} • impact {{ likeImpact }}</small>
                                </div>
                                <span class="engagement-legend-item__value">{{ likeShare|round(0, 'common') }}%</span>
                            </div>

                            <div class="engagement-legend-item engagement-legend-item--dislikes">
                                <span class="engagement-legend-item__dot"></span>
                                <div>
                                    <strong>Dislikes</strong>
                                    <small>{{ feedback_insights.totals.dislikes }} dislike{{ feedback_insights.totals.dislikes > 1 ? 's' : '' }} • pression -{{ dislikeImpact }}</small>
                                </div>
                                <span class="engagement-legend-item__value">{{ dislikeShare|round(0, 'common') }}%</span>
                            </div>
                        </div>

                        <div class="engagement-overview-card__mini-stats">
                            <div class="engagement-mini-stat">
                                <span>Commentaires</span>
                                <strong>{{ feedback_insights.totals.comments }}</strong>
                            </div>
                            <div class="engagement-mini-stat engagement-mini-stat--success">
                                <span>Likes</span>
                                <strong>{{ feedback_insights.totals.likes }}</strong>
                            </div>
                            <div class="engagement-mini-stat engagement-mini-stat--danger">
                                <span>Dislikes</span>
                                <strong>{{ feedback_insights.totals.dislikes }}</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="advanced-panel__subhead">
                    <div>
                        <h4>Top publications</h4>
                        <p>Classement secondaire pour identifier les publications qui tirent le score vers le haut.</p>
                    </div>
                    <span class="advanced-panel__badge advanced-panel__badge--soft">{{ top_publications|length }} publications</span>
                </div>

                <div class="feedback-category-table feedback-category-table--bars">
                    <div class="feedback-category-table__head">
                        <span>Publication</span>
                        <span>Impact</span>
                    </div>
                    {% set topMaxScore = top_publications is not empty ? (top_publications|first).engagementScore : 0 %}
                    {% for pub in top_publications %}
                        {% set scoreRatio = topMaxScore > 0 ? ((pub.engagementScore / topMaxScore) * 100)|round(0, 'floor') : 0 %}
                        <div class="feedback-category-table__row feedback-category-table__row--bar">
                            <div>
                                <strong>{{ pub.titre }}</strong>
                                <small>&#128172; {{ pub.commentCount }} commentaires &nbsp; &#128077; {{ pub.likeCount }} likes &nbsp; &#128078; {{ pub.dislikeCount }} dislikes</small>
                            </div>
                            <div class="feedback-category-table__bar-wrap">
                                <div class="feedback-category-table__bar-track">
                                    <div class="feedback-category-table__bar-fill" style="width: {{ scoreRatio }}%"></div>
                                </div>
                                <span class="feedback-category-table__total">{{ pub.engagementScore }}</span>
                            </div>
                        </div>
                    {% else %}
                        <div class="advanced-empty-state">
                            <h4>Aucune publication classee</h4>
                            <p>Le top apparaitra des que les publications recevront des interactions.</p>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="advanced-panel">
                <div class="advanced-panel__head">
                    <div>
                        <h3>Chart hebdomadaire des publications</h3>
                        <p>Visualisez les jours ou vos publications sont le plus souvent mises en ligne.</p>
                    </div>
                    <span class="advanced-panel__badge">Lundi a Dimanche</span>
                </div>

                <div class="weekly-publication-chart">
                    {% for item in weekly_publication_stats %}
                        <div class="weekly-publication-chart__row">
                            <div class="weekly-publication-chart__label-wrap">
                                <span class="weekly-publication-chart__label">{{ item.label }}</span>
                                <span class="weekly-publication-chart__count">{{ item.count }} publication{{ item.count > 1 ? 's' : '' }}</span>
                            </div>
                            <div class="weekly-publication-chart__track">
                                <div class="weekly-publication-chart__fill" style="width: {{ item.ratio }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="feedback-ratio-stack feedback-ratio-stack--compact">
                    <div class="feedback-ratio-card feedback-ratio-card--success">
                        <div class="feedback-ratio-card__top">
                            <span class="feedback-ratio-card__label">Ratio positif</span>
                            <strong class="feedback-ratio-card__value">{{ feedback_insights.positive_rate }}%</strong>
                        </div>
                        <div class="feedback-ratio-card__track">
                            <div class="feedback-ratio-card__fill" style="width: {{ feedback_insights.positive_rate }}%"></div>
                        </div>
                    </div>

                    <div class="feedback-ratio-card feedback-ratio-card--neutral">
                        <div class="feedback-ratio-card__top">
                            <span class="feedback-ratio-card__label">Part commentaires</span>
                            <strong class="feedback-ratio-card__value">{{ feedback_insights.comment_rate }}%</strong>
                        </div>
                        <div class="feedback-ratio-card__track">
                            <div class="feedback-ratio-card__fill" style="width: {{ feedback_insights.comment_rate }}%"></div>
                        </div>
                    </div>

                    <div class="feedback-ratio-card feedback-ratio-card--danger">
                        <div class="feedback-ratio-card__top">
                            <span class="feedback-ratio-card__label">Ratio negatif</span>
                            <strong class="feedback-ratio-card__value">{{ feedback_insights.negative_rate }}%</strong>
                        </div>
                        <div class="feedback-ratio-card__track">
                            <div class="feedback-ratio-card__fill" style="width: {{ feedback_insights.negative_rate }}%"></div>
                        </div>
                    </div>
                </div>

            </section>
            </section>
        </div></div>
</div>

<style>
.admin-publications-container {
    padding: 2rem;
    max-width: 100%;
    overflow-x: hidden;
}

.publications-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
}

.page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #0f172a;
    display: flex;
    align-items: center;
