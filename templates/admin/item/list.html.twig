{% extends 'admin/back.html.twig' %}

{% block title %}Gestion des items{% endblock %}

{% block admin_content %}
{% set totalItems = 0 %}
{% set totalAmount = 0 %}
{% for categoryName, categoryItems in groupedItems %}
    {% set totalItems = totalItems + categoryItems|length %}
    {% for item in categoryItems %}
        {% set totalAmount = totalAmount + item.montant %}
    {% endfor %}
{% endfor %}
{% set averageAmount = totalItems > 0 ? totalAmount / totalItems : 0 %}

<div class="container-fluid mt-4 ft-admin-items-page">
    <div class="d-flex flex-wrap gap-2 justify-content-end mb-4">
        <a href="{{ path('admin_item_create') }}" class="btn ft-btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Nouvel item
        </a>
        <a href="{{ path('admin_item_export') ~ '?' ~ app.request.queryString }}" class="btn ft-btn-outline-primary">
            <i class="bi bi-file-earmark-pdf me-2"></i>Exporter PDF
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <section class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-items-kpi is-blue">
                <span class="ft-items-kpi-icon"><i class="bi bi-journal-check"></i></span>
                <div class="ft-items-kpi-label">Total items</div>
                <div class="ft-items-kpi-value">{{ totalItems }}</div>
                <div class="ft-items-kpi-text">Articles budgets actuellement suivis.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-items-kpi is-cyan">
                <span class="ft-items-kpi-icon"><i class="bi bi-cash-stack"></i></span>
                <div class="ft-items-kpi-label">Montant cumule</div>
                <div class="ft-items-kpi-value">{{ totalAmount|number_format(2, ',', ' ') }} DT</div>
                <div class="ft-items-kpi-text">Somme de tous les items affiches.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-items-kpi is-violet">
                <span class="ft-items-kpi-icon"><i class="bi bi-grid-3x3-gap"></i></span>
                <div class="ft-items-kpi-label">Categories visibles</div>
                <div class="ft-items-kpi-value">{{ groupedItems|length }}</div>
                <div class="ft-items-kpi-text">Regroupements categories apres filtre.</div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-items-kpi is-slate">
                <span class="ft-items-kpi-icon"><i class="bi bi-bar-chart-line"></i></span>
                <div class="ft-items-kpi-label">Montant moyen</div>
                <div class="ft-items-kpi-value">{{ averageAmount|number_format(2, ',', ' ') }} DT</div>
                <div class="ft-items-kpi-text">Niveau moyen par item dans la vue.</div>
            </article>
        </div>
    </section>

    <section class="ft-items-filter-card mb-4">
        <div class="ft-items-filter-head">
            <div>
                <span class="ft-items-section-kicker">Recherche avancee</span>
                <h2>Filtres budgetaires</h2>
            </div>
            <span class="ft-items-filter-badge"><i class="bi bi-bar-chart-line-fill me-2"></i>Vue dynamique</span>
        </div>

        <div class="ft-items-filter-body">
            <form method="GET" class="row g-3">
                <div class="col-lg-6">
                    <label for="search" class="form-label ft-items-label">Recherche par libelle</label>
                    <input type="text"
                           class="form-control ft-items-control"
                           id="search"
                           name="search"
                           value="{{ search }}"
                           placeholder="Entrez un libelle, un nom d article ou un mot cle...">
                </div>

                <div class="col-lg-6">
                    <label for="categorie" class="form-label ft-items-label">Categorie</label>
                    <select class="form-select ft-items-control" id="categorie" name="categorie">
                        <option value="">Toutes les categories</option>
                        {% for categorie in categories %}
                            <option value="{{ categorie.idCategorie }}" {% if categorieId == categorie.idCategorie %}selected{% endif %}>
                                {{ categorie.nomCategorie }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label for="min_amount" class="form-label ft-items-label">Montant min</label>
                    <input type="number"
                           step="0.01"
                           class="form-control ft-items-control"
                           id="min_amount"
                           name="min_amount"
                           value="{{ minAmount }}"
                           placeholder="0.00">
                </div>

                <div class="col-md-6 col-lg-3">
                    <label for="max_amount" class="form-label ft-items-label">Montant max</label>
                    <input type="number"
                           step="0.01"
                           class="form-control ft-items-control"
                           id="max_amount"
                           name="max_amount"
                           value="{{ maxAmount }}"
                           placeholder="0.00">
                </div>

                <div class="col-lg-6 d-flex align-items-end gap-2 flex-wrap">
                    <button type="submit" class="btn ft-btn-primary">
                        <i class="bi bi-search me-2"></i>Rechercher
                    </button>
                    <a href="{{ path('admin_item_list') }}" class="btn ft-btn-outline-primary">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reinitialiser
                    </a>
                </div>
            </form>
        </div>
    </section>

    {% if groupedItems|length > 0 %}
        <div class="ft-items-groups-stack">
            {% for categoryName, categoryItems in groupedItems %}
                {% set categoryAmount = 0 %}
                {% for item in categoryItems %}
                    {% set categoryAmount = categoryAmount + item.montant %}
                {% endfor %}
                <section class="ft-items-group-card">
                    <div class="ft-items-group-head">
                        <div class="ft-items-group-title">
                            <span class="ft-items-group-icon"><i class="bi bi-folder2-open"></i></span>
                            <div>
                                <h2>{{ categoryName }}</h2>
                                <p>{{ categoryItems|length }} item(s) pour {{ categoryAmount|number_format(2, ',', ' ') }} DT</p>
                            </div>
                        </div>
                        <span class="ft-items-group-badge">{{ categoryItems|length }} item(s)</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table ft-items-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Libelle</th>
                                    <th>Montant</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in categoryItems %}
                                    <tr>
                                        <td>
                                            <span class="ft-items-id-pill">#{{ item.idItem }}</span>
                                        </td>
                                        <td>
                                            <div class="ft-items-name-cell">
                                                <strong>{{ item.libelle }}</strong>
                                                <small>Article budgetaire FinTrust</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="ft-items-amount">{{ item.montant|number_format(2, ',', ' ') }} DT</span>
                                        </td>
                                        <td>
                                            <div class="ft-items-actions">
                                                <a href="{{ path('admin_item_show', {'idItem': item.idItem}) }}"
                                                   class="btn ft-items-action-btn is-view"
                                                   title="Voir">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('admin_item_edit', {'idItem': item.idItem}) }}"
                                                   class="btn ft-items-action-btn is-edit"
                                                   title="Modifier">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <form method="post"
                                                      action="{{ path('admin_item_delete', {'idItem': item.idItem}) }}"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Etes-vous sur de vouloir supprimer cet item ?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.idItem) }}">
                                                    <button type="submit" class="btn ft-items-action-btn is-delete" title="Supprimer">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endfor %}
        </div>
    {% else %}
        <div class="ft-items-empty-state">
            <div class="ft-items-empty-icon"><i class="bi bi-info-circle-fill"></i></div>
            <div class="ft-items-empty-copy">
                <strong>Aucun item trouve</strong>
                <span>Essayez un filtre plus large ou commencez par creer un nouvel item budgetaire.</span>
            </div>
            <a href="{{ path('admin_item_create') }}" class="btn ft-btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Creer un item
            </a>
        </div>
    {% endif %}
</div>

<style>
.ft-admin-items-page {
    position: relative;
    padding-bottom: 2rem;
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 24%),
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.08), transparent 22%);
}

.ft-items-hero {
    border-radius: 28px;
    border: 1px solid rgba(59, 130, 246, 0.14);
    background:
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.18), transparent 28%),
        radial-gradient(circle at left center, rgba(37, 99, 235, 0.08), transparent 26%),
        linear-gradient(135deg, #ffffff 0%, #f8fbff 40%, #eef5ff 100%);
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    padding: 1.75rem;
}

.ft-items-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .9fr);
    gap: 1.5rem;
    align-items: center;
}

.ft-items-kicker,
.ft-items-section-kicker {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: #2563eb;
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.ft-items-hero h1 {
    margin: 1rem 0 .5rem;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -.04em;
}

.ft-items-hero p {
    margin: 0;
    color: #64748b;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 48rem;
}

.ft-items-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.15rem;
}

.ft-items-hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .58rem .9rem;
    border-radius: 999px;
    background: rgba(255,255,255,.88);
    border: 1px solid rgba(191, 219, 254, 0.95);
    color: #36527b;
    font-size: .86rem;
    font-weight: 700;
}

.ft-items-hero-side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.ft-items-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    justify-content: flex-end;
}

.ft-items-hero-panel {
    margin-top: .5rem;
    padding: 1rem 1.05rem;
    border-radius: 22px;
    background: linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid rgba(191, 219, 254, 0.95);
    text-align: right;
}

.ft-items-hero-panel-label {
    display: block;
    color: #64748b;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: .2rem;
}

.ft-items-hero-panel strong {
    display: block;
    color: #0f172a;
    font-size: 1.5rem;
    font-weight: 800;
}

.ft-items-hero-panel small {
    color: #7184aa;
}

.ft-items-kpi {
    position: relative;
    overflow: hidden;
    height: 100%;
    padding: 1.25rem 1.2rem 1.15rem;
    border-radius: 24px;
    border: 1px solid rgba(191, 219, 254, 0.88);
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,250,255,.96));
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    transition: transform .2s ease, box-shadow .2s ease;
}

.ft-items-kpi::after {
    content: "";
    position: absolute;
    left: 1rem;
    bottom: .95rem;
    width: 3.1rem;
    height: 4px;
    border-radius: 999px;
    background: currentColor;
    opacity: .95;
}

.ft-items-kpi:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(15, 23, 42, 0.10);
}

.ft-items-kpi-icon {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    color: #fff;
    font-size: 1.2rem;
    margin-bottom: 1rem;
}

.ft-items-kpi.is-blue .ft-items-kpi-icon {
    background: linear-gradient(135deg, #7dd3fc, #38bdf8);
}
.ft-items-kpi.is-blue {
    color: #38bdf8;
}

.ft-items-kpi.is-cyan .ft-items-kpi-icon {
    background: linear-gradient(135deg, #a5f3fc, #67e8f9);
}
.ft-items-kpi.is-cyan {
    color: #22c7ee;
}

.ft-items-kpi.is-violet .ft-items-kpi-icon {
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
}
.ft-items-kpi.is-violet {
    color: #7c3aed;
}

.ft-items-kpi.is-slate .ft-items-kpi-icon {
    background: linear-gradient(135deg, #93c5fd, #60a5fa);
}
.ft-items-kpi.is-slate {
    color: #60a5fa;
}

.ft-items-kpi-label {
    color: #64748b;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.ft-items-kpi-value {
    margin-top: .5rem;
    color: #0f172a;
    font-size: 1.85rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -.04em;
}

.ft-items-kpi-text {
    margin-top: .55rem;
    color: #7184aa;
    font-size: .9rem;
}

.ft-items-filter-card,
.ft-items-group-card {
    background: rgba(255,255,255,0.96);
    border: 1px solid rgba(191, 219, 254, 0.85);
    border-radius: 28px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    overflow: hidden;
}

.ft-items-filter-head,
.ft-items-group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 1.45rem;
    background: linear-gradient(135deg, #1d4ed8, #2563eb 46%, #4f46e5 100%);
    color: #fff;
}

.ft-items-filter-head h2,
.ft-items-group-head h2 {
    margin: .3rem 0 0;
    font-size: 1.2rem;
    font-weight: 800;
}

.ft-items-filter-badge,
.ft-items-group-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .48rem .8rem;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    color: #2563eb;
    font-size: .78rem;
    font-weight: 800;
}

.ft-items-filter-body {
    padding: 1.4rem 1.45rem;
}

.ft-items-label {
    color: #0f172a;
    font-weight: 800;
    margin-bottom: .55rem;
}

.ft-items-control {
    min-height: 52px;
    border-radius: 16px;
    border-color: rgba(191, 219, 254, 0.94);
    box-shadow: none;
}

.ft-items-control:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 .2rem rgba(96, 165, 250, 0.18);
}

.ft-items-groups-stack {
    display: grid;
    gap: 1.25rem;
}

.ft-items-group-title {
    display: flex;
    align-items: center;
    gap: .95rem;
}

.ft-items-group-icon {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background: rgba(255,255,255,.22);
    color: #fff;
    font-size: 1rem;
}

.ft-items-group-title p {
    margin: .2rem 0 0;
    color: rgba(255,255,255,.88);
    font-size: .92rem;
}

.ft-items-table thead th {
    color: #64748b;
    font-size: .78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    border-bottom-color: rgba(191, 219, 254, 0.9);
    padding-top: 1rem;
    padding-bottom: 1rem;
}

.ft-items-table tbody td {
    padding-top: 1rem;
    padding-bottom: 1rem;
    vertical-align: middle;
}

.ft-items-table tbody tr:hover {
    background: rgba(240, 249, 255, 0.72);
    box-shadow: inset 4px 0 0 #60a5fa;
}

.ft-items-id-pill {
    display: inline-flex;
    align-items: center;
    padding: .4rem .65rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.10);
    color: #1d4ed8;
    font-weight: 800;
    font-size: .82rem;
}

.ft-items-name-cell strong {
    display: block;
    color: #0f172a;
}

.ft-items-name-cell small {
    color: #7184aa;
}

.ft-items-amount {
    color: #0f172a;
    font-size: 1rem;
    font-weight: 800;
}

.ft-items-actions {
    display: flex;
    align-items: center;
    gap: .45rem;
    flex-wrap: wrap;
}

.ft-items-action-btn {
    width: 38px;
    height: 38px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: none;
    transition: transform .2s ease, box-shadow .2s ease;
}

.ft-items-action-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(15, 23, 42, 0.10);
}

.ft-items-action-btn.is-view {
    background: linear-gradient(135deg, #38bdf8, #0ea5e9);
    color: #fff;
}

.ft-items-action-btn.is-edit {
    background: linear-gradient(135deg, #7dd3fc, #38bdf8);
    color: #fff;
}

.ft-items-action-btn.is-delete {
    background: linear-gradient(135deg, #fb7185, #ef4444);
    color: #fff;
}

.ft-items-empty-state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    border-radius: 24px;
    background: linear-gradient(135deg, #f0f9ff, #ecfeff);
    border: 1px solid rgba(125, 211, 252, 0.8);
    color: #0f172a;
}

.ft-items-empty-icon {
    width: 62px;
    height: 62px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: rgba(14, 165, 233, 0.12);
    color: #0ea5e9;
    font-size: 1.4rem;
    flex-shrink: 0;
}

.ft-items-empty-copy strong,
.ft-items-empty-copy span {
    display: block;
}

.ft-items-empty-copy span {
    color: #64748b;
    margin-top: .2rem;
}

@media (max-width: 991.98px) {
    .ft-items-hero-grid {
        grid-template-columns: 1fr;
    }

    .ft-items-hero-actions {
        justify-content: flex-start;
    }

    .ft-items-hero-panel {
        text-align: left;
    }
}

@media (max-width: 767.98px) {
    .ft-items-filter-head,
    .ft-items-group-head,
    .ft-items-empty-state {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 575.98px) {
    .ft-items-hero,
    .ft-items-filter-card,
    .ft-items-group-card {
        border-radius: 22px;
    }

    .ft-items-hero,
    .ft-items-filter-body {
        padding: 1.15rem;
    }

    .ft-items-hero h1 {
        font-size: 1.9rem;
    }
}
</style>

{% include 'admin/budget_ai/_widget.html.twig' %}
{% endblock %}
