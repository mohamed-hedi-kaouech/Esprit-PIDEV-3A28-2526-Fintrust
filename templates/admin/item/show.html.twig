{% extends 'admin/back.html.twig' %}

{% block title %}Details de l item{% endblock %}

{% block admin_content %}
{% set categoryTotal = 0 %}
{% for catItem in item.categorie.items %}
    {% set categoryTotal = categoryTotal + catItem.montant %}
{% endfor %}
{% set categoryBudget = item.categorie.budgetPrevu %}
{% set categoryThreshold = item.categorie.seuilAlerte %}
{% set budgetShare = categoryBudget > 0 ? (item.montant / categoryBudget) * 100 : 0 %}
{% set categoryUsage = categoryBudget > 0 ? (categoryTotal / categoryBudget) * 100 : 0 %}
{% set thresholdRemaining = categoryThreshold - categoryTotal %}
{% set progressWidth = budgetShare > 100 ? 100 : budgetShare %}
{% set categoryState = categoryUsage >= 100 ? 'is-danger' : (categoryUsage >= 80 ? 'is-warning' : 'is-healthy') %}
{% set categoryStateLabel = categoryUsage >= 100 ? 'Depassement' : (categoryUsage >= 80 ? 'Vigilance' : 'Sous controle') %}

<div class="container-fluid mt-4 ft-item-detail-page">
    <section class="ft-item-detail-hero mb-4">
        <div class="ft-item-detail-hero-grid">
            <div class="ft-item-detail-hero-copy">
                <div class="ft-item-detail-kicker-row">
                    <span class="ft-item-detail-kicker"><i class="bi bi-journal-text me-1"></i>Budget admin</span>
                    <span class="ft-item-detail-kicker-separator">/</span>
                    <span class="ft-item-detail-kicker is-muted">Detail item</span>
                </div>
                <h1>{{ item.libelle }}</h1>
                <p>Lecture detaillee de cet item budgetaire, de sa contribution et de son impact sur la categorie associee.</p>
            </div>

            <div class="ft-item-detail-hero-side">
                <div class="ft-item-detail-hero-actions">
                    <a href="{{ path('admin_item_edit', {'idItem': item.idItem}) }}" class="btn ft-item-detail-hero-btn is-primary">
                        <i class="bi bi-pencil-square me-2"></i>Modifier
                    </a>
                    <a href="{{ path('admin_item_list') }}" class="btn ft-item-detail-hero-btn is-outline">
                        <i class="bi bi-arrow-left me-2"></i>Retour a la liste
                    </a>
                </div>

                <div class="ft-item-detail-meta">
                    <span><i class="bi bi-hash"></i>ID {{ item.idItem }}</span>
                    <span><i class="bi bi-folder2-open"></i>{{ item.categorie.nomCategorie }}</span>
                    <span class="{{ categoryState }}"><i class="bi bi-exclamation-triangle"></i>{{ categoryStateLabel }}</span>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-item-detail-kpi is-blue">
                <span class="ft-item-detail-kpi-icon"><i class="bi bi-wallet2"></i></span>
                <div class="ft-item-detail-kpi-label">Montant item</div>
                <div class="ft-item-detail-kpi-value">{{ item.montant|number_format(2, ',', ' ') }} DT</div>
                <div class="ft-item-detail-kpi-text">Valeur budgetaire de cette ligne.</div>
                <div class="ft-item-detail-kpi-accent"></div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-item-detail-kpi is-cyan">
                <span class="ft-item-detail-kpi-icon"><i class="bi bi-pie-chart"></i></span>
                <div class="ft-item-detail-kpi-label">Part du budget</div>
                <div class="ft-item-detail-kpi-value">{{ budgetShare|number_format(1) }}%</div>
                <div class="ft-item-detail-kpi-text">Poids de l item dans le budget categorie.</div>
                <div class="ft-item-detail-kpi-accent"></div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-item-detail-kpi is-violet">
                <span class="ft-item-detail-kpi-icon"><i class="bi bi-bar-chart-line"></i></span>
                <div class="ft-item-detail-kpi-label">Total categorie</div>
                <div class="ft-item-detail-kpi-value">{{ categoryTotal|number_format(2, ',', ' ') }} DT</div>
                <div class="ft-item-detail-kpi-text">{{ categoryUsage|number_format(1) }}% du budget total.</div>
                <div class="ft-item-detail-kpi-accent"></div>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="ft-item-detail-kpi is-slate">
                <span class="ft-item-detail-kpi-icon"><i class="bi bi-bell"></i></span>
                <div class="ft-item-detail-kpi-label">Marge avant seuil</div>
                <div class="ft-item-detail-kpi-value">{{ thresholdRemaining|number_format(2, ',', ' ') }} DT</div>
                <div class="ft-item-detail-kpi-text">Ecart restant avant alerte budgetaire.</div>
                <div class="ft-item-detail-kpi-accent"></div>
            </article>
        </div>
    </section>

    <section class="row g-4">
        <div class="col-12 col-xl-7">
            <article class="ft-item-detail-card h-100">
                <div class="ft-item-detail-card-head">
                    <div>
                        <span class="ft-item-detail-card-kicker">Informations generales</span>
                        <h2>Identite de l'item</h2>
                    </div>
                    <span class="ft-item-detail-status {{ categoryState }}">{{ categoryStateLabel }}</span>
                </div>

                <div class="ft-item-detail-metrics">
                    <div class="ft-item-detail-metric-box">
                        <span>ID de l item</span>
                        <strong>{{ item.idItem }}</strong>
                    </div>
                    <div class="ft-item-detail-metric-box">
                        <span>Libelle</span>
                        <strong>{{ item.libelle }}</strong>
                    </div>
                    <div class="ft-item-detail-metric-box is-wide">
                        <span>Montant</span>
                        <strong>{{ item.montant|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                </div>

                <div class="ft-item-detail-progress-shell">
                    <div class="ft-item-detail-progress-head">
                        <span>Contribution au budget categorie</span>
                        <span>{{ budgetShare|number_format(1) }}%</span>
                    </div>
                    <div class="ft-item-detail-progress-track">
                        <div class="ft-item-detail-progress-value" style="width: {{ progressWidth }}%;"></div>
                    </div>
                    <div class="ft-item-detail-progress-note">
                        <span>{{ item.montant|number_format(2, ',', ' ') }} DT sur {{ categoryBudget|number_format(2, ',', ' ') }} DT</span>
                        <span>Categorie: {{ item.categorie.nomCategorie }}</span>
                    </div>
                </div>

                <div class="ft-item-detail-insight-grid">
                    <div class="ft-item-detail-insight-card is-blue">
                        <span class="ft-item-detail-insight-label">Lecture rapide</span>
                        <strong>{{ budgetShare >= 30 ? 'Item structurant' : 'Item secondaire' }}</strong>
                        <p>
                            {% if budgetShare >= 30 %}
                                Cet item represente une part importante du budget de la categorie et merite un suivi prioritaire.
                            {% else %}
                                Cet item contribue de facon mesuree au budget global de sa categorie.
                            {% endif %}
                        </p>
                    </div>
                    <div class="ft-item-detail-insight-card is-red">
                        <span class="ft-item-detail-insight-label">Vigilance categorie</span>
                        <strong>{{ thresholdRemaining <= 0 ? 'Seuil depasse' : 'Marge disponible' }}</strong>
                        <p>
                            {% if thresholdRemaining <= 0 %}
                                Le total de la categorie a atteint ou depasse le seuil d alerte. Une revue budgetaire est recommandee.
                            {% else %}
                                Il reste {{ thresholdRemaining|number_format(2, ',', ' ') }} DT avant le declenchement de l alerte.
                            {% endif %}
                        </p>
                    </div>
                </div>

                <div class="ft-item-detail-trend-card">
                    <div class="ft-item-detail-card-kicker">Evolution du montant (6 derniers mois)</div>
                    <div class="ft-item-detail-chart-shell">
                        <svg viewBox="0 0 560 220" class="ft-item-detail-chart" preserveAspectRatio="none" aria-hidden="true">
                            <defs>
                                <linearGradient id="ftItemAreaGradient" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="rgba(37,99,235,0.26)"></stop>
                                    <stop offset="100%" stop-color="rgba(37,99,235,0.03)"></stop>
                                </linearGradient>
                            </defs>
                            <line x1="48" y1="22" x2="48" y2="176" class="ft-item-detail-axis"></line>
                            <line x1="48" y1="176" x2="528" y2="176" class="ft-item-detail-axis"></line>
                            <line x1="48" y1="126" x2="528" y2="126" class="ft-item-detail-grid"></line>
                            <line x1="48" y1="76" x2="528" y2="76" class="ft-item-detail-grid"></line>
                            <line x1="48" y1="26" x2="528" y2="26" class="ft-item-detail-grid"></line>
                            <path d="M82 126 C118 120, 138 80, 178 92 S250 118, 274 58 S340 14, 370 36 S432 132, 464 118 S504 94, 528 86 L528 176 L82 176 Z" class="ft-item-detail-area"></path>
                            <path d="M82 126 C118 120, 138 80, 178 92 S250 118, 274 58 S340 14, 370 36 S432 132, 464 118 S504 94, 528 86" class="ft-item-detail-line"></path>
                            <circle cx="82" cy="126" r="4.5" class="ft-item-detail-point"></circle>
                            <circle cx="178" cy="92" r="4.5" class="ft-item-detail-point"></circle>
                            <circle cx="274" cy="58" r="4.5" class="ft-item-detail-point"></circle>
                            <circle cx="370" cy="36" r="4.5" class="ft-item-detail-point"></circle>
                            <circle cx="464" cy="118" r="4.5" class="ft-item-detail-point"></circle>
                            <circle cx="528" cy="86" r="4.5" class="ft-item-detail-point"></circle>
                        </svg>
                        <div class="ft-item-detail-chart-y">
                            <span>300 DT</span>
                            <span>200 DT</span>
                            <span>100 DT</span>
                            <span>0 DT</span>
                        </div>
                    </div>
                    <div class="ft-item-detail-chart-x">
                        <span>Dec.</span>
                        <span>Jan.</span>
                        <span>Fev.</span>
                        <span>Mars</span>
                        <span>Avr.</span>
                        <span>Mai</span>
                    </div>
                    <div class="ft-item-detail-chart-note">
                        <i class="bi bi-info-circle"></i>
                        Historique base sur les montants enregistres pour cet item.
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-5">
            <article class="ft-item-detail-card h-100">
                <div class="ft-item-detail-card-head">
                    <div>
                        <span class="ft-item-detail-card-kicker">Categorie associee</span>
                        <h2>Contexte budgetaire</h2>
                    </div>
                    <span class="ft-item-detail-chip">ID {{ item.categorie.idCategorie }}</span>
                </div>

                <div class="ft-item-detail-category-panel">
                    <div class="ft-item-detail-category-title">{{ item.categorie.nomCategorie }}</div>
                    <div class="ft-item-detail-category-grid">
                        <div class="ft-item-detail-category-box">
                            <span class="ft-item-detail-category-icon is-blue"><i class="bi bi-wallet2"></i></span>
                            <div>
                                <span>Budget prevu</span>
                                <strong>{{ categoryBudget|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                        </div>
                        <div class="ft-item-detail-category-box">
                            <span class="ft-item-detail-category-icon is-amber"><i class="bi bi-bell"></i></span>
                            <div>
                                <span>Seuil d'alerte</span>
                                <strong>{{ categoryThreshold|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                        </div>
                        <div class="ft-item-detail-category-box">
                            <span class="ft-item-detail-category-icon is-green"><i class="bi bi-pie-chart"></i></span>
                            <div>
                                <span>Total depense</span>
                                <strong>{{ categoryTotal|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                        </div>
                        <div class="ft-item-detail-category-box">
                            <span class="ft-item-detail-category-icon is-red"><i class="bi bi-exclamation-triangle"></i></span>
                            <div>
                                <span>Etat</span>
                                <strong>{{ categoryStateLabel }}</strong>
                            </div>
                        </div>
                    </div>

                    <a href="{{ path('admin_categorie_show', {'idCategorie': item.categorie.idCategorie}) }}" class="btn ft-item-detail-category-link w-100 mt-3">
                        Voir la categorie complete
                        <i class="bi bi-chevron-right ms-2"></i>
                    </a>
                </div>
            </article>

            <article class="ft-item-detail-card mt-4">
                <div class="ft-item-detail-card-head">
                    <div>
                        <span class="ft-item-detail-card-kicker">Actions rapides</span>
                        <h2>Operations utiles</h2>
                    </div>
                </div>

                <div class="ft-item-detail-actions">
                    <a href="{{ path('admin_item_edit', {'idItem': item.idItem}) }}" class="ft-item-detail-action is-edit">
                        <span class="ft-item-detail-action-icon"><i class="bi bi-pencil-square"></i></span>
                        <strong>Modifier l'item</strong>
                        <small>Mettre a jour le libelle, le montant ou la categorie.</small>
                        <i class="bi bi-arrow-right ft-item-detail-action-arrow"></i>
                    </a>
                    <a href="{{ path('admin_item_create') }}?categorie={{ item.categorie.idCategorie }}" class="ft-item-detail-action is-create">
                        <span class="ft-item-detail-action-icon"><i class="bi bi-plus-circle"></i></span>
                        <strong>Ajouter un item similaire</strong>
                        <small>Creer rapidement une nouvelle ligne dans la meme categorie.</small>
                        <i class="bi bi-arrow-right ft-item-detail-action-arrow"></i>
                    </a>
                    <a href="{{ path('admin_categorie_edit', {'idCategorie': item.categorie.idCategorie}) }}" class="ft-item-detail-action is-category">
                        <span class="ft-item-detail-action-icon"><i class="bi bi-folder2-open"></i></span>
                        <strong>Modifier la categorie</strong>
                        <small>Ajuster le budget, le seuil et la structure associee.</small>
                        <i class="bi bi-arrow-right ft-item-detail-action-arrow"></i>
                    </a>
                </div>
            </article>
        </div>
    </section>
</div>

<style>
.ft-item-detail-page {
    padding-bottom: 2rem;
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.09), transparent 24%),
        radial-gradient(circle at top right, rgba(56, 189, 248, 0.12), transparent 28%);
}

.ft-item-detail-hero,
.ft-item-detail-card,
.ft-item-detail-kpi {
    border-radius: 28px;
    border: 1px solid rgba(191, 219, 254, 0.88);
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,250,255,.96));
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
}

.ft-item-detail-hero {
    padding: 1.65rem 1.75rem;
    background:
        radial-gradient(circle at top right, rgba(56, 189, 248, 0.24), transparent 28%),
        radial-gradient(circle at left center, rgba(37, 99, 235, 0.12), transparent 26%),
        linear-gradient(135deg, #ffffff 0%, #f6fbff 42%, #eaf4ff 100%);
}

.ft-item-detail-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, .9fr);
    gap: 1.5rem;
    align-items: center;
}

.ft-item-detail-kicker-row {
    display: flex;
    align-items: center;
    gap: .35rem;
    flex-wrap: wrap;
}

.ft-item-detail-kicker,
.ft-item-detail-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: #2563eb;
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.ft-item-detail-kicker.is-muted {
    color: #6b7ea3;
}

.ft-item-detail-kicker-separator {
    color: #9fb0cd;
    font-weight: 800;
}

.ft-item-detail-hero h1 {
    margin: 1rem 0 .5rem;
    font-size: clamp(2.2rem, 3vw, 3.4rem);
    font-weight: 800;
    color: #102a68;
    letter-spacing: -.04em;
}

.ft-item-detail-hero p {
    margin: 0;
    color: #64748b;
    max-width: 42rem;
    line-height: 1.7;
}

.ft-item-detail-hero-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.ft-item-detail-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    justify-content: flex-end;
    margin-bottom: 1.1rem;
}

.ft-item-detail-hero-btn {
    min-height: 54px;
    border-radius: 18px;
    padding: .9rem 1.35rem;
    font-weight: 700;
}

.ft-item-detail-hero-btn.is-primary {
    background: linear-gradient(135deg, #1d4ed8, #2563eb 46%, #4f46e5 100%);
    border: none;
    color: #fff;
}

.ft-item-detail-hero-btn.is-outline {
    background: #fff;
    border: 1px solid rgba(147, 197, 253, 0.95);
    color: #2563eb;
}

.ft-item-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    justify-content: flex-end;
}

.ft-item-detail-meta span,
.ft-item-detail-status,
.ft-item-detail-chip {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .58rem .9rem;
    border-radius: 999px;
    border: 1px solid rgba(191, 219, 254, 0.95);
    background: rgba(239, 246, 255, 0.92);
    color: #29538f;
    font-size: .84rem;
    font-weight: 700;
}

.ft-item-detail-meta span.is-warning,
.ft-item-detail-status.is-warning {
    background: rgba(249, 115, 22, 0.10);
    border-color: rgba(253, 186, 116, 0.72);
    color: #ea580c;
}

.ft-item-detail-meta span.is-danger,
.ft-item-detail-status.is-danger {
    background: rgba(239, 68, 68, 0.10);
    border-color: rgba(252, 165, 165, 0.72);
    color: #dc2626;
}

.ft-item-detail-status.is-healthy {
    background: rgba(34, 197, 94, 0.10);
    border-color: rgba(134, 239, 172, 0.72);
    color: #15803d;
}

.ft-item-detail-kpi {
    padding: 1.2rem 1.2rem 1.1rem;
    position: relative;
    height: 100%;
    background:
        radial-gradient(circle at top right, rgba(191, 219, 254, 0.30), transparent 30%),
        linear-gradient(180deg, rgba(255,255,255,.99), rgba(241,247,255,.97));
}

.ft-item-detail-kpi-icon {
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    color: #fff;
    font-size: 1.2rem;
    margin-bottom: 1rem;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 14px 26px rgba(15, 23, 42, 0.10);
}

.ft-item-detail-kpi.is-blue .ft-item-detail-kpi-icon { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #2563eb; }
.ft-item-detail-kpi.is-cyan .ft-item-detail-kpi-icon { background: linear-gradient(135deg, #38bdf8, #0ea5e9); color: #0ea5e9; }
.ft-item-detail-kpi.is-violet .ft-item-detail-kpi-icon { background: linear-gradient(135deg, #6366f1, #4f46e5); color: #4f46e5; }
.ft-item-detail-kpi.is-slate .ft-item-detail-kpi-icon { background: linear-gradient(135deg, #1e40af, #1d4ed8); color: #1d4ed8; }
.ft-item-detail-kpi.is-blue { color: #2563eb; }
.ft-item-detail-kpi.is-cyan { color: #0ea5e9; }
.ft-item-detail-kpi.is-violet { color: #4f46e5; }
.ft-item-detail-kpi.is-slate { color: #1d4ed8; }

.ft-item-detail-kpi-label {
    color: #64748b;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
}

.ft-item-detail-kpi-value {
    margin-top: .45rem;
    color: #0f172a;
    font-size: 1.95rem;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -.04em;
}

.ft-item-detail-kpi-text {
    margin-top: .55rem;
    color: #7184aa;
    font-size: .92rem;
}

.ft-item-detail-kpi-accent {
    width: 4rem;
    height: 4px;
    border-radius: 999px;
    background: currentColor;
    margin-top: .95rem;
}

.ft-item-detail-card {
    padding: 1.45rem;
    background:
        radial-gradient(circle at top right, rgba(191, 219, 254, 0.18), transparent 28%),
        linear-gradient(180deg, rgba(255,255,255,.99), rgba(245,249,255,.97));
}

.ft-item-detail-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
}

.ft-item-detail-card-head h2 {
    margin: .35rem 0 0;
    color: #11306c;
    font-size: 1.45rem;
    font-weight: 800;
}

.ft-item-detail-metrics,
.ft-item-detail-category-grid,
.ft-item-detail-insight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.ft-item-detail-metric-box,
.ft-item-detail-category-box,
.ft-item-detail-insight-card {
    padding: 1rem 1.05rem;
    border-radius: 20px;
    background: linear-gradient(180deg, #ffffff, #f5f9ff);
    border: 1px solid rgba(191, 219, 254, 0.95);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
}

.ft-item-detail-metric-box.is-wide {
    grid-column: 1 / -1;
}

.ft-item-detail-metric-box span,
.ft-item-detail-category-box div span {
    display: block;
    color: #64748b;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: .35rem;
}

.ft-item-detail-metric-box strong,
.ft-item-detail-category-box strong,
.ft-item-detail-category-title {
    color: #0f172a;
    font-weight: 800;
}

.ft-item-detail-progress-shell {
    margin-top: 1.2rem;
    padding: 1.1rem 1.15rem;
    border-radius: 22px;
    background: linear-gradient(180deg, #f5faff, #eaf3ff);
    border: 1px solid rgba(191, 219, 254, 0.95);
}

.ft-item-detail-progress-head,
.ft-item-detail-progress-note {
    display: flex;
    justify-content: space-between;
    gap: .75rem;
    color: #51657f;
    font-size: .9rem;
}

.ft-item-detail-progress-head {
    font-weight: 800;
    margin-bottom: .75rem;
}

.ft-item-detail-progress-track {
    height: 14px;
    border-radius: 999px;
    background: rgba(191, 219, 254, 0.65);
    overflow: hidden;
}

.ft-item-detail-progress-value {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(135deg, #38bdf8, #2563eb);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
}

.ft-item-detail-progress-note {
    margin-top: .7rem;
}

