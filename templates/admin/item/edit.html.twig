{% extends 'admin/back.html.twig' %}

{% block title %}Modifier l'Item{% endblock %}

{% block admin_content %}
<div class="container-fluid ft-item-edit-page">
    <section class="ft-item-edit-hero mb-4">
        <div class="ft-item-edit-hero-main">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb ft-item-edit-breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('admin_item_list') }}">Items</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('admin_item_show', {'idItem': item.idItem}) }}">{{ item.libelle }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>

            <span class="ft-item-edit-kicker">
                <i class="bi bi-pencil-square"></i>
                Edition budgetaire
            </span>
            <h1>Modifier l'Item</h1>
            <p>Affinez les informations de votre article budgetaire avec une vue plus claire, plus fiable et plus premium.</p>
        </div>

        <div class="ft-item-edit-hero-actions">
            <a href="{{ path('admin_item_show', {'idItem': item.idItem}) }}" class="btn ft-item-edit-btn-primary">
                <i class="bi bi-eye me-2"></i>Voir les details
            </a>
            <a href="{{ path('admin_item_list') }}" class="btn ft-item-edit-btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Retour a la liste
            </a>
        </div>
    </section>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-xl-8">
            <section class="ft-item-edit-card">
                <div class="ft-item-edit-card-head">
                    <div class="ft-item-edit-card-title">
                        <span class="ft-item-edit-card-icon"><i class="bi bi-journal-text"></i></span>
                        <div>
                            <h2>Modification de l'Item</h2>
                            <p>Modifiez les informations de votre article budgetaire</p>
                        </div>
                    </div>
                    <span class="ft-item-edit-id-pill">ID: {{ item.idItem }}</span>
                </div>

                <div class="ft-item-edit-card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="ft-item-edit-form-grid">
                        <div class="ft-item-edit-field">
                            <label for="{{ form.libelle.vars.id }}" class="ft-item-edit-label">Libelle de l'item <span>*</span></label>
                            <div class="ft-item-edit-input-wrap">
                                <span class="ft-item-edit-input-icon"><i class="bi bi-type"></i></span>
                                {{ form_widget(form.libelle, {
                                    'attr': {
                                        'class': 'form-control ft-item-edit-control',
                                        'placeholder': 'Entrez le nom de l article budgetaire'
                                    }
                                }) }}
                            </div>
                            {% if form.libelle.vars.errors|length > 0 %}
                                <div class="ft-item-edit-error">
                                    {% for error in form.libelle.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="ft-item-edit-help">Description claire et precise de l article (3-100 caracteres)</small>
                        </div>

                        <div class="ft-item-edit-field">
                            <label for="{{ form.montant.vars.id }}" class="ft-item-edit-label">Montant (DT) <span>*</span></label>
                            <div class="ft-item-edit-input-wrap">
                                <span class="ft-item-edit-input-icon"><i class="bi bi-cash-stack"></i></span>
                                {{ form_widget(form.montant, {
                                    'attr': {
                                        'class': 'form-control ft-item-edit-control',
                                        'placeholder': '0.00',
                                        'step': '0.01'
                                    }
                                }) }}
                                <span class="ft-item-edit-suffix">DT</span>
                            </div>
                            {% if form.montant.vars.errors|length > 0 %}
                                <div class="ft-item-edit-error">
                                    {% for error in form.montant.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="ft-item-edit-help">Montant positif avec maximum 2 decimales</small>
                        </div>

                        <div class="ft-item-edit-field">
                            <label for="{{ form.categorieRel.vars.id }}" class="ft-item-edit-label">Categorie budgetaire <span>*</span></label>
                            <div class="ft-item-edit-input-wrap">
                                <span class="ft-item-edit-input-icon"><i class="bi bi-folder2-open"></i></span>
                                {{ form_widget(form.categorieRel, {
                                    'attr': {
                                        'class': 'form-select ft-item-edit-control ft-item-edit-select'
                                    }
                                }) }}
                            </div>
                            {% if form.categorieRel.vars.errors|length > 0 %}
                                <div class="ft-item-edit-error">
                                    {% for error in form.categorieRel.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <div class="ft-item-edit-meta">
                                {% if item.categorie %}
                                    <a href="{{ path('admin_categorie_edit', {'idCategorie': item.categorie.idCategorie}) }}" target="_blank" class="ft-item-edit-inline-link">
                                        Modifier la categorie actuelle
                                    </a>
                                {% endif %}
                                <small class="ft-item-edit-help">Choisissez la categorie budgetaire appropriee</small>
                            </div>
                        </div>
                    </div>

                    <div class="ft-item-edit-current-box">
                        <div class="ft-item-edit-section-head">
                            <h3><i class="bi bi-info-circle me-2"></i>Informations actuelles</h3>
                        </div>
                        <div class="ft-item-edit-current-grid">
                            <div class="ft-item-edit-mini-card">
                                <span>Libelle actuel</span>
                                <strong>{{ item.libelle }}</strong>
                            </div>
                            <div class="ft-item-edit-mini-card">
                                <span>Montant actuel</span>
                                <strong>{{ item.montant|number_format(2, ',', ' ') }} DT</strong>
                            </div>
                            <div class="ft-item-edit-mini-card">
                                <span>Categorie actuelle</span>
                                <strong>{{ item.categorie.nomCategorie }}</strong>
                            </div>
                        </div>
                    </div>

                    <div class="ft-item-edit-actions">
                        <button type="submit" class="btn ft-item-edit-submit">
                            <i class="bi bi-check2-circle me-2"></i>Mettre a jour l'Item
                        </button>
                        <a href="{{ path('admin_item_show', {'idItem': item.idItem}) }}" class="btn ft-item-edit-outline">
                            <i class="bi bi-eye me-2"></i>Voir les details
                        </a>
                        <a href="{{ path('admin_item_list') }}" class="btn ft-item-edit-cancel">
                            <i class="bi bi-x-circle me-2"></i>Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="ft-item-edit-side-card">
                <div class="ft-item-edit-section-head">
                    <h3><i class="bi bi-lightbulb me-2"></i>Lecture budgetaire</h3>
                </div>
                <div class="ft-item-edit-side-stack">
                    <div class="ft-item-edit-insight-card is-blue">
                        <span class="ft-item-edit-insight-label">Impact potentiel</span>
                        <strong>Chaque modification recalcule la lecture budgetaire de la categorie associee.</strong>
                    </div>
                    <div class="ft-item-edit-insight-card is-amber">
                        <span class="ft-item-edit-insight-label">Vigilance</span>
                        <strong>Changer le montant peut influencer les alertes et les equilibres de suivi.</strong>
                    </div>
                    <div class="ft-item-edit-insight-card is-green">
                        <span class="ft-item-edit-insight-label">Application</span>
                        <strong>Les changements enregistres sont pris en compte immediatement dans l espace admin.</strong>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
.ft-item-edit-page {
    background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 24%),
        radial-gradient(circle at top right, rgba(34, 211, 238, 0.10), transparent 26%);
}

.ft-item-edit-hero,
.ft-item-edit-card,
.ft-item-edit-side-card {
    border-radius: 28px;
    border: 1px solid rgba(191, 219, 254, 0.88);
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(246,250,255,.96));
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
}

.ft-item-edit-hero {
    padding: 1.55rem 1.7rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
}

.ft-item-edit-breadcrumb a {
    color: #59739e;
    text-decoration: none;
}

.ft-item-edit-breadcrumb .active {
    color: #10224f;
    font-weight: 700;
}

.ft-item-edit-kicker {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .5rem .9rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.10);
    color: #2563eb;
    font-size: .82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .03em;
}

.ft-item-edit-hero h1 {
    margin: .95rem 0 .45rem;
    font-size: clamp(2rem, 3vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -.04em;
    color: #0f172a;
}

.ft-item-edit-hero p {
    margin: 0;
    color: #667a9d;
    line-height: 1.7;
    max-width: 43rem;
}

.ft-item-edit-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    justify-content: flex-end;
}

.ft-item-edit-btn-primary,
.ft-item-edit-btn-secondary,
.ft-item-edit-submit,
.ft-item-edit-outline,
.ft-item-edit-cancel {
    min-height: 52px;
    border-radius: 16px;
    padding: .9rem 1.3rem;
    font-weight: 700;
    border: none;
}

.ft-item-edit-btn-primary,
.ft-item-edit-submit {
    background: linear-gradient(135deg, #1d4ed8, #2563eb 46%, #4f46e5 100%);
    color: #fff;
}

.ft-item-edit-btn-secondary,
.ft-item-edit-cancel {
    background: linear-gradient(135deg, #64748b, #475569);
    color: #fff;
}

.ft-item-edit-outline {
    background: #fff;
    color: #2563eb;
    border: 1px solid rgba(147, 197, 253, 0.95);
}

.ft-item-edit-card,
.ft-item-edit-side-card {
    overflow: hidden;
}

.ft-item-edit-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.45rem;
    background: linear-gradient(135deg, #1d4ed8, #2563eb 46%, #4f46e5 100%);
    color: #fff;
}

.ft-item-edit-card-title {
    display: flex;
    align-items: center;
    gap: .95rem;
}

.ft-item-edit-card-title h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
}

.ft-item-edit-card-title p {
    margin: .2rem 0 0;
    color: rgba(255,255,255,.86);
}

.ft-item-edit-card-icon {
    width: 46px;
    height: 46px;
    border-radius: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.22);
    font-size: 1.05rem;
}

.ft-item-edit-id-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .48rem .82rem;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    color: #2563eb;
    font-size: .8rem;
    font-weight: 800;
}

.ft-item-edit-card-body,
.ft-item-edit-side-card {
    padding: 1.5rem;
}

.ft-item-edit-form-grid {
    display: grid;
    gap: 1.4rem;
}

.ft-item-edit-field {
    display: grid;
    gap: .55rem;
}

.ft-item-edit-label {
    color: #0f172a;
    font-weight: 800;
}

.ft-item-edit-label span {
    color: #ef4444;
}

.ft-item-edit-input-wrap {
    position: relative;
}

.ft-item-edit-input-icon,
.ft-item-edit-suffix {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    color: #6b7ea3;
    font-weight: 700;
}

.ft-item-edit-input-icon {
    left: 1rem;
}

.ft-item-edit-suffix {
    right: 1rem;
}

.ft-item-edit-control {
    min-height: 58px;
    border-radius: 18px;
    border: 1px solid rgba(191, 219, 254, 0.94);
    box-shadow: none;
    padding-left: 3rem;
    color: #0f172a;
}

.ft-item-edit-select {
    padding-right: 2.7rem;
}

.ft-item-edit-control:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 .22rem rgba(96, 165, 250, 0.16);
}

.ft-item-edit-help {
    color: #7184aa;
    font-size: .88rem;
}

.ft-item-edit-error {
    color: #dc2626;
    font-size: .9rem;
    font-weight: 600;
}

.ft-item-edit-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem 1rem;
    align-items: center;
}

.ft-item-edit-inline-link {
    color: #2563eb;
    font-weight: 700;
    text-decoration: none;
}

.ft-item-edit-current-box {
    margin-top: 1.5rem;
    margin-bottom: 1.65rem;
    border-radius: 22px;
    border: 1px solid rgba(253, 230, 138, 0.72);
    background: linear-gradient(135deg, rgba(255, 247, 237, 0.96), rgba(255, 251, 235, 0.96));
    padding: 1.2rem;
}

.ft-item-edit-section-head h3 {
    margin: 0 0 .95rem;
    font-size: 1.08rem;
    font-weight: 800;
    color: #a16207;
}

.ft-item-edit-current-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .9rem;
}

.ft-item-edit-mini-card {
    padding: 1rem;
    border-radius: 18px;
    background: rgba(255,255,255,.84);
    border: 1px solid rgba(251, 191, 36, 0.18);
}

.ft-item-edit-mini-card span {
    display: block;
    color: #8a6a26;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: .35rem;
}

.ft-item-edit-mini-card strong {
    color: #0f172a;
    font-size: 1rem;
}

.ft-item-edit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
}

.ft-item-edit-side-stack {
    display: grid;
    gap: .95rem;
}

.ft-item-edit-insight-card {
    border-radius: 20px;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(214, 226, 255, 0.88);
    background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(246,249,255,.94));
}

.ft-item-edit-insight-card.is-blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(255,255,255,.96));
}

.ft-item-edit-insight-card.is-amber {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.08), rgba(255,255,255,.96));
}

.ft-item-edit-insight-card.is-green {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.08), rgba(255,255,255,.96));
}

.ft-item-edit-insight-label {
    display: block;
    color: #64748b;
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: .45rem;
}

.ft-item-edit-insight-card strong {
    color: #0f172a;
    line-height: 1.55;
}

@media (max-width: 1199.98px) {
    .ft-item-edit-hero {
        flex-direction: column;
    }

    .ft-item-edit-hero-actions {
        justify-content: flex-start;
    }
}

@media (max-width: 767.98px) {
    .ft-item-edit-current-grid {
        grid-template-columns: 1fr;
    }

    .ft-item-edit-card-head {
        flex-direction: column;
        align-items: flex-start;
    }
}
</style>
{% endblock %}
