{% extends 'admin/back.html.twig' %}

{% block title %}Creer un Nouvel Item{% endblock %}

{% block admin_content %}
<div class="container-fluid ft-item-create-page">
    <section class="ft-item-create-hero mb-4">
        <div class="ft-item-create-hero-main">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb ft-item-create-breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('admin_item_list') }}">Items</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Creer</li>
                </ol>
            </nav>

            <span class="ft-item-create-kicker">
                <i class="bi bi-plus-circle"></i>
                Creation budgetaire
            </span>
            <h1>Creer un Nouvel Item</h1>
            <p>Ajoutez un nouvel article budgetaire dans une interface plus claire, plus guidee et plus premium pour votre pilotage admin.</p>
        </div>

        <div class="ft-item-create-hero-actions">
            <a href="{{ path('admin_item_list') }}" class="btn ft-item-create-btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Retour a la liste
            </a>
        </div>
    </section>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-xl-8">
            <section class="ft-item-create-card">
                <div class="ft-item-create-card-head">
                    <div class="ft-item-create-card-title">
                        <span class="ft-item-create-card-icon"><i class="bi bi-journal-plus"></i></span>
                        <div>
                            <h2>Informations de l'Item</h2>
                            <p>Renseignez les details de votre nouvel article budgetaire</p>
                        </div>
                    </div>
                </div>

                <div class="ft-item-create-card-body">
                    <div class="ft-item-create-ocr-shell mb-4" id="ocrZone">
                        <div class="ft-item-create-section-head">
                            <h3><i class="bi bi-magic me-2"></i>Remplissage automatique par OCR</h3>
                            <p>Importez une facture image ou PDF pour pre-remplir les champs en quelques secondes.</p>
                        </div>

                        <div class="ft-item-create-drop-area" id="ocrDropArea">
                            <input type="file" id="ocrFileInput" accept="image/*,.pdf" hidden>
                            <div class="ft-item-create-drop-content" id="ocrDropContent">
                                <span class="ft-item-create-drop-icon"><i class="bi bi-cloud-arrow-up"></i></span>
                                <strong>Glissez votre facture ici</strong>
                                <span class="ft-item-create-drop-separator">ou</span>
                                <button type="button" class="btn ft-item-create-upload-btn" onclick="document.getElementById('ocrFileInput').click()">
                                    <i class="bi bi-folder2-open me-2"></i>Choisir un fichier
                                </button>
                                <small>PDF, JPG, PNG, BMP, GIF, TIF, TIFF, WEBP · Max 5 Mo</small>
                            </div>
                        </div>

                        <div class="ft-item-create-ocr-loading d-none" id="ocrLoading">
                            <div class="ft-item-create-spinner"></div>
                            <span>Analyse OCR en cours...</span>
                        </div>

                        <div class="ft-item-create-ocr-result d-none" id="ocrResult">
                            <div class="ft-item-create-ocr-result-head">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Donnees detectees, verifiez puis appliquez</strong>
                            </div>
                            <div class="ft-item-create-ocr-fields" id="ocrResultFields"></div>
                            <div class="ft-item-create-ocr-actions">
                                <button type="button" class="btn ft-item-create-apply-btn" id="ocrApplyBtn">
                                    <i class="bi bi-check2 me-2"></i>Appliquer au formulaire
                                </button>
                                <button type="button" class="btn ft-item-create-reset-btn" id="ocrResetBtn">
                                    <i class="bi bi-arrow-counterclockwise me-2"></i>Reessayer
                                </button>
                            </div>
                        </div>

                        <div class="ft-item-create-ocr-error d-none" id="ocrError">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <span id="ocrErrorMsg"></span>
                            <button type="button" class="btn btn-sm ft-item-create-reset-btn ms-3" id="ocrErrorReset">Reessayer</button>
                        </div>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="ft-item-create-form-grid">
                        <div class="ft-item-create-field">
                            <label for="{{ form.libelle.vars.id }}" class="ft-item-create-label">Libelle de l'item <span>*</span></label>
                            <div class="ft-item-create-input-wrap">
                                <span class="ft-item-create-input-icon"><i class="bi bi-type"></i></span>
                                {{ form_widget(form.libelle, {
                                    'attr': {
                                        'class': 'form-control ft-item-create-control',
                                        'placeholder': 'Entrez le nom de l article budgetaire'
                                    }
                                }) }}
                            </div>
                            {% if form.libelle.vars.errors|length > 0 %}
                                <div class="ft-item-create-error">
                                    {% for error in form.libelle.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="ft-item-create-help">Description claire et precise de l article (3-100 caracteres)</small>
                        </div>

                        <div class="ft-item-create-field">
                            <label for="{{ form.montant.vars.id }}" class="ft-item-create-label">Montant (DT) <span>*</span></label>
                            <div class="ft-item-create-input-wrap">
                                <span class="ft-item-create-input-icon"><i class="bi bi-cash-stack"></i></span>
                                {{ form_widget(form.montant, {
                                    'attr': {
                                        'class': 'form-control ft-item-create-control',
                                        'placeholder': '0.00',
                                        'step': '0.01'
                                    }
                                }) }}
                                <span class="ft-item-create-suffix">DT</span>
                            </div>
                            {% if form.montant.vars.errors|length > 0 %}
                                <div class="ft-item-create-error">
                                    {% for error in form.montant.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="ft-item-create-help">Montant positif avec maximum 2 decimales</small>
                        </div>

                        <div class="ft-item-create-field">
                            <label for="{{ form.categorieRel.vars.id }}" class="ft-item-create-label">Categorie budgetaire <span>*</span></label>
                            <div class="ft-item-create-input-wrap">
                                <span class="ft-item-create-input-icon"><i class="bi bi-folder2-open"></i></span>
                                {{ form_widget(form.categorieRel, {
                                    'attr': {
                                        'class': 'form-select ft-item-create-control ft-item-create-select'
                                    }
                                }) }}
                            </div>
                            {% if form.categorieRel.vars.errors|length > 0 %}
                                <div class="ft-item-create-error">
                                    {% for error in form.categorieRel.vars.errors %}
                                        <div><i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="ft-item-create-help">Choisissez la categorie budgetaire appropriee</small>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="ft-item-create-field">
                                    <label for="{{ form.quantite.vars.id }}" class="ft-item-create-label">Quantite</label>
                                    <div class="ft-item-create-input-wrap">
                                        <span class="ft-item-create-input-icon"><i class="bi bi-123"></i></span>
                                        {{ form_widget(form.quantite, {'attr': {'class': 'form-control ft-item-create-control', 'placeholder': '1', 'id': 'field_quantite'}}) }}
                                    </div>
                                    {% if form.quantite.vars.errors|length > 0 %}
                                        <div class="ft-item-create-error">{% for e in form.quantite.vars.errors %}<div>{{ e.message }}</div>{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ft-item-create-field">
                                    <label for="{{ form.prixUnitaire.vars.id }}" class="ft-item-create-label">Prix unitaire (TND)</label>
                                    <div class="ft-item-create-input-wrap">
                                        <span class="ft-item-create-input-icon"><i class="bi bi-tag"></i></span>
                                        {{ form_widget(form.prixUnitaire, {'attr': {'class': 'form-control ft-item-create-control', 'placeholder': '0.000', 'id': 'field_prix_unitaire'}}) }}
                                    </div>
                                    {% if form.prixUnitaire.vars.errors|length > 0 %}
                                        <div class="ft-item-create-error">{% for e in form.prixUnitaire.vars.errors %}<div>{{ e.message }}</div>{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ft-item-create-field">
                                    <label for="{{ form.tva.vars.id }}" class="ft-item-create-label">TVA (%)</label>
                                    <div class="ft-item-create-input-wrap">
                                        <span class="ft-item-create-input-icon"><i class="bi bi-percent"></i></span>
                                        {{ form_widget(form.tva, {'attr': {'class': 'form-control ft-item-create-control', 'placeholder': '0'}}) }}
                                        <span class="ft-item-create-suffix">%</span>
                                    </div>
                                    {% if form.tva.vars.errors|length > 0 %}
                                        <div class="ft-item-create-error">{% for e in form.tva.vars.errors %}<div>{{ e.message }}</div>{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ft-item-create-preview-box" id="budgetPreview" style="display:none;">
                        <div class="ft-item-create-section-head">
                            <h3><i class="bi bi-bar-chart-line me-2"></i>Apercu budgetaire</h3>
                        </div>
                        <div class="ft-item-create-preview-grid">
                            <div class="ft-item-create-preview-card">
                                <span>Categorie selectionnee</span>
                                <strong id="selectedCategory">-</strong>
                            </div>
                            <div class="ft-item-create-preview-card">
                                <span>Budget prevu</span>
                                <strong id="categoryBudget">-</strong>
                            </div>
                            <div class="ft-item-create-preview-card">
                                <span>Total actuel</span>
                                <strong id="currentTotal">-</strong>
                            </div>
                            <div class="ft-item-create-preview-card is-highlight">
                                <span>Apres ajout</span>
                                <strong id="newTotal">-</strong>
                            </div>
                        </div>
                    </div>

                    <div class="ft-item-create-actions">
                        <button type="submit" class="btn ft-item-create-submit">
                            <i class="bi bi-check2-circle me-2"></i>Creer l'Item
                        </button>
                        <a href="{{ path('admin_item_list') }}" class="btn ft-item-create-cancel">
                            <i class="bi bi-x-circle me-2"></i>Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="ft-item-create-side-card">
                <div class="ft-item-create-section-head">
                    <h3><i class="bi bi-lightbulb me-2"></i>Lecture budgetaire</h3>
                </div>
                <div class="ft-item-create-side-stack">
                    <div class="ft-item-create-insight-card is-blue">
                        <span class="ft-item-create-insight-label">Assistance OCR</span>
                        <strong>Importez une facture pour gagner du temps sur le libelle, le montant et les champs financiers.</strong>
                    </div>
                    <div class="ft-item-create-insight-card is-amber">
                        <span class="ft-item-create-insight-label">Vigilance</span>
                        <strong>Le montant saisi peut influencer les alertes de categorie et la lecture budgetaire globale.</strong>
                    </div>
                    <div class="ft-item-create-insight-card is-green">
                        <span class="ft-item-create-insight-label">Application</span>
                        <strong>Une fois enregistre, l item sera immediatement pris en compte dans vos statistiques budgetaires.</strong>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const categorySelect = document.querySelector('#{{ form.categorieRel.vars.id }}');
    const montantInput = document.querySelector('#{{ form.montant.vars.id }}');
    const budgetPreview = document.getElementById('budgetPreview');

    const categoriesData = {
        {% for categorie in form.categorieRel.vars.choices %}
            {{ categorie.data.idCategorie }}: {
                nom: "{{ categorie.data.nomCategorie }}",
                budget: {{ categorie.data.budgetPrevu }},
                seuil: {{ categorie.data.seuilAlerte }},
                items: {{ categorie.data.items|length }}
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    };

    function updateBudgetPreview() {
        const selectedCategoryId = categorySelect.value;
        const montant = parseFloat(montantInput.value) || 0;

        if (selectedCategoryId && categoriesData[selectedCategoryId]) {
            const category = categoriesData[selectedCategoryId];
            const currentTotal = category.budget - (category.budget * 0.1);
            const newTotal = currentTotal + montant;

            document.getElementById('selectedCategory').textContent = category.nom;
            document.getElementById('categoryBudget').textContent = category.budget.toFixed(2) + ' DT';
            document.getElementById('currentTotal').textContent = currentTotal.toFixed(2) + ' DT';
            document.getElementById('newTotal').textContent = newTotal.toFixed(2) + ' DT';

            budgetPreview.style.display = 'block';
        } else {
            budgetPreview.style.display = 'none';
        }
    }

    categorySelect.addEventListener('change', updateBudgetPreview);
    montantInput.addEventListener('input', updateBudgetPreview);
});
</script>

