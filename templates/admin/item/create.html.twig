<script>
const ocrUrl = '{{ path("admin_ocr_extract") }}';
let ocrData  = {};

const dropArea    = document.getElementById('ocrDropArea');
const fileInput   = document.getElementById('ocrFileInput');
const loading     = document.getElementById('ocrLoading');
const result      = document.getElementById('ocrResult');
const errorBox    = document.getElementById('ocrError');
const dropContent = document.getElementById('ocrDropContent');

// Drag & drop
dropArea.addEventListener('dragover',  e => { e.preventDefault(); dropArea.classList.add('drag-over'); });
dropArea.addEventListener('dragleave', () => dropArea.classList.remove('drag-over'));
dropArea.addEventListener('drop', e => {
    e.preventDefault(); dropArea.classList.remove('drag-over');
    const f = e.dataTransfer.files[0];
    if (f) processFile(f);
});
dropArea.addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', () => { if (fileInput.files[0]) processFile(fileInput.files[0]); });

function showState(state) {
    dropContent.classList.toggle('d-none', state !== 'drop');
    loading.classList.toggle('d-none',     state !== 'loading');
    result.classList.toggle('d-none',      state !== 'result');
    errorBox.classList.toggle('d-none',    state !== 'error');
}

async function processFile(file) {
    showState('loading');

    // Compression cote client si image > 900 KB
    let fileToSend = file;
    if (file.type.startsWith('image/') && file.size > 900 * 1024) {
        try {
            fileToSend = await compressImage(file, 900 * 1024);
        } catch(e) {
            // Si compression echoue, on envoie l original
            fileToSend = file;
        }
    }

    const fd = new FormData();
    fd.append('invoice', fileToSend, 'invoice.jpg');
    try {
        const res  = await fetch(ocrUrl, { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok || data.error) {
            document.getElementById('ocrErrorMsg').textContent = data.error || 'Erreur inconnue.';
            showState('error');
            return;
        }
        ocrData = data;
        renderResult(data);
        showState('result');
    } catch(e) {
        document.getElementById('ocrErrorMsg').textContent = 'Erreur réseau. Vérifiez votre connexion.';
        showState('error');
    }
}

// Compression image cote client via Canvas
function compressImage(file, maxBytes) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                let w = img.width;
                let h = img.height;
                // Reduire si trop grand
                const maxW = 1200;
                if (w > maxW) { h = Math.round(h * maxW / w); w = maxW; }

                const canvas = document.createElement('canvas');
                canvas.width = w; canvas.height = h;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, w, h);
                ctx.drawImage(img, 0, 0, w, h);

                // Reduire la qualite progressivement
                let quality = 0.8;
                const tryCompress = () => {
                    canvas.toBlob(blob => {
                        if (!blob) { reject('Compression echouee'); return; }
                        if (blob.size <= maxBytes || quality <= 0.2) {
                            resolve(new File([blob], 'invoice.jpg', { type: 'image/jpeg' }));
                        } else {
                            quality -= 0.15;
                            tryCompress();
                        }
                    }, 'image/jpeg', quality);
                };
                tryCompress();
            };
            img.onerror = reject;
            img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
    });
}

function renderResult(data) {
    const fields = [
        { label: 'Libellé détecté',   value: data.libelle,   key: 'libelle' },
        { label: 'Montant détecté',   value: data.montant,   key: 'montant' },
        { label: 'Date détectée',     value: data.date,      key: 'date' },
        { label: 'Catégorie suggérée',value: data.categorie, key: 'categorie' },
        { label: 'Quantité',          value: data.quantite,     key: 'quantite' },
        { label: 'Prix Unitaire',     value: data.prixUnitaire, key: 'prixUnitaire' },
        { label: 'TVA (%)',           value: data.tva,          key: 'tva' },
    ];
    document.getElementById('ocrResultFields').innerHTML = fields.map(f =>
        `<div class="ocr-field">
            <div class="ocr-field-label">${f.label}</div>
            <div class="ocr-field-value ${f.value ? '' : 'empty'}">${f.value || 'Non détecté'}</div>
        </div>`
    ).join('') +
    `<div class="ocr-field" style="grid-column:1/-1">
        <div class="ocr-field-label">Texte brut OCR (pour vérification)</div>
        <details><summary style="cursor:pointer;color:#1560BD;font-size:.75rem">Voir le texte extrait</summary>
        <pre style="font-size:.7rem;max-height:120px;overflow:auto;background:#f8fafc;padding:8px;border-radius:6px;margin-top:4px">${(data.rawText||'').replace(/</g,'&lt;')}</pre>
        </details>
    </div>`;
}

// Appliquer au formulaire
const libelleId   = '{{ form.libelle.vars.id }}';
const montantId   = '{{ form.montant.vars.id }}';
const categorieId = '{{ form.categorieRel.vars.id }}';
const quantiteId  = '{{ form.quantite.vars.id }}';
const tvaId       = '{{ form.tva.vars.id }}';
const prixUnitId  = '{{ form.prixUnitaire.vars.id }}';

document.getElementById('ocrApplyBtn').addEventListener('click', () => {
    if (ocrData.libelle) {
        const el = document.getElementById(libelleId);
        if (el) el.value = ocrData.libelle;
    }
    if (ocrData.montant) {
        const el = document.getElementById(montantId);
        if (el) el.value = ocrData.montant;
    }
    if (ocrData.quantite) {
        const el = document.getElementById(quantiteId);
        if (el) el.value = ocrData.quantite;
    }
    if (ocrData.tva !== undefined && ocrData.tva !== null) {
        const el = document.getElementById(tvaId);
        if (el) el.value = ocrData.tva;
    }
    if (ocrData.prixUnitaire) {
        const el = document.getElementById(prixUnitId);
        if (el) el.value = ocrData.prixUnitaire;
    }
    if (ocrData.date) {
        // Convertir la date detectee en format HTML date (YYYY-MM-DD)
        const raw = ocrData.date.trim();
        let formatted = '';
        // Format DD/MM/YYYY ou DD-MM-YYYY ou DD.MM.YYYY
        const m1 = raw.match(/^(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})$/);
        // Format YYYY/MM/DD ou YYYY-MM-DD
        const m2 = raw.match(/^(\d{4})[\/\-\.](\d{1,2})[\/\-\.](\d{1,2})$/);
        if (m1) formatted = `${m1[3]}-${m1[2].padStart(2,'0')}-${m1[1].padStart(2,'0')}`;
        else if (m2) formatted = `${m2[1]}-${m2[2].padStart(2,'0')}-${m2[3].padStart(2,'0')}`;
        if (formatted) {
            // Cherche le champ date (type=date ou type=datetime-local)
            const dateEl = document.querySelector('input[type="date"], input[type="datetime-local"]');
            if (dateEl) dateEl.value = formatted;
        }
    }
    if (ocrData.categorie) {
        const catSelect = document.getElementById(categorieId);
        if (catSelect) {
            const opts = Array.from(catSelect.options);
            const match = opts.find(o => o.text.toLowerCase().includes(ocrData.categorie.toLowerCase()));
            if (match) catSelect.value = match.value;
        }
    }
    // Flash visuel
    document.querySelectorAll('.form-control, .form-select').forEach(el => {
        el.style.transition = 'background .4s';
        el.style.background = '#f0fdf4';
        setTimeout(() => el.style.background = '', 1200);
    });
    // Scroll vers le formulaire
    document.querySelector('.form-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

// Reset
document.getElementById('ocrResetBtn').addEventListener('click',      () => { fileInput.value=''; ocrData={}; showState('drop'); });
document.getElementById('ocrErrorReset').addEventListener('click',    () => { fileInput.value=''; showState('drop'); });
</script>
