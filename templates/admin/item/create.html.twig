.ocr-btn-apply:hover { background:#15803d;color:#fff; }
.ocr-btn-reset { background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;border-radius:8px;padding:8px 18px;font-size:.85rem;font-weight:600; }
.ocr-btn-reset:hover { background:#e2e8f0;color:#1e293b; }
.ocr-error { background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:14px;color:#dc2626;display:flex;align-items:center; }
