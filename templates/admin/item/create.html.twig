    color: #0f172a;
    font-size: 1rem;
}

.ft-item-create-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
    padding-top: 1.35rem;
}

.ft-item-create-side-stack {
    display: grid;
    gap: .95rem;
}

.ft-item-create-insight-card {
    border-radius: 20px;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(214, 226, 255, 0.88);
    background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(246,249,255,.94));
}

.ft-item-create-insight-card.is-blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(255,255,255,.96));
}

.ft-item-create-insight-card.is-amber {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.08), rgba(255,255,255,.96));
}

