    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(125, 211, 252, 0.14));
}

.ft-item-create-preview-card span {
    display: block;
    color: #64748b;
    font-size: .82rem;
    font-weight: 700;
    margin-bottom: .35rem;
}

