{% extends 'admin/back.html.twig' %}

{% block title %}Créer un Nouvel Item{% endblock %}

{% block admin_content %}
<div class="container-fluid mt-5">
    <!-- Header avec navigation -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_dashboard') }}" class="text-decoration-none">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_item_list') }}" class="text-decoration-none">Items</a>
                    </li>
                    <li class="breadcrumb-item active">Créer</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold text-dark mb-2">
                <i class="fas fa-plus-circle text-success me-3"></i>
                Créer un Nouvel Item
            </h1>
            <p class="text-muted">Ajoutez un nouvel article budgétaire à votre gestion financière</p>
        </div>
        <div class="d-flex gap-3">
            <a href="{{ path('admin_item_list') }}" class="btn btn-secondary btn-lg">
                <i class="fas fa-arrow-left me-2"></i>Retour à la liste
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="form-card">
                <div class="card-header-custom">
                    <div class="card-icon">
                        <i class="fas fa-tag"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">Informations de l'Item</h5>
                        <small class="text-muted">Renseignez les détails de votre nouvel article budgétaire</small>
                    </div>
                </div>

                <div class="card-body-custom">
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {# ── ZONE OCR ─────────────────────────────────────────────────── #}
                    <div class="ocr-zone mb-4" id="ocrZone">
                        <div class="ocr-zone-header">
                            <div class="ocr-zone-icon"><i class="fas fa-magic"></i></div>
                            <div>
                                <div class="ocr-zone-title">Remplissage automatique par OCR</div>
                                <div class="ocr-zone-sub">Importez une facture (image ou PDF) — les champs se remplissent automatiquement</div>
                            </div>
                        </div>
                        <div class="ocr-drop-area" id="ocrDropArea">
                            <input type="file" id="ocrFileInput" accept="image/*,.pdf" style="display:none"/>
                            <div class="ocr-drop-content" id="ocrDropContent">
                                <i class="fas fa-cloud-upload-alt ocr-drop-icon"></i>
                                <div class="ocr-drop-text">Glissez votre facture ici</div>
                                <div class="ocr-drop-sub">ou</div>
                                <button type="button" class="btn ocr-btn-upload" onclick="document.getElementById('ocrFileInput').click()">
                                    <i class="fas fa-folder-open me-2"></i>Choisir un fichier
                                </button>
                                <div class="ocr-drop-hint">JPG, PNG, PDF · Max 5 Mo</div>
                            </div>
                        </div>
                        <div class="ocr-loading d-none" id="ocrLoading">
                            <div class="ocr-spinner"></div>
                            <span>Analyse en cours...</span>
                        </div>
                        <div class="ocr-result d-none" id="ocrResult">
                            <div class="ocr-result-header">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Données détectées — vérifiez et confirmez</strong>
                            </div>
                            <div class="ocr-result-fields" id="ocrResultFields"></div>
                            <div class="ocr-result-actions">
                                <button type="button" class="btn ocr-btn-apply" id="ocrApplyBtn">
                                    <i class="fas fa-check me-2"></i>Appliquer au formulaire
                                </button>
                                <button type="button" class="btn ocr-btn-reset" id="ocrResetBtn">
                                    <i class="fas fa-redo me-2"></i>Réessayer
                                </button>
                            </div>
                        </div>
                        <div class="ocr-error d-none" id="ocrError">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span id="ocrErrorMsg"></span>
                            <button type="button" class="btn btn-sm ocr-btn-reset ms-3" id="ocrErrorReset">Réessayer</button>
                        </div>
                    </div>
                    {# ── FIN ZONE OCR ─────────────────────────────────────────────── #}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="form-section">
                        <div class="form-group">
                            <label for="{{ form.libelle.vars.id }}" class="form-label">
                                <i class="fas fa-tag text-primary me-2"></i>
                                Libellé de l'Item
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-pencil-alt"></i>
                                </span>
                                {{ form_widget(form.libelle, {
                                    'attr': {
                                        'class': 'form-control form-control-lg',
                                        'placeholder': 'Entrez le nom de l\'article budgétaire'
                                    }
                                }) }}
                            </div>
                            {% if form.libelle.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.libelle.vars.errors %}
                                        <i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Description claire et précise de l'article (3-100 caractères)
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="{{ form.montant.vars.id }}" class="form-label">
                                <i class="fas fa-coins text-success me-2"></i>
                                Montant (DT)
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-calculator"></i>
                                </span>
                                {{ form_widget(form.montant, {
                                    'attr': {
                                        'class': 'form-control form-control-lg',
                                        'placeholder': '0.00',
                                        'step': '0.01'
                                    }
                                }) }}
                                <span class="input-group-text">€</span>
                            </div>
                            {% if form.montant.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.montant.vars.errors %}
                                        <i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Montant positif avec maximum 2 décimales
                            </small>
                        </div>

                        <div class="form-group">
                            <label for="{{ form.categorieRel.vars.id }}" class="form-label">
                                <i class="fas fa-folder text-warning me-2"></i>
                                Catégorie Budgétaire
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-list"></i></span>
                                {{ form_widget(form.categorieRel, {'attr': {'class': 'form-select form-select-lg'}}) }}
                            </div>
                            {% if form.categorieRel.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.categorieRel.vars.errors %}<i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="{{ form.quantite.vars.id }}" class="form-label">
                                        <i class="fas fa-sort-numeric-up text-info me-2"></i>Quantité
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-hashtag"></i></span>
                                        {{ form_widget(form.quantite, {'attr': {'class': 'form-control form-control-lg', 'placeholder': '1', 'id': 'field_quantite'}}) }}
                                    </div>
                                    {% if form.quantite.vars.errors|length > 0 %}
                                        <div class="invalid-feedback d-block">{% for e in form.quantite.vars.errors %}{{ e.message }}{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="{{ form.prixUnitaire.vars.id }}" class="form-label">
                                        <i class="fas fa-tag text-warning me-2"></i>Prix Unitaire (TND)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-coins"></i></span>
                                        {{ form_widget(form.prixUnitaire, {'attr': {'class': 'form-control form-control-lg', 'placeholder': '0.000', 'id': 'field_prix_unitaire'}}) }}
                                    </div>
                                    {% if form.prixUnitaire.vars.errors|length > 0 %}
                                        <div class="invalid-feedback d-block">{% for e in form.prixUnitaire.vars.errors %}{{ e.message }}{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="{{ form.tva.vars.id }}" class="form-label">
                                        <i class="fas fa-percent text-secondary me-2"></i>TVA (%)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-percent"></i></span>
                                        {{ form_widget(form.tva, {'attr': {'class': 'form-control form-control-lg', 'placeholder': '0'}}) }}
                                        <span class="input-group-text">%</span>
                                    </div>
                                    {% if form.tva.vars.errors|length > 0 %}
                                        <div class="invalid-feedback d-block">{% for e in form.tva.vars.errors %}{{ e.message }}{% endfor %}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Aperçu budgétaire dynamique -->
                    <div class="budget-preview" id="budgetPreview" style="display: none;">
                        <div class="preview-header">
                            <i class="fas fa-eye me-2"></i>
                            Aperçu Budgétaire
                        </div>
                        <div class="preview-content">
                            <div class="preview-item">
                                <span class="preview-label">Catégorie sélectionnée :</span>
                                <span class="preview-value" id="selectedCategory">-</span>
                            </div>
                            <div class="preview-item">
                                <span class="preview-label">Budget prévu :</span>
                                <span class="preview-value" id="categoryBudget">-</span>
                            </div>
                            <div class="preview-item">
                                <span class="preview-label">Total actuel :</span>
                                <span class="preview-value" id="currentTotal">-</span>
                            </div>
                            <div class="preview-item">
                                <span class="preview-label">Après ajout :</span>
                                <span class="preview-value text-primary" id="newTotal">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-save me-2"></i>Créer l'Item
                        </button>
                        <a href="{{ path('admin_item_list') }}" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Informations complémentaires -->
            <div class="info-card mt-4">
                <div class="card-header-custom">
                    <div class="card-icon">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Informations Importantes</h6>
                    </div>
                </div>
                <div class="card-body-custom">
                    <div class="info-list">
                        <div class="info-item">
                            <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                            <span>Le montant ne peut pas dépasser le budget restant de la catégorie</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-bell text-info me-2"></i>
                            <span>Une alerte sera automatiquement créée si le seuil d'alerte est atteint</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-undo text-secondary me-2"></i>
                            <span>Vous pourrez modifier ces informations ultérieurement</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const categorySelect = document.querySelector('#{{ form.categorieRel.vars.id }}');
    const montantInput = document.querySelector('#{{ form.montant.vars.id }}');
    const budgetPreview = document.getElementById('budgetPreview');

    // Données des catégories (injectées depuis Twig)
    const categoriesData = {
        {% for categorie in form.categorieRel.vars.choices %}
            {{ categorie.data.idCategorie }}: {
                nom: "{{ categorie.data.nomCategorie }}",
                budget: {{ categorie.data.budgetPrevu }},
                seuil: {{ categorie.data.seuilAlerte }},
                items: {{ categorie.data.items|length }}
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    };

    function updateBudgetPreview() {
        const selectedCategoryId = categorySelect.value;
        const montant = parseFloat(montantInput.value) || 0;

        if (selectedCategoryId && categoriesData[selectedCategoryId]) {
            const category = categoriesData[selectedCategoryId];
            const currentTotal = category.budget - (category.budget * 0.1); // Simulation du total actuel
            const newTotal = currentTotal + montant;

            document.getElementById('selectedCategory').textContent = category.nom;
            document.getElementById('categoryBudget').textContent = category.budget.toFixed(2) + ' DT';
            document.getElementById('currentTotal').textContent = currentTotal.toFixed(2) + ' DT';
            document.getElementById('newTotal').textContent = newTotal.toFixed(2) + ' DT';

            budgetPreview.style.display = 'block';
        } else {
            budgetPreview.style.display = 'none';
        }
    }

    categorySelect.addEventListener('change', updateBudgetPreview);
    montantInput.addEventListener('input', updateBudgetPreview);
});
</script>

