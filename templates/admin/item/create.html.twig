}

.ft-item-create-insight-label {
    display: block;
    color: #64748b;
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: .45rem;
}

.ft-item-create-insight-card strong {
    color: #0f172a;
    line-height: 1.55;
}

@media (max-width: 1199.98px) {
    .ft-item-create-hero {
        flex-direction: column;
    }

    .ft-item-create-hero-actions {
        justify-content: flex-start;
    }
}

@media (max-width: 767.98px) {
    .ft-item-create-preview-grid,
    .ft-item-create-ocr-fields {
        grid-template-columns: 1fr;
    }

    .ft-item-create-actions,
    .ft-item-create-ocr-actions {
        flex-direction: column;
    }

    .ft-item-create-card-head {
        flex-direction: column;
        align-items: flex-start;
