.ocr-zone-title { font-weight:700;color:#1e293b;font-size:.95rem; }
.ocr-zone-sub { color:#64748b;font-size:.8rem; }
.ocr-drop-area { border:2px dashed #bfdbfe;border-radius:10px;background:#fff;padding:28px;text-align:center;cursor:pointer;transition:all .2s; }
.ocr-drop-area.drag-over { border-color:#1560BD;background:#eff6ff; }
.ocr-drop-icon { font-size:2.5rem;color:#93c5fd;margin-bottom:10px; }
.ocr-drop-text { font-weight:600;color:#1e293b;margin-bottom:4px; }
