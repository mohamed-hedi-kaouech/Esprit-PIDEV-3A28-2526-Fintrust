{% extends 'admin/back.html.twig' %}
{% block title %}Intelligence décisionnelle{% endblock %}

{% block breadcrumb %}
  <i class="bi bi-graph-up-arrow me-1 text-primary"></i>
  <span class="fw-semibold">Intelligence décisionnelle</span>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .ft-admin-analytics-hero {
      position: relative;
      overflow: hidden;
      border-radius: 2rem;
      padding: 2.3rem;
      border: 1px solid rgba(191,219,254,.82);
      background:
        radial-gradient(circle at top right, rgba(56,189,248,.28), transparent 24%),
        radial-gradient(circle at bottom left, rgba(139,92,246,.20), transparent 24%),
        radial-gradient(circle at 25% 15%, rgba(37,99,235,.12), transparent 18%),
        linear-gradient(135deg, rgba(255,255,255,.99), rgba(238,246,255,.96));
      box-shadow: 0 30px 62px rgba(15,23,42,.10);
    }
    .ft-admin-analytics-hero::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 5px;
      background: linear-gradient(180deg, #2563eb, #38bdf8, #8b5cf6);
    }
    .ft-admin-analytics-hero::after {
      content: "";
      position: absolute;
      right: -5rem;
      top: -6rem;
      width: 18rem;
      height: 18rem;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,99,235,.15), rgba(37,99,235,0));
      pointer-events: none;
    }
    .ft-admin-analytics-hero .ft-admin-hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .62rem 1rem;
      border-radius: 999px;
      background: rgba(255,255,255,.92);
      border: 1px solid rgba(191,219,254,.94);
      color: #1d4ed8;
      font-weight: 800;
      box-shadow: 0 12px 24px rgba(37,99,235,.08);
    }
    .ft-admin-analytics-hero .ft-admin-page-title {
      color: #0f2550;
      font-size: clamp(2.15rem, 3vw, 3.6rem);
      line-height: .98;
      letter-spacing: -.03em;
      max-width: 56rem;
      margin-bottom: .9rem !important;
      text-wrap: balance;
    }
    .ft-admin-analytics-hero .ft-admin-hero-subtitle {
      color: #506987;
      font-size: 1.08rem;
      line-height: 1.8;
      max-width: 48rem;
    }
    .ft-admin-analytics-hero .ft-btn-outline-primary {
      background: rgba(255,255,255,.88);
      border-color: rgba(96,165,250,.9);
      color: #1450b8;
      box-shadow: 0 14px 26px rgba(37,99,235,.08);
    }
    .ft-admin-analytic-card {
      border-radius: 1.6rem;
      border: 1px solid rgba(203,213,225,.84);
      background:
        linear-gradient(145deg, rgba(255,255,255,.98), rgba(246,250,255,.96));
      box-shadow: 0 18px 34px rgba(15,23,42,.06);
    }
    .ft-admin-kpi-card {
      position: relative;
      overflow: hidden;
      border-radius: 1.45rem;
      background:
        radial-gradient(circle at top right, rgba(59,130,246,.14), transparent 28%),
        linear-gradient(145deg, rgba(255,255,255,.99), rgba(243,248,255,.96));
      border: 1px solid rgba(191,219,254,.82);
      box-shadow: 0 16px 30px rgba(37,99,235,.08);
    }
    .ft-admin-kpi-card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: linear-gradient(180deg, #60a5fa, #2563eb, #38bdf8);
    }
    .ft-admin-kpi-card::after {
      content: "";
      position: absolute;
      inset: auto -20px -26px auto;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,99,235,.12), rgba(37,99,235,0));
    }
    .ft-admin-kpi-card .ft-admin-card-body {
      padding: 1.15rem 1.2rem;
    }
    .ft-admin-kpi-label {
      color: #6680a7;
      font-size: .82rem;
      font-weight: 700;
      margin-bottom: .5rem;
    }
    .ft-admin-kpi-value {
      font-size: 2.1rem;
      line-height: 1;
      font-weight: 900;
      letter-spacing: -.03em;
    }
    .ft-admin-priority-chip {
      padding: .92rem 1rem;
      border-radius: 1.1rem;
      background:
        linear-gradient(135deg, rgba(37,99,235,.08), rgba(14,165,233,.08));
      border: 1px solid rgba(191,219,254,.9);
      color: #274979;
    }
    .ft-admin-deactivation-card {
      padding: 1rem 1.05rem;
      border-radius: 1.15rem;
      border: 1px solid rgba(219,234,254,.92);
      background:
        radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 26%),
        linear-gradient(135deg, rgba(255,255,255,.98), rgba(246,250,255,.95));
      box-shadow: 0 14px 30px rgba(15,23,42,.05);
    }
    .ft-admin-deactivation-card + .ft-admin-deactivation-card {
      margin-top: .95rem;
    }
    .ft-admin-deactivation-kpi {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .9rem;
    }
    .ft-admin-deactivation-kpi-item {
      padding: 1rem;
      border-radius: 1rem;
      background: rgba(255,255,255,.92);
      border: 1px solid rgba(219,234,254,.9);
    }
    .ft-admin-deactivation-kpi-item span {
      display: block;
      color: #64748b;
      font-size: .76rem;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: .05em;
      margin-bottom: .45rem;
    }
    .ft-admin-deactivation-kpi-item strong {
      font-size: 1.6rem;
      color: #0f2550;
    }
    .ft-admin-admin-note {
      min-height: 88px;
    }
    .ft-admin-table-wrap table thead th {
      color: #5c7499;
      font-size: .78rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      border-bottom-color: rgba(191,219,254,.7);
    }
    .ft-admin-table-wrap table tbody tr:hover {
      background: rgba(239,246,255,.55);
    }
    @media (max-width: 991.98px) {
      .ft-admin-deactivation-kpi {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endblock %}

{% block admin_content %}
  <section class="ft-admin-analytics-hero mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div>
        <div class="ft-admin-hero-kicker mb-3"><i class="bi bi-stars"></i> FinTrust Advanced Analytics Bundle</div>
        <h1 class="ft-admin-page-title mb-3">Pilotage analytique premium, explicable et actionnable</h1>
        <p class="ft-admin-hero-subtitle mb-0">{{ advancedOverview.headline }}</p>
      </div>
      <a href="{{ path('admin_dashboard') }}" class="btn ft-btn-outline-primary">Retour au dashboard</a>
    </div>
  </section>

  <div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl">
      <div class="ft-admin-card ft-admin-kpi-card h-100"><div class="ft-admin-card-body"><div class="ft-admin-kpi-label">Clients analyses</div><div class="ft-admin-kpi-value text-primary">{{ advancedOverview.kpis.clientsAnalyses }}</div></div></div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="ft-admin-card ft-admin-kpi-card h-100"><div class="ft-admin-card-body"><div class="ft-admin-kpi-label">Utilisateurs a risque</div><div class="ft-admin-kpi-value text-warning-emphasis">{{ advancedOverview.kpis.atRiskUsers }}</div></div></div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="ft-admin-card ft-admin-kpi-card h-100"><div class="ft-admin-card-body"><div class="ft-admin-kpi-label">Risques critiques</div><div class="ft-admin-kpi-value text-danger">{{ advancedOverview.kpis.criticalRiskUsers }}</div></div></div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="ft-admin-card ft-admin-kpi-card h-100"><div class="ft-admin-card-body"><div class="ft-admin-kpi-label">KYC en attente</div><div class="ft-admin-kpi-value text-primary">{{ advancedOverview.kpis.pendingKyc }}</div></div></div>
    </div>
    <div class="col-sm-6 col-xl">
      <div class="ft-admin-card ft-admin-kpi-card h-100"><div class="ft-admin-card-body"><div class="ft-admin-kpi-label">VIP suivis</div><div class="ft-admin-kpi-value text-success">{{ advancedOverview.kpis.vipMonitored }}</div></div></div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-xl-7">
      <div class="ft-admin-card ft-admin-analytic-card h-100">
        <div class="ft-admin-card-header"><i class="bi bi-people me-2 text-primary"></i>Utilisateurs a risque de desengagement</div>
        <div class="ft-admin-card-body">
          <div class="table-responsive ft-admin-table-wrap">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Client</th>
                  <th>Score</th>
                  <th>Signal</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {% for item in atRiskUsersAnalytics|slice(0, 8) %}
                  <tr>
                    <td>
                      <div class="fw-semibold">{{ item.name }}</div>
                      <div class="small text-muted">{{ item.segment }} · {{ item.kycStatus }}</div>
                    </td>
                    <td><span class="badge {{ item.dropoffRiskScore >= 80 ? 'ft-badge-danger' : 'ft-badge-warning' }}">{{ item.dropoffRiskScore }}/100</span></td>
                    <td class="small text-muted">{{ item.mainSignal }}</td>
                    <td class="small fw-semibold">{{ item.actionTitle }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-5">
      <div class="ft-admin-card ft-admin-analytic-card h-100">
        <div class="ft-admin-card-header"><i class="bi bi-grid-1x2 me-2 text-primary"></i>Signaux prioritaires</div>
        <div class="ft-admin-card-body">
          <div class="d-grid gap-3 mb-4">
            {% for signal in advancedOverview.prioritySignals %}
              <div class="ft-admin-priority-chip">{{ signal }}</div>
            {% endfor %}
          </div>
          <div class="p-3 rounded-4" style="background:linear-gradient(135deg,rgba(59,130,246,.10),rgba(14,165,233,.08));border:1px solid rgba(191,219,254,.9);">
            <div class="small text-muted">Temps moyen de traitement support</div>
            <div class="fw-bold fs-4">{{ supportInsightsAnalytics.averageResolutionTime }}</div>
            <div class="small text-muted mt-2">{{ supportInsightsAnalytics.serviceNote }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-xl-5">
      <div class="ft-admin-card ft-admin-analytic-card h-100">
        <div class="ft-admin-card-header"><i class="bi bi-person-dash me-2 text-primary"></i>Hypotheses de desactivation</div>
        <div class="ft-admin-card-body">
          <div class="ft-admin-deactivation-kpi mb-4">
            <div class="ft-admin-deactivation-kpi-item">
              <span>Demandes en attente</span>
              <strong>{{ deactivationInsights.summary.pendingRequests }}</strong>
            </div>
            <div class="ft-admin-deactivation-kpi-item">
              <span>Hypotheses critiques</span>
              <strong>{{ deactivationInsights.summary.criticalHypotheses }}</strong>
            </div>
            <div class="ft-admin-deactivation-kpi-item">
              <span>Probabilite elevee</span>
              <strong>{{ deactivationInsights.summary.highProbabilityUsers }}</strong>
            </div>
          </div>
          <div class="p-3 rounded-4" style="border:1px solid rgba(191,219,254,.88);background:linear-gradient(135deg,rgba(239,246,255,.96),rgba(255,255,255,.94));">
            <div class="fw-semibold text-primary mb-2">Analyse globale</div>
            <div class="small text-muted">{{ deactivationInsights.summary.headline }}</div>
          </div>
          <div class="d-grid gap-3 mt-4">
            {% for item in deactivationInsights.hypotheses|slice(0, 4) %}
              <div class="ft-admin-deactivation-card">
                <div class="d-flex justify-content-between gap-3 align-items-start">
                  <div>
                    <div class="fw-semibold">{{ item.name }}</div>
                    <div class="small text-muted">{{ item.email }} · {{ item.segment }}</div>
                  </div>
                  <span class="badge {{ item.deactivationProbability >= 82 ? 'ft-badge-danger' : (item.deactivationProbability >= 66 ? 'ft-badge-warning' : 'ft-badge-blue') }}">{{ item.deactivationProbability }}/100</span>
                </div>
                <div class="small text-muted mt-3">{{ item.mainHypothesis }}</div>
                <div class="small fw-semibold mt-2">{{ item.recommendedAction }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-7">
      <div class="ft-admin-card ft-admin-analytic-card h-100">
        <div class="ft-admin-card-header"><i class="bi bi-check2-square me-2 text-primary"></i>Demandes de desactivation a revoir</div>
        <div class="ft-admin-card-body">
          {% if pendingDeactivationRequests is empty %}
            <div class="text-center text-muted py-4">
              <i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>
              Aucune demande de desactivation en attente actuellement.
            </div>
          {% else %}
            <div class="d-grid gap-3">
              {% for request in pendingDeactivationRequests %}
                <div class="ft-admin-deactivation-card">
                  <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                      <div class="fw-semibold">{{ request.userName }}</div>
                      <div class="small text-muted">{{ request.userEmail }} · deposee le {{ request.submittedAt|date('d/m/Y H:i') }}</div>
                    </div>
                    <span class="badge ft-badge-warning">Revue requise</span>
                  </div>
                  <div class="row g-3 mt-1">
                    <div class="col-lg-6">
                      <div class="small fw-semibold text-primary mb-1">Justification client</div>
                      <div class="small text-muted">{{ request.reason }}</div>
                    </div>
                    <div class="col-lg-6">
                      <div class="small fw-semibold text-primary mb-1">Contexte complete</div>
                      <div class="small text-muted">{{ request.impactSummary }}</div>
                    </div>
                  </div>
                  <form method="post" action="{{ path('admin_user_deactivation_decision', {id: request.userId}) }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('deactivation_decision_' ~ request.userId) }}">
                    <div class="mb-3">
                      <label class="form-label fw-semibold small">Justification admin</label>
                      <textarea name="admin_note" class="form-control ft-input ft-admin-admin-note" placeholder="Expliquez la decision admin et les suites a donner."></textarea>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                      <button type="submit" name="decision" value="APPROVE" class="btn ft-btn-primary">
                        <i class="bi bi-check2-circle me-2"></i>Approuver la desactivation
                      </button>
                      <button type="submit" name="decision" value="REJECT" class="btn ft-btn-outline-primary">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Refuser avec justification
                      </button>
                    </div>
                  </form>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
