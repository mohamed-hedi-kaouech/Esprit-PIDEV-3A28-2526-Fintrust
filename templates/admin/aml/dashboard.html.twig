{% extends 'admin/back.html.twig' %}
{% block title %}AML — Surveillance Anti-Blanchiment{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <span class="fw-semibold small">Surveillance AML</span>
{% endblock %}

{% block admin_content %}

{# ── Hero ─────────────────────────────────────────────────────────────── #}
<section class="ft-admin-hero mb-4">
  <div class="ft-admin-hero-grid">
    <div>
      <span class="ft-admin-hero-kicker">
        <i class="bi bi-shield-lock me-1"></i>Module Anti-Blanchiment (AML)
      </span>
      <h1 class="ft-admin-page-title mb-2">Surveillance Anti-Blanchiment</h1>
      <p class="ft-admin-hero-subtitle mb-0">
        Analyse comportementale intelligente de chaque wallet. Score AML, alertes réglementaires et recommandations admin en temps réel.
      </p>
    </div>
    <div class="ft-admin-hero-panel">
      <div class="d-flex flex-wrap gap-2 justify-content-lg-end mb-3">
        <a href="{{ path('admin_wallet_index') }}" class="btn ft-btn-outline-primary">
          <i class="bi bi-wallet2 me-2"></i>Pilotage Wallets
        </a>
      </div>
      <div class="ft-admin-meta justify-content-lg-end">
        <span><i class="bi bi-shield-exclamation"></i>{{ stats.critical_alerts_total }} alerte(s) critique(s)</span>
        <span><i class="bi bi-list-check"></i>{{ stats.total }} wallet(s) analysé(s)</span>
      </div>
    </div>
  </div>
</section>

{# ── KPI ──────────────────────────────────────────────────────────────── #}
<section class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-wallet2"></i></span>
      <div class="ft-admin-kpi-mini-label">Total wallets</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.total }}</div>
    </article>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-red">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-shield-x"></i></span>
      <div class="ft-admin-kpi-mini-label">Critiques</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.critique }}</div>
    </article>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-amber">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-shield-exclamation"></i></span>
      <div class="ft-admin-kpi-mini-label">Niveau élevé</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.eleve }}</div>
    </article>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-blue">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-shield-half"></i></span>
      <div class="ft-admin-kpi-mini-label">Niveau moyen</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.moyen }}</div>
    </article>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-green">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-shield-check"></i></span>
      <div class="ft-admin-kpi-mini-label">Niveau faible</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.faible }}</div>
    </article>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <article class="ft-admin-kpi-mini ft-admin-kpi-mini-red">
      <span class="ft-admin-kpi-mini-icon"><i class="bi bi-bell-fill"></i></span>
      <div class="ft-admin-kpi-mini-label">Alertes critiques</div>
      <div class="ft-admin-kpi-mini-value">{{ stats.critical_alerts_total }}</div>
    </article>
  </div>
</section>

{# ── Table ─────────────────────────────────────────────────────────────── #}
<section class="ft-admin-card">
  <div class="ft-admin-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span><i class="bi bi-table me-2 text-primary"></i>Scores AML par wallet</span>
    <span class="ft-admin-status-chip ft-admin-status-info">{{ summaries|length }} wallet(s)</span>
  </div>
  <div class="ft-admin-card-body p-0">
    <div class="table-responsive">
      <table class="table ft-admin-table align-middle mb-0">
        <thead>
          <tr>
            <th>Wallet</th>
            <th>Propriétaire</th>
            <th>Statut</th>
            <th>Score AML</th>
            <th>Niveau</th>
            <th>Profil</th>
            <th>Alertes</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>
        <tbody>
          {% for s in summaries %}
          <tr class="{{ s.level == 'critique' ? 'table-danger' : (s.level == 'eleve' ? 'table-warning' : '') }}">
            <td class="fw-bold">#{{ s.wallet_id }}</td>
            <td>{{ s.wallet_name }}</td>
            <td>
              {% if s.is_blocked %}
                <span class="badge ft-badge-danger">Bloqué</span>
              {% else %}
                <span class="badge ft-badge-success">{{ s.wallet_status|capitalize }}</span>
              {% endif %}
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="progress flex-grow-1" style="height:8px;min-width:70px;">
                  <div class="progress-bar {{ s.level == 'critique' ? 'bg-danger' : (s.level == 'eleve' ? 'bg-warning' : (s.level == 'moyen' ? 'bg-info' : 'bg-success')) }}"
                       style="width:{{ s.score }}%"></div>
                </div>
                <span class="fw-semibold text-nowrap">{{ s.score }}/100</span>
              </div>
            </td>
            <td>
              <span class="badge {{ s.level_badge }}">{{ s.level_label }}</span>
            </td>
            <td>
              <span class="badge {{ s.profile_badge }}">{{ s.profile_label }}</span>
            </td>
            <td>
              {% if s.critical_count > 0 %}
                <span class="badge ft-badge-danger me-1">{{ s.critical_count }} critique(s)</span>
              {% endif %}
              {% if s.high_count > 0 %}
                <span class="badge ft-badge-warning">{{ s.high_count }} haute(s)</span>
              {% endif %}
              {% if s.alert_count == 0 %}
                <span class="text-muted small">Aucune</span>
              {% endif %}
            </td>
            <td class="text-center">
              <a href="{{ path('admin_aml_wallet_detail', {id: s.wallet_id}) }}" class="btn btn-sm ft-btn-primary">
                <i class="bi bi-search me-1"></i>Analyser
              </a>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">Aucun wallet disponible.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% endblock %}
