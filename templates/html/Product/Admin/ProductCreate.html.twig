{% extends 'admin/back.html.twig' %}

{% block title %}Creation du Produit{% endblock %}

{% block breadcrumb %}
  <a href="{{ path('admin_dashboard') }}" class="text-muted small text-decoration-none">Dashboard</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <a href="{{ path('product_list') }}" class="text-muted small text-decoration-none">Produits</a>
  <i class="bi bi-chevron-right mx-1 text-muted small"></i>
  <span class="fw-semibold small">Creation</span>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/Product/StyleEditProduct.css') }}">
{% endblock %}

{% block admin_content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="ft-admin-page-title mb-1">
      <i class="bi bi-box-seam me-2 text-primary"></i>Creation du produit
    </h1>
    <p class="text-muted mb-0">
      Ajoutez une nouvelle offre bancaire avec une presentation plus premium et un formulaire admin plus fiable.
    </p>
  </div>
  <a href="{{ path('product_list') }}" class="btn ft-btn-outline-primary">
    <i class="bi bi-arrow-left me-2"></i>Retour a la liste
  </a>
</div>

<section class="row g-4">
  <div class="col-12 col-xl-8">
    <article class="ft-admin-card product-admin-card">
      <div class="ft-admin-card-header">
        <i class="bi bi-plus-circle me-2 text-primary"></i>Nouveau produit
      </div>
      <div class="form-card">
    {{ form_start(form) }}
    <div class="form-group">
        <label class="field-label">Nouvelle Catégorie</label>
        {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.category) }}
    </div>

    <div class="form-group">
        <label class="field-label">Nouveau Prix (DT)</label>
        <div class="price-row">
            {{ form_widget(form.price, {'attr': {'class': 'form-input'}}) }}
            <span class="currency-tag">DT</span>
        </div>
        {{ form_errors(form.price) }}
    </div>

    <div class="form-group">
        <label class="field-label">Nouvelle Description</label>
        {{ form_widget(form.description, {'attr': {'class': 'form-textarea'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <hr class="form-divider">

    <div class="btn-row">
        <button type="submit" class="btn btn-primary">✓ Ajouter le Produit</button>
        <a href="{{ path('product_list') }}" class="btn btn-secondary">Annuler</a>
    </div>
    {{ form_end(form) }}
</div>

  <div class="col-12 col-xl-4">
    <article class="ft-admin-card mb-4 product-admin-sidecard">
      <div class="ft-admin-card-header">
        <i class="bi bi-stars me-2 text-primary"></i>Guide de creation
      </div>
      <div class="ft-admin-card-body">
        <div class="ft-admin-insight-list">
          <div class="ft-admin-insight-item">
            <strong>Categorie claire</strong>
            <span>Choisissez une famille de produit explicite pour garder un catalogue propre et lisible.</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Prix premium</strong>
            <span>Affichez un tarif juste et positif pour eviter les erreurs de souscription en front.</span>
          </div>
          <div class="ft-admin-insight-item">
            <strong>Description utile</strong>
            <span>Une bonne description augmente la comprehension et la conversion des utilisateurs.</span>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
{% endblock %}
