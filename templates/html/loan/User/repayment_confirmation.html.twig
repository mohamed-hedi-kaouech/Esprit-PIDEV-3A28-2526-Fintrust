{# templates/email/repayment_confirmation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #15803d; color: white; padding: 20px; text-align: center; }
        .content { background: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0; }
        .details { background: white; padding: 15px; border-radius: 6px; margin: 15px 0; }
        .amount { font-size: 24px; font-weight: bold; color: #15803d; }
        .footer { text-align: center; color: #666; font-size: 12px; margin-top: 30px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✓ Paiement Confirmé</h1>
        </div>
        
        <div class="content">
            <p>Bonjour,</p>
            <p>Votre paiement a été traité avec succès.</p>
            
            <div class="details">
                <p><strong>Prêt:</strong> #{{ loan.loanId }}</p>
                <p><strong>Mois:</strong> {{ repayment.month }}</p>
                <p class="amount">{{ repayment.monthlyPayment|number_format(3) }} TND</p>
                <p><strong>Date:</strong> {{ paymentDate|date('d/m/Y à H:i') }}</p>
            </div>
            
            <p>Solde restant: <strong>{{ repayment.remainingBalance|number_format(3) }} TND</strong></p>
        </div>
        
        <div class="footer">
            <p>FinTrust - République Tunisienne</p>
            <p>Cet email est généré automatiquement, merci de ne pas y répondre.</p>
        </div>
    </div>
</body>
</html>