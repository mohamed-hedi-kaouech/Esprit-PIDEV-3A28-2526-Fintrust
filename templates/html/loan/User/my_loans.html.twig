{# templates/loan/user/my_loans.html.twig #}
{% extends 'html/Loan/User/base.html.twig' %}

{% block title %}Mes Prêts{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-8">
        
        {# ... VOTRE CONTENU EXISTANT ... #}
        
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Mes Demandes de Prêt</h1>
            <a href="{{ path('loan_simulator') }}" class="bg-green-700 hover:bg-green-800 text-white px-4 py-2 rounded-lg font-medium">
                + Nouveau Prêt
            </a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {{ label == 'success' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# TABLE DES PRÊTS (votre code existant) #}
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Montant</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mensualité</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for loan in loansData %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4">{{ loan.Loan.getLoanType() }}</td>
                        <td class="px-6 py-4 font-medium">{{ loan.Loan.getAmount()|number_format(3) }} TND</td>
                        <td class="px-6 py-4 text-green-600 font-medium">
                            {{ loan.monthlyPayment|number_format(3) }} TND/mois
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 rounded text-xs font-bold 
                                {{ loan.Loan.getStatus() == 'PENDING' ? 'bg-amber-100 text-amber-700' : 
                                   loan.Loan.getStatus() == 'ACTIVE' ? 'bg-green-100 text-green-700' : 
                                   loan.Loan.getStatus() == 'REJECTED' ? 'bg-red-100 text-red-700' : 
                                   'bg-gray-100 text-gray-700' }}">
                                {{ loan.Loan.getStatus() == 'PENDING' ? 'En attente' : 
                                   loan.Loan.getStatus() == 'ACTIVE' ? 'Actif' : 
                                   loan.Loan.getStatus() == 'REJECTED' ? 'Refusé' : loan.Loan.getStatus() }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <a href="{{ path('loan_user_details', {id: loan.Loan.getLoanId()}) }}" class="text-green-700 hover:text-green-900 font-medium">
                                Voir détails →
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                            Vous n'avez aucune demande de prêt.
                            <br>
                            <a href="{{ path('loan_simulator') }}" class="text-green-700 font-medium mt-2 inline-block">Créer une simulation</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>

{# ═══════════════════════════════════════════════════════ #}
{# 🤖 CHATBOT FLOTANT - AJOUTÉ ICI                      #}
{# ═══════════════════════════════════════════════════════ #}

{# Bouton bulle flottante #}
<button id="chat-toggle" onclick="toggleChat()" 
    class="fixed bottom-6 right-6 w-14 h-14 bg-green-600 hover:bg-green-700 text-white rounded-full shadow-lg flex items-center justify-center text-2xl z-50 transition-transform hover:scale-110">
    💬
</button>

{# Fenêtre de chat (cachée par défaut) #}
<div id="chat-window" class="fixed bottom-24 right-6 w-80 bg-white rounded-xl shadow-2xl border z-50 hidden flex flex-col" style="height: 400px;">
    
    {# Header #}
    <div class="bg-green-600 text-white px-4 py-3 rounded-t-xl flex justify-between items-center">
        <div class="flex items-center gap-2">
            <span class="text-lg">🤖</span>
            <span class="font-medium text-sm">Assistant Fintrust</span>
        </div>
        <button onclick="toggleChat()" class="text-white hover:text-gray-200 text-xl leading-none">&times;</button>
    </div>
    
    {# Messages #}
    <div id="chat-messages" class="flex-1 overflow-y-auto p-3 space-y-3 text-sm">
        <div class="flex items-start gap-2">
            <div class="w-7 h-7 bg-green-100 rounded-full flex items-center justify-center text-xs flex-shrink-0">🤖</div>
            <div class="bg-gray-100 rounded-lg p-2 max-w-[85%]">
                Bonjour ! Je peux vous aider avec vos prêts. Comment puis-je vous assister ?
            </div>
        </div>
    </div>
    
    {# Input #}
    <div class="border-t p-3">
        <form id="chat-form" class="flex gap-2">
            <input type="text" id="chat-input" placeholder="Posez votre question..." 
                class="flex-1 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg text-sm">
                ➤
            </button>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}

<script>
    // ═══════════════════════════════════════════════════════════
    // LOANS DATA
    // ═══════════════════════════════════════════════════════════
    const loansData = [
        {% for item in loansData %}
        {
            loanId: {{ item.Loan.getLoanId() }},
            type: "{{ item.Loan.getLoanType() }}",
            amount: "{{ item.Loan.getAmount() }}",
            monthlyPayment: "{{ item.monthlyPayment|number_format(3) }}",
            status: "{{ item.Loan.getStatus() }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    // ✅ FIX: must be let (not const)
    let activeLoan = loansData.find(l => l.status === 'ACTIVE') || loansData[0];
    let activeLoanId = activeLoan ? activeLoan.loanId : null;


    // ═══════════════════════════════════════════════════════════
    // CHAT UI
    // ═══════════════════════════════════════════════════════════

    function toggleChat() {
        const chatWindow = document.getElementById('chat-window');
        chatWindow.classList.toggle('hidden');

        if (!chatWindow.classList.contains('hidden')) {
            document.getElementById('chat-input').focus();

            // Show suggestions first time
            if (document.getElementById('chat-messages').children.length <= 1) {
                showSuggestions();
            }
        }
    }


    // ═══════════════════════════════════════════════════════════
    // SUGGESTIONS (🔥 VERY IMPORTANT FOR AI QUALITY)
    // ═══════════════════════════════════════════════════════════

    function showSuggestions() {
        const suggestions = [
            "💰 Combien je paie par mois ?",
            "📊 Combien il reste à payer ?",
            "📅 Quand est mon prochain paiement ?",
            "📁 Donne-moi les détails de mon prêt",
            "💳 Comment payer ?"
        ];

        const container = document.createElement('div');
        container.className = "flex flex-wrap gap-2 mt-2";

        suggestions.forEach(q => {
            const btn = document.createElement('button');
            btn.className = "bg-gray-200 hover:bg-gray-300 text-xs px-2 py-1 rounded";
            btn.innerText = q;
            btn.onclick = () => quickAsk(q);
            container.appendChild(btn);
        });

        document.getElementById('chat-messages').appendChild(container);
    }


    // ═══════════════════════════════════════════════════════════
    // MESSAGE HANDLING
    // ═══════════════════════════════════════════════════════════

    function addMessage(content, isUser = false) {
        const messagesDiv = document.getElementById('chat-messages');

        const div = document.createElement('div');
        div.className = 'flex items-start gap-2 ' + (isUser ? 'flex-row-reverse' : '');

        const avatar = isUser
            ? '<div class="w-7 h-7 bg-blue-100 rounded-full flex items-center justify-center text-xs">👤</div>'
            : '<div class="w-7 h-7 bg-green-100 rounded-full flex items-center justify-center text-xs">🤖</div>';

        const bubbleColor = isUser ? 'bg-blue-50 text-blue-900' : 'bg-gray-100 text-gray-800';

        div.innerHTML = `
        ${avatar}
        <div class="${bubbleColor} rounded-lg p-2 max-w-[85%] text-sm">
            ${content}
        </div>
    `;

        messagesDiv.appendChild(div);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }


    // ═══════════════════════════════════════════════════════════
    // LOADING
    // ═══════════════════════════════════════════════════════════

    function showLoading() {
        const div = document.createElement('div');
        div.id = 'chat-loading';
        div.className = 'flex items-start gap-2';

        div.innerHTML = `
        <div class="w-7 h-7 bg-green-100 rounded-full flex items-center justify-center text-xs">🤖</div>
        <div class="bg-gray-100 rounded-lg p-2">
            <span class="animate-pulse text-gray-500 text-sm">● ● ●</span>
        </div>
    `;

        document.getElementById('chat-messages').appendChild(div);
    }

    function hideLoading() {
        document.getElementById('chat-loading')?.remove();
    }


    // ═══════════════════════════════════════════════════════════
    // SEND MESSAGE (🔥 IMPROVED)
    // ═══════════════════════════════════════════════════════════

    async function sendMessage() {
        const input = document.getElementById('chat-input');
        let question = input.value.trim();

        if (!question) return;

        addMessage(question, true);
        input.value = '';

        showLoading();

        try {
            const bodyParams = new URLSearchParams();
            bodyParams.append('question', question);

            if (activeLoanId) {
                bodyParams.append('loanId', activeLoanId);
            }

            const response = await fetch('{{ path("chatbot_ask") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: bodyParams.toString(),
            });

            const data = await response.json();
            hideLoading();

            if (data.success) {
                addMessage(data.answer);

                // 🔥 After answer → suggest next actions
                setTimeout(showSuggestions, 500);
            } else {
                addMessage("❌ Erreur serveur");
            }

        } catch (error) {
            hideLoading();
            addMessage("⚠️ Service indisponible");
        }
    }


    // ═══════════════════════════════════════════════════════════
    // QUICK ASK
    // ═══════════════════════════════════════════════════════════

    function quickAsk(question) {
        document.getElementById('chat-input').value = question;
        sendMessage();
    }


    // ═══════════════════════════════════════════════════════════
    // FORM
    // ═══════════════════════════════════════════════════════════

    document.getElementById('chat-form').addEventListener('submit', (e) => {
        e.preventDefault();
        sendMessage();
    });


    // ═══════════════════════════════════════════════════════════
    // SWITCH LOAN (FIXED)
    // ═══════════════════════════════════════════════════════════

    function switchLoan(loanId) {
        const selected = loansData.find(l => l.loanId === loanId);

        if (selected) {
            activeLoanId = selected.loanId;

            addMessage(
                `🔄 Prêt sélectionné : ${selected.type} (${selected.amount} TND)`,
            false
        );
    }
}

</script>
{% endblock %}