<+>{% extends 'admin/back.html.twig' %}\r\n{% block title %}Edit Produit{% endblock %}\r\n\r\n{% block admin_content %}\r\n\r\n<html lang=\"fr\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n  <title>Modifier le Produit</title>\r\n\r\n  <link rel=\"stylesheet\" href=\"{{ asset('css/Product/StyleEditProduct.css') }}\">\r\n  <script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"></script>\r\n</head>\r\n<body>\r\n\r\n<header class=\"header\">\r\n    <div class=\"header-left\">\r\n        <a href=\"{{ path('product_list') }}\" class=\"btn-back\">← Retour</a>\r\n        <span class=\"header-title\">Modifier le Produit</span>\r\n    </div>\r\n</header>\r\n\r\n<div class=\"page-wrapper\">\r\n\r\n```\r\n{# Flash messages #}\r\n{% for msg in app.flashes('success') %}\r\n    <script>\r\n        Swal.fire({\r\n            icon: 'success',\r\n            title: '{{ msg }}',\r\n            showConfirmButton: false,\r\n            timer: 2000\r\n        });\r\n    </script>\r\n{% endfor %}\r\n\r\n{% for msg in app.flashes('error') %}\r\n    <script>\r\n        Swal.fire({\r\n            icon: 'error',\r\n            title: 'Erreur',\r\n            text: '{{ msg }}'\r\n        });\r\n    </script>\r\n{% endfor %}\r\n\r\n<div class=\"section-heading\">\r\n    <h2>Modification du Produit</h2>\r\n    <p>Modifiez les informations du produit ci-dessous</p>\r\n    <hr class=\"divider\">\r\n</div>\r\n\r\n<div class=\"info-strip\">\r\n    <div class=\"info-item\">\r\n        <span class=\"info-label\">\uD83D\uDCCB Catégorie actuelle</span>\r\n        <span class=\"info-value\">{{ product.category }}</span>\r\n    </div>\r\n    <div class=\"info-item\">\r\n        <span class=\"info-label\">\uD83D\uDCB0 Prix actuel</span>\r\n        <span class=\"info-value\">{{ product.price|number_format(2, '.', ' ') }} DT</span>\r\n    </div>\r\n    <div class=\"info-item\">\r\n        <span class=\"info-label\">\uD83D\uDCC5 Date de création</span>\r\n        <span class=\"info-value\">{{ product.createdAt|date('d/m/Y') }}</span>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"form-card\">\r\n    <form method=\"POST\" action=\"{{ path('EditProduct', {id: product.productId}) }}\">\r\n\r\n        <input type=\"hidden\" name=\"_token\" value=\"{{ csrf_token('EditProduct_' ~ product.productId) }}\">\r\n        <input type=\"hidden\" name=\"productId\" value=\"{{ product.productId }}\">\r\n\r\n        <!-- Category -->\r\n        <div class=\"form-group\">\r\n            <label class=\"field-label\">Nouvelle Catégorie</label>\r\n            <select name=\"category\" class=\"form-select\">\r\n                <option value=\"\">Sélectionner une catégorie</option>\r\n\r\n                {% set categories = [\r\n                    'COMPTE_COURANT','COMPTE_EPARGNE','COMPTE_PREMIUM',\r\n                    'COMPTE_JEUNE','COMPTE_ENTREPRISE',\r\n                    'CARTE_DEBIT','CARTE_CREDIT','CARTE_PREMIUM',\r\n                    'CARTE_VIRTUELLE',\r\n                    'EPARGNE_CLASSIQUE','EPARGNE_LOGEMENT','DEPOT_A_TERME',\r\n                    'PLACEMENT_INVESTISSEMENT',\r\n                    'ASSURANCE_VIE','ASSURANCE_HABITATION','ASSURANCE_VOYAGE'\r\n                ] %}\r\n\r\n                {% for cat in categories %}\r\n                    <option value=\"{{ cat }}\"\r\n                        {% if product.category == cat %}selected{% endif %}>\r\n                        {{ cat }}\r\n                    </option>\r\n                {% endfor %}\r\n            </select>\r\n        </div>\r\n\r\n        <!-- Price -->\r\n        <div class=\"form-group\">\r\n            <label class=\"field-label\">Nouveau Prix (DT)</label>\r\n            <div class=\"price-row\">\r\n                <input type=\"text\" name=\"price\" class=\"form-input\" value=\"{{ product.price }}\">\r\n                <span class=\"currency-tag\">DT</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Description -->\r\n        <div class=\"form-group\">\r\n            <label class=\"field-label\">Nouvelle Description</label>\r\n            <textarea name=\"description\" class=\"form-textarea\">{{ product.description|trim }}</textarea>\r\n        </div>\r\n\r\n        <!-- Date -->\r\n        <div class=\"form-group\">\r\n            <label class=\"field-label\">Date de Création</label>\r\n            <input type=\"date\" class=\"form-input\"\r\n                   value=\"{{ product.createdAt|date('Y-m-d') }}\"\r\n                   disabled>\r\n        </div>\r\n\r\n        <hr class=\"form-divider\">\r\n\r\n        <div class=\"btn-row\">\r\n            <button type=\"submit\" class=\"btn btn-primary\">\r\n                ✓ Enregistrer les modifications\r\n            </button>\r\n\r\n            <a href=\"{{ path('product_list') }}\" class=\"btn btn-secondary\">\r\n                Annuler\r\n            </a>\r\n        </div>\r\n\r\n    </form>\r\n</div>\r\n```\r\n\r\n</div>\r\n\r\n<script>\r\ndocument.querySelector('form').addEventListener('submit', function(e) {\r\n    e.preventDefault();\r\n\r\n    Swal.fire({\r\n        title: 'Confirmer la modification ?',\r\n        text: 'Les changements seront appliqués immédiatement.',\r\n        icon: 'warning',\r\n        showCancelButton: true,\r\n        confirmButtonColor: '#2563eb',\r\n        cancelButtonColor: '#64748b',\r\n        confirmButtonText: 'Oui, modifier',\r\n        cancelButtonText: 'Annuler'\r\n    }).then((result) => {\r\n        if (result.isConfirmed) {\r\n            e.target.submit();\r\n        }\r\n    });\r\n});\r\n</script>\r\n\r\n</body>\r\n</html>\r\n{% endblock %}
