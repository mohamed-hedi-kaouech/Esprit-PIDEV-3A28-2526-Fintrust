<+>{% extends 'admin/back.html.twig' %}\r\n{% block title %}Edit Subscription{% endblock %}\r\n\r\n{% block admin_content %}\r\n<html lang=\"fr\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Modifier l'abonnement </title>\r\n    <link rel=\"stylesheet\" href=\"{{ asset('css/Product/SubscriptionEdit.css') }}\">\r\n    <script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"></script>\r\n</head>\r\n<body>\r\n\r\n{# ── TOP BAR ── #}\r\n<header class=\"topbar\">\r\n    <a href=\"{{ path('subscription_list') }}\" class=\"btn-back\">\r\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\r\n             stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"/></svg>\r\n        Retour\r\n    </a>\r\n    <h1 class=\"topbar-title\">Modifier l'abonnement</h1>\r\n</header>\r\n\r\n<main class=\"content\">\r\n    <div class=\"form-card\" style=\"max-width:680px; margin:32px auto;\">\r\n\r\n\r\n\r\n        {# ── CARD HEADER ── #}\r\n        <div style=\"display:flex; align-items:flex-start; gap:14px; margin-bottom:22px;\">\r\n            <span style=\"font-size:28px;\">✏\uFE0F</span>\r\n            <div>\r\n                <div class=\"form-title\">Modification d'abonnement</div>\r\n                <div class=\"form-subtitle\">Mettez à jour les informations de l'abonnement</div>\r\n            </div>\r\n        </div>\r\n\r\n        {# ── CURRENT INFO DISPLAY ── #}\r\n        <div class=\"current-info-display\">\r\n            <div class=\"current-info-title\">\uD83D\uDCCB Informations actuelles</div>\r\n            <div style=\"display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-top:10px;\">\r\n                <div>\r\n                    <div class=\"current-label\">Client</div>\r\n                    <div class=\"current-value\">\r\n                        {{ subscription.clientUser.nom }} {{ subscription.clientUser.prenom }}\r\n                    </div>\r\n                </div>\r\n                <div>\r\n                    <div class=\"current-label\">Produit</div>\r\n                    <div class=\"current-value\">{{ subscription.productObj.category }}</div>\r\n                </div>\r\n                <div>\r\n                    <div class=\"current-label\">Type</div>\r\n                    <div class=\"current-value-budget\">{{ subscription.type }}</div>\r\n                </div>\r\n                <div>\r\n                    <div class=\"current-label\">Statut</div>\r\n                    <span class=\"status-badge status-badge--{{ subscription.status|lower }}\">\r\n                            {% if   subscription.status == 'ACTIVE'    %}Actif\r\n                            {% elseif subscription.status == 'DRAFT'     %}Brouillon\r\n                            {% elseif subscription.status == 'SUSPENDED' %}Suspendu\r\n                            {% elseif subscription.status == 'CLOSED'    %}Fermé\r\n                            {% else %}{{ subscription.status }}{% endif %}\r\n                        </span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <hr class=\"form-separator\">\r\n        <div class=\"section-title\">Nouvelles valeurs</div>\r\n\r\n        {# ── UPDATE FORM ── #}\r\n        <form method=\"post\" action=\"{{ path('subscription_update', {id: subscription.subscriptionId}) }}\">\r\n            <input type=\"hidden\" name=\"_token\"\r\n                   value=\"{{ csrf_token('update' ~ subscription.subscriptionId) }}\">\r\n\r\n            {# Client #}\r\n            <div class=\"input-group\">\r\n                <label class=\"input-label\" for=\"cbClient\">Client *</label>\r\n                <select id=\"cbClient\" name=\"client\" class=\"input-field\" required>\r\n                    {% for client in clients %}\r\n                        <option value=\"{{ client.id }}\"\r\n                                {{ subscription.client == client.id ? 'selected' : '' }}>\r\n                            {{ client.nom }} {{ client.prenom }}\r\n                        </option>\r\n                    {% endfor %}\r\n                </select>\r\n                <div class=\"input-help\">Choisissez le client pour cet abonnement</div>\r\n            </div>\r\n\r\n            {# Product #}\r\n            <div class=\"input-group\">\r\n                <label class=\"input-label\" for=\"cbProduct\">Produit *</label>\r\n                <select id=\"cbProduct\" name=\"product\" class=\"input-field\" required>\r\n                    {% for product in products %}\r\n                        <option value=\"{{ product.productId }}\"\r\n                                {{ subscription.product == product.productId ? 'selected' : '' }}>\r\n                            {{ product.productId }} — {{ product.category }}\r\n                        </option>\r\n                    {% endfor %}\r\n                </select>\r\n            </div>\r\n\r\n            {# Type #}\r\n            <div class=\"input-group\">\r\n                <label class=\"input-label\" for=\"cbType\">Type d'abonnement *</label>\r\n                <select id=\"cbType\" name=\"type\" class=\"input-field\" required>\r\n                    {% for type in ['MONTHLY','ANNUAL','TRANSACTION','ONE_TIME'] %}\r\n                        <option value=\"{{ type }}\"\r\n                                {{ subscription.type == type ? 'selected' : '' }}>\r\n                            {{ type }}\r\n                        </option>\r\n                    {% endfor %}\r\n                </select>\r\n            </div>\r\n\r\n            {# Dates #}\r\n            <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:16px;\">\r\n                <div class=\"input-group\">\r\n                    <label class=\"input-label\" for=\"dpSubscriptionDate\">Date de souscription *</label>\r\n                    <input type=\"date\" id=\"dpSubscriptionDate\" name=\"subscriptionDate\"\r\n                           class=\"input-field\" required\r\n                           value=\"{{ subscription.subscriptionDate|date('Y-m-d') }}\">\r\n                </div>\r\n                <div class=\"input-group\">\r\n                    <label class=\"input-label\" for=\"dpExpirationDate\">Date d'expiration *</label>\r\n                    <input type=\"date\" id=\"dpExpirationDate\" name=\"expirationDate\"\r\n                           class=\"input-field\" required\r\n                           value=\"{{ subscription.expirationDate|date('Y-m-d') }}\">\r\n                </div>\r\n            </div>\r\n\r\n            {# Status #}\r\n            <div class=\"input-group\">\r\n                <label class=\"input-label\" for=\"cbStatus\">Statut *</label>\r\n                <select id=\"cbStatus\" name=\"status\" class=\"input-field\" required>\r\n                    {% for status in ['DRAFT','ACTIVE','SUSPENDED','CLOSED'] %}\r\n                        <option value=\"{{ status }}\"\r\n                                {{ subscription.status == status ? 'selected' : '' }}>\r\n                            {{ status }}\r\n                        </option>\r\n                    {% endfor %}\r\n                </select>\r\n            </div>\r\n\r\n            {# Preview Box (JS-computed) #}\r\n            <div class=\"preview-box\">\r\n                <div class=\"preview-title\">\uD83D\uDCCA Aperçu</div>\r\n                <div style=\"display:flex; gap:8px; align-items:center; margin-top:6px;\">\r\n                    <span class=\"preview-label\">Durée :</span>\r\n                    <span class=\"preview-value\" id=\"previewDuration\">-</span>\r\n                </div>\r\n                <div style=\"display:flex; gap:8px; align-items:center;\">\r\n                    <span class=\"preview-label\">Jours restants :</span>\r\n                    <span class=\"preview-statut\" id=\"previewRemaining\">-</span>\r\n                </div>\r\n            </div>\r\n\r\n            <hr class=\"form-separator\">\r\n\r\n            <div class=\"warning-box\">\r\n                <div class=\"warning-title\">⚠\uFE0F Attention</div>\r\n                <div class=\"warning-text\">· Les modifications seront appliquées immédiatement</div>\r\n                <div class=\"warning-text\">· Vérifiez les dates avant d'enregistrer</div>\r\n            </div>\r\n\r\n            <div style=\"display:flex; gap:12px; justify-content:center; margin-top:20px;\">\r\n                <button type=\"submit\" class=\"btn-save\">✅ Enregistrer</button>\r\n                <button type=\"reset\" class=\"btn-clear\">\uD83D\uDD04 Réinitialiser</button>\r\n                <button type=\"button\" class=\"btn-danger\" onclick=\"confirmDelete()\">\uD83D\uDDD1\uFE0F Supprimer</button>\r\n            </div>\r\n        </form>\r\n\r\n        {# Delete form (hidden, triggered by JS) #}\r\n        <form id=\"deleteForm\" method=\"post\"\r\n              action=\"{{ path('subscriptiondelete', {id: subscription.subscriptionId}) }}\"\r\n              style=\"display:none;\">\r\n            <input type=\"hidden\" name=\"_token\"\r\n                   value=\"{{ csrf_token('delete' ~ subscription.subscriptionId) }}\">\r\n        </form>\r\n    </div>\r\n</main>\r\n\r\n<script>\r\n    function updatePreview() {\r\n        const s = document.getElementById('dpSubscriptionDate').value;\r\n        const e = document.getElementById('dpExpirationDate').value;\r\n        if (!s || !e) return;\r\n        const start = new Date(s), end = new Date(e), now = new Date();\r\n        const duration = Math.round((end - start) / 86400000);\r\n        const remaining = Math.round((end - now) / 86400000);\r\n        document.getElementById('previewDuration').textContent =\r\n            duration > 0 ? duration + ' jours' : 'Dates invalides';\r\n        document.getElementById('previewRemaining').textContent =\r\n            remaining >= 0 ? remaining + ' jours' : Math.abs(remaining) + ' jours dépassés';\r\n    }\r\n    document.getElementById('dpSubscriptionDate').addEventListener('change', updatePreview);\r\n    document.getElementById('dpExpirationDate').addEventListener('change', updatePreview);\r\n    updatePreview();\r\n\r\n    function confirmDelete() {\r\n        if (confirm('Supprimer cet abonnement ? Cette action est irréversible.')) {\r\n            document.getElementById('deleteForm').submit();\r\n        }\r\n    }\r\n        document.querySelector('form').addEventListener('submit', function(e) {\r\n        e.preventDefault();\r\n\r\n        Swal.fire({\r\n        title: 'Confirmer la modification ?',\r\n        text: 'Les changements seront appliqués immédiatement.',\r\n        icon: 'warning',\r\n        showCancelButton: true,\r\n        confirmButtonColor: '#2563eb',\r\n        cancelButtonColor: '#64748b',\r\n        confirmButtonText: 'Oui, modifier',\r\n        cancelButtonText: 'Annuler'\r\n    }).then((result) => {\r\n        if (result.isConfirmed) {\r\n        e.target.submit();\r\n    }\r\n    });\r\n    });\r\n</script>\r\n</body>\r\n</html>\r\n{% endblock %}
