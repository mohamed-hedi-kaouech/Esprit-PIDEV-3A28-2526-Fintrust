<+>{#\r\n  LAYOUT PRINCIPAL — FRONT OFFICE\r\n  Toutes les pages client héritent de ce layout.\r\n  Bootstrap 5 + thème bleu FinTrust.\r\n#}\r\n<!DOCTYPE html>\r\n<html lang=\"fr\">\r\n<head>\r\n  <meta charset=\"UTF-8\"/>\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\r\n  <title>{% block title %}FinTrust{% endblock %} — FinTrust Banking</title>\r\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\"/>\r\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css\" rel=\"stylesheet\"/>\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\"/>\r\n  <script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"></script>\r\n  <link rel=\"stylesheet\" href=\"{{ asset('css/fintrust-front.css') }}\"/>\r\n  {% block stylesheets %}{% endblock %}\r\n</head>\r\n<body class=\"ft-front-body{% if app.user and app.user.themeMode == 'dark' %} ft-theme-dark{% endif %}\">\r\n\r\n  {# ---- NAVBAR ---- #}\r\n  {% if app.user %}\r\n    {# Navbar connecté avec tous les modules #}\r\n    <nav class=\"navbar navbar-expand-lg ft-navbar-app sticky-top\">\r\n      <div class=\"container-fluid px-4\">\r\n\r\n        <a class=\"navbar-brand ft-brand\" href=\"{{ path('front_dashboard') }}\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\" width=\"32\" height=\"32\">\r\n            <rect width=\"40\" height=\"40\" rx=\"10\" fill=\"#1560BD\"/>\r\n            <path d=\"M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z\" fill=\"white\"/>\r\n          </svg>\r\n          <span class=\"ft-brand-name ms-2\">FinTrust</span>\r\n        </a>\r\n\r\n        <button class=\"navbar-toggler border-0\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#appNav\">\r\n          <i class=\"bi bi-list fs-4\"></i>\r\n        </button>\r\n\r\n        <div class=\"collapse navbar-collapse\" id=\"appNav\">\r\n          <ul class=\"navbar-nav me-auto ms-3 gap-1\">\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_profile' %}active{% endif %}\"\r\n                 href=\"{{ path('front_profile') }}\">\r\n                <i class=\"bi bi-person-circle me-1\"></i>Profile\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if 'front_kyc' in app.request.attributes.get('_route') %}active{% endif %}\"\r\n                 href=\"{% if app.user.kycStatus in ['EN_ATTENTE', 'APPROUVE'] %}{{ path('front_kyc_status') }}{% else %}{{ path('front_kyc_submit') }}{% endif %}\">\r\n                <i class=\"bi bi-shield-check me-1\"></i>KYC\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') starts with 'front_wallet_' and app.request.attributes.get('_route') not in ['front_wallet_transactions', 'front_wallet_cheques', 'front_wallet_cheque_request'] %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('front_wallet_dashboard') : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-wallet2 me-1\"></i>Wallet\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_wallet_transactions' %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('front_wallet_transactions') : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-arrow-left-right me-1\"></i>Transactions\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') in ['front_wallet_cheques', 'front_wallet_cheque_request'] %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('front_wallet_cheques') : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-journal-check me-1\"></i>Cheques\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'product' %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('Client_product_list') : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-box-seam me-1\"></i>Product\r\n              </a>\r\n            </li>\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'product' %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('Client_subscription_list') : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-box-seam me-1\"></i>Product Subscriptions\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'loan' %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('loan_my_loans', {slug: 'loan'}) : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-bank me-1\"></i>Loan\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'budget' %}active{% endif %}\" href=\"{{ app.user.kycApproved ? path('front_module', {slug: 'budget'}) : path('front_kyc_status') }}\">\r\n                <i class=\"bi bi-calculator me-1\"></i>Budget\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link {% if app.request.attributes.get('_route') == 'front_module' and app.request.attributes.get('slug') == 'publications' %}active{% endif %}\" href=\"{{ path('front_module', {slug: 'publications'}) }}\">\r\n                <i class=\"bi bi-newspaper me-1\"></i>Publications\r\n              </a>\r\n            </li>\r\n\r\n            <li class=\"nav-item\">\r\n              <a class=\"nav-link ft-app-link text-danger\" href=\"{{ path('app_logout') }}?from=client\">\r\n                <i class=\"bi bi-box-arrow-right me-1\"></i>Log Out\r\n              </a>\r\n            </li>\r\n\r\n          </ul>\r\n\r\n          {# Droite : notifications + avatar #}\r\n          <div class=\"d-flex align-items-center gap-2\">\r\n\r\n            {# Notifications #}\r\n            <a href=\"{{ path('front_notifications') }}\"\r\n               class=\"btn ft-app-icon-btn {% if app.request.attributes.get('_route') == 'front_notifications' %}active{% endif %}\"\r\n               title=\"Notifications\">\r\n              <i class=\"bi bi-bell\"></i>\r\n            </a>\r\n\r\n            {# Avatar + dropdown #}\r\n            <div class=\"dropdown\">\r\n              <button class=\"btn ft-app-avatar-btn dropdown-toggle\" type=\"button\" data-bs-toggle=\"dropdown\">\r\n                <div class=\"ft-app-avatar\">\r\n                  {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}\r\n                </div>\r\n                <span class=\"d-none d-lg-inline ms-2 small fw-semibold\">{{ app.user.prenom }}</span>\r\n              </button>\r\n              <ul class=\"dropdown-menu dropdown-menu-end ft-app-dropdown shadow-lg\">\r\n                <li>\r\n                  <div class=\"px-3 py-2 border-bottom\">\r\n                    <div class=\"fw-semibold small\">{{ app.user.fullName }}</div>\r\n                    <div class=\"text-muted\" style=\"font-size:.75rem\">{{ app.user.email }}</div>\r\n                    <div class=\"mt-1\">\r\n                      {% if app.user.kycStatus == 'APPROUVE' %}\r\n                        <span class=\"badge ft-badge-success\" style=\"font-size:.65rem\">KYC Vérifié</span>\r\n                      {% elseif app.user.kycStatus == 'EN_ATTENTE' %}\r\n                        <span class=\"badge ft-badge-warning\" style=\"font-size:.65rem\">KYC En attente</span>\r\n                      {% else %}\r\n                        <span class=\"badge ft-badge-neutral\" style=\"font-size:.65rem\">KYC Non soumis</span>\r\n                      {% endif %}\r\n                    </div>\r\n                  </div>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ path('front_profile') }}\">\r\n                    <i class=\"bi bi-person me-2 text-primary\"></i>Profile\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{% if app.user.kycStatus in ['EN_ATTENTE', 'APPROUVE'] %}{{ path('front_kyc_status') }}{% else %}{{ path('front_kyc_submit') }}{% endif %}\">\r\n                    <i class=\"bi bi-shield-check me-2 text-primary\"></i>KYC\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_wallet_dashboard') : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-wallet2 me-2 text-primary\"></i>Wallet\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_wallet_transactions') : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-arrow-left-right me-2 text-primary\"></i>Transactions\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_wallet_cheques') : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-journal-check me-2 text-primary\"></i>Cheques\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_module', {slug: 'product'}) : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-box-seam me-2 text-primary\"></i>Product\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_module', {slug: 'loan'}) : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-bank me-2 text-primary\"></i>Loan\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ app.user.kycApproved ? path('front_module', {slug: 'budget'}) : path('front_kyc_status') }}\">\r\n                    <i class=\"bi bi-calculator me-2 text-primary\"></i>Budget\r\n                  </a>\r\n                </li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2\" href=\"{{ path('front_module', {slug: 'publications'}) }}\">\r\n                    <i class=\"bi bi-newspaper me-2 text-primary\"></i>Publications\r\n                  </a>\r\n                </li>\r\n                <li><hr class=\"dropdown-divider my-1\"/></li>\r\n                <li>\r\n                  <a class=\"dropdown-item py-2 text-danger\" href=\"{{ path('app_logout') }}?from=client\">\r\n                    <i class=\"bi bi-box-arrow-right me-2\"></i>Déconnexion\r\n                  </a>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n\r\n  {% else %}\r\n    {# Navbar publique (landing page, login, register) #}\r\n    <nav class=\"navbar navbar-expand-lg ft-navbar sticky-top\">\r\n      <div class=\"container-xl\">\r\n        <a class=\"navbar-brand ft-brand\" href=\"{{ path('app') }}\">\r\n          <svg viewBox=\"0 0 40 40\" fill=\"none\" width=\"32\" height=\"32\">\r\n            <rect width=\"40\" height=\"40\" rx=\"10\" fill=\"#1560BD\"/>\r\n            <path d=\"M10 28V18l10-8 10 8v10H24v-6h-8v6H10Z\" fill=\"white\"/>\r\n          </svg>\r\n          <span class=\"ft-brand-name ms-2\">FinTrust</span>\r\n        </a>\r\n        <div class=\"ms-auto d-flex gap-2\">\r\n          <a href=\"{{ path('app_login') }}\" class=\"btn ft-btn-outline-primary btn-sm\">Connexion</a>\r\n          <a href=\"{{ path('app_register') }}\" class=\"btn ft-btn-primary btn-sm\">S'inscrire</a>\r\n        </div>\r\n      </div>\r\n    </nav>\r\n  {% endif %}\r\n\r\n  {# ---- FLASH MESSAGES ---- #}\r\n  {% if app.flashes|length > 0 %}\r\n    <div class=\"position-fixed top-0 end-0 p-3\" style=\"z-index:1100;margin-top:70px\">\r\n      {% for type, messages in app.flashes %}\r\n        {% set bsType = type == 'error' ? 'danger' : type %}\r\n        {% for message in messages %}\r\n          <div class=\"toast align-items-center text-bg-{{ bsType }} border-0 show mb-2\" role=\"alert\">\r\n            <div class=\"d-flex\">\r\n              <div class=\"toast-body fw-semibold\">\r\n                {% if type == 'success' %}<i class=\"bi bi-check-circle me-2\"></i>\r\n                {% elseif type == 'error' %}<i class=\"bi bi-x-circle me-2\"></i>\r\n                {% elseif type == 'warning' %}<i class=\"bi bi-exclamation-triangle me-2\"></i>\r\n                {% else %}<i class=\"bi bi-info-circle me-2\"></i>{% endif %}\r\n                {{ message }}\r\n              </div>\r\n              <button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" data-bs-dismiss=\"toast\"></button>\r\n            </div>\r\n          </div>\r\n        {% endfor %}\r\n      {% endfor %}\r\n    </div>\r\n  {% endif %}\r\n\r\n  {# ---- CONTENU ---- #}\r\n  <main class=\"ft-main\">\r\n    {% block body %}{% endblock %}\r\n  </main>\r\n\r\n  {# ---- FOOTER (uniquement si non connecté) ---- #}\r\n  {% if not app.user %}\r\n  <footer class=\"ft-footer mt-auto\">\r\n    <div class=\"container-xl\">\r\n      <div class=\"row align-items-center py-3\">\r\n        <div class=\"col-md-6\">\r\n          <p class=\"text-muted small mb-0\">© {{ \"now\"|date(\"Y\") }} FinTrust. Tous droits réservés.</p>\r\n        </div>\r\n        <div class=\"col-md-6 text-md-end\">\r\n          <a href=\"#\" class=\"text-muted small me-3\">Confidentialité</a>\r\n          <a href=\"#\" class=\"text-muted small\">Contact</a>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </footer>\r\n  {% endif %}\r\n\r\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\r\n  <script>\r\n    document.querySelectorAll('.toast').forEach(function(el) {\r\n      new bootstrap.Toast(el, { delay: 5000 }).show();\r\n    });\r\n  </script>\r\n  {% block javascripts %}{% endblock %}\r\n</body>\r\n</html>\r\n
