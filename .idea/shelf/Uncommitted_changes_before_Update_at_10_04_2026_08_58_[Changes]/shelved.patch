Subsystem: com.intellij.openapi.diff.impl.patch.BaseRevisionTextPatchEP
<+>{% extends 'admin/back.html.twig' %}\r\n{% block title %}List Produit{% endblock %}\r\n\r\n{% block admin_content %}\r\n\r\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&family=Fraunces:wght@700;900&display=swap\" rel=\"stylesheet\">\r\n  <link rel=\"stylesheet\" href=\"{{ asset('css/Product/StyleProduct.css') }}\">\r\n\r\n  <style>\r\n    /* stagger */\r\n    {% for i in 1..50 %}\r\n    .pl-card:nth-child({{ i }}) { animation-delay: {{ (i - 1) * 0.04 }}s; }\r\n    {% endfor %}\r\n  </style>\r\n\r\n  <div class=\"pl-page\">\r\n\r\n    {# ── Header ── #}\r\n    <div class=\"pl-header\">\r\n      <h1 class=\"pl-title\">Nos Produits</h1>\r\n\r\n      <div class=\"pl-count\">{{ products|length }} produit{{ products|length != 1 ? 's' : '' }}</div>\r\n      <a  href=\"{{ path('CreateProduct') }}\" class=\"pl-buy-btn\">&#43; Nouveau Produit</a>\r\n    </div>\r\n\r\n    {# ── Controls ── #}\r\n    <form method=\"GET\" action=\"{{ path('product_list') }}\">\r\n      <div class=\"pl-controls\">\r\n\r\n        <div class=\"pl-search-wrap\">\r\n          <input\r\n                  class=\"pl-input\"\r\n                  type=\"text\"\r\n                  name=\"search\"\r\n                  placeholder=\"\uD83D\uDD0D Rechercher un produit...\"\r\n                  value=\"{{ app.request.query.get('search') }}\"\r\n          />\r\n          <button type=\"submit\" class=\"pl-btn pl-btn-primary\">Rechercher</button>\r\n          <a href=\"{{ path('product_list') }}\" class=\"pl-btn pl-btn-ghost\">✕</a>\r\n        </div>\r\n\r\n        <div class=\"pl-divider\"></div>\r\n\r\n        <span class=\"pl-filter-label\">Catégorie</span>\r\n        <select name=\"category\" class=\"pl-select\" onchange=\"this.form.submit()\">\r\n          <option value=\"\">Toutes</option>\r\n          {% set categories = [] %}\r\n          {% for product in products %}\r\n            {% if product.category not in categories %}\r\n              {% set categories = categories|merge([product.category]) %}\r\n            {% endif %}\r\n          {% endfor %}\r\n          {% for cat in categories|sort %}\r\n            <option value=\"{{ cat }}\" {% if app.request.query.get('category') == cat %}selected{% endif %}>\r\n              {{ cat|replace({'_': ' '})|title }}\r\n            </option>\r\n          {% endfor %}\r\n        </select>\r\n\r\n        <span class=\"pl-filter-label\">Trier</span>\r\n        <select name=\"sort\" class=\"pl-select\" onchange=\"this.form.submit()\">\r\n          <option value=\"\">Par défaut</option>\r\n          <option value=\"price_asc\"  {% if app.request.query.get('sort') == 'price_asc'  %}selected{% endif %}>Prix ↑</option>\r\n          <option value=\"price_desc\" {% if app.request.query.get('sort') == 'price_desc' %}selected{% endif %}>Prix ↓</option>\r\n          <option value=\"date_desc\"  {% if app.request.query.get('sort') == 'date_desc'  %}selected{% endif %}>Plus récent</option>\r\n          <option value=\"date_asc\"   {% if app.request.query.get('sort') == 'date_asc'   %}selected{% endif %}>Plus ancien</option>\r\n        </select>\r\n\r\n      </div>\r\n    </form>\r\n\r\n    {# ── Active filter indicator ── #}\r\n    {% set searchTerm = app.request.query.get('search') %}\r\n    {% set filterCat  = app.request.query.get('category') %}\r\n    {% if searchTerm or filterCat %}\r\n      <div class=\"pl-active-bar\">\r\n        \uD83D\uDD0E Résultats filtrés\r\n        {% if searchTerm %} — recherche : <strong>\"{{ searchTerm }}\"</strong>{% endif %}\r\n        {% if filterCat  %} — catégorie : <strong>{{ filterCat|replace({'_': ' '})|title }}</strong>{% endif %}\r\n      </div>\r\n    {% endif %}\r\n\r\n    {# ── Card Grid ── #}\r\n    {% set strips = ['strip-blue','strip-green','strip-amber','strip-purple','strip-coral'] %}\r\n    {% set icons  = ['icon-blue','icon-green','icon-amber','icon-purple','icon-coral'] %}\r\n    {% set badges = ['badge-blue','badge-green','badge-amber','badge-purple','badge-coral'] %}\r\n\r\n    <div class=\"pl-grid\">\r\n\r\n      {% if products is empty %}\r\n        <div class=\"pl-empty\">\r\n          <div class=\"pl-empty-icon\">\uD83D\uDCED</div>\r\n          <div class=\"pl-empty-text\">Aucun produit trouvé.</div>\r\n        </div>\r\n      {% else %}\r\n        {% for product in products %}\r\n          {% set idx = loop.index0 % 5 %}\r\n\r\n          {# Hidden buy form #}\r\n          <form\r\n                  id=\"buy-form-{{ product.productId }}\"\r\n                  method=\"POST\"\r\n                  action=\"{{ path('Client_product_Buy') }}\"\r\n                  style=\"display:none\"\r\n          >\r\n            <input type=\"hidden\" name=\"Productid\" value=\"{{ product.productId }}\">\r\n            <input type=\"hidden\" name=\"type\" id=\"buy-type-{{ product.productId }}\">\r\n            <input type=\"hidden\" name=\"_token\" value=\"{{ csrf_token('BuyProduct_') }}\">\r\n          </form>\r\n\r\n          <div class=\"pl-card\">\r\n            <div class=\"pl-card-top {{ strips[idx] }}\"></div>\r\n\r\n            <div class=\"pl-card-body\">\r\n              <div class=\"pl-card-icon-row\">\r\n                <div class=\"pl-card-icon {{ icons[idx] }}\">\r\n                  {{ product.category|slice(0,2)|upper }}\r\n                </div>\r\n                <div style=\"text-align:right\">\r\n                <span class=\"pl-card-badge {{ badges[idx] }}\">\r\n                  {{ product.category|replace({'_': ' '})|title }}\r\n                </span>\r\n                  <div class=\"pl-card-date\">{{ product.createdAt|date('d/m/Y') }}</div>\r\n                </div>\r\n              </div>\r\n\r\n              <p class=\"pl-card-desc\" title=\"{{ product.description }}\">\r\n                {{ product.description }}\r\n              </p>\r\n            </div>\r\n\r\n            <div class=\"pl-card-footer\">\r\n              <div class=\"pl-card-price\">\r\n                {{ product.price|number_format(2, ',', ' ') }}<span>DT</span>\r\n              </div>\r\n              <a class=\"pl-buy-btn\" href=\"{{ path('EditProduct', {id: product.productId}) }}\" >Edit</a><br>\r\n              <form method=\"post\" action=\"{{ path('product_delete', {id: product.productId}) }}\" class=\"delete-form\">\r\n                <button class=\"pl-buy-btn\" type=\"button\">\r\n                  Delete\r\n                </button>\r\n              </form>\r\n            </div>\r\n          </div>\r\n\r\n        {% endfor %}\r\n      {% endif %}\r\n\r\n    </div>\r\n  </div>\r\n\r\n  {# ── Consume flashes ── #}\r\n  {% set flashSuccesses = app.flashes('success') %}\r\n  {% set flashErrors    = app.flashes('error') %}\r\n\r\n  <script src=\"https://cdn.jsdelivr.net/npm/sweetalert2@11\"></script>\r\n  <script src=\"{{ asset('js/Product/ScriptProduct.js') }}\" defer></script>\r\n\r\n  <script>\r\n    {% if flashSuccesses is not empty %}\r\n    window.addEventListener('load', function () {\r\n      Swal.fire({\r\n        icon: 'success',\r\n        title: '{{ flashSuccesses|first|e('js') }}',\r\n        showConfirmButton: false,\r\n        timer: 2500,\r\n        timerProgressBar: true,\r\n        background: '#151820',\r\n        color: '#f0f2f8',\r\n        iconColor: '#22c97a'\r\n      });\r\n    });\r\n    {% endif %}\r\n\r\n    {% if flashErrors is not empty %}\r\n    window.addEventListener('load', function () {\r\n      Swal.fire({\r\n        icon: 'error',\r\n        title: '{{ flashErrors|first|e('js') }}',\r\n        showConfirmButton: true,\r\n        background: '#151820',\r\n        color: '#f0f2f8'\r\n      });\r\n    });\r\n    {% endif %}\r\n\r\n    function selectType(productId) {\r\n      Swal.fire({\r\n        title: \"Type d'abonnement\",\r\n        text: \"Choisissez le type d'abonnement pour ce produit :\",\r\n        input: 'select',\r\n        inputOptions: {\r\n          'MONTHLY':     'Mensuel',\r\n          'ANNUALLY':    'Annuel',\r\n          'TRANSACTION': 'Par transaction',\r\n          'ONE_TIME':    'Paiement unique'\r\n        },\r\n        inputPlaceholder: 'Sélectionner un type',\r\n        showCancelButton: true,\r\n        confirmButtonText: 'Confirmer',\r\n        cancelButtonText: 'Annuler',\r\n        background: '#151820',\r\n        color: '#f0f2f8',\r\n        confirmButtonColor: '#3d7fff',\r\n        inputValidator: (value) => {\r\n          if (!value) return 'Veuillez sélectionner un type.';\r\n        }\r\n      }).then((result) => {\r\n        if (result.isConfirmed) {\r\n          document.getElementById('buy-type-' + productId).value = result.value;\r\n          document.getElementById('buy-form-' + productId).submit();\r\n        }\r\n      });\r\n    }\r\n  </script>\r\n\r\n{% endblock %}\r\n
