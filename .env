###> karser/karser-recaptcha3-bundle ###
# Remplacez ces valeurs par vos cles Google reCAPTCHA v3.
# Gardez RECAPTCHA3_ENABLED=0 tant que les vraies cles ne sont pas configurees.
RECAPTCHA3_KEY=change_me_site_key
RECAPTCHA3_SECRET=change_me_secret_key
RECAPTCHA3_SCORE_THRESHOLD=0.5
RECAPTCHA3_ENABLED=0
###< karser/karser-recaptcha3-bundle ###

###> fintrust/security-external-apis ###
# Active le controle externe au login : geolocalisation IP.
# Mettez 1 pour activer les appels API.
SECURITY_EXTERNAL_APIS_ENABLED=1
# Optionnel pour tester sans VPN : mettez par exemple 8.8.8.8 puis 1.1.1.1.
SECURITY_TEST_IP=
###< fintrust/security-external-apis ###
